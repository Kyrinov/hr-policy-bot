r.\", \"detailed_analysis\": \"Detail.\", \"citations\": [], \"agents_consulted\": [\"staffing\"], \"overall_confidence\": \"high\"}'\n        orchestrator._llm_client.chat = AsyncMock(return_value=valid_json)\n        response = await orchestrator.process(\"query\", [{\"agent_id\": \"staffing\", \"citations\": [], \"confidence\": \"high\", \"findings\": \"x\"}])\n        assert response.summary == \"Answer.\"\n        assert response.overall_confidence == \"high\"\n\n    @pytest.mark.asyncio\n    async def test_returns_error_response_on_json_decode_failure(self, orchestrator):\n        orchestrator._llm_client.chat = AsyncMock(return_value=\"not json at all\")\n        response = await orchestrator.process(\"query\", [])\n        assert response.overall_confidence == \"low\"\n        assert \"error\" in response.summary.lower()\n\n    @pytest.mark.asyncio\n    async def test_strips_preamble_before_json(self, orchestrator):\n        with_preamble = 'Here is your answer:\\n{\"summary\": \"Ok.\", \"detailed_analysis\": \"d.\", \"citations\": [], \"agents_consulted\": [], \"overall_confidence\": \"medium\"}'\n        orchestrator._llm_client.chat = AsyncMock(return_value=with_preamble)\n        response = await orchestrator.process(\"query\", [])\n        assert response.summary == \"Ok.\"\n\n\nclass TestRoute:\n    @pytest.mark.asyncio\n    async def test_returns_parsed_routing_on_valid_json(self, orchestrator):\n        routing_json = '{\"selected_agents\": [\"staffing\"], \"routing_rationale\": \"r\", \"sub_queries\": {\"staffing\": \"sub\"}}'\n        orchestrator._llm_client.chat = AsyncMock(return_value=routing_json)\n        result = await orchestrator._route(\"staffing query\")\n        assert result[\"selected_agents\"] == [\"staffing\"]\n\n    @pytest.mark.asyncio\n    async def test_falls_back_to_all_agents_on_parse_failure(self, orchestrator):\n        orchestrator._llm_client.chat = AsyncMock(return_value=\"bad json\")\n        result = await orchestrator.