        "code": "# tests/test_cache.py\n\"\"\"Unit tests for FetchCache and CacheEntry.\"\"\"\n\nimport pytest\nfrom datetime import datetime, timedelta\nfrom unittest.mock import AsyncMock, patch\n\nfrom src.fetch.cache import CacheEntry, FetchCache\n\n\nclass TestCacheEntry:\n    def test_content_hash_is_sha256(self):\n        import hashlib\n        entry = CacheEntry(url=\"https://x.ca\", content=\"hello\", ttl_hours=24)\n        expected = hashlib.sha256(b\"hello\").hexdigest()\n        assert entry.content_hash == expected\n\n    def test_is_valid_fresh_entry(self):\n        entry = CacheEntry(url=\"https://x.ca\", content=\"c\", ttl_hours=168)\n        entry.fetched_at = datetime.utcnow().isoformat()\n        assert entry.is_valid()\n\n    def test_is_valid_expired_entry(self):\n        entry = CacheEntry(url=\"https://x.ca\", content=\"c\", ttl_hours=1)\n        entry.fetched_at = (datetime.utcnow() - timedelta(hours=2)).isoformat()\n        assert not entry.is_valid()\n\n\nclass TestFetchCache:\n    @pytest.fixture\n    def mock_db(self):\n        return AsyncMock()\n\n    @pytest.fixture\n    def cache(self, mock_db):\n        with patch(\"src.fetch.cache.get_config\") as mock_cfg:\n            mock_cfg.return_value.cache.ttl_hours = 168\n            return FetchCache(db_manager=mock_db)\n\n    @pytest.mark.asyncio\n    async def test_get_returns_none_on_miss(self, cache, mock_db):\n        mock_db.get_cached.return_value = None\n        assert await cache.get(\"https://x.ca\") is None\n\n    @pytest.mark.asyncio\n    async def test_get_returns_cache_entry_on_hit(self, cache, mock_db):\n        from src.models.schemas import FetchCacheEntry\n        mock_db.get_cached.return_value = FetchCacheEntry(\n            url=\"https://x.ca\", content_text=\"content\", content_hash=\"abc\",\n            ttl_hours=168, fetched_at=datetime.utcnow()\n        )\n        result = await cache.get(\"https://x.ca\")\n        assert result is not None\n        assert result.content == \"content\"\n\n    @pytest.mark.asyncio\n    async def test_get_stale_returns_none_on_miss(self, cache, mock_db):\n        mock_db.get_stale.return_value = None\n        assert await cache.get_stale(\"https://x.ca\") is None\n\n    @pytest.mark.asyncio\n    async def test_set_cached_calls_db(self, cache, mock_db):\n        entry = CacheEntry(url=\"https://x.ca\", content=\"c\", ttl_hours=24)\n        await cache.set_cached(entry)\n        mock_db.set_cached.assert_called_once()\n\n    def test_get_default_ttl_legislation_domain(self, cache):\n        assert cache._get_default_ttl(\"https://laws-lois.justice.gc.ca/eng/acts/x\") == 720\n\n    def test_get_default_ttl_collective_domain(self, cache):\n        assert cache._get_default_ttl(\"https://tbs-sct.canada.ca/agreements-conventions/x\") == 720\n\n    def test_get_default_ttl_default_domain(self, cache):\n        assert cache._get_default_ttl(\"https://example.com/page\") == 168\n\n    @pytest.mark.asyncio\n    async def test_clear_expired_delegates_to_db(self, cache, mock_db):\n        mock_db.clear_expired.return_value = 5\n        count = await cache.clear_expired()\n        assert count == 5"
