      {
        "title": "---------------------------------------------------------------------------",
        "content": "\n@pytest.mark.asyncio\nclass TestWebSocketManager:\n    async def test_send_to_unknown_query_returns_false(self):\n        from src.api.websocket import WebSocketManager\n\n        manager = WebSocketManager()\n        result = await manager.send(\"nonexistent-id\", {\"type\": \"test\"})\n        assert result is False\n\n    async def test_disconnect_removes_connection(self):\n        from src.api.websocket import WebSocketManager\n\n        manager = WebSocketManager()\n        mock_ws = AsyncMock()\n        await manager.connect(\"q1\", mock_ws)\n        assert \"q1\" in manager._connections\n        await manager.disconnect(\"q1\")\n        assert \"q1\" not in manager._connections\n\n    async def test_disconnect_nonexistent_is_safe(self):\n        from src.api.websocket import WebSocketManager\n\n        manager = WebSocketManager()\n        await manager.disconnect(\"does-not-exist\")  # must not raise\n\n    async def test_broadcast_error_sends_to_all_connections(self):\n        from src.api.websocket import WebSocketManager\n\n        manager = WebSocketManager()\n        ws1 = AsyncMock()\n        ws2 = AsyncMock()\n        await manager.connect(\"q1\", ws1)\n        await manager.connect(\"q2\", ws2)\n        await manager.broadcast_error(\"system error\")\n        ws1.send_json.assert_awaited_once()\n        ws2.send_json.assert_awaited_once()\n\n\n",
        "level": 1
