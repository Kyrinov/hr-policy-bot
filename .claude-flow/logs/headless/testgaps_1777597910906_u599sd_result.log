        "code": "# tests/test_extractors.py\n\"\"\"Additional ContentExtractor tests.\"\"\"\n\nimport pytest\nfrom unittest.mock import patch\n\n\n@pytest.fixture\ndef extractor():\n    with patch.object(\n        __import__(\"src.fetch.extractors\", fromlist=[\"ContentExtractor\"]).ContentExtractor,\n        \"_load_selectors\",\n        return_value={\n            \"domain_selectors\": {\n                \"default\": {\n                    \"content_selector\": [\"main\", \"article\"],\n                    \"remove_selector\": [\"nav\", \"footer\"],\n                }\n            }\n        },\n    ):\n        from src.fetch.extractors import ContentExtractor\n        return ContentExtractor.__new__(ContentExtractor)\n\n\nclass TestLoadSelectorsFallback:\n    def test_returns_default_when_file_missing(self):\n        from src.fetch.extractors import ContentExtractor\n        extractor = ContentExtractor.__new__(ContentExtractor)\n        result = extractor._load_selectors(\"/nonexistent/path.yaml\")\n        assert \"default\" in result\n\n    def test_returns_loaded_selectors_on_valid_file(self, tmp_path):\n        import yaml\n        sel = {\"domain_selectors\": {\"default\": {\"content_selector\": [\"main\"]}}}\n        path = tmp_path / \"selectors.yaml\"\n        path.write_text(yaml.dump(sel))\n        from src.fetch.extractors import ContentExtractor\n        extractor = ContentExtractor.__new__(ContentExtractor)\n        result = extractor._load_selectors(str(path))\n        assert result == sel\n\n\nclass TestTruncate:\n    def test_returns_text_unchanged_when_under_limit(self):\n        from src.fetch.extractors import ContentExtractor\n        e = ContentExtractor.__new__(ContentExtractor)\n        assert e._truncate(\"short\", 100) == \"short\"\n\n    def test_truncates_and_appends_ellipsis(self):\n        from src.fetch.extractors import ContentExtractor\n        e = ContentExtractor.__new__(ContentExtractor)\n        result = e._truncate(\"a\" * 200, 100)\n        assert len(result) == 100\n        assert result.endswith(\"...\")\n\n\nclass TestFormatContent:\n    def test_extracts_headings_with_newlines(self):\n        from bs4 import BeautifulSoup\n        from src.fetch.extractors import ContentExtractor\n        e = ContentExtractor.__new__(ContentExtractor)\n        soup = BeautifulSoup(\"<main><h1>Title</h1><p>Paragraph.</p></main>\", \"lxml\")\n        result = e._format_content(soup.find(\"main\"))\n        assert \"Title\" in result\n        assert \"Paragraph.\" in result\n\n    def test_removes_specified_elements(self):\n        from bs4 import BeautifulSoup\n        from src.fetch.extractors import ContentExtractor\n        e = ContentExtractor.__new__(ContentExtractor)\n        soup = BeautifulSoup(\"<main><nav>Skip</nav><p>Content</p></main>\", \"lxml\")\n        main = soup.find(\"main\")\n        e._remove_elements(main, [\"nav\"])\n        assert \"Skip\" not in str(main)\n        assert \"Content\" in str(main)\n\n\nclass TestExtractErrorHandling:\n    def test_returns_raw_text_on_exception(self):\n        from src.fetch.extractors import ContentExtractor\n        e = ContentExtractor.__new__(ContentExtractor)\n        e._selectors = {\"domain_selectors\": {}}\n        # Force an error by passing non-HTML\n        result = e.extract(\"https://example.com\", None)  # type: ignore\n        assert isinstance(result, str)"
