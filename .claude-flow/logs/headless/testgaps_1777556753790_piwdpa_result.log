        "title": "tests/test_fetch_engine.py",
        "content": "\"\"\"Tests for FetchEngine — mocks httpx and cache.\"\"\"\n\nimport pytest\nfrom unittest.mock import AsyncMock, MagicMock, patch\nfrom src.fetch.engine import FetchEngine, FetchError\n\n\n@pytest.fixture\ndef mock_cache():\n    cache = MagicMock()\n    cache.get = AsyncMock(return_value=None)\n    cache.get_stale = AsyncMock(return_value=None)\n    cache.set_cached = AsyncMock()\n    cache._get_default_ttl = MagicMock(return_value=168)\n    return cache\n\n\n@pytest.fixture\ndef mock_extractor():\n    extractor = MagicMock()\n    extractor.extract = MagicMock(return_value=\"extracted content\")\n    return extractor\n\n\n@pytest.fixture\ndef engine(mock_cache, mock_extractor):\n    return FetchEngine(cache=mock_cache, extractor=mock_extractor)\n\n\nclass TestNormalizeUrl:\n    def test_appends_fulltext_to_laws_lois_act_index(self, engine):\n        url = \"https://laws-lois.justice.gc.ca/eng/acts/P-33.01/\"\n        assert engine._normalize_url(url).endswith(\"/FullText.html\")\n\n    def test_leaves_other_urls_unchanged(self, engine):\n        url = \"https://tbs-sct.canada.ca/pol/doc-eng.aspx?id=32621\"\n        assert engine._normalize_url(url) == url\n\n    def test_does_not_double_append_fulltext(self, engine):\n        url = \"https://laws-lois.justice.gc.ca/eng/acts/P-33.01/FullText.html\"\n        assert engine._normalize_url(url) == url\n\n\nclass TestGetDomain:\n    def test_extracts_domain_correctly(self, engine):\n        assert engine._get_domain(\"https://tbs-sct.canada.ca/some/path\") == \"tbs-sct.canada.ca\"\n\n    def test_returns_default_for_malformed_url(self, engine):\n        assert engine._get_domain(\"\") == \"default\"\n\n\nclass TestFetch:\n    @pytest.mark.asyncio\n    async def test_returns_cached_content_on_cache_hit(self, engine, mock_cache):\n        from src.fetch.cache import CacheEntry\n        from unittest.mock import MagicMock\n        entry = MagicMock(spec=CacheEntry)\n        entry.content = \"cached text\"\n        mock_cache.get = AsyncMock(return_value=entry)\n\n        result = await engine.fetch(\"https://example.com/page\")\n        assert result == \"cached text\"\n        engine._client.get.assert_not_called() if hasattr(engine._client, 'get') else None\n\n    @pytest.mark.asyncio\n    async def test_raises_fetch_error_when_both_live_and_stale_fail(self, engine, mock_cache):\n        mock_cache.get = AsyncMock(return_value=None)\n        mock_cache.get_stale = AsyncMock(return_value=None)\n\n        import httpx\n        engine._client = MagicMock()\n        engine._client.get = AsyncMock(side_effect=httpx.RequestError(\"conn failed\"))\n\n        with pytest.raises(FetchError):\n            await engine.fetch(\"https://example.com/page\")\n\n    @pytest.mark.asyncio\n    async def test_falls_back_to_stale_cache_on_live_fetch_failure(self, engine, mock_cache):\n        from src.fetch.cache import CacheEntry\n        stale_entry = MagicMock(spec=CacheEntry)\n        stale_entry.content = \"stale content\"\n        mock_cache.get = AsyncMock(return_value=None)\n        mock_cache.get_stale = AsyncMock(return_value=stale_entry)\n\n        import httpx\n        engine._client = MagicMock()\n        engine._client.get = AsyncMock(side_effect=httpx.RequestError(\"timeout\"))\n\n        result = await engine.fetch(\"https://example.com/page\")\n        assert result == \"stale content\"\n\n\nclass TestFetchBatch:\n    @pytest.mark.asyncio\n    async def test_returns_only_successful_urls(self, engine):\n        async def selective_fetch(url):\n            if \"good\" in url:\n                return \"content\"\n            raise FetchError(\"bad url\")\n\n        engine.fetch = selective_fetch\n        results = await engine.fetch_batch([\"https://good.com\", \"https://bad.com\"])\n        assert \"https://good.com\" in results\n        assert \"https://bad.com\" not in results\n```\n\n```python\n",
        "level": 1
