        "code": "# tests/test_base_agent.py\n\"\"\"Unit tests for GenericAgent base class.\"\"\"\n\nimport pytest\nfrom src.agents.base import GenericAgent\n\n\n@pytest.fixture\ndef agent():\n    return GenericAgent(\n        agent_id=\"test-agent\",\n        display_name=\"Test Agent\",\n        domain_description=\"Test domain\",\n        system_prompt=\"You are a test agent.\",\n    )\n\n\nclass TestGenericAgentProperties:\n    def test_agent_id(self, agent):\n        assert agent.agent_id == \"test-agent\"\n\n    def test_display_name(self, agent):\n        assert agent.display_name == \"Test Agent\"\n\n    def test_domain_description(self, agent):\n        assert agent.domain_description == \"Test domain\"\n\n    def test_system_prompt(self, agent):\n        assert agent.system_prompt == \"You are a test agent.\"\n\n\nclass TestBuildPrompt:\n    def test_includes_query(self, agent):\n        prompt = agent.build_prompt(\"What is overtime pay?\")\n        assert \"What is overtime pay?\" in prompt\n\n    def test_includes_policy_context(self, agent):\n        prompt = agent.build_prompt(\"query\", policy_context=\"Section 5.1: ...\")\n        assert \"Section 5.1\" in prompt\n\n    def test_no_policy_context_omitted(self, agent):\n        prompt = agent.build_prompt(\"query\")\n        assert \"RELEVANT POLICY CONTENT\" not in prompt\n\n    def test_includes_json_instruction(self, agent):\n        prompt = agent.build_prompt(\"query\")\n        assert \"JSON\" in prompt\n\n\nclass TestBaseProcess:\n    @pytest.mark.asyncio\n    async def test_process_raises_not_implemented(self, agent):\n        with pytest.raises(NotImplementedError):\n            await agent.process(\"query\")"
