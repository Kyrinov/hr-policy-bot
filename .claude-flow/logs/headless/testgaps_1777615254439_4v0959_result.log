n edge cases.\"\"\"\n\n    def test_orchestrator_response_defaults(self):\n        \"\"\"OrchestratorResponse optional fields default to None/[].\"\"\"\n        from src.models.schemas import OrchestratorResponse\n\n        r = OrchestratorResponse(\n            summary=\"Test\",\n            detailed_analysis=\"Detail\",\n            agents_consulted=[\"staffing\"],\n            overall_confidence=\"medium\",\n        )\n        assert r.policy_tensions is None\n        assert r.citations == []\n        assert r.gaps_and_limitations is None\n\n    def test_ws_agent_status_update(self):\n        \"\"\"WSAgentStatusUpdate serialises correctly.\"\"\"\n        from src.models.schemas import WSAgentStatusUpdate\n\n        msg = WSAgentStatusUpdate(agent_id=\"staffing\", status=\"working\")\n        d = msg.model_dump()\n        assert d[\"type\"] == \"agent_status_update\"\n        assert d[\"agent_id\"] == \"staffing\"\n        assert d[\"status\"] == \"working\"\n        assert d[\"message\"] is None\n\n    def test_ws_error_without_query_id(self):\n        from src.models.schemas import WSError\n\n        err = WSError(message=\"something failed\")\n        assert err.query_id is None\n        assert err.type == \"error\"\n\n    def test_citation_item_optional_fields(self):\n        from src.models.schemas import CitationItem\n\n        c = CitationItem(instrument_title=\"PSEA\", instrument_type=\"Act\")\n        assert c.url is None\n        assert c.relevant_section is None\n\n    def test_feedback_record_rating_values(self):\n        \"\"\"FeedbackRecord accepts known rating strings.\"\"\"\n        from src.models.schemas import FeedbackRecord\n\n        for rating in (\"accurate\", \"needs_work\"):\n            r = FeedbackRecord(\n                feedback_id=str(uuid.uuid4()),\n                query_id=str(uuid.uuid4()),\n                rating=rating,\n            )\n            assert r.rating == rating\n\n    def test_routing_decision(self):\n        from src.models.schemas import RoutingDecision\n\n        rd = RoutingDecision(\n            selected_agents=[\"staffing\", \"labour\"],\n            routing_rationale=\"Both domains apply.\",\n            sub_queries={\"staffing\": \"Can we post externally?\", \"labour\": \"Grievance procedure?\"},\n        )\n        assert len(rd.selected_agents) == 2\n\n\n# ---------------------------------------------------------------------------\n# 2. FETCH ENGINE\n# ---------------------------------------------------------------------------\n\nclass TestFetchEngineNormalizeUrl:\n    \"\"\"_normalize_url rewrites laws-lois act index pages.\"\"\"\n\n    def test_normalizes_laws_lois_act_index(self):\n        from src.fetch.engine import FetchEngine\n\n        engine = FetchEngine.__new__(FetchEngine)\n        url = \"https://laws-lois.justice.gc.ca/eng/acts/P-33.01/\"\n        assert engine._normalize_url(url).endswith(\"/FullText.html\")\n\n    def test_does_not_rewrite_full_text_url(self):\n        from src.fetch.engine import FetchEngine\n\n        engine = FetchEngine.__new__(FetchEngine)\n        url = \"https://laws-lois.justice.gc.ca/eng/acts/P-33.01/FullText.html\"\n        assert engine._normalize_url(url) == url\n\n    def test_does_not_rewrite_non_laws_url(self):\n        from src.fetch.engine import FetchEngine\n\n        engine = FetchEngine.__new__(FetchEngine)\n        url = \"https://tbs-sct.canada.ca/pol/doc-eng.aspx?id=12345\"\n        assert engine._normalize_url(url) == url\n\n\nclass TestFetchEngineGetDomain:\n    def test_extracts_domain(self):\n        from src.fetch.engine import FetchEngine\n\n        engine = FetchEngine.__new__(FetchEngine)\n        assert engine._get_domain(\"https://tbs-sct.canada.ca/foo/bar\") == \"tbs-sct.canada.ca\"\n\n    def test_fallback_on_bad_url(self):\n        from src.fetch.engine import FetchEngine\n\n        engine = FetchEngine.__new__(FetchEngine)\n        assert engine._get_domain(\"not-a-url\") == \"default\"\n\n\n@pytest.mark.asyncio\nclass TestFetchEngineDoFetch:\n    \"\"\"_do_fetch: cache hit, HTTP success, HTTP failure + stale fallback.\"\"\"\n\n    async def test_returns_cache_hit(self):\n        from src.fetch.cache import CacheEntry\n        from src.fetch.engine import FetchEngine\n\n        mock_cache = AsyncMock()\n        mock_cache.get.return_value = CacheEntry(\n            url=\"https://example.com\",\n            content=\"cached content\",\n            ttl_hours=24,\n        )\n        mock_extractor = MagicMock()\n        engine = FetchEngine(cache=mock_cache, extractor=mock_extractor)\n        result = await engine._do_fetch(\"https://example.com\")\n        assert result == \"cached content\"\n        mock_cache.get.assert_awaited_once()\n\n    async def test_fetch_success_stores_in_cache(self):\n        import httpx\n        from src.fetch.engine import FetchEngine\n\n        mock_cache = AsyncMock()\n        mock_cache.get.return_value = None  # cache miss\n        mock_extractor = MagicMock(return_value=\"extracted text\")\n        mock_extractor.extract.return_value = \"extracted text\"\n\n        engine = FetchEngine(cache=mock_cache, extractor=mock_extractor)\n\n        mock_response = MagicMock()\n        mock_response.text = \"<html>content</html>\"\n        mock_response.status_code = 200\n        mock_response.raise_for_status = MagicMock()\n\n        engine._client = AsyncMock()\n        engine._client.get.return_value = mock_response\n\n        result = await engine._do_fetch(\"https://example.com/page\")\n        assert result == \"extracted text\"\n        mock_cache.set_cached.assert_awaited_once()\n\n    async def test_fetch_failure_falls_back_to_stale_cache(self):\n        import httpx\n        from src.fetch.cache import CacheEntry\n        from src.fetch.engine import FetchEngine\n\n        mock_cache = AsyncMock()\n        mock_cache.get.return_value = None  # no fresh cache\n        mock_cache.get_stale.return_value = CacheEntry(\n            url=\"https://example.com\",\n            content=\"stale content\",\n            ttl_hours=24,\n        )\n\n        engine = FetchEngine(cache=mock_cache, extractor=MagicMock())\n        engine._client = AsyncMock()\n        engine._client.get.side_effect = httpx.RequestError(\"timeout\")\n\n        result = await engine._do_fetch(\"https://example.com\")\n        assert result == \"stale content\"\n\n    async def test_fetch_failure_no_stale_raises_fetch_error(self):\n        import httpx\n        from src.fetch.engine import FetchEngine, FetchError\n\n        mock_cache = AsyncMock()\n        mock_cache.get.return_value = None\n        mock_cache.get_stale.return_value = None\n\n        engine = FetchEngine(cache=mock_cache, extractor=MagicMock())\n        engine._client = AsyncMock()\n        engine._client.get.side_effect = httpx.RequestError(\"connection refused\")\n\n        with pytest.raises(FetchError):\n            await engine._do_fetch(\"https://example.com\")\n\n    async def test_fetch_batch_returns_successful_urls_only(self):\n        from src.fetch.engine import FetchEngine, FetchError\n\n        engine = FetchEngine.__new__(FetchEngine)\n        engine._global_semaphore = asyncio.Semaphore(10)\n\n        async def fake_fetch(url):\n            if \"good\" in url:\n                return \"content\"\n            raise FetchError(\"bad url\")\n\n        engine.fetch = fake_fetch  # type: ignore\n\n        results = await engine.fetch_batch([\"https://good.com\", \"https://bad.com\"])\n        assert \"https://good.com\" in results\n        assert \"https://bad.com\" not in results\n\n\n# ---------------------------------------------------------------------------\n# 3. FETCH CACHE\n# ---------------------------------------------------------------------------\n\nclass TestCacheEntry:\n    def test_content_hash_is_sha256(self):\n        import hashlib\n        from src.fetch.cache import CacheEntry\n\n        entry = CacheEntry(url=\"u\", content=\"hello\", ttl_hours=24)\n        # Manually set fetched_at so expires_at works\n        entry.fetched_at = datetime.utcnow()  # type: ignore\n        expected = hashlib.sha256(b\"hello\").hexdigest()\n        assert entry.content_hash == expected\n\n    def test_is_valid_future_expiry(self):\n        from src.fetch.cache import CacheEntry\n\n        entry = CacheEntry(url=\"u\", content=\"c\", ttl_hours=24)\n        entry.fetched_at = datetime.utcnow().isoformat()  # type: ignore\n        assert entry.is_valid() is True\n\n    def test_is_valid_past_expiry(self):\n        from src.fetch.cache import CacheEntry\n\n        entry = CacheEntry(url=\"u\", content=\"c\", ttl_hours=1)\n        past = (datetime.utcnow() - timedelta(hours=2)).isoformat()\n        entry.fetched_at = past  # type: ignore\n        assert entry.is_valid() is False\n\n\nclass TestFetchCacheDefaultTtl:\n    def test_legislation_domain_gets_720h(self):\n        from src.fetch.cache import FetchCache\n\n        cache = FetchCache.__new__(FetchCache)\n        cache._config = MagicMock()\n        cache._config.cache.ttl_hours = 168\n        assert cache._get_default_ttl(\"https://laws-lois.justice.gc.ca/eng/acts/P-33.01/\") == 720\n\n    def test_collective_agreement_domain_gets_720h(self):\n        from src.fetch.cache import FetchCache\n\n        cache = FetchCache.__new__(FetchCache)\n        cache._config = MagicMock()\n        cache._config.cache.ttl_hours = 168\n        assert cache._get_default_ttl(\"https://tbs-sct.canada.ca/agreements-conventions/view-visualiser-eng.aspx?id=4\") == 720\n\n    def test_default_domain_uses_config_value(self):\n        from src.fetch.cache import FetchCache\n\n        cache = FetchCache.__new__(FetchCache)\n        cache._config = MagicMock()\n        cache._config.cache.ttl_hours = 168\n        assert cache._get_default_ttl(\"https://www.tbs-sct.gc.ca/pol/doc-eng.aspx?id=15\") == 168\n\n\n# ---------------------------------------------------------------------------\n# 4. CONTENT EXTRACTOR\n# ---------------------------------------------------------------------------\n\nclass TestContentExtractorEdgeCases:\n    def test_truncate_adds_ellipsis(self):\n        from src.fetch.extractors import ContentExtractor\n\n        extractor = ContentExtractor.__new__(ContentExtractor)\n        result = extractor._truncate(\"a\" * 100, 10)\n        assert len(result) == 10\n        assert result.endswith(\"...\")\n\n    def test_truncate_does_not_modify_short_text(self):\n        from src.fetch.extractors import ContentExtractor\n\n        extractor = ContentExtractor.__new__(ContentExtractor)\n        result = extractor._truncate(\"short\", 100)\n        assert result == \"short\"\n\n    def test_clean_text_collapses_whitespace(self):\n        from src.fetch.extractors import ContentExtractor\n\n        extractor = ContentExtractor.__new__(ContentExtractor)\n        result = extractor._clean_text(\"  hello   world  \\n\\t foo  \", 1000)\n        assert result == \"hello world foo\"\n\n    def test_extract_falls_back_on_missing_main(self):\n        \"\"\"When no <main> or <article> exists, falls back to <body>.\"\"\"\n        from src.fetch.extractors import ContentExtractor\n\n        extractor = ContentExtractor()\n        html = \"<html><body><p>Only body here.</p></body></html>\"\n        result = extractor.extract(\"https://example.com\", html)\n        assert \"Only body here\" in result\n\n    def test_extract_removes_nav_elements(self):\n        from src.fetch.extractors import ContentExtractor\n\n        extractor = ContentExtractor()\n        html = \"\"\"<html><body><main>\n            <nav>Skip link</nav>\n            <p>Policy content.</p>\n        </main></body></html>\"\"\"\n        result = extractor.extract(\"https://www.tbs-sct.gc.ca/anything\", html)\n        assert \"Policy content\" in result\n\n    def test_extract_handles_exception_gracefully(self):\n        \"\"\"extract() should not raise even with completely broken