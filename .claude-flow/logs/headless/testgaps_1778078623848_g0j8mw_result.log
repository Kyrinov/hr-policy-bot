        "title": "tests/test_specialist.py",
        "content": "\"\"\"Unit tests for SpecialistAgent helper methods.\"\"\"\nimport pytest\n\nfrom src.agents.specialist import SpecialistAgent\nfrom src.models.schemas import PolicyTriple\n\n\ndef make_specialist(agent_id=\"staffing\"):\n    display, domain = (\n        \"Staffing & Recruitment Agent\",\n        \"Staffing and recruitment\",\n    )\n    return SpecialistAgent(agent_id, display, domain)\n\n\nclass TestBuildPolicyContext:\n    def test_empty_fetched_returns_empty_string(self):\n        agent = make_specialist()\n        assert agent._build_policy_context([]) == \"\"\n\n    def test_includes_instrument_title_and_content(self):\n        agent = make_specialist()\n        instrument = {\"title\": \"PSEA\", \"type\": \"Act\", \"url\": \"https://example.com\"}\n        result = agent._build_policy_context([(instrument, \"article text\")])\n        assert \"PSEA\" in result\n        assert \"article text\" in result\n\n\nclass TestFormatTriples:\n    def test_formats_numbered_list(self):\n        agent = make_specialist()\n        triple = PolicyTriple(\n            triple_id=\"t1\",\n            doc_id=\"d1\",\n            source_url=\"https://example.com\",\n            instrument_title=\"PSEA\",\n            agent_id=\"staffing\",\n            sentence_text=\"The deputy head must approve.\",\n            subject=\"deputy head\",\n            predicate=\"must approve\",\n            predicate_lemma=\"approve\",\n            is_deontic=True,\n            deontic_type=\"obligation\",\n            object_=\"[action]\",\n            validation_flags=[],\n        )\n        result = agent._format_triples([triple])\n        assert \"1.\" in result\n        assert \"deputy head\" in result\n        assert \"must approve\" in result\n\n    def test_empty_list(self):\n        agent = make_specialist()\n        assert agent._format_triples([]) == \"\"\n\n\nclass TestLoadInstruments:\n    def test_returns_only_matching_agent(self):\n        agent = make_specialist(\"staffing\")\n        instruments = agent._instruments\n        assert all(\"staffing\" in i[\"agent_ids\"] for i in instruments)\n\n    def test_different_agents_get_different_instruments(self):\n        staffing = make_specialist(\"staffing\")\n        ohs = make_specialist(\"ohs\")\n        staffing_urls = {i[\"url\"] for i in staffing._instruments}\n        ohs_urls = {i[\"url\"] for i in ohs._instruments}\n        # No requirement they're disjoint but they should differ in non-trivial ways\n        assert staffing_urls != ohs_urls\n\n\nclass TestParseResponse:\n    def test_valid_json_parsed(self):\n        agent = make_specialist()\n        raw = \"\"\"{\n            \"findings\": \"Employees must apply via GCJobs.\",\n            \"citations\": [],\n            \"caveats\": null,\n            \"scope_flags\": [],\n            \"confidence\": \"high\"\n        }\"\"\"\n        result = agent._parse_response(raw, attempted=1, retrieved=1, failed=[])\n        assert result.confidence == \"high\"\n        assert \"GCJobs\" in result.findings\n\n    def test_malformed_json_falls_back_gracefully(self):\n        agent = make_specialist()\n        raw = \"This is plain text, not JSON.\"\n        result = agent._parse_response(raw, attempted=1, retrieved=0, failed=[\"PSEA\"])\n        assert result.agent_id == \"staffing\"\n        assert result.confidence == \"low\"\n\n    def test_validate_grounding_mode_set(self):\n        agent = make_specialist()\n        raw = '{\"findings\": \"ok\", \"citations\": [], \"confidence\": \"high\"}'\n        result = agent._parse_response(raw, attempted=0, retrieved=3, failed=[], grounding_mode=\"validate\")\n        assert result.grounding_mode == \"validate\"\n```\n\n```python\n",
        "level": 1
      },
