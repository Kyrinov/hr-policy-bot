        "code": "# tests/test_websocket.py\nimport pytest\nfrom unittest.mock import AsyncMock, MagicMock, patch\n\n\nclass TestWebSocketManager:\n    @pytest.mark.asyncio\n    async def test_send_returns_false_when_no_connection(self):\n        from src.api.websocket import WebSocketManager\n        manager = WebSocketManager()\n        result = await manager.send(\"unknown-id\", {\"type\": \"test\"})\n        assert result is False\n\n    @pytest.mark.asyncio\n    async def test_connect_and_send(self):\n        from src.api.websocket import WebSocketManager\n        manager = WebSocketManager()\n        mock_ws = AsyncMock()\n        await manager.connect(\"q1\", mock_ws)\n        result = await manager.send(\"q1\", {\"type\": \"test\"})\n        assert result is True\n        mock_ws.send_json.assert_called_once_with({\"type\": \"test\"})\n\n    @pytest.mark.asyncio\n    async def test_disconnect_removes_connection(self):\n        from src.api.websocket import WebSocketManager\n        manager = WebSocketManager()\n        mock_ws = AsyncMock()\n        await manager.connect(\"q1\", mock_ws)\n        await manager.disconnect(\"q1\")\n        result = await manager.send(\"q1\", {\"type\": \"test\"})\n        assert result is False\n\n    @pytest.mark.asyncio\n    async def test_send_disconnects_on_send_failure(self):\n        from src.api.websocket import WebSocketManager\n        manager = WebSocketManager()\n        mock_ws = AsyncMock()\n        mock_ws.send_json = AsyncMock(side_effect=Exception(\"broken pipe\"))\n        await manager.connect(\"q1\", mock_ws)\n        result = await manager.send(\"q1\", {\"type\": \"test\"})\n        assert result is False\n        assert \"q1\" not in manager._connections\n\n    @pytest.mark.asyncio\n    async def test_broadcast_error_reaches_all_connections(self):\n        from src.api.websocket import WebSocketManager\n        manager = WebSocketManager()\n        ws1, ws2 = AsyncMock(), AsyncMock()\n        await manager.connect(\"q1\", ws1)\n        await manager.connect(\"q2\", ws2)\n        await manager.broadcast_error(\"system failure\")\n        assert ws1.send_json.called\n        assert ws2.send_json.called\n\n\nclass TestProcessQuery:\n    @pytest.mark.asyncio\n    async def test_happy_path_saves_to_db_and_sends_complete(self):\n        from src.api.websocket import process_query\n        from src.models.schemas import OrchestratorResponse\n\n        mock_response = OrchestratorResponse(\n            summary=\"Answer\",\n            detailed_analysis=\"Detail\",\n            agents_consulted=[\"staffing\"],\n            overall_confidence=\"high\",\n        )\n        mock_orchestrator = AsyncMock()\n        mock_orchestrator.process_with_streaming = AsyncMock(return_value=mock_response)\n        mock_db = AsyncMock()\n        mock_ws_manager = AsyncMock()\n        mock_ws_manager.send = AsyncMock(return_value=True)\n        mock_ws = MagicMock()\n\n        await process_query(\n            \"q-123\", mock_ws, \"staffing query\",\n            mock_orchestrator, AsyncMock(), mock_db, mock_ws_manager,\n        )\n\n        # Verify query was saved twice (initial + update with confidence)\n        assert mock_db.save_query.call_count == 2\n        mock_db.save_orchestrator_response.assert_called_once()\n\n        # Verify response_complete message sent\n        sent_calls = mock_ws_manager.send.call_args_list\n        types = [call[0][1].get(\"type\") for call in sent_calls]\n        assert \"response_complete\" in types\n\n    @pytest.mark.asyncio\n    async def test_orchestrator_error_sends_error_message(self):\n        from src.api.websocket import process_query\n\n        mock_orchestrator = AsyncMock()\n        mock_orchestrator.process_with_streaming = AsyncMock(side_effect=RuntimeError(\"LLM error\"))\n        mock_db = AsyncMock()\n        mock_ws_manager = AsyncMock()\n        mock_ws_manager.send = AsyncMock(return_value=True)\n\n        await process_query(\n            \"q-err\", MagicMock(), \"query\",\n            mock_orchestrator, AsyncMock(), mock_db, mock_ws_manager,\n        )\n\n        sent_calls = mock_ws_manager.send.call_args_list\n        types = [call[0][1].get(\"type\") for call in sent_calls]\n        assert \"error\" in types"
