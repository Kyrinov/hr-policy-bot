            \"citations\": [],\n                        \"confidence\": \"low\",\n                    })\n                    agent = SpecialistAgent(\"staffing\", \"Staffing\", \"Staffing\")\n                    result = await agent.process_with_fetch(\"test query\", fetch_engine=None)\n                    assert result.agent_id == \"staffing\"\n                    assert result.retrieval_status.instruments_attempted == 0\n\nclass TestInstrumentLimit:\n    @pytest.mark.asyncio\n    async def test_respects_max_instruments_limit(self):\n        from src.agents.specialist import SpecialistAgent, _MAX_INSTRUMENTS_PER_QUERY\n        instruments = [\n            {\"id\": f\"inst-{i}\", \"title\": f\"Inst {i}\", \"url\": f\"http://x.com/{i}\"}\n            for i in range(10)\n        ]\n        with patch.object(SpecialistAgent, \"_load_instruments\", return_value=instruments):\n            with patch(\"src.agents.specialist.get_specialist_prompt\", return_value=\"p\"):\n                with patch(\"src.agents.specialist.get_client\") as mock_client:\n                    mock_client.return_value.chat_parsed = AsyncMock(return_value={\"findings\": \"f\", \"citations\": [], \"confidence\": \"medium\"})\n                    mock_fetch = AsyncMock(return_value=\"content\")\n                    engine = AsyncMock()\n                    engine.fetch = mock_fetch\n                    agent = SpecialistAgent(\"staffing\", \"Staffing\", \"Staffing\")\n                    await agent.process_with_fetch(\"query\", fetch_engine=engine)\n                    assert mock_fetch.call_count <= _MAX_INSTRUMENTS_PER_QUERY\n```\n\n---\n\n### 9. `src/agents/orchestrator.py` — `OrchestratorAgent`\n\n**Untested:**\n- `_route()` falls back to all agents when LLM routing fails\n- `process()` returns error `OrchestratorResponse` on JSON parse failure\n- `_aggregate_citations()` deduplicates by `(title, url)`\n- `process_with_streaming()` handles specialist that raises (returns low-confidence response)\n\n**Skeleton:**\n```python\n# tests/test_orchestrator.py\nimport pytest\nfrom unittest.mock import AsyncMock, patch, MagicMock\n\nclass TestRouting:\n    @pytest.mark.asyncio\n    async def test_route_falls_back_to_all_agents_on_llm_error(self):\n        from src.agents.orchestrator import OrchestratorAgent\n        agent = OrchestratorAgent.__new__(OrchestratorAgent)\n        agent._all_specialist_ids = [\"staffing\", \"classification\", \"labour\"]\n        with patch(\"src.agents.orchestrator.get_client\") as mock_client:\n            mock_client.return_value.chat_parsed = AsyncMock(side_effect=Exception(\"API down\"))\n            result = await agent._route(\"some query\")\n            assert set(result[\"selected_agents\"]) == {\"staffing\", \"classification\", \"labour\"}\n\nclass TestCitationDeduplication:\n    def test_duplicate_citations_merged(self):\n        from src.agents.orchestrator import OrchestratorAgent\n        agent = OrchestratorAgent.__new__(OrchestratorAgent)\n        specialist_responses = [\n            {\"agent_id\": \"staffing\", \"citations\": [{\"instrument_title\": \"PSEA\", \"url\": \"http://x.com\", \"type\": \"Act\"}]},\n            {\"agent_id\": \"classification\", \"citations\": [{\"instrument_title\": \"PSEA\", \"url\": \"http://x.com\", \"type\": \"Act\"}]},\n        ]\n        citations = agent._aggregate_citations(specialist_responses)\n        assert len(citations) == 1\n\nclass TestProcessErrorFallback:\n    @pytest.mark.asyncio\n    async def test_json_parse_failure_returns_error_response(self):\n        from src.agents.orchestrator import OrchestratorAgent\n        agent = OrchestratorAgent.__new__(OrchestratorAgent)\n        with patch(\"src.agents.orchestrator.get_client\") as mock_client:\n            mock_client.return_value.chat = AsyncMock(return_value=\"definitely not JSON\")\n            result = await agent.process(\"test query\", [])\n            assert result.overall_confidence == \"low\"\n```\n\n---\n\n### 10. `src/api/routes.py` — REST endpoints\n\n**Untested:**\n- `GET /queries/{query_id}` returns 404 when query not found\n- `GET /queries` respects `limit` query param bounds (FastAPI validation: `ge=1, le=100`)\n- `submit_feedback` saves and returns success\n- `health_check` marks `status: \"degraded\"` when DB check fails\n- `export_feedback` returns JSON with correct shape\n\n**Skeleton:**\n```python\n# tests/test_routes.py\nimport pytest\nfrom httpx import AsyncClient\nfrom src.main import app\n\n@pytest.fixture\nasync def client():\n    async with AsyncClient(app=app, base_url=\"http://test\") as c:\n        yield c\n\nclass TestQueryEndpoints:\n    @pytest.mark.asyncio\n    async def test_get_missing_query_returns_404(self, client):\n        resp = await client.get(\"/api/queries/nonexistent-id\")\n        assert resp.status_code == 404\n\n    @pytest.mark.asyncio\n    async def test_list_queries_limit_too_high_returns_422(self, client):\n        resp = await client.get(\"/api/queries?limit=999\")\n        assert resp.status_code == 422\n\n    @pytest.mark.asyncio\n    async def test_list_queries_limit_zero_returns_422(self, client):\n        resp = await client.get(\"/api/queries?limit=0\")\n        assert resp.status_code == 422\n\nclass TestHealthCheck:\n    @pytest.mark.asyncio\n    async def test_health_check_returns_ok_or_degraded(self, client):\n        resp = await client.get(\"/api/health\")\n        assert resp.status_code == 200\n        data = resp.json()\n        assert data[\"status\"] in (\"ok\", \"degraded\")\n        assert \"components\" in data\n```\n\n---\n\n### 11. `src/api/websocket.py` — `WebSocketManager` + `websocket_endpoint`\n\n**Untested:**\n- `WebSocketManager.disconnect()` is safe for unknown `query_id`\n- `WebSocketManager.send()` calls `disconnect()` on send failure\n- `broadcast_error()` sends to all connected clients\n- `websocket_endpoint` sends welcome message on connect\n- Malformed JSON message is gracefully handled\n- Client disconnect mid-query cancels the processing task\n\n**Skeleton:**\n```python\n# tests/test_websocket.py\nimport pytest\nfrom unittest.mock import AsyncMock, MagicMock\nfrom src.api.websocket import WebSocketManager\n\nclass TestWebSocketManager:\n    def test_disconnect_unknown_id_is_safe(self):\n        mgr = WebSocketManager()\n        mgr.disconnect(\"nonexistent\")  # should not raise\n\n    @pytest.mark.asyncio\n    async def test_send_disconnects_on_error(self):\n        mgr = WebSocketManager()\n        ws = AsyncMock()\n        ws.send_json = AsyncMock(side_effect=Exception(\"broken pipe\"))\n        mgr._connections[\"qid\"] = ws\n        await mgr.send(\"qid\", {\"msg\": \"hi\"})\n        assert \"qid\" not in mgr._connections\n\n    @pytest.mark.asyncio\n    async def test_broadcast_error_reaches_all_clients(self):\n        mgr = WebSocketManager()\n        ws1, ws2 = AsyncMock(), AsyncMock()\n        mgr._connections[\"q1\"] = ws1\n        mgr._connections[\"q2\"] = ws2\n        await mgr.broadcast_error(\"something broke\")\n        ws1.send_json.assert_called_once()\n        ws2.send_json.assert_called_once()\n```\n\n---\n\n### 12. `src/models/schemas.py` — Pydantic models\n\n**Untested:**\n- `CitationItem` defaults: `url=None`, `relevant_section=None`\n- `QueryRecord` auto-generates `timestamp` if not provided\n- `FetchCacheEntry` auto-generates `fetched_at` if not provided\n- `SpecialistResponse` with confidence values other than `\"high\"/\"medium\"/\"low\"` (no enum enforcement)\n- `WSError` message structure\n\n**Skeleton:**\n```python\n# tests/test_schemas.py\nfrom datetime import datetime\nfrom src.models.schemas import CitationItem, QueryRecord, FetchCacheEntry, SpecialistResponse, RetrievalStatus\n\nclass TestCitationItemDefaults:\n    def test_optional_fields_default_to_none(self):\n        item = CitationItem(instrument_title=\"PSEA\", type=\"Act\")\n        assert item.url is None\n        assert item.relevant_section is None\n\nclass TestAutoTimestamps:\n    def test_query_record_auto_timestamp(self):\n        r = QueryRecord(query_id=\"x\", query_text=\"q\", agents_invoked=[])\n        assert isinstance(r.timestamp, datetime)\n\n    def test_fetch_cache_entry_auto_fetched_at(self):\n        e = FetchCacheEntry(url=\"http://x.com\", content=\"c\", ttl_hours=1, status_code=200, content_length=1)\n        assert isinstance(e.fetched_at, datetime)\n\nclass TestConfidenceNoEnforcement:\n    def test_arbitrary_confidence_accepted(self):\n        # confidence is a plain str — no validation currently enforced\n        r = SpecialistResponse(\n            agent_id=\"staffing\",\n            findings=\"f\",\n            citations=[],\n            confidence=\"ultra-high\",\n            retrieval_status=RetrievalStatus(instruments_attempted=0, instruments_successfully_retrieved=0),\n        )\n        assert r.confidence == \"ultra-high\"\n```\n\n---\n\n## Summary of Gaps\n\n| Module | Tested | Key Gaps |\n|--------|--------|----------|\n| `config.py` | Happy path only | Missing file, bad YAML, non-numeric port, env overrides, LRU singleton |\n| `db.py` | `initialize`, `save/get_query` | Agent/orchestrator/feedback round-trips, TTL expiry, stale cache, `clear_expired` |\n| `fetch/engine.py` | Creation, `health_check` | URL normalization, cache hit/miss, `FetchError`, partial batch, malformed URL |\n| `fetch/cache.py` | None | `CacheEntry.is_valid`, `expires_at` with datetime type, domain TTL, `health_check` error |\n| `fetch/extractors.py` | Creation, basic HTML | Selector fallback, extraction failure, truncation, whitespace collapsing |\n| `llm/client.py` | None | Missing API key, JSON parse error, empty stream chunks, singleton |\n| `agents/base.py` | None | `NotImplementedError`, `build_prompt` with/without context |\n| `agents/specialist.py` | None | Missing registry, no fetch engine, JSON parse fallback, instrument limit, fetch failures |\n| `agents/orchestrator.py` | None | Routing fallback, parse error response, citation deduplication, specialist failure |\n| `api/routes.py` | None | 404, query param validation, health degraded, feedback endpoints |\n| `api/websocket.py` | None | Disconnect safety, send failure, broadcast, task cancellation |\n| `models/schemas.py` | 2 happy-path models | Optional defaults, auto-timestamps, no confidence enum enforcement |\n\nThe highest-priority gaps are the **LLM client** (all error paths completely uncovered), **specialist/orchestrator JSON parse fallbacks** (production reliability), and **database TTL logic** (correctness of cache behaviour).\n",
