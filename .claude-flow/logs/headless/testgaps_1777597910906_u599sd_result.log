ed\": [], \"overall_confidence\": \"low\"}'\n        orchestrator._llm_client.chat = AsyncMock(side_effect=[routing_json, synth_json])\n\n        mock_specialist = AsyncMock()\n        mock_specialist.process_with_fetch = AsyncMock(side_effect=RuntimeError(\"network error\"))\n\n        with patch(\"src.agents.specialist.get_specialists\", return_value={\"staffing\": mock_specialist}):\n            response = await orchestrator.process_with_streaming(\n                \"query\", fetch_engine=MagicMock(), status_callback=AsyncMock()\n            )\n        assert response is not None\n```\n\n```python\n# tests/test_specialist.py\n\"\"\"Tests for SpecialistAgent.\"\"\"\n\nimport pytest\nimport json\nfrom unittest.mock import AsyncMock, MagicMock, mock_open, patch\n\n\n@pytest.fixture\ndef registry_data():\n    return [\n        {\"id\": \"i1\", \"title\": \"PSEA\", \"type\": \"Act\", \"url\": \"https://laws.gc.ca/psea\", \"agent_ids\": [\"staffing\"]},\n        {\"id\": \"i2\", \"title\": \"PSLRA\", \"type\": \"Act\", \"url\": \"https://laws.gc.ca/pslra\", \"agent_ids\": [\"labour\"]},\n    ]\n\n\n@pytest.fixture\ndef staffing_agent(registry_data):\n    with patch(\"builtins.open\", mock_open(read_data=json.dumps(registry_data))):\n        with patch(\"src.llm.client.get_client\", return_value=MagicMock()):\n            with patch(\"src.agents.prompts.specialist_prompts.get_specialist_prompt\", return_value=\"prompt\"):\n                from src.agents.specialist import SpecialistAgent\n                return SpecialistAgent(\"staffing\", \"Staffing Agent\", \"Staffing domain\")\n\n\nclass TestLoadInstruments:\n    def test_filters_by_agent_id(self, staffing_agent):\n        assert len(staffing_agent._instruments) == 1\n        assert staffing_agent._instruments[0][\"title\"] == \"PSEA\"\n\n    def test_returns_empty_when_no_match(self, registry_data):\n        with patch(\"builtins.open\", mock_open(read_data=json.dumps(registry_data))):\n            with patch(\"src.llm.client.get_client\", return_value=MagicMock()):\n                with patch(\"src.agents.prompts.specialist_prompts.get_specialist_prompt\", return_value=\"p\"):\n                    from src.agents.specialist import SpecialistAgent\n                    agent = SpecialistAgent(\"ohs\", \"OHS Agent\", \"OHS\")\n        assert agent._instruments == []\n\n\nclass TestBuildPolicyContext:\n    def test_returns_empty_string_when_no_fetched(self, staffing_agent):\n        assert staffing_agent._build_policy_context([]) == \"\"\n\n    def test_includes_instrument_title_and_url(self, staffing_agent):\n        fetched = [({\"title\": \"PSEA\", \"type\": \"Act\", \"url\": \"https://a.com\"}, \"content here\")]\n        ctx = staffing_agent._build_policy_context(fetched)\n        assert \"PSEA\" in ctx\n        assert \"https://a.com\" in ctx\n        assert \"content here\" in ctx\n\n\nclass TestParseResponse:\n    def test_parses_valid_json(self, staffing_agent):\n        raw = json.dumps({\n            \"agent_id\": \"staffing\",\n            \"findings\": \"You must post.\",\n            \"citations\": [{\"instrument_title\": \"PSEA\", \"instrument_type\": \"Act\", \"url\": \"https://a.com\"}],\n            \"confidence\": \"high\",\n        })\n        result = staffing_agent._parse_response(raw, attempted=1, retrieved=1, failed=[])\n        assert result.confidence == \"high\"\n        assert result.findings == \"You must post.\"\n\n    def test_fallback_on_invalid_json(self, staffing_agent):\n        result = staffing_agent._parse_response(\"not json\", attempted=1, retrieved=0, failed=[\"PSEA\"])\n        assert result.confidence == \"low\"\n        assert result.findings == \"not json\"\n        assert result.retrieval_status.instruments_failed == [\"PSEA\"]\n\n    def test_strips_preamble_before_json(self, staffing_agent):\n        raw = 'Sure! Here:\\n' + json.dumps({\n            \"agent_id\": \"staffing\", \"findings\": \"f\", \"citations\": [], \"confidence\": \"medium\"\n        })\n        result = staffing_agent._parse_response(raw, attempted=0, retrieved=0, failed=[])\n        assert result.confidence == \"medium\"\n\n\nclass TestProcessWithFetch:\n    @pytest.mark.asyncio\n    async def test_skips_fetch_when_no_engine(self, staffing_agent):\n        staffing_agent._llm_client.chat = AsyncMock(return_value='{\"agent_id\":\"staffing\",\"findings\":\"f\",\"citations\":[],\"confidence\":\"medium\"}')\n        result = await staffing_agent.process_with_fetch(\"query\", fetch_engine=None)\n        assert result.retrieval_status.instruments_attempted == 0\n\n    @pytest.mark.asyncio\n    async def test_records_fetch_failures(self, staffing_agent):\n        mock_engine = MagicMock()\n        mock_engine.fetch = AsyncMock(side_effect=Exception(\"timeout\"))\n        staffing_agent._llm_client.chat = AsyncMock(return_value='{\"agent_id\":\"staffing\",\"findings\":\"f\",\"citations\":[],\"confidence\":\"low\"}')\n\n        result = await staffing_agent.process_with_fetch(\"query\", fetch_engine=mock_engine)\n        assert result.retrieval_status.instruments_attempted == 1\n        assert result.retrieval_status.instruments_successfully_retrieved == 0\n        assert len(result.retrieval_status.instruments_failed) == 1\n```\n\n```python\n# tests/test_fetch_engine.py\n\"\"\"Tests for FetchEngine.\"\"\"\n\nimport pytest\nfrom unittest.mock import AsyncMock, MagicMock, patch\n\n\n@pytest.fixture\ndef engine():\n    mock_cache = AsyncMock()\n    mock_extractor = MagicMock()\n    mock_extractor.extract.return_value = \"extracted content\"\n    from src.fetch.engine import FetchEngine\n    return FetchEngine(cache=mock_cache, extractor=mock_extractor)\n\n\nclass TestNormalizeUrl:\n    def test_rewrites_laws_lois_act_index(self, engine):\n        url = \"https://laws-lois.justice.gc.ca/eng/acts/P-33.01/\"\n        result = engine._normalize_url(url)\n        assert result.endswith(\"/FullText.html\")\n\n    def test_leaves_other_urls_unchanged(self, engine):\n        url = \"https://tbs-sct.canada.ca/pol/doc-eng.aspx?id=32621\"\n        assert engine._normalize_url(url) == url\n\n    def test_leaves_already_fulltext_url_unchanged(self, engine):\n        url = \"https://laws-lois.justice.gc.ca/eng/acts/P-33.01/FullText.html\"\n        assert engine._normalize_url(url) == url\n\n\nclass TestGetDomain:\n    def test_extracts_domain_from_normal_url(self, engine):\n        assert engine._get_domain(\"https://tbs-sct.canada.ca/pol/doc.aspx\") == \"tbs-sct.canada.ca\"\n\n    def test_returns_default_on_malformed_url(self, engine):\n        assert engine._get_domain(\"\") == \"default\"\n\n\nclass TestDoFetch:\n    @pytest.mark.asyncio\n    async def test_returns_cached_content_on_hit(self, engine):\n        from src.fetch.cache import CacheEntry\n        engine._cache.get = AsyncMock(return_value=CacheEntry(url=\"https://a.com\", content=\"cached!\", ttl_hours=168))\n        result = await engine._do_fetch(\"https://a.com\")\n        assert result == \"cached!\"\n\n    @pytest.mark.asyncio\n    async def test_fetches_and_caches_on_miss(self, engine):\n        engine._cache.get = AsyncMock(return_value=None)\n        engine._cache.set_cached = AsyncMock()\n\n        mock_response = MagicMock()\n        mock_response.status_code = 200\n        mock_response.text = \"<html><body>content</body></html>\"\n        mock_response.raise_for_status = MagicMock()\n        engine._client = AsyncMock()\n        engine._client.get = AsyncMock(return_value=mock_response)\n\n        result = await engine._do_fetch(\"https://a.com\")\n        assert result == \"extracted content\"\n        engine._cache.set_cached.assert_called_once()\n\n    @pytest.mark.asyncio\n    async def test_falls_back_to_stale_on_http_error(self, engine):\n        import httpx\n        from src.fetch.cache import CacheEntry\n        engine._cache.get = AsyncMock(return_value=None)\n        engine._cache.get_stale = AsyncMock(return_value=CacheEntry(url=\"https://a.com\", content=\"stale!\", ttl_hours=0))\n        engine._client = AsyncMock()\n        engine._client.get = AsyncMock(side_effect=httpx.RequestError(\"timeout\"))\n\n        result = await engine._do_fetch(\"https://a.com\")\n        assert result == \"stale!\"\n\n    @pytest.mark.asyncio\n    async def test_raises_fetch_error_when_no_stale(self, engine):\n        import httpx\n        from src.fetch.engine import FetchError\n        engine._cache.get = AsyncMock(return_value=None)\n        engine._cache.get_stale = AsyncMock(return_value=None)\n        engine._client = AsyncMock()\n        engine._client.get = AsyncMock(side_effect=httpx.RequestError(\"timeout\"))\n\n        with pytest.raises(FetchError):\n            await engine._do_fetch(\"https://a.com\")\n\n\nclass TestFetchBatch:\n    @pytest.mark.asyncio\n    async def test_returns_successful_urls_only(self, engine):\n        from src.fetch.engine import FetchError\n        async def mock_fetch(url):\n            if \"good\" in url:\n                return \"content\"\n            raise FetchError(\"bad\")\n\n        engine.fetch = mock_fetch\n        results = await engine.fetch_batch([\"https://good.com\", \"https://bad.com\"])\n        assert \"https://good.com\" in results\n        assert \"https://bad.com\" not in results\n```\n\n```python\n# tests/test_cache.py\n\"\"\"Tests for FetchCache and CacheEntry.\"\"\"\n\nimport pytest\nfrom datetime import datetime, timedelta\nfrom unittest.mock import AsyncMock, MagicMock\n\n\nclass TestCacheEntry:\n    def test_content_hash_is_sha256(self):\n        import hashlib\n        from src.fetch.cache import CacheEntry\n        entry = CacheEntry(url=\"https://a.com\", content=\"hello\", ttl_hours=168)\n        expected = hashlib.sha256(b\"hello\").hexdigest()\n        assert entry.content_hash == expected\n\n    def test_is_valid_true_when_not_expired(self):\n        from src.fetch.cache import CacheEntry\n        entry = CacheEntry(url=\"https://a.com\", content=\"x\", ttl_hours=24)\n        entry.fetched_at = datetime.utcnow().isoformat()\n        assert entry.is_valid() is True\n\n    def test_is_valid_false_when_expired(self):\n        from src.fetch.cache import CacheEntry\n        entry = CacheEntry(url=\"https://a.com\", content=\"x\", ttl_hours=1)\n        entry.fetched_at = (datetime.utcnow() - timedelta(hours=2)).isoformat()\n        assert entry.is_valid() is False\n\n\nclass TestFetchCacheGetDefaultTtl:\n    def test_legislation_domain_gets_720_hours(self):\n        from src.fetch.cache import FetchCache\n        cache = FetchCache(db_manager=MagicMock())\n        assert cache._get_default_ttl(\"https://laws-lois.justice.gc.ca/eng/acts/P-33.01/\") == 720\n\n    def test_collective_agreement_domain_gets_720_hours(self):\n        from src.fetch.cache import FetchCache\n        cache = FetchCache(db_manager=MagicMock())\n        assert cache._get_default_ttl(\"https://tbs-sct.canada.ca/agreements-conventions/view.aspx\") == 720\n\n    def test_default_domain_uses_config_ttl(self):\n        from src.fetch.cache import FetchCache\n        from unittest.mock import patch\n        mock_config = MagicMock()\n        mock_config.cache.ttl_hours = 48\n        with patch(\"src.fetch.cache.get_config\", return_value=mock_config):\n            cache = FetchCache(db_manager=MagicMock())\n        assert cache._get_default_ttl(\"https://example.com/page\") == 48\n\n\nclass TestFetchCacheGet:\n    @pytest.mark.asyncio\n    async def test_returns_none_on_cache_miss(self):\n        from src.fetch.cache import FetchCache\n        mock_db = AsyncMock()\n        mock_db.get_cached = AsyncMock(return_value=None)\n        cache = FetchCache(db_manager=mock_db)\n        result = await cache.get(\"https://a.com\")\n        assert result is None\n\n    @pytest.mark.asyncio\n    async def test_returns_cache_entry_on_hit(self):\n        from src.fetch.cache import FetchCache\n        from src.models.schemas import FetchCacheEntry\n        mock_db = AsyncMock()\n        mock_db.get_cached = AsyncMock(return_value=FetchCacheEntry(\n            url=\"https://a.com\", content_text=\"content\", content_hash=\"abc\",\n            ttl_hours=168, fetched_at=datetime.utcnow(),\n        ))\n        cache = FetchCache(db_manager=mock_db)\n        result = await cache.get(\"https://a.com\")\n        assert result is not None\n        assert result.content == \"content\"\n```\n\n```python\n# tests/test_db.py\n\"\"\"Additional DatabaseManager tests.\"\"\"\n\nimport pytest\nimport uuid\nimport tempfile\nfrom pathlib import Path\nfrom datetime import datetime\n\n\n@pytest.fixture\nasync def db(tmp_path):\n    from src.data.db import DatabaseManager\n    manager = DatabaseManager(db_path=tmp_path / \"test.db\")\n    await manager.initialize()\n    return manager\n\n\nclass TestAgentResponseCRUD:\n    @pytest.mark.asyncio\n    async def test_save_and_get_agent_response(self, db):\n        from src.models.schemas import AgentResponseRecord, CitationItem, RetrievalStatus\n        query_id = str(uuid.uuid4())\n\n        # Prerequisite: save parent query\n        from src.models.schemas import QueryRecord\n        await db.save_query(QueryRecord(query_id=query_id, query_text=\"Q\", agents_invoked=[\"staffing\"]))\n\n        record = AgentResponseRecord(\n            response_id=str(uuid.uuid4()),\n            query_id=query_id,\n            agent_id=\"staffing\",\n            findings=\"Some findings\",\n            citations=[CitationItem(instrument_title=\"PSEA\", instrument_type=\"Act\")],\n            confidence=\"high\",\n            retrieval_status=RetrievalStatus(instruments_attempted=1, instruments_successfully_retrieved=1),\n        )\n        await db.save_agent_response(record)\n        results = await db.get_agent_responses(query_id)\n        assert len(results) == 1\n        assert results[0].agent_id == \"staffing\"\n\n    @pytest.mark.asyncio\n    async def test_get_agent_responses_returns_empty_for_unknown_query(self, db):\n        results = await db.get_agent_responses(\"nonexistent-id\")\n        assert results == []\n\n\nclass TestOrchestratorResponseCRUD:\n    @pytest.mark.asyncio\n    async def test_save_and_get_orchestrator_response(self, db):\n        from src.models.schemas import QueryRecord, OrchestratorResponseRecord\n        query_id = str(uuid.uuid4())\n        await db.save_query(QueryRecord(query_id=query_id, query_text=\"Q\", agents_invoked=[]))\n\n        record = OrchestratorResponseRecord(\n            response_id=str(uuid.uuid4()),\n            query_id=query_id,\n            summary=\"Summary here\",\n            detailed_analysis=\"Full analysis.\",\n            citations=[],\n            overall_confidence=\"medium\",\n        )\n        await db.save_orchestrator_response(record)\n        result = await db.get_orchestrator_response(query_id)\n        assert result is not None\n        assert result.summary == \"Summary here\"\n\n    @pytest.mark.asyncio\n    async def test_get_orchestrator_response_returns_none_for_unknown(self, db):\n        result = await db.get_orchestrator_response(\"nonexistent\")\n        assert result is None\n\n\nclass TestFeedbackCRUD:\n    @pytest.mark.asyncio\n    async def test_save_and_get_feedback(self, db):\n        from src.models.schemas import QueryRecord, FeedbackRecord\n        query_id = str(uuid.uuid4())\n        await db.save_query(QueryRecord(query_id=query_id, query_text=\"Q\", agents_invoked=[]))\n\n        feedback = FeedbackRecord(\n            feedback_id=str(uuid.uuid4()),\n            query_id=query_id,\n            rating=\"accurate\",\n            comment=\"Very helpful.\",\n        )\n        await db.save_feedback(feedback)\n        result = await db.get_feedback_for_query(query_id)\n        assert result is not None\n        assert result.rating == \"accurate\"\n\n    @pytest.mark.asyncio\n    async def test_export_feedback_returns_list(self, db):\n        results = await db.export_feedback()\n        assert isinstance(results, list)\n\n\nclass TestFetchCacheCRUD:\n    @pytest.mark.asyncio\n    async def test_get_cached_returns_none_before_set(self, db):\n        result = await db.get_cached(\"https://example.com\")\n        assert result is None\n\n    @pytest.mark.asyncio\n    async def test_set_and_get_cached(self, db):\n        from src.models.schemas import FetchCacheEntry\n        entry = FetchCacheEntry(\n            url=\"https://example.com\",\n            content_text=\"page content\",\n            content_hash=\"abc123\",\n            ttl_hours=168,\n            fetched_at=datetime.utcnow(),\n        )\n        await db.set_cached(entry)\n        result = await db.get_cached(\"https://example.com\")\n        assert result is not None\n        assert result.content_text == \"page content\"\n\n    @pytest.mark.asyncio\n    async def test_clear_expired_removes_old_entries(self, db):\n        from src.models.schemas import FetchCacheEntry\n        from datetime import timedelta\n        entry = FetchCacheEntry(\n            url=\"https://old.example.com\",\n            content_text=\"old\",\n            content_hash=\"xyz\",\n            ttl_hours=1,\n            fetched_at=datetime.utcnow() - timedelta(hours=2),\n        )\n        await db.set_cached(entry)\n        deleted = await db.clear_expired()\n        assert deleted >= 1\n\n\nclass TestListQueries:\n    @pytest.mark.asyncio\n    async def test_returns_empty_list_on_fresh_db(self, db):\n        results = await db.list_queries()\n        assert results == []\n\n    @pytest.mark.asyncio\n    async def test_returns_queries_ordered_by_newest_first(self, db):\n        from src.models.schemas import QueryRecord\n        ids = [str(uuid.uuid4()) for _ in range(3)]\n        for qid in ids:\n            await db.save_query(QueryRecord(query_id=qid, query_text=f\"Q {qid}\", agents_invoked=[]))\n        results = await db.list_queries(limit=10)\n        assert len(results) == 3\n```\n\n```python\n# tests/test_extractors.py\n\"\"\"Additional ContentExtractor tests.\"\"\"\n\nimport pytest\nfrom unittest.mock import patch\n\n\n@pytest.fixture\ndef extractor():\n    with patch.object(\n        __import__(\"src.fetch.extractors\", fromlist=[\"ContentExtractor\"]).ContentExtractor,\n        \"_load_selectors\",\n        return_value={\n            \"domain_selectors\": {\n                \"default\": {\n                    \"content_selector\": [\"main\", \"article\"],\n                    \"remove_selector\": [\"nav\", \"footer\"],\n                }\n            }\n        },\n    ):\n        from src.fetch.extractors import ContentExtractor\n        return ContentExtractor.__new__(ContentExtractor)\n\n\nclass TestLoadSelectorsFallback:\n    def test_returns_default_when_file_missing(self):\n        from src.fetch.extractors import ContentExtractor\n        extractor = ContentExtractor.__new__(ContentExtractor)\n        result = extractor._load_selectors(\"/nonexistent/path.yaml\")\n        assert \"default\" in result\n\n    def test_returns_loaded_selectors_on_valid_file(self, tmp_path):\n        import yaml\n        sel = {\"domain_selectors\": {\"default\": {\"content_selector\": [\"main\"]}}}\n        path = tmp_path / \"selectors.yaml\"\n        path.write_text(yaml.dump(sel))\n        from src.fetch.extractors import ContentExtractor\n        extractor = ContentExtractor.__new__(ContentExtractor)\n        result = extractor._load_selectors(str(path))\n        assert result == sel\n\n\nclass TestTruncate:\n    def test_returns_text_unchanged_when_under_limit(self):\n        from src.fetch.extractors import ContentExtractor\n        e = ContentExtractor.__new__(ContentExtractor)\n        assert e._truncate(\"short\", 100) == \"short\"\n\n    def test_truncates_and_appends_ellipsis(self):\n        from src.fetch.extractors import ContentExtractor\n        e = ContentExtractor.__new__(ContentExtractor)\n        result = e._truncate(\"a\" * 200, 100)\n        assert len(result) == 100\n        assert result.endswith(\"...\")\n\n\nclass TestFormatContent:\n    def test_extracts_headings_with_newlines(self):\n        from bs4 import BeautifulSoup\n        from src.fetch.extractors import ContentExtractor\n        e = ContentExtractor.__new__(ContentExtractor)\n        soup = BeautifulSoup(\"<main><h1>Title</h1><p>Paragraph.</p></main>\", \"lxml\")\n        result = e._format_content(soup.find(\"main\"))\n        assert \"Title\" in result\n        assert \"Paragraph.\" in result\n\n    def test_removes_specified_elements(self):\n        from bs4 import BeautifulSoup\n        from src.fetch.extractors import ContentExtractor\n        e = ContentExtractor.__new__(ContentExtractor)\n        soup = BeautifulSoup(\"<main><nav>Skip</nav><p>Content</p></main>\", \"lxml\")\n        main = soup.find(\"main\")\n        e._remove_elements(main, [\"nav\"])\n        assert \"Skip\" not in str(main)\n        assert \"Content\" in str(main)\n\n\nclass TestExtractErrorHandling:\n    def test_returns_raw_text_on_exception(self):\n        from src.fetch.extractors import ContentExtractor\n        e = ContentExtractor.__new__(ContentExtractor)\n        e._selectors = {\"domain_selectors\": {}}\n        # Force an error by passing non-HTML\n        result = e.extract(\"https://example.com\", None)  # type: ignore\n        assert isinstance(result, str)\n```\n\n```python\n# tests/test_api_routes.py\n\"\"\"Tests for REST API routes.\"\"\"\n\nimport pytest\nimport uuid\nfrom fastapi.testclient import TestClient\nfrom unittest.mock import AsyncMock, MagicMock, patch\n\n\n@pytest.fixture\ndef client():\n    from src.main import app\n    return TestClient(app)\n\n\nclass TestHealthCheck:\n    def test_returns_200(self, client):\n        with patch(\"src.api.routes.ollama.AsyncClient\") as mock_ollama:\n            mock_ollama.return_value.list = AsyncMock(return_value=MagicMock(models=[]))\n            response = client.get(\"/api/health\")\n        assert response.status_code == 200\n        assert \"status\" in response.json()\n\n    def test_degraded_when_ollama_unavailable(self, client):\n        with patch(\"src.api.routes.ollama.AsyncClient\") as mock_ollama:\n            mock_ollama.return_value.list = AsyncMock(side_effect=Exception(\"connection refused\"))\n            response = client.get(\"/api/health\")\n        assert response.json()[\"status\"] in (\"degraded\", \"healthy\")\n\n\nclass TestListAgents:\n    def test_returns_8_agents(self, client):\n        response = client.get(\"/api/agents\")\n        assert response.status_code == 200\n        assert len(response.json()) == 8\n\n    def test_each_agent_has_required_fields(self, client):\n        response = client.get(\"/api/agents\")\n        for agent in response.json():\n            assert \"agent_id\" in agent\n            assert \"display_name\" in agent\n            assert \"domain\" in agent\n\n\nclass TestListQueries:\n    def test_returns_empty_list_on_fresh_db(self, client):\n        with patch(\"src.api.routes.DatabaseManager\") as MockDB:\n            MockDB.return_value.list_queries = AsyncMock(return_value=[])\n            response = client.get(\"/api/queries\")\n        assert response.status_code == 200\n        assert response.json() == []\n\n    def test_limit_param_respected(self, client):\n        with patch(\"src.api.routes.DatabaseManager\") as MockDB:\n            MockDB.return_value.list_queries = AsyncMock(return_value=[])\n            response = client.get(\"/api/queries?limit=10\")\n        assert response.status_code == 200\n\n\nclass TestGetQuery:\n    def test_returns_404_for_unknown_query(self, client):\n        with patch(\"src.api.routes.DatabaseManager\") as MockDB:\n            MockDB.return_value.get_query = AsyncMock(return_value=None)\n            response = client.get(f\"/api/queries/{uuid.uuid4()}\")\n        assert response.status_code == 404\n\n    def test_returns_query_data_for_known_query(self, client):\n        from src.models.schemas import QueryRecord\n        query_id = str(uuid.uuid4())\n        mock_query = QueryRecord(query_id=query_id, query_text=\"Test query\", agents_invoked=[\"staffing\"])\n\n        with patch(\"src.api.routes.DatabaseManager\") as MockDB:\n            instance = MockDB.return_value\n            instance.get_query = AsyncMock(return_value=mock_query)\n            instance.get_agent_responses = AsyncMock(return_value=[])\n            instance.get_orchestrator_response = AsyncMock(return_value=None)\n            instance.get_feedback_for_query = AsyncMock(return_value=None)\n            response = client.get(f\"/api/queries/{query_id}\")\n\n        assert response.status_code == 200\n        assert response.json()[\"query_id\"] == query_id\n\n\nclass TestSubmitFeedback:\n    def test_saves_feedback_and_returns_ok(self, client):\n        with patch(\"src.api.routes.DatabaseManager\") as MockDB:\n            MockDB.return_value.save_feedback = AsyncMock()\n            payload = {\n                \"feedback_id\": str(uuid.uuid4()),\n                \"query_id\": str(uuid.uuid4()),\n                \"rating\": \"accurate\",\n            }\n            response = client.post(\"/api/feedback\", json=payload)\n        assert response.status_code == 200\n        assert response.json()[\"status\"] == \"ok\"\n```\n\n```python\n# tests/test_websocket_manager.py\n\"\"\"Tests for WebSocketManager.\"\"\"\n\nimport pytest\nfrom unittest.mock import AsyncMock, MagicMock\n\n\nclass TestWebSocketManager:\n    @pytest.mark.asyncio\n    async def test_connect_accepts_websocket(self):\n        from src.api.websocket import WebSocketManager\n        manager = WebSocketManager()\n        mock_ws = AsyncMock()\n        await manager.connect(\"q1\", mock_ws)\n        mock_ws.accept.assert_called_once()\n        assert \"q1\" in manager._connections\n\n    @pytest.mark.asyncio\n    async def test_disconnect_removes_connection(self):\n        from src.api.websocket import WebSocketManager\n        manager = WebSocketManager()\n        mock_ws = AsyncMock()\n        await manager.connect(\"q1\", mock_ws)\n        await manager.disconnect(\"q1\")\n        assert \"q1\" not in manager._connections\n\n    @pytest.mark.asyncio\n    async def test_send_returns_false_for_unknown_query(self):\n        from src.api.websocket import WebSocketManager\n        manager = WebSocketManager()\n        result = await manager.send(\"nonexistent\", {\"type\": \"test\"})\n        assert result is False\n\n    @pytest.mark.asyncio\n    async def test_send_removes_connection_on_failure(self):\n        from src.api.websocket import WebSocketManager\n        manager = WebSocketManager()\n        mock_ws = AsyncMock()\n        mock_ws.send_json = AsyncMock(side_effect=Exception(\"broken pipe\"))\n        await manager.connect(\"q1\", mock_ws)\n        result = await manager.send(\"q1\", {\"type\": \"test\"})\n        assert result is False\n        assert \"q1\" not in manager._connections\n\n    @pytest.mark.asyncio\n    async def test_broadcast_error_sends_to_all_connections(self):\n        from src.api.websocket import WebSocketManager\n        manager = WebSocketManager()\n        ws1, ws2 = AsyncMock(), AsyncMock()\n        await manager.connect(\"q1\", ws1)\n        await manager.connect(\"q2\", ws2)\n        await manager.broadcast_error(\"Something broke\")\n        ws1.send_json.assert_called_once()\n        ws2.send_json.assert_called_once()\n```\n\n---\n\n### Summary\n\nThe current test suite covers ~10% of the codebase (model construction + trivial creation checks). The major unprotected surfaces are:\n\n| Priority | Gap |\n|---|---|\n| **Critical** | `GeminiClient` — rate-limit retry, blocked content, no API key |\n| **Critical** | `OrchestratorAgent._route` fallback + `process` JSON parse failure |\n| **Critical** | `FetchEngine._do_fetch` — cache hit/miss/stale/error paths |\n| **High** | `SpecialistAgent._parse_response` JSON fallback |\n| **High** | All `DatabaseManager` CRUD (5 untested tables) |\n| **High** | `WebSocketManager.send` failure path (connection cleanup) |\n| **Medium** | REST routes — 404 handling, feedback, export |\n| **Medium** | `FetchCache._get_default_ttl` domain classification |\n| **Medium** | `ContentExtractor` truncation, element removal, error fallback |\n",
