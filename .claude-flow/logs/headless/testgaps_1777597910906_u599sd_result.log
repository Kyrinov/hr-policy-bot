        "code": "# tests/test_api_routes.py\n\"\"\"Tests for REST API routes.\"\"\"\n\nimport pytest\nimport uuid\nfrom fastapi.testclient import TestClient\nfrom unittest.mock import AsyncMock, MagicMock, patch\n\n\n@pytest.fixture\ndef client():\n    from src.main import app\n    return TestClient(app)\n\n\nclass TestHealthCheck:\n    def test_returns_200(self, client):\n        with patch(\"src.api.routes.ollama.AsyncClient\") as mock_ollama:\n            mock_ollama.return_value.list = AsyncMock(return_value=MagicMock(models=[]))\n            response = client.get(\"/api/health\")\n        assert response.status_code == 200\n        assert \"status\" in response.json()\n\n    def test_degraded_when_ollama_unavailable(self, client):\n        with patch(\"src.api.routes.ollama.AsyncClient\") as mock_ollama:\n            mock_ollama.return_value.list = AsyncMock(side_effect=Exception(\"connection refused\"))\n            response = client.get(\"/api/health\")\n        assert response.json()[\"status\"] in (\"degraded\", \"healthy\")\n\n\nclass TestListAgents:\n    def test_returns_8_agents(self, client):\n        response = client.get(\"/api/agents\")\n        assert response.status_code == 200\n        assert len(response.json()) == 8\n\n    def test_each_agent_has_required_fields(self, client):\n        response = client.get(\"/api/agents\")\n        for agent in response.json():\n            assert \"agent_id\" in agent\n            assert \"display_name\" in agent\n            assert \"domain\" in agent\n\n\nclass TestListQueries:\n    def test_returns_empty_list_on_fresh_db(self, client):\n        with patch(\"src.api.routes.DatabaseManager\") as MockDB:\n            MockDB.return_value.list_queries = AsyncMock(return_value=[])\n            response = client.get(\"/api/queries\")\n        assert response.status_code == 200\n        assert response.json() == []\n\n    def test_limit_param_respected(self, client):\n        with patch(\"src.api.routes.DatabaseManager\") as MockDB:\n            MockDB.return_value.list_queries = AsyncMock(return_value=[])\n            response = client.get(\"/api/queries?limit=10\")\n        assert response.status_code == 200\n\n\nclass TestGetQuery:\n    def test_returns_404_for_unknown_query(self, client):\n        with patch(\"src.api.routes.DatabaseManager\") as MockDB:\n            MockDB.return_value.get_query = AsyncMock(return_value=None)\n            response = client.get(f\"/api/queries/{uuid.uuid4()}\")\n        assert response.status_code == 404\n\n    def test_returns_query_data_for_known_query(self, client):\n        from src.models.schemas import QueryRecord\n        query_id = str(uuid.uuid4())\n        mock_query = QueryRecord(query_id=query_id, query_text=\"Test query\", agents_invoked=[\"staffing\"])\n\n        with patch(\"src.api.routes.DatabaseManager\") as MockDB:\n            instance = MockDB.return_value\n            instance.get_query = AsyncMock(return_value=mock_query)\n            instance.get_agent_responses = AsyncMock(return_value=[])\n            instance.get_orchestrator_response = AsyncMock(return_value=None)\n            instance.get_feedback_for_query = AsyncMock(return_value=None)\n            response = client.get(f\"/api/queries/{query_id}\")\n\n        assert response.status_code == 200\n        assert response.json()[\"query_id\"] == query_id\n\n\nclass TestSubmitFeedback:\n    def test_saves_feedback_and_returns_ok(self, client):\n        with patch(\"src.api.routes.DatabaseManager\") as MockDB:\n            MockDB.return_value.save_feedback = AsyncMock()\n            payload = {\n                \"feedback_id\": str(uuid.uuid4()),\n                \"query_id\": str(uuid.uuid4()),\n                \"rating\": \"accurate\",\n            }\n            response = client.post(\"/api/feedback\", json=payload)\n        assert response.status_code == 200\n        assert response.json()[\"status\"] == \"ok\""
