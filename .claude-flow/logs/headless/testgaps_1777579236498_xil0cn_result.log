        "code": "# tests/test_api_routes.py\nimport pytest\nimport uuid\nfrom unittest.mock import AsyncMock, MagicMock, patch\nfrom fastapi.testclient import TestClient\n\n\n@pytest.fixture\ndef client(tmp_path):\n    from src.main import app\n    with TestClient(app) as c:\n        yield c\n\n\nclass TestHealthEndpoint:\n    def test_health_returns_200(self, client):\n        with patch(\"ollama.AsyncClient\") as mock_ollama:\n            mock_ollama.return_value.list = AsyncMock(return_value=MagicMock(models=[]))\n            response = client.get(\"/api/health\")\n        assert response.status_code == 200\n        assert \"status\" in response.json()\n\n    def test_health_degrades_on_ollama_failure(self, client):\n        with patch(\"ollama.AsyncClient\", side_effect=Exception(\"connection refused\")):\n            response = client.get(\"/api/health\")\n        data = response.json()\n        assert data[\"status\"] in (\"healthy\", \"degraded\")\n\n\nclass TestAgentsEndpoint:\n    def test_returns_8_agents(self, client):\n        response = client.get(\"/api/agents\")\n        assert response.status_code == 200\n        agents = response.json()\n        assert len(agents) == 8\n        agent_ids = [a[\"agent_id\"] for a in agents]\n        assert \"staffing\" in agent_ids\n        assert \"governance\" in agent_ids\n\n\nclass TestQueriesEndpoint:\n    def test_empty_list(self, client):\n        with patch(\"src.data.db.DatabaseManager.list_queries\", new_callable=AsyncMock, return_value=[]):\n            response = client.get(\"/api/queries\")\n        assert response.status_code == 200\n        assert response.json() == []\n\n    def test_limit_parameter_validated(self, client):\n        response = client.get(\"/api/queries?limit=0\")\n        assert response.status_code == 422  # validation error\n\n    def test_limit_over_100_rejected(self, client):\n        response = client.get(\"/api/queries?limit=200\")\n        assert response.status_code == 422\n\n\nclass TestGetQueryEndpoint:\n    def test_returns_404_for_unknown_id(self, client):\n        with patch(\"src.data.db.DatabaseManager.get_query\", new_callable=AsyncMock, return_value=None):\n            response = client.get(f\"/api/queries/{uuid.uuid4()}\")\n        assert response.status_code == 404\n\n    def test_returns_query_with_responses(self, client):\n        from src.models.schemas import QueryRecord\n        mock_query = QueryRecord(\n            query_id=\"test-id\", query_text=\"test\", agents_invoked=[\"staffing\"]\n        )\n        with patch(\"src.data.db.DatabaseManager.get_query\", new_callable=AsyncMock, return_value=mock_query), \\\n             patch(\"src.data.db.DatabaseManager.get_agent_responses\", new_callable=AsyncMock, return_value=[]), \\\n             patch(\"src.data.db.DatabaseManager.get_orchestrator_response\", new_callable=AsyncMock, return_value=None), \\\n             patch(\"src.data.db.DatabaseManager.get_feedback_for_query\", new_callable=AsyncMock, return_value=None):\n            response = client.get(\"/api/queries/test-id\")\n        assert response.status_code == 200\n        assert response.json()[\"query_id\"] == \"test-id\"\n\n\nclass TestFeedbackEndpoint:\n    def test_submit_feedback(self, client):\n        payload = {\n            \"feedback_id\": str(uuid.uuid4()),\n            \"query_id\": str(uuid.uuid4()),\n            \"rating\": \"accurate\",\n            \"comment\": \"Great answer\",\n            \"timestamp\": \"2026-04-30T12:00:00\",\n        }\n        with patch(\"src.data.db.DatabaseManager.save_feedback\", new_callable=AsyncMock):\n            response = client.post(\"/api/feedback\", json=payload)\n        assert response.status_code == 200\n        assert response.json()[\"status\"] == \"ok\"\n\n    def test_export_feedback(self, client):\n        with patch(\"src.data.db.DatabaseManager.export_feedback\", new_callable=AsyncMock, return_value=[]):\n            response = client.get(\"/api/feedback/export\")\n        assert response.status_code == 200\n        assert isinstance(response.json(), list)"
