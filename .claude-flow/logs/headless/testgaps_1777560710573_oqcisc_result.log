        "title": "tests/test_database.py  (extend existing TestDatabase class or new file)",
        "content": "import pytest, uuid\nfrom pathlib import Path\n\n@pytest.fixture\nasync def db(tmp_path):\n    from src.data.db import DatabaseManager\n    manager = DatabaseManager(db_path=tmp_path / \"test.db\")\n    await manager.initialize()\n    return manager\n\n@pytest.mark.asyncio\nasync def test_get_query_nonexistent_returns_none(db):\n    result = await db.get_query(\"nonexistent-id\")\n    assert result is None\n\n@pytest.mark.asyncio\nasync def test_list_queries_respects_limit(db):\n    from src.models.schemas import QueryRecord\n    for i in range(5):\n        await db.save_query(QueryRecord(query_id=str(uuid.uuid4()), query_text=f\"q{i}\", agents_invoked=[]))\n    results = await db.list_queries(limit=3)\n    assert len(results) == 3\n\n@pytest.mark.asyncio\nasync def test_save_and_get_agent_response(db):\n    from src.models.schemas import QueryRecord, AgentResponseRecord, RetrievalStatus\n    qid = str(uuid.uuid4())\n    await db.save_query(QueryRecord(query_id=qid, query_text=\"q\", agents_invoked=[]))\n    record = AgentResponseRecord(\n        response_id=str(uuid.uuid4()), query_id=qid, agent_id=\"staffing\",\n        findings=\"Test findings\", citations=[], confidence=\"medium\",\n        retrieval_status=RetrievalStatus(instruments_attempted=1, instruments_successfully_retrieved=1),\n    )\n    await db.save_agent_response(record)\n    results = await db.get_agent_responses(qid)\n    assert len(results) == 1\n    assert results[0].agent_id == \"staffing\"\n\n@pytest.mark.asyncio\nasync def test_clear_expired_removes_stale_entries(db):\n    from src.models.schemas import FetchCacheEntry\n    from datetime import datetime, timedelta\n    entry = FetchCacheEntry(\n        url=\"https://stale.example.com\",\n        content_text=\"old content\",\n        content_hash=\"abc\",\n        fetched_at=datetime.utcnow() - timedelta(hours=200),\n        ttl_hours=1,\n    )\n    await db.set_cached(entry)\n    count = await db.clear_expired()\n    assert count >= 1\n```\n\n---\n\n",
