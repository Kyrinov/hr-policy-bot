        "code": "# tests/test_fetch_engine.py\nimport pytest\nfrom unittest.mock import AsyncMock, MagicMock, patch\nfrom src.fetch.engine import FetchEngine, FetchError\n\n\nclass TestNormalizeUrl:\n    def setup_method(self):\n        with patch(\"src.fetch.engine.get_cache\"), patch(\"src.fetch.engine.get_extractor\"):\n            self.engine = FetchEngine(cache=MagicMock(), extractor=MagicMock())\n\n    def test_act_index_rewritten_to_full_text(self):\n        url = \"https://laws-lois.justice.gc.ca/eng/acts/P-33.01/\"\n        result = self.engine._normalize_url(url)\n        assert result.endswith(\"/FullText.html\")\n\n    def test_non_act_url_unchanged(self):\n        url = \"https://tbs-sct.canada.ca/pol/doc-eng.aspx?id=32614\"\n        assert self.engine._normalize_url(url) == url\n\n    def test_act_url_without_trailing_slash_not_rewritten(self):\n        url = \"https://laws-lois.justice.gc.ca/eng/acts/P-33.01\"\n        result = self.engine._normalize_url(url)\n        assert result == url  # No trailing slash → no match\n\n\nclass TestGetDomain:\n    def setup_method(self):\n        with patch(\"src.fetch.engine.get_cache\"), patch(\"src.fetch.engine.get_extractor\"):\n            self.engine = FetchEngine(cache=MagicMock(), extractor=MagicMock())\n\n    def test_extracts_domain_from_https_url(self):\n        assert self.engine._get_domain(\"https://tbs-sct.canada.ca/pol/doc.aspx\") == \"tbs-sct.canada.ca\"\n\n    def test_malformed_url_returns_default(self):\n        assert self.engine._get_domain(\"not-a-url\") == \"default\"\n\n\nclass TestDoFetch:\n    @pytest.mark.asyncio\n    async def test_cache_hit_returns_cached_content(self):\n        from src.fetch.cache import CacheEntry\n        mock_cache = AsyncMock()\n        mock_cache.get.return_value = CacheEntry(url=\"https://example.com\", content=\"cached!\", ttl_hours=168)\n        mock_extractor = MagicMock()\n\n        with patch(\"src.fetch.engine.get_config\"):\n            engine = FetchEngine(cache=mock_cache, extractor=mock_extractor)\n\n        result = await engine._do_fetch(\"https://example.com\")\n        assert result == \"cached!\"\n        mock_cache.get.assert_called_once()\n\n    @pytest.mark.asyncio\n    async def test_http_error_falls_back_to_stale_cache(self):\n        import httpx\n        from src.fetch.cache import CacheEntry\n\n        mock_cache = AsyncMock()\n        mock_cache.get.return_value = None\n        mock_cache.get_stale.return_value = CacheEntry(url=\"https://example.com\", content=\"stale!\", ttl_hours=168)\n        mock_cache._get_default_ttl = MagicMock(return_value=168)\n\n        mock_client = AsyncMock()\n        mock_client.get.side_effect = httpx.RequestError(\"timeout\")\n\n        with patch(\"src.fetch.engine.get_config\"):\n            engine = FetchEngine(cache=mock_cache, extractor=MagicMock())\n            engine._client = mock_client\n\n        result = await engine._do_fetch(\"https://example.com\")\n        assert result == \"stale!\"\n\n    @pytest.mark.asyncio\n    async def test_http_error_with_no_stale_raises_fetch_error(self):\n        import httpx\n\n        mock_cache = AsyncMock()\n        mock_cache.get.return_value = None\n        mock_cache.get_stale.return_value = None\n\n        mock_client = AsyncMock()\n        mock_client.get.side_effect = httpx.HTTPStatusError(\"404\", request=MagicMock(), response=MagicMock())\n\n        with patch(\"src.fetch.engine.get_config\"):\n            engine = FetchEngine(cache=mock_cache, extractor=MagicMock())\n            engine._client = mock_client\n\n        with pytest.raises(FetchError):\n            await engine._do_fetch(\"https://example.com\")\n\n\nclass TestFetchBatch:\n    @pytest.mark.asyncio\n    async def test_partial_failure_returns_successful_urls_only(self):\n        from src.fetch.engine import FetchError\n\n        with patch(\"src.fetch.engine.get_config\"):\n            engine = FetchEngine(cache=AsyncMock(), extractor=MagicMock())\n\n        async def mock_fetch(url: str) -> str:\n            if \"bad\" in url:\n                raise FetchError(\"bad url\")\n            return \"content\"\n\n        engine.fetch = mock_fetch\n        results = await engine.fetch_batch([\"https://good.com\", \"https://bad.com\"])\n        assert \"https://good.com\" in results\n        assert \"https://bad.com\" not in results"
