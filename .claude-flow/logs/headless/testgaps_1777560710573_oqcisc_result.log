        "code": "# tests/test_fetch_engine.py\nimport pytest\nfrom unittest.mock import AsyncMock, MagicMock, patch\n\nclass TestNormalizeUrl:\n    def test_rewrites_act_index_to_fulltext(self):\n        from src.fetch.engine import FetchEngine\n        engine = FetchEngine.__new__(FetchEngine)\n        url = \"https://laws-lois.justice.gc.ca/eng/acts/P-33.3/\"\n        assert engine._normalize_url(url).endswith(\"/FullText.html\")\n\n    def test_leaves_non_act_url_unchanged(self):\n        from src.fetch.engine import FetchEngine\n        engine = FetchEngine.__new__(FetchEngine)\n        url = \"https://tbs-sct.canada.ca/pol/doc-eng.aspx?id=32612\"\n        assert engine._normalize_url(url) == url\n\nclass TestGetDomain:\n    def test_extracts_domain(self):\n        from src.fetch.engine import FetchEngine\n        engine = FetchEngine.__new__(FetchEngine)\n        assert engine._get_domain(\"https://tbs-sct.canada.ca/pol/doc-eng.aspx\") == \"tbs-sct.canada.ca\"\n\n    def test_returns_default_on_malformed(self):\n        from src.fetch.engine import FetchEngine\n        engine = FetchEngine.__new__(FetchEngine)\n        assert engine._get_domain(\"not-a-url\") == \"default\"\n\nclass TestDoFetch:\n    @pytest.mark.asyncio\n    async def test_cache_hit_returns_cached_content(self):\n        from src.fetch.engine import FetchEngine\n        from src.fetch.cache import CacheEntry\n        cache = MagicMock()\n        cache.get = AsyncMock(return_value=CacheEntry(\n            url=\"https://example.com\", content=\"cached\", ttl_hours=24))\n        engine = FetchEngine(cache=cache)\n        result = await engine._do_fetch(\"https://example.com\")\n        assert result == \"cached\"\n\n    @pytest.mark.asyncio\n    async def test_fetch_failure_falls_back_to_stale_cache(self):\n        import httpx\n        from src.fetch.engine import FetchEngine\n        from src.fetch.cache import CacheEntry\n        cache = MagicMock()\n        cache.get = AsyncMock(return_value=None)\n        cache.get_stale = AsyncMock(return_value=CacheEntry(\n            url=\"https://example.com\", content=\"stale\", ttl_hours=24))\n        extractor = MagicMock()\n        engine = FetchEngine(cache=cache, extractor=extractor)\n        engine._client = MagicMock()\n        engine._client.get = AsyncMock(side_effect=httpx.RequestError(\"timeout\"))\n        result = await engine._do_fetch(\"https://example.com\")\n        assert result == \"stale\"\n\n    @pytest.mark.asyncio\n    async def test_fetch_failure_no_stale_raises_fetch_error(self):\n        import httpx\n        from src.fetch.engine import FetchEngine, FetchError\n        cache = MagicMock()\n        cache.get = AsyncMock(return_value=None)\n        cache.get_stale = AsyncMock(return_value=None)\n        engine = FetchEngine(cache=cache)\n        engine._client = MagicMock()\n        engine._client.get = AsyncMock(side_effect=httpx.RequestError(\"timeout\"))\n        with pytest.raises(FetchError):\n            await engine._do_fetch(\"https://example.com\")\n\nclass TestFetchBatch:\n    @pytest.mark.asyncio\n    async def test_partial_failures_omitted_from_results(self):\n        from src.fetch.engine import FetchEngine, FetchError\n        engine = FetchEngine.__new__(FetchEngine)\n        async def fake_fetch(url):\n            if \"bad\" in url:\n                raise FetchError(\"bad url\")\n            return \"content\"\n        engine.fetch = fake_fetch\n        results = await engine.fetch_batch([\"https://good.com\", \"https://bad.com\"])\n        assert \"https://good.com\" in results\n        assert \"https://bad.com\" not in results"
