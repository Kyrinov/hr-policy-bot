        "title": "tests/test_websocket_manager.py",
        "content": "import pytest\nfrom unittest.mock import AsyncMock, MagicMock\n\nclass TestWebSocketManager:\n    @pytest.mark.asyncio\n    async def test_connect_stores_websocket(self):\n        from src.api.websocket import WebSocketManager\n        manager = WebSocketManager()\n        ws = MagicMock()\n        ws.accept = AsyncMock()\n        await manager.connect(\"qid1\", ws)\n        assert \"qid1\" in manager._connections\n\n    @pytest.mark.asyncio\n    async def test_send_returns_false_for_unknown_query_id(self):\n        from src.api.websocket import WebSocketManager\n        manager = WebSocketManager()\n        result = await manager.send(\"unknown\", {\"type\": \"test\"})\n        assert result is False\n\n    @pytest.mark.asyncio\n    async def test_send_disconnects_on_exception(self):\n        from src.api.websocket import WebSocketManager\n        manager = WebSocketManager()\n        ws = MagicMock()\n        ws.accept = AsyncMock()\n        ws.send_json = AsyncMock(side_effect=RuntimeError(\"broken pipe\"))\n        await manager.connect(\"qid1\", ws)\n        result = await manager.send(\"qid1\", {\"type\": \"test\"})\n        assert result is False\n        assert \"qid1\" not in manager._connections\n\n    @pytest.mark.asyncio\n    async def test_disconnect_is_idempotent(self):\n        from src.api.websocket import WebSocketManager\n        manager = WebSocketManager()\n        await manager.disconnect(\"nonexistent\")  # should not raise\n```\n\n---\n\n",
