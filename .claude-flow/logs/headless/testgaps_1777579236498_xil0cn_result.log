        "content": "import asyncio\nimport pytest\nfrom unittest.mock import AsyncMock, MagicMock, patch\n\n\nclass TestGeminiClientInit:\n    def test_raises_without_api_key(self, monkeypatch):\n        monkeypatch.delenv(\"GEMINI_API_KEY\", raising=False)\n        from src.llm import client as llm_module\n        llm_module._client = None  # reset singleton\n        with pytest.raises(RuntimeError, match=\"GEMINI_API_KEY\"):\n            from src.llm.client import GeminiClient\n            GeminiClient()\n\n    def test_initializes_with_api_key(self, monkeypatch):\n        monkeypatch.setenv(\"GEMINI_API_KEY\", \"fake-key\")\n        with patch(\"google.generativeai.configure\"):\n            from src.llm.client import GeminiClient\n            client = GeminiClient()\n            assert client is not None\n\n\nclass TestSafeText:\n    def test_returns_text_on_success(self):\n        from src.llm.client import _safe_text\n        mock_response = MagicMock()\n        mock_response.text = \"hello\"\n        assert _safe_text(mock_response) == \"hello\"\n\n    def test_returns_empty_on_blocked_content(self):\n        from src.llm.client import _safe_text\n        mock_response = MagicMock()\n        type(mock_response).text = property(lambda self: (_ for _ in ()).throw(ValueError(\"blocked\")))\n        assert _safe_text(mock_response) == \"\"\n\n\nclass TestGeminiClientChat:\n    @pytest.mark.asyncio\n    async def test_chat_returns_text(self, monkeypatch):\n        monkeypatch.setenv(\"GEMINI_API_KEY\", \"fake-key\")\n        with patch(\"google.generativeai.configure\"), \\\n             patch(\"google.generativeai.GenerativeModel\") as mock_model_cls:\n            mock_model = MagicMock()\n            mock_response = MagicMock()\n            mock_response.text = \"response text\"\n            mock_model.generate_content_async = AsyncMock(return_value=mock_response)\n            mock_model_cls.return_value = mock_model\n\n            from src.llm.client import GeminiClient\n            client = GeminiClient()\n            result = await client.chat(\"system prompt\", \"user message\")\n            assert result == \"response text\"\n\n    @pytest.mark.asyncio\n    async def test_chat_parsed_returns_dict(self, monkeypatch):\n        monkeypatch.setenv(\"GEMINI_API_KEY\", \"fake-key\")\n        with patch(\"google.generativeai.configure\"), \\\n             patch(\"google.generativeai.GenerativeModel\") as mock_model_cls:\n            mock_model = MagicMock()\n            mock_response = MagicMock()\n            mock_response.text = '{\"key\": \"value\"}'\n            mock_model.generate_content_async = AsyncMock(return_value=mock_response)\n            mock_model_cls.return_value = mock_model\n\n            from src.llm.client import GeminiClient\n            client = GeminiClient()\n            result = await client.chat_parsed(\"system\", \"user\")\n            assert result == {\"key\": \"value\"}\n\n    @pytest.mark.asyncio\n    async def test_chat_parsed_returns_raw_on_json_error(self, monkeypatch):\n        monkeypatch.setenv(\"GEMINI_API_KEY\", \"fake-key\")\n        with patch(\"google.generativeai.configure\"), \\\n             patch(\"google.generativeai.GenerativeModel\") as mock_model_cls:\n            mock_model = MagicMock()\n            mock_response = MagicMock()\n            mock_response.text = \"not valid json\"\n            mock_model.generate_content_async = AsyncMock(return_value=mock_response)\n            mock_model_cls.return_value = mock_model\n\n            from src.llm.client import GeminiClient\n            client = GeminiClient()\n            result = await client.chat_parsed(\"system\", \"user\")\n            assert \"_parse_error\" in result\n            assert \"_raw\" in result\n\n\nclass TestGeminiRateLimitRetry:\n    @pytest.mark.asyncio\n    async def test_retries_on_resource_exhausted(self, monkeypatch):\n        from google.api_core.exceptions import ResourceExhausted\n        monkeypatch.setenv(\"GEMINI_API_KEY\", \"fake-key\")\n        with patch(\"google.generativeai.configure\"), \\\n             patch(\"google.generativeai.GenerativeModel\") as mock_model_cls, \\\n             patch(\"asyncio.sleep\", new_callable=AsyncMock):\n            mock_model = MagicMock()\n            ok_response = MagicMock()\n            ok_response.text = \"ok\"\n            mock_model.generate_content_async = AsyncMock(\n                side_effect=[ResourceExhausted(\"rate limit\"), ok_response]\n            )\n            mock_model_cls.return_value = mock_model\n\n            from src.llm.client import GeminiClient\n            client = GeminiClient()\n            result = await client._generate(mock_model, [])\n            assert result == \"ok\"\n\n    @pytest.mark.asyncio\n    async def test_raises_after_max_retries(self, monkeypatch):\n        from google.api_core.exceptions import ResourceExhausted\n        monkeypatch.setenv(\"GEMINI_API_KEY\", \"fake-key\")\n        with patch(\"google.generativeai.configure\"), \\\n             patch(\"google.generativeai.GenerativeModel\") as mock_model_cls, \\\n             patch(\"asyncio.sleep\", new_callable=AsyncMock):\n            mock_model = MagicMock()\n            mock_model.generate_content_async = AsyncMock(\n                side_effect=ResourceExhausted(\"rate limit\")\n            )\n            mock_model_cls.return_value = mock_model\n\n            from src.llm.client import GeminiClient\n            client = GeminiClient()\n            with pytest.raises(ResourceExhausted):\n                await client._generate(mock_model, [], max_retries=3)\n```\n\n---\n\n",
