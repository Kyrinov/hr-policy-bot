        "title": "tests/test_content_extractor.py",
        "content": "\"\"\"Tests for ContentExtractor edge cases.\"\"\"\n\nimport pytest\nfrom src.fetch.extractors import ContentExtractor\n\n\n@pytest.fixture\ndef extractor():\n    return ContentExtractor(selectors_path=\"nonexistent_path.yaml\")  # forces default selectors\n\n\nclass TestTruncate:\n    def test_short_text_unchanged(self, extractor):\n        result = extractor._truncate(\"hello\", 100)\n        assert result == \"hello\"\n\n    def test_long_text_truncated_with_ellipsis(self, extractor):\n        text = \"a\" * 200\n        result = extractor._truncate(text, 50)\n        assert len(result) == 50\n        assert result.endswith(\"...\")\n\n\nclass TestCleanText:\n    def test_collapses_whitespace(self, extractor):\n        result = extractor._clean_text(\"  hello   world  \", 100)\n        assert result == \"hello world\"\n\n\nclass TestExtract:\n    def test_truncates_at_max_length(self, extractor):\n        long_html = f\"<html><body><p>{'x' * 100000}</p></body></html>\"\n        result = extractor.extract(\"https://example.com\", long_html, max_length=100)\n        assert len(result) <= 100\n\n    def test_removes_nav_elements(self, extractor):\n        html = \"\"\"\n        <html><body>\n          <main>\n            <nav>SKIP THIS NAV</nav>\n            <p>Keep this paragraph.</p>\n          </main>\n        </body></html>\n        \"\"\"\n        result = extractor.extract(\"https://example.com\", html)\n        assert \"Keep this paragraph\" in result\n\n    def test_formats_headings_on_own_line(self, extractor):\n        html = \"<html><body><main><h2>Section Title</h2><p>Body text.</p></main></body></html>\"\n        result = extractor.extract(\"https://example.com\", html)\n        assert \"Section Title\" in result\n        assert \"Body text\" in result\n\n    def test_handles_empty_html_gracefully(self, extractor):\n        result = extractor.extract(\"https://example.com\", \"\")\n        assert isinstance(result, str)\n```\n\n```python\n",
