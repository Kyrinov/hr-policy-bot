        "language": "python",
        "code": "# tests/test_orchestrator.py\n\"\"\"Tests for OrchestratorAgent.\"\"\"\n\nimport pytest\nfrom unittest.mock import AsyncMock, MagicMock, patch\n\n\n@pytest.fixture\ndef orchestrator():\n    with patch(\"src.llm.client.get_client\") as mock_client_factory:\n        mock_client_factory.return_value = MagicMock()\n        from src.agents.orchestrator import OrchestratorAgent\n        return OrchestratorAgent()\n\n\nclass TestBuildSynthesisPrompt:\n    def test_includes_query_and_agent_findings(self, orchestrator):\n        specialist_responses = [\n            {\"agent_id\": \"staffing\", \"findings\": \"Staffing rules apply.\", \"confidence\": \"high\", \"citations\": []},\n        ]\n        prompt = orchestrator._build_synthesis_prompt(\"What are staffing rules?\", specialist_responses)\n        assert \"What are staffing rules?\" in prompt\n        assert \"STAFFING\" in prompt\n        assert \"Staffing rules apply.\" in prompt\n\n    def test_includes_citations_when_present(self, orchestrator):\n        specialist_responses = [\n            {\n                \"agent_id\": \"labour\",\n                \"findings\": \"Some findings.\",\n                \"confidence\": \"medium\",\n                \"citations\": [\n                    {\"instrument_title\": \"PSLRA\", \"url\": \"https://example.com\", \"relevant_section\": \"s.12\", \"instrument_type\": \"Act\"}\n                ],\n            }\n        ]\n        prompt = orchestrator._build_synthesis_prompt(\"query\", specialist_responses)\n        assert \"PSLRA\" in prompt\n\n    def test_empty_specialist_responses(self, orchestrator):\n        prompt = orchestrator._build_synthesis_prompt(\"query\", [])\n        assert \"query\" in prompt\n\n\nclass TestAggregateCitations:\n    def test_deduplicates_same_url(self, orchestrator):\n        responses = [\n            {\"agent_id\": \"staffing\", \"citations\": [{\"instrument_title\": \"PSEA\", \"url\": \"https://a.com\", \"instrument_type\": \"Act\", \"relevant_section\": None}]},\n            {\"agent_id\": \"classification\", \"citations\": [{\"instrument_title\": \"PSEA\", \"url\": \"https://a.com\", \"instrument_type\": \"Act\", \"relevant_section\": None}]},\n        ]\n        citations = orchestrator._aggregate_citations(responses)\n        assert len(citations) == 1\n\n    def test_keeps_distinct_urls(self, orchestrator):\n        responses = [\n            {\"agent_id\": \"staffing\", \"citations\": [{\"instrument_title\": \"PSEA\", \"url\": \"https://a.com\", \"instrument_type\": \"Act\", \"relevant_section\": None}]},\n            {\"agent_id\": \"labour\", \"citations\": [{\"instrument_title\": \"PSLRA\", \"url\": \"https://b.com\", \"instrument_type\": \"Act\", \"relevant_section\": None}]},\n        ]\n        citations = orchestrator._aggregate_citations(responses)\n        assert len(citations) == 2\n\n    def test_empty_responses(self, orchestrator):\n        assert orchestrator._aggregate_citations([]) == []\n\n\nclass TestProcess:\n    @pytest.mark.asyncio\n    async def test_returns_orchestrator_response_on_valid_json(self, orchestrator):\n        valid_json = '{\"summary\": \"Answer.\", \"detailed_analysis\": \"Detail.\", \"citations\": [], \"agents_consulted\": [\"staffing\"], \"overall_confidence\": \"high\"}'\n        orchestrator._llm_client.chat = AsyncMock(return_value=valid_json)\n        response = await orchestrator.process(\"query\", [{\"agent_id\": \"staffing\", \"citations\": [], \"confidence\": \"high\", \"findings\": \"x\"}])\n        assert response.summary == \"Answer.\"\n        assert response.overall_confidence == \"high\"\n\n    @pytest.mark.asyncio\n    async def test_returns_error_response_on_json_decode_failure(self, orchestrator):\n        orchestrator._llm_client.chat = AsyncMock(return_value=\"not json at all\")\n        response = await orchestrator.process(\"query\", [])\n        assert response.overall_confidence == \"low\"\n        assert \"error\" in response.summary.lower()\n\n    @pytest.mark.asyncio\n    async def test_strips_preamble_before_json(self, orchestrator):\n        with_preamble = 'Here is your answer:\\n{\"summary\": \"Ok.\", \"detailed_analysis\": \"d.\", \"citations\": [], \"agents_consulted\": [], \"overall_confidence\": \"medium\"}'\n        orchestrator._llm_client.chat = AsyncMock(return_value=with_preamble)\n        response = await orchestrator.process(\"query\", [])\n        assert response.summary == \"Ok.\"\n\n\nclass TestRoute:\n    @pytest.mark.asyncio\n    async def test_returns_parsed_routing_on_valid_json(self, orchestrator):\n        routing_json = '{\"selected_agents\": [\"staffing\"], \"routing_rationale\": \"r\", \"sub_queries\": {\"staffing\": \"sub\"}}'\n        orchestrator._llm_client.chat = AsyncMock(return_value=routing_json)\n        result = await orchestrator._route(\"staffing query\")\n        assert result[\"selected_agents\"] == [\"staffing\"]\n\n    @pytest.mark.asyncio\n    async def test_falls_back_to_all_agents_on_parse_failure(self, orchestrator):\n        orchestrator._llm_client.chat = AsyncMock(return_value=\"bad json\")\n        result = await orchestrator._route(\"query\")\n        assert set(result[\"selected_agents\"]) == set(orchestrator._specialist_agent_ids)\n\n\nclass TestProcessWithStreaming:\n    @pytest.mark.asyncio\n    async def test_calls_status_callback_for_each_agent(self, orchestrator):\n        routing_json = '{\"selected_agents\": [\"staffing\"], \"routing_rationale\": \"r\", \"sub_queries\": {\"staffing\": \"q\"}}'\n        orchestrator._llm_client.chat = AsyncMock(return_value=routing_json)\n\n        mock_specialist = AsyncMock()\n        from src.models.schemas import SpecialistResponse, RetrievalStatus\n        mock_specialist.process_with_fetch = AsyncMock(return_value=SpecialistResponse(\n            agent_id=\"staffing\", findings=\"f\", citations=[], confidence=\"high\",\n            retrieval_status=RetrievalStatus(instruments_attempted=0, instruments_successfully_retrieved=0),\n        ))\n\n        synth_json = '{\"summary\": \"s\", \"detailed_analysis\": \"d\", \"citations\": [], \"agents_consulted\": [\"staffing\"], \"overall_confidence\": \"high\"}'\n        # Second call to chat returns synthesis\n        orchestrator._llm_client.chat = AsyncMock(side_effect=[routing_json, synth_json])\n\n        with patch(\"src.agents.specialist.get_specialists\", return_value={\"staffing\": mock_specialist}):\n            statuses = []\n            await orchestrator.process_with_streaming(\n                \"query\",\n                fetch_engine=MagicMock(),\n                status_callback=AsyncMock(side_effect=lambda s: statuses.append(s.agent_id)),\n            )\n        assert \"orchestrator\" in statuses\n        assert \"staffing\" in statuses\n\n    @pytest.mark.asyncio\n    async def test_handles_specialist_exception_gracefully(self, orchestrator):\n        routing_json = '{\"selected_agents\": [\"staffing\"], \"routing_rationale\": \"r\", \"sub_queries\": {\"staffing\": \"q\"}}'\n        synth_json = '{\"summary\": \"s\", \"detailed_analysis\": \"d\", \"citations\": [], \"agents_consulted\": [], \"overall_confidence\": \"low\"}'\n        orchestrator._llm_client.chat = AsyncMock(side_effect=[routing_json, synth_json])\n\n        mock_specialist = AsyncMock()\n        mock_specialist.process_with_fetch = AsyncMock(side_effect=RuntimeError(\"network error\"))\n\n        with patch(\"src.agents.specialist.get_specialists\", return_value={\"staffing\": mock_specialist}):\n            response = await orchestrator.process_with_streaming(\n                \"query\", fetch_engine=MagicMock(), status_callback=AsyncMock()\n            )\n        assert response is not None"
