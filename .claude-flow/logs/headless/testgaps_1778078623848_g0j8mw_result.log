  def test_returns_only_matching_agent(self):\n        agent = make_specialist(\"staffing\")\n        instruments = agent._instruments\n        assert all(\"staffing\" in i[\"agent_ids\"] for i in instruments)\n\n    def test_different_agents_get_different_instruments(self):\n        staffing = make_specialist(\"staffing\")\n        ohs = make_specialist(\"ohs\")\n        staffing_urls = {i[\"url\"] for i in staffing._instruments}\n        ohs_urls = {i[\"url\"] for i in ohs._instruments}\n        # No requirement they're disjoint but they should differ in non-trivial ways\n        assert staffing_urls != ohs_urls\n\n\nclass TestParseResponse:\n    def test_valid_json_parsed(self):\n        agent = make_specialist()\n        raw = \"\"\"{\n            \"findings\": \"Employees must apply via GCJobs.\",\n            \"citations\": [],\n            \"caveats\": null,\n            \"scope_flags\": [],\n            \"confidence\": \"high\"\n        }\"\"\"\n        result = agent._parse_response(raw, attempted=1, retrieved=1, failed=[])\n        assert result.confidence == \"high\"\n        assert \"GCJobs\" in result.findings\n\n    def test_malformed_json_falls_back_gracefully(self):\n        agent = make_specialist()\n        raw = \"This is plain text, not JSON.\"\n        result = agent._parse_response(raw, attempted=1, retrieved=0, failed=[\"PSEA\"])\n        assert result.agent_id == \"staffing\"\n        assert result.confidence == \"low\"\n\n    def test_validate_grounding_mode_set(self):\n        agent = make_specialist()\n        raw = '{\"findings\": \"ok\", \"citations\": [], \"confidence\": \"high\"}'\n        result = agent._parse_response(raw, attempted=0, retrieved=3, failed=[], grounding_mode=\"validate\")\n        assert result.grounding_mode == \"validate\"\n```\n\n```python\n# tests/test_fetch_engine.py\n\"\"\"FetchEngine unit tests — URL normalization, domain extraction, batch errors.\"\"\"\nimport pytest\n\nfrom src.fetch.engine import FetchEngine, FetchError\n\n\nclass TestNormalizeUrl:\n    def setup_method(self):\n        self.engine = FetchEngine()\n\n    def test_laws_lois_bilingual_rewrite(self):\n        # laws-lois serves bilingual HTML — engine should prefer English\n        url = \"https://laws-lois.justice.gc.ca/eng/acts/P-33.01/\"\n        result = self.engine._normalize_url(url)\n        assert \"laws-lois.justice.gc.ca\" in result\n\n    def test_non_laws_url_unchanged(self):\n        url = \"https://www.tbs-sct.gc.ca/pol/doc-eng.aspx?id=19134\"\n        assert self.engine._normalize_url(url) == url\n\n\nclass TestGetDomain:\n    def setup_method(self):\n        self.engine = FetchEngine()\n\n    def test_extracts_hostname(self):\n        assert self.engine._get_domain(\"https://www.tbs-sct.gc.ca/pol/\") == \"www.tbs-sct.gc.ca\"\n\n    def test_different_subdomains_are_separate(self):\n        d1 = self.engine._get_domain(\"https://api.example.com/\")\n        d2 = self.engine._get_domain(\"https://www.example.com/\")\n        assert d1 != d2\n\n\nclass TestFetchBatch:\n    @pytest.mark.asyncio\n    async def test_partial_failures_isolated(self, mocker):\n        engine = FetchEngine()\n        call_count = {\"n\": 0}\n\n        async def mock_fetch(url):\n            call_count[\"n\"] += 1\n            if \"bad\" in url:\n                raise FetchError(f\"failed: {url}\")\n            return f\"content of {url}\"\n\n        mocker.patch.object(engine, \"fetch\", side_effect=mock_fetch)\n\n        results = await engine.fetch_batch([\n            \"https://good.com/page\",\n            \"https://bad.com/page\",\n        ])\n        assert \"https://good.com/page\" in results\n        assert results[\"https://good.com/page\"] == \"content of https://good.com/page\"\n        assert \"https://bad.com/page\" not in results\n\n    @pytest.mark.asyncio\n    async def test_empty_batch_returns_empty(self):\n        engine = FetchEngine()\n        results = await engine.fetch_batch([])\n        assert results == {}\n```\n\n```python\n# tests/test_content_extractor.py\n\"\"\"ContentExtractor edge case tests.\"\"\"\nimport pytest\n\nfrom src.fetch.extractors import ContentExtractor\n\n\n@pytest.fixture\ndef extractor():\n    return ContentExtractor()\n\n\nclass TestExtractEdgeCases:\n    def test_empty_html_returns_empty_string(self, extractor):\n        result = extractor.extract(\"https://example.com\", \"\")\n        assert result == \"\"\n\n    def test_max_length_truncation(self, extractor):\n        long_content = \"<p>\" + (\"word \" * 10_000) + \"</p>\"\n        result = extractor.extract(\"https://example.com\", long_content, max_length=100)\n        assert len(result) <= 100\n\n    def test_script_tags_removed(self, extractor):\n        html = \"<html><body><p>Good content</p><script>alert('xss')</script></body></html>\"\n        result = extractor.extract(\"https://example.com\", html)\n        assert \"alert\" not in result\n        assert \"Good content\" in result\n\n    def test_nav_stripped(self, extractor):\n        html = \"<html><body><nav>Breadcrumb nav</nav><main><p>Policy text</p></main></body></html>\"\n        result = extractor.extract(\"https://www.tbs-sct.gc.ca/\", html)\n        assert \"Policy text\" in result\n\n\nclass TestLoadSelectors:\n    def test_unknown_domain_uses_defaults(self, extractor):\n        selectors = extractor._get_selectors(\"https://unknown-domain.example.com/\")\n        assert isinstance(selectors, dict)\n```\n\n```python\n# tests/test_sage_extractor.py\n\"\"\"Async SageExtractor pipeline tests.\"\"\"\nimport pytest\nfrom unittest.mock import AsyncMock, MagicMock, patch\n\nfrom src.models.schemas import KISSDocument, KISSToken, PolicyTriple\nfrom src.parsing.sage_extractor import SageExtractor\n\n\ndef make_doc_with_tokens(tokens: list[KISSToken]) -> KISSDocument:\n    return KISSDocument(\n        source_url=\"https://example.com\",\n        instrument_title=\"Test Instrument\",\n        agent_id=\"staffing\",\n        model_version=\"en_core_web_sm-3.7\",\n        sentences=[tokens],\n    )\n\n\nclass TestValidationFlags:\n    def setup_method(self):\n        self.sage = SageExtractor(db=MagicMock(), parser=MagicMock())\n\n    def test_no_flags_on_valid_triple(self):\n        flags = self.sage._validation_flags(\n            subject=\"employee\",\n            predicate=\"must submit\",\n            object_text=\"leave request\",\n            sentence_text=\"An employee must submit a leave request.\",\n        )\n        assert flags == []\n\n    def test_flags_empty_subject(self):\n        flags = self.sage._validation_flags(\n            subject=\"\",\n            predicate=\"must submit\",\n            object_text=\"leave request\",\n            sentence_text=\"Must submit a leave request.\",\n        )\n        assert any(\"subject\" in f.lower() for f in flags)\n\n    def test_flags_empty_object(self):\n        flags = self.sage._validation_flags(\n            subject=\"employee\",\n            predicate=\"must\",\n            object_text=\"\",\n            sentence_text=\"An employee must.\",\n        )\n        assert any(\"object\" in f.lower() for f in flags)\n\n\nclass TestProcessDocumentForUrl:\n    @pytest.mark.asyncio\n    async def test_unknown_url_returns_empty(self):\n        sage = SageExtractor(db=MagicMock(), parser=MagicMock())\n        result = await sage.process_document_for_url(\n            source_url=\"https://not-in-registry.example.com/\",\n            text=\"some text\",\n        )\n        assert result == []\n```\n\n```python\n# tests/test_api.py\n\"\"\"FastAPI endpoint tests.\"\"\"\nimport pytest\nfrom httpx import AsyncClient\nfrom httpx._transports.asgi import ASGITransport\n\nfrom src.main import app\n\n\n@pytest.fixture\nasync def client():\n    async with AsyncClient(\n        transport=ASGITransport(app=app), base_url=\"http://test\"\n    ) as ac:\n        yield ac\n\n\nclass TestHealthEndpoint:\n    @pytest.mark.asyncio\n    async def test_health_returns_200(self, client):\n        response = await client.get(\"/health\")\n        assert response.status_code == 200\n\n    @pytest.mark.asyncio\n    async def test_health_body_contains_status(self, client):\n        response = await client.get(\"/health\")\n        data = response.json()\n        assert \"status\" in data\n\n\nclass TestQueryEndpoint:\n    @pytest.mark.asyncio\n    async def test_empty_query_rejected(self, client):\n        response = await client.post(\"/query\", json={\"query_text\": \"\"})\n        assert response.status_code == 422\n\n    @pytest.mark.asyncio\n    async def test_valid_query_accepted(self, client, mocker):\n        mocker.patch(\n            \"src.agents.orchestrator.OrchestratorAgent.process_with_streaming\",\n            return_value=MagicMock(summary=\"ok\", overall_confidence=\"high\"),\n        )\n        response = await client.post(\"/query\", json={\"query_text\": \"Who can approve leave?\"})\n        assert response.status_code in (200, 202)\n```\n\n---\n\n### Priority Order for Writing These Tests\n\n1. **`test_llm_client.py`** — most testable via mocks, covers `chat_parsed` JSON fallback which is load-bearing\n2. **`test_specialist.py`** — `_parse_response` malformed-JSON path is where silent failures hide\n3. **`test_db_extended.py`** — all the feedback/cache/triple methods are completely dark\n4. **`test_fetch_engine.py`** — `fetch_batch` partial-failure isolation prevents cascading errors\n5. **`test_orchestrator.py`** — `_aggregate_citations` deduplication logic\n6. **`test_sage_extractor.py`** — `_validation_flags` and unknown-URL early exit\n7. **`test_api.py`** — endpoint smoke tests last (needs a running DB fixture)\n\nThe largest single risk right now is **`_parse_response` in `SpecialistAgent`** — it's the function that converts raw LLM text into structured data, it handles malformed JSON silently, and it has zero test coverage.\n",
