        "code": "# tests/test_specialist.py\n\"\"\"Tests for SpecialistAgent — mocks LLM and FetchEngine.\"\"\"\n\nimport json\nimport pytest\nfrom unittest.mock import AsyncMock, MagicMock, patch\n\n\n@pytest.fixture(autouse=True)\ndef mock_gemini(monkeypatch):\n    monkeypatch.setenv(\"GEMINI_API_KEY\", \"test-key\")\n    with patch(\"google.generativeai.configure\"), \\\n         patch(\"google.generativeai.GenerativeModel\"):\n        yield\n\n\n@pytest.fixture\ndef specialist():\n    import src.llm.client as llm_mod\n    llm_mod._client = None\n    from src.agents.specialist import SpecialistAgent\n    agent = SpecialistAgent(\"staffing\", \"Staffing Agent\", \"Staffing domain\")\n    agent._llm_client = MagicMock()\n    return agent\n\n\nclass TestLoadInstruments:\n    def test_loads_only_matching_agent_instruments(self, specialist):\n        assert all(\"staffing\" in i[\"agent_ids\"] for i in specialist._instruments)\n\n    def test_returns_empty_for_unknown_agent_id(self):\n        import src.llm.client as llm_mod\n        llm_mod._client = None\n        from src.agents.specialist import SpecialistAgent\n        agent = SpecialistAgent(\"nonexistent\", \"Test\", \"Test\")\n        assert agent._instruments == []\n\n\nclass TestBuildPolicyContext:\n    def test_returns_empty_string_when_no_fetched(self, specialist):\n        assert specialist._build_policy_context([]) == \"\"\n\n    def test_includes_instrument_title_and_content(self, specialist):\n        fetched = [\n            ({\"title\": \"PSEA\", \"type\": \"Act\", \"url\": \"https://example.com\"}, \"Policy text here\")\n        ]\n        context = specialist._build_policy_context(fetched)\n        assert \"PSEA\" in context\n        assert \"Policy text here\" in context\n\n\nclass TestParseResponse:\n    def test_parses_valid_json_response(self, specialist):\n        raw = json.dumps({\n            \"agent_id\": \"staffing\",\n            \"findings\": \"Key finding\",\n            \"citations\": [],\n            \"confidence\": \"high\",\n        })\n        result = specialist._parse_response(raw, attempted=1, retrieved=1, failed=[])\n        assert result.findings == \"Key finding\"\n        assert result.confidence == \"high\"\n\n    def test_falls_back_to_raw_on_invalid_json(self, specialist):\n        result = specialist._parse_response(\"not json\", attempted=0, retrieved=0, failed=[])\n        assert result.findings == \"not json\"\n        assert result.confidence == \"low\"\n\n    def test_records_retrieval_failures(self, specialist):\n        raw = json.dumps({\"findings\": \"ok\", \"citations\": [], \"confidence\": \"medium\"})\n        result = specialist._parse_response(raw, attempted=3, retrieved=1, failed=[\"Doc A\", \"Doc B\"])\n        assert result.retrieval_status.instruments_failed == [\"Doc A\", \"Doc B\"]\n        assert result.retrieval_status.instruments_attempted == 3\n\n\nclass TestProcessWithFetch:\n    @pytest.mark.asyncio\n    async def test_process_without_fetch_engine(self, specialist):\n        valid_resp = json.dumps({\"findings\": \"ok\", \"citations\": [], \"confidence\": \"high\"})\n        specialist._llm_client.chat = AsyncMock(return_value=valid_resp)\n        result = await specialist.process(\"What are hiring rules?\")\n        assert result.agent_id == \"staffing\"\n\n    @pytest.mark.asyncio\n    async def test_failed_fetch_still_calls_llm(self, specialist):\n        \"\"\"If fetch fails for all instruments, LLM is still called with empty context.\"\"\"\n        mock_engine = MagicMock()\n        mock_engine.fetch = AsyncMock(side_effect=Exception(\"network error\"))\n        valid_resp = json.dumps({\"findings\": \"best effort\", \"citations\": [], \"confidence\": \"low\"})\n        specialist._llm_client.chat = AsyncMock(return_value=valid_resp)\n        result = await specialist.process_with_fetch(\"query\", mock_engine)\n        assert result.retrieval_status.instruments_successfully_retrieved == 0"
