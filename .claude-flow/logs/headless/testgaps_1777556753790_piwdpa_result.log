        "code": "# tests/test_llm_client.py\n\"\"\"Tests for GeminiClient — all paths require mocking google.generativeai.\"\"\"\n\nimport asyncio\nimport json\nimport pytest\nfrom unittest.mock import AsyncMock, MagicMock, patch\nfrom google.api_core.exceptions import ResourceExhausted\n\n\n@pytest.fixture\ndef gemini_env(monkeypatch):\n    monkeypatch.setenv(\"GEMINI_API_KEY\", \"test-key\")\n\n\nclass TestGeminiClientInit:\n    def test_raises_without_api_key(self, monkeypatch):\n        monkeypatch.delenv(\"GEMINI_API_KEY\", raising=False)\n        with pytest.raises(RuntimeError, match=\"GEMINI_API_KEY\"):\n            from src.llm.client import GeminiClient\n            GeminiClient()\n\n    def test_initializes_with_api_key(self, gemini_env):\n        with patch(\"google.generativeai.configure\"), patch(\"google.generativeai.GenerativeModel\"):\n            from src.llm.client import GeminiClient\n            client = GeminiClient()\n            assert client is not None\n\n\nclass TestSafeText:\n    def test_returns_text_normally(self):\n        from src.llm.client import _safe_text\n        mock_resp = MagicMock()\n        mock_resp.text = \"hello\"\n        assert _safe_text(mock_resp) == \"hello\"\n\n    def test_returns_empty_on_blocked_content(self):\n        from src.llm.client import _safe_text\n        mock_resp = MagicMock()\n        type(mock_resp).text = property(lambda self: (_ for _ in ()).throw(ValueError(\"blocked\")))\n        assert _safe_text(mock_resp) == \"\"\n\n\nclass TestGenerateRetry:\n    @pytest.mark.asyncio\n    async def test_retries_on_rate_limit_then_succeeds(self, gemini_env):\n        \"\"\"First call raises ResourceExhausted; second call succeeds.\"\"\"\n        from src.llm.client import GeminiClient\n        with patch(\"google.generativeai.configure\"):\n            with patch(\"google.generativeai.GenerativeModel\") as MockModel:\n                mock_model_inst = MagicMock()\n                mock_resp = MagicMock()\n                mock_resp.text = \"result\"\n                mock_model_inst.generate_content_async = AsyncMock(\n                    side_effect=[ResourceExhausted(\"rate limited\"), mock_resp]\n                )\n                MockModel.return_value = mock_model_inst\n\n                client = GeminiClient()\n                result = await client._generate(mock_model_inst, [], max_retries=2)\n                assert result == \"result\"\n\n    @pytest.mark.asyncio\n    async def test_raises_after_max_retries(self, gemini_env):\n        from src.llm.client import GeminiClient\n        with patch(\"google.generativeai.configure\"):\n            with patch(\"google.generativeai.GenerativeModel\") as MockModel:\n                mock_model_inst = MagicMock()\n                mock_model_inst.generate_content_async = AsyncMock(\n                    side_effect=ResourceExhausted(\"always limited\")\n                )\n                MockModel.return_value = mock_model_inst\n\n                client = GeminiClient()\n                with pytest.raises(ResourceExhausted):\n                    await client._generate(mock_model_inst, [], max_retries=2)\n\n\nclass TestChatParsed:\n    @pytest.mark.asyncio\n    async def test_returns_parsed_dict_on_valid_json(self, gemini_env):\n        from src.llm.client import GeminiClient\n        with patch(\"google.generativeai.configure\"):\n            with patch(\"google.generativeai.GenerativeModel\"):\n                client = GeminiClient()\n                client._generate = AsyncMock(return_value='{\"key\": \"value\"}')\n                result = await client.chat_parsed(\"sys\", \"user\")\n                assert result == {\"key\": \"value\"}\n\n    @pytest.mark.asyncio\n    async def test_returns_raw_fallback_on_invalid_json(self, gemini_env):\n        from src.llm.client import GeminiClient\n        with patch(\"google.generativeai.configure\"):\n            with patch(\"google.generativeai.GenerativeModel\"):\n                client = GeminiClient()\n                client._generate = AsyncMock(return_value=\"not json at all\")\n                result = await client.chat_parsed(\"sys\", \"user\")\n                assert \"_raw\" in result\n                assert \"_parse_error\" in result"
