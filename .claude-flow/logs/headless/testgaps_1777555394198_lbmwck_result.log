        "code": "# tests/test_database.py\nimport pytest\nimport asyncio\nfrom src.data.db import DatabaseManager\n\n\n@pytest.fixture\nasync def db(tmp_path):\n    manager = DatabaseManager(db_path=str(tmp_path / \"test.db\"))\n    await manager.initialize()\n    yield manager\n    await manager.close()\n\n\n@pytest.mark.asyncio\nasync def test_save_and_get_agent_response(db):\n    query_id = \"q-001\"\n    await db.save_query({\"id\": query_id, \"text\": \"Test query\"})\n    await db.save_agent_response(query_id=query_id, agent_id=\"staffing\", response={\"answer\": \"ok\"})\n    responses = await db.get_agent_responses(query_id)\n    assert len(responses) == 1\n    assert responses[0][\"agent_id\"] == \"staffing\"\n\n\n@pytest.mark.asyncio\nasync def test_save_orchestrator_response(db):\n    query_id = \"q-002\"\n    await db.save_query({\"id\": query_id, \"text\": \"Orchestrator test\"})\n    await db.save_orchestrator_response(query_id=query_id, response={\"synthesis\": \"answer\"})\n    result = await db.get_orchestrator_response(query_id)\n    assert result[\"synthesis\"] == \"answer\"\n\n\n@pytest.mark.asyncio\nasync def test_save_and_get_feedback(db):\n    query_id = \"q-003\"\n    await db.save_query({\"id\": query_id, \"text\": \"Feedback test\"})\n    await db.save_feedback(query_id=query_id, rating=5, comment=\"Accurate!\")\n    feedback = await db.get_feedback_for_query(query_id)\n    assert feedback[\"rating\"] == 5\n    assert feedback[\"comment\"] == \"Accurate!\"\n\n\n@pytest.mark.asyncio\nasync def test_export_feedback_returns_all(db):\n    for i in range(3):\n        qid = f\"q-fb-{i}\"\n        await db.save_query({\"id\": qid, \"text\": f\"Query {i}\"})\n        await db.save_feedback(query_id=qid, rating=i + 3)\n    records = await db.export_feedback()\n    assert len(records) >= 3\n\n\n@pytest.mark.asyncio\nasync def test_cache_set_and_get(db):\n    await db.set_cached(url=\"https://example.com\", content=\"<html/>\", ttl_seconds=3600)\n    result = await db.get_cached(\"https://example.com\")\n    assert result == \"<html/>\"\n\n\n@pytest.mark.asyncio\nasync def test_cache_expired_returns_none(db):\n    await db.set_cached(url=\"https://example.com\", content=\"<html/>\", ttl_seconds=1)\n    await asyncio.sleep(1.1)\n    result = await db.get_cached(\"https://example.com\")\n    assert result is None\n\n\n@pytest.mark.asyncio\nasync def test_cache_get_stale_returns_expired(db):\n    await db.set_cached(url=\"https://example.com\", content=\"stale\", ttl_seconds=1)\n    await asyncio.sleep(1.1)\n    result = await db.get_stale(\"https://example.com\")\n    assert result == \"stale\"\n\n\n@pytest.mark.asyncio\nasync def test_duplicate_query_id_raises_or_updates(db):\n    \"\"\"Inserting same query_id twice should not silently corrupt data.\"\"\"\n    await db.save_query({\"id\": \"q-dup\", \"text\": \"Original\"})\n    try:\n        await db.save_query({\"id\": \"q-dup\", \"text\": \"Duplicate\"})\n    except Exception:\n        pass  # Either raises or upserts — verify data integrity\n    result = await db.get_query(\"q-dup\")\n    assert result is not None"
