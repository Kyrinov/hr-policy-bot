== \"low\"\n\n\nclass TestBuildPolicyContext:\n    def _make_agent(self):\n        with patch(\"src.agents.specialist.get_client\"), \\\n             patch.object(__import__(\"src.agents.specialist\", fromlist=[\"SpecialistAgent\"]).SpecialistAgent, \"_load_instruments\", return_value=[]):\n            from src.agents.specialist import SpecialistAgent\n            return SpecialistAgent(\"staffing\", \"D\", \"D\")\n\n    def test_empty_fetched_returns_empty_string(self):\n        agent = self._make_agent()\n        assert agent._build_policy_context([]) == \"\"\n\n    def test_includes_instrument_title_and_content(self):\n        agent = self._make_agent()\n        instrument = {\"title\": \"PSEA\", \"type\": \"Act\", \"url\": \"https://example.com\"}\n        result = agent._build_policy_context([(instrument, \"Policy text here\")])\n        assert \"PSEA\" in result\n        assert \"Policy text here\" in result\n        assert \"https://example.com\" in result\n\n\nclass TestProcessWithFetch:\n    @pytest.mark.asyncio\n    async def test_returns_response_when_fetch_engine_is_none(self):\n        from src.agents.specialist import SpecialistAgent\n        good_json = '{\"agent_id\": \"staffing\", \"findings\": \"No fetch\", \"citations\": [], \"confidence\": \"low\", \"scope_flags\": []}'\n        mock_llm = AsyncMock()\n        mock_llm.chat.return_value = good_json\n\n        with patch(\"src.agents.specialist.get_client\", return_value=mock_llm), \\\n             patch.object(SpecialistAgent, \"_load_instruments\", return_value=[]):\n            agent = SpecialistAgent(\"staffing\", \"D\", \"D\")\n\n        result = await agent.process_with_fetch(\"What is leave?\", None)\n        assert result.agent_id == \"staffing\"\n        assert result.retrieval_status.instruments_attempted == 0\n\n    @pytest.mark.asyncio\n    async def test_fetch_failure_captured_in_retrieval_status(self):\n        from src.agents.specialist import SpecialistAgent\n        from src.fetch