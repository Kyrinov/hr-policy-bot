        "title": "tests/test_database.py  (extend existing, or separate file)",
        "content": "\"\"\"Tests for remaining untested DatabaseManager methods.\"\"\"\n\nimport uuid\nimport pytest\nfrom pathlib import Path\nfrom src.data.db import DatabaseManager\nfrom src.models.schemas import (\n    AgentResponseRecord, CitationItem, FeedbackRecord,\n    FetchCacheEntry, OrchestratorResponseRecord, RetrievalStatus,\n)\nfrom datetime import datetime\n\n\n@pytest.fixture\nasync def db(tmp_path):\n    manager = DatabaseManager(db_path=tmp_path / \"test.db\")\n    await manager.initialize()\n    return manager\n\n\nclass TestAgentResponses:\n    @pytest.mark.asyncio\n    async def test_save_and_get_agent_responses(self, db):\n        qid = str(uuid.uuid4())\n        from src.models.schemas import QueryRecord\n        await db.save_query(QueryRecord(query_id=qid, query_text=\"q\", agents_invoked=[\"staffing\"]))\n\n        record = AgentResponseRecord(\n            response_id=str(uuid.uuid4()),\n            query_id=qid,\n            agent_id=\"staffing\",\n            findings=\"Found relevant policy.\",\n            citations=[CitationItem(instrument_title=\"PSEA\", instrument_type=\"Act\")],\n            confidence=\"high\",\n            retrieval_status=RetrievalStatus(\n                instruments_attempted=1, instruments_successfully_retrieved=1\n            ),\n        )\n        await db.save_agent_response(record)\n        results = await db.get_agent_responses(qid)\n        assert len(results) == 1\n        assert results[0].agent_id == \"staffing\"\n\n    @pytest.mark.asyncio\n    async def test_get_agent_responses_returns_empty_for_unknown_query(self, db):\n        results = await db.get_agent_responses(\"nonexistent-id\")\n        assert results == []\n\n\nclass TestOrchestratorResponses:\n    @pytest.mark.asyncio\n    async def test_save_and_get_orchestrator_response(self, db):\n        qid = str(uuid.uuid4())\n        from src.models.schemas import QueryRecord\n        await db.save_query(QueryRecord(query_id=qid, query_text=\"q\", agents_invoked=[]))\n\n        record = OrchestratorResponseRecord(\n            response_id=str(uuid.uuid4()),\n            query_id=qid,\n            summary=\"Direct answer.\",\n            overall_confidence=\"medium\",\n        )\n        await db.save_orchestrator_response(record)\n        result = await db.get_orchestrator_response(qid)\n        assert result is not None\n        assert result.summary == \"Direct answer.\"\n\n    @pytest.mark.asyncio\n    async def test_get_orchestrator_response_returns_none_for_unknown(self, db):\n        result = await db.get_orchestrator_response(\"nonexistent\")\n        assert result is None\n\n\nclass TestFeedback:\n    @pytest.mark.asyncio\n    async def test_save_and_get_feedback(self, db):\n        qid = str(uuid.uuid4())\n        from src.models.schemas import QueryRecord\n        await db.save_query(QueryRecord(query_id=qid, query_text=\"q\", agents_invoked=[]))\n\n        record = FeedbackRecord(\n            feedback_id=str(uuid.uuid4()),\n            query_id=qid,\n            rating=\"accurate\",\n            comment=\"Very helpful.\",\n        )\n        await db.save_feedback(record)\n        result = await db.get_feedback_for_query(qid)\n        assert result is not None\n        assert result.rating == \"accurate\"\n\n    @pytest.mark.asyncio\n    async def test_export_feedback_returns_list(self, db):\n        results = await db.export_feedback()\n        assert isinstance(results, list)\n\n\nclass TestFetchCacheDb:\n    @pytest.mark.asyncio\n    async def test_get_cached_returns_none_before_storing(self, db):\n        result = await db.get_cached(\"https://example.com\")\n        assert result is None\n\n    @pytest.mark.asyncio\n    async def test_set_and_get_cached(self, db):\n        entry = FetchCacheEntry(\n            url=\"https://example.com/page\",\n            content_text=\"policy content\",\n            content_hash=\"abc123\",\n            ttl_hours=24,\n        )\n        await db.set_cached(entry)\n        result = await db.get_cached(\"https://example.com/page\")\n        assert result is not None\n        assert result.content_text == \"policy content\"\n\n    @pytest.mark.asyncio\n    async def test_get_stale_returns_expired_entry(self, db):\n        \"\"\"get_stale returns entries regardless of TTL expiry.\"\"\"\n        from datetime import datetime, timedelta\n        entry = FetchCacheEntry(\n            url=\"https://example.com/expired\",\n            content_text=\"old content\",\n            content_hash=\"def456\",\n            fetched_at=datetime.utcnow() - timedelta(hours=200),\n            ttl_hours=1,\n        )\n        await db.set_cached(entry)\n        result = await db.get_stale(\"https://example.com/expired\")\n        assert result is not None\n\n    @pytest.mark.asyncio\n    async def test_clear_expired_removes_old_entries(self, db):\n        from datetime import datetime, timedelta\n        entry = FetchCacheEntry(\n            url=\"https://example.com/old\",\n            content_text=\"stale\",\n            content_hash=\"xyz\",\n            fetched_at=datetime.utcnow() - timedelta(hours=200),\n            ttl_hours=1,\n        )\n        await db.set_cached(entry)\n        deleted = await db.clear_expired()\n        assert deleted >= 1\n\n\nclass TestListQueries:\n    @pytest.mark.asyncio\n    async def test_list_queries_returns_recent_first(self, db):\n        from src.models.schemas import QueryRecord\n        for i in range(3):\n            await db.save_query(QueryRecord(\n                query_id=str(uuid.uuid4()), query_text=f\"query {i}\", agents_invoked=[]\n            ))\n        results = await db.list_queries(limit=10)\n        assert len(results) == 3\n\n    @pytest.mark.asyncio\n    async def test_list_queries_respects_limit(self, db):\n        from src.models.schemas import QueryRecord\n        for i in range(5):\n            await db.save_query(QueryRecord(\n                query_id=str(uuid.uuid4()), query_text=f\"q{i}\", agents_invoked=[]\n            ))\n        results = await db.list_queries(limit=2)\n        assert len(results) == 2\n```\n\n```python\n",
