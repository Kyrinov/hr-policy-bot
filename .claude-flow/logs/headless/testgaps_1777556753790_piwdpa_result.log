        "title": "tests/test_fetch_cache.py",
        "content": "\"\"\"Tests for FetchCache and CacheEntry.\"\"\"\n\nfrom datetime import datetime, timedelta\nimport pytest\nfrom unittest.mock import AsyncMock, MagicMock\nfrom src.fetch.cache import CacheEntry, FetchCache\n\n\nclass TestCacheEntry:\n    def test_is_valid_returns_true_for_unexpired_entry(self):\n        entry = CacheEntry(url=\"https://example.com\", content=\"text\", ttl_hours=24)\n        entry.fetched_at = datetime.utcnow().isoformat()\n        assert entry.is_valid() is True\n\n    def test_is_valid_returns_false_for_expired_entry(self):\n        entry = CacheEntry(url=\"https://example.com\", content=\"text\", ttl_hours=1)\n        entry.fetched_at = (datetime.utcnow() - timedelta(hours=2)).isoformat()\n        assert entry.is_valid() is False\n\n    def test_content_hash_is_sha256(self):\n        import hashlib\n        entry = CacheEntry(url=\"https://example.com\", content=\"hello\", ttl_hours=24)\n        expected = hashlib.sha256(b\"hello\").hexdigest()\n        assert entry.content_hash == expected\n\n\nclass TestFetchCacheGetDefaultTtl:\n    def test_legislation_domain_gets_720h(self):\n        cache = FetchCache(db_manager=MagicMock())\n        ttl = cache._get_default_ttl(\"https://laws-lois.justice.gc.ca/eng/acts/P-33.01/\")\n        assert ttl == 720\n\n    def test_collective_agreement_domain_gets_720h(self):\n        cache = FetchCache(db_manager=MagicMock())\n        ttl = cache._get_default_ttl(\"https://tbs-sct.canada.ca/agreements-conventions/1-eng.aspx\")\n        assert ttl == 720\n\n    def test_default_domain_uses_config_ttl(self):\n        cache = FetchCache(db_manager=MagicMock())\n        ttl = cache._get_default_ttl(\"https://some-other-site.gc.ca/page\")\n        assert ttl == cache._config.cache.ttl_hours\n\n\nclass TestFetchCacheMethods:\n    @pytest.fixture\n    def cache(self):\n        mock_db = MagicMock()\n        mock_db.get_cached = AsyncMock(return_value=None)\n        mock_db.get_stale = AsyncMock(return_value=None)\n        mock_db.set_cached = AsyncMock()\n        return FetchCache(db_manager=mock_db)\n\n    @pytest.mark.asyncio\n    async def test_get_returns_none_on_cache_miss(self, cache):\n        result = await cache.get(\"https://example.com\")\n        assert result is None\n\n    @pytest.mark.asyncio\n    async def test_set_cached_calls_db_set(self, cache):\n        entry = CacheEntry(url=\"https://example.com\", content=\"text\", ttl_hours=24)\n        entry.fetched_at = datetime.utcnow().isoformat()\n        await cache.set_cached(entry)\n        cache._db_manager.set_cached.assert_called_once()\n\n    @pytest.mark.asyncio\n    async def test_store_uses_auto_ttl(self, cache):\n        await cache.store(\"https://example.com/page\", \"content\")\n        cache._db_manager.set_cached.assert_called_once()\n```\n\n```python\n",
