        "code": "# tests/test_fetch_engine.py\nimport pytest\nfrom unittest.mock import AsyncMock, MagicMock, patch\nimport httpx\n\n\n@pytest.fixture\ndef engine():\n    mock_cache = AsyncMock()\n    mock_cache._get_default_ttl = MagicMock(return_value=168)\n    mock_extractor = MagicMock()\n    mock_extractor.extract = MagicMock(return_value=\"extracted content\")\n    from src.fetch.engine import FetchEngine\n    return FetchEngine(cache=mock_cache, extractor=mock_extractor)\n\n\nclass TestNormalizeUrl:\n    def test_rewrites_laws_lois_act_index(self):\n        from src.fetch.engine import FetchEngine\n        engine = FetchEngine.__new__(FetchEngine)\n        result = engine._normalize_url(\"https://laws-lois.justice.gc.ca/eng/acts/P-33.01/\")\n        assert result.endswith(\"/FullText.html\")\n\n    def test_leaves_fulltext_url_unchanged(self):\n        from src.fetch.engine import FetchEngine\n        engine = FetchEngine.__new__(FetchEngine)\n        url = \"https://laws-lois.justice.gc.ca/eng/acts/P-33.01/FullText.html\"\n        assert engine._normalize_url(url) == url\n\n    def test_leaves_non_laws_url_unchanged(self):\n        from src.fetch.engine import FetchEngine\n        engine = FetchEngine.__new__(FetchEngine)\n        url = \"https://tbs-sct.canada.ca/pol/doc-eng.aspx?id=32592\"\n        assert engine._normalize_url(url) == url\n\n\nclass TestGetDomain:\n    def test_extracts_standard_domain(self):\n        from src.fetch.engine import FetchEngine\n        engine = FetchEngine.__new__(FetchEngine)\n        assert engine._get_domain(\"https://laws-lois.justice.gc.ca/eng/acts/\") == \"laws-lois.justice.gc.ca\"\n\n    def test_malformed_url_returns_default(self):\n        from src.fetch.engine import FetchEngine\n        engine = FetchEngine.__new__(FetchEngine)\n        result = engine._get_domain(\"\")\n        assert result == \"default\"\n\n\nclass TestDoFetch:\n    @pytest.mark.asyncio\n    async def test_cache_hit_returns_cached_content(self, engine):\n        from src.fetch.cache import CacheEntry\n        entry = MagicMock()\n        entry.content = \"cached content\"\n        engine._cache.get = AsyncMock(return_value=entry)\n        result = await engine._do_fetch(\"https://example.com\")\n        assert result == \"cached content\"\n\n    @pytest.mark.asyncio\n    async def test_cache_miss_fetches_and_stores(self, engine):\n        engine._cache.get = AsyncMock(return_value=None)\n        engine._cache.set_cached = AsyncMock()\n        mock_response = MagicMock()\n        mock_response.text = \"<html><body>content</body></html>\"\n        mock_response.status_code = 200\n        mock_response.raise_for_status = MagicMock()\n        engine._client = AsyncMock()\n        engine._client.get = AsyncMock(return_value=mock_response)\n        result = await engine._do_fetch(\"https://example.com\")\n        assert result == \"extracted content\"\n        engine._cache.set_cached.assert_called_once()\n\n    @pytest.mark.asyncio\n    async def test_fetch_failure_falls_back_to_stale(self, engine):\n        engine._cache.get = AsyncMock(return_value=None)\n        engine._client = AsyncMock()\n        engine._client.get = AsyncMock(side_effect=httpx.RequestError(\"timeout\"))\n        stale_entry = MagicMock()\n        stale_entry.content = \"stale content\"\n        engine._cache.get_stale = AsyncMock(return_value=stale_entry)\n        result = await engine._do_fetch(\"https://example.com\")\n        assert result == \"stale content\"\n\n    @pytest.mark.asyncio\n    async def test_fetch_failure_no_stale_raises_fetch_error(self, engine):\n        from src.fetch.engine import FetchError\n        engine._cache.get = AsyncMock(return_value=None)\n        engine._cache.get_stale = AsyncMock(return_value=None)\n        engine._client = AsyncMock()\n        engine._client.get = AsyncMock(side_effect=httpx.RequestError(\"timeout\"))\n        with pytest.raises(FetchError):\n            await engine._do_fetch(\"https://example.com\")\n\n    @pytest.mark.asyncio\n    async def test_http_status_error_falls_back_to_stale(self, engine):\n        from src.fetch.engine import FetchError\n        engine._cache.get = AsyncMock(return_value=None)\n        engine._cache.get_stale = AsyncMock(return_value=None)\n        engine._client = AsyncMock()\n        mock_response = MagicMock()\n        mock_response.raise_for_status = MagicMock(\n            side_effect=httpx.HTTPStatusError(\"404\", request=MagicMock(), response=MagicMock())\n        )\n        engine._client.get = AsyncMock(return_value=mock_response)\n        with pytest.raises(FetchError):\n            await engine._do_fetch(\"https://example.com\")\n\n\nclass TestFetchBatch:\n    @pytest.mark.asyncio\n    async def test_returns_successful_results(self, engine):\n        engine._cache.get = AsyncMock(return_value=None)\n        engine._cache.get_stale = AsyncMock(return_value=None)\n        mock_response = MagicMock()\n        mock_response.text = \"<html>content</html>\"\n        mock_response.status_code = 200\n        mock_response.raise_for_status = MagicMock()\n        engine._client = AsyncMock()\n        engine._client.get = AsyncMock(return_value=mock_response)\n        engine._cache.set_cached = AsyncMock()\n        results = await engine.fetch_batch([\"https://a.com\", \"https://b.com\"])\n        assert len(results) == 2\n\n    @pytest.mark.asyncio\n    async def test_partial_failure_returns_successes_only(self, engine):\n        from src.fetch.engine import FetchError\n        async def side_effect(url):\n            if \"fail\" in url:\n                raise FetchError(\"fail\")\n            entry = MagicMock()\n            entry.content = \"ok\"\n            return entry.content\n\n        engine.fetch = AsyncMock(side_effect=side_effect)\n        results = await engine.fetch_batch([\"https://ok.com\", \"https://fail.com\"])\n        assert \"https://ok.com\" in results\n        assert \"https://fail.com\" not in results"
