        "title": "tests/test_fetch_engine.py",
        "content": "import asyncio\nimport pytest\nfrom unittest.mock import AsyncMock, patch, MagicMock\nfrom src.fetch.engine import FetchEngine\n\n\n@pytest.fixture\nasync def engine():\n    e = FetchEngine()\n    yield e\n    await e.close()\n\n\n@pytest.mark.asyncio\nasync def test_fetch_single_success(engine):\n    with patch.object(engine, \"_do_fetch\", AsyncMock(return_value=\"<html>content</html>\")):\n        result = await engine.fetch(\"https://laws-lois.justice.gc.ca/eng/acts/P-33.3/\")\n        assert \"content\" in result\n\n\n@pytest.mark.asyncio\nasync def test_fetch_returns_stale_on_timeout(engine):\n    \"\"\"On timeout, must return stale cache rather than raising.\"\"\"\n    with patch.object(engine, \"_do_fetch\", AsyncMock(side_effect=asyncio.TimeoutError())):\n        with patch.object(engine._cache, \"get_stale\", AsyncMock(return_value=\"stale content\")):\n            result = await engine.fetch(\"https://example.com\")\n            assert result == \"stale content\"\n\n\n@pytest.mark.asyncio\nasync def test_fetch_returns_none_when_no_cache_on_error(engine):\n    with patch.object(engine, \"_do_fetch\", AsyncMock(side_effect=Exception(\"Network error\"))):\n        with patch.object(engine._cache, \"get_stale\", AsyncMock(return_value=None)):\n            result = await engine.fetch(\"https://example.com\")\n            assert result is None\n\n\n@pytest.mark.asyncio\nasync def test_fetch_batch_partial_failure(engine):\n    \"\"\"If 1 of 3 URLs fails, the other 2 results should still be returned.\"\"\"\n    urls = [\"https://a.com\", \"https://b.com\", \"https://c.com\"]\n    responses = {\"https://a.com\": \"content A\", \"https://b.com\": None, \"https://c.com\": \"content C\"}\n\n    async def fake_fetch(url, **kw):\n        return responses.get(url)\n\n    with patch.object(engine, \"fetch\", side_effect=fake_fetch):\n        results = await engine.fetch_batch(urls)\n        assert results[\"https://a.com\"] == \"content A\"\n        assert results[\"https://b.com\"] is None\n        assert results[\"https://c.com\"] == \"content C\"\n\n\n@pytest.mark.asyncio\nasync def test_domain_concurrency_limit(engine):\n    \"\"\"Per-domain semaphore must prevent more than 3 concurrent fetches.\"\"\"\n    call_times = []\n\n    async def fake_do_fetch(url, **kw):\n        call_times.append(asyncio.get_event_loop().time())\n        await asyncio.sleep(0.1)\n        return \"<html/>\"\n\n    with patch.object(engine, \"_do_fetch\", side_effect=fake_do_fetch):\n        urls = [f\"https://laws-lois.justice.gc.ca/page{i}\" for i in range(6)]\n        await engine.fetch_batch(urls)\n        # Assert batching happened (not all started within first 10ms)\n        assert len(call_times) == 6\n\n\n@pytest.mark.asyncio\nasync def test_url_normalization_laws_lois(engine):\n    \"\"\"laws-lois.justice.gc.ca URLs should use browser fetcher.\"\"\"\n    with patch.object(engine, \"_browser_fetch\", AsyncMock(return_value=\"<html/>\")) as mock_browser:\n        await engine.fetch(\"https://laws-lois.justice.gc.ca/eng/acts/P-33.3/\")\n        mock_browser.assert_called_once()\n```\n\n---\n\n",
