  assert \"https://laws.gc.ca/PSEA\" in prompt\n\n\nclass TestAggregateCitations:\n    def test_deduplicates_same_title_and_url(self, agent):\n        citations = agent._aggregate_citations(SAMPLE_RESPONSES)\n        urls = [c.url for c in citations]\n        assert urls.count(\"https://laws.gc.ca/PSEA\") == 1\n\n    def test_preserves_sourced_from_agent(self, agent):\n        citations = agent._aggregate_citations(SAMPLE_RESPONSES)\n        assert any(c.sourced_from_agent == \"staffing\" for c in citations)\n\n    def test_empty_responses_returns_empty_list(self, agent):\n        assert agent._aggregate_citations([]) == []\n\n\nclass TestDeterministicGrounding:\n    def test_full_coverage_when_all_validate(self, agent):\n        responses = [\n            {**r, \"grounding_mode\": \"validate\",\n             \"retrieval_status\": {\"instruments_successfully_retrieved\": 3, \"instruments_attempted\": 3, \"instruments_failed\": []}}\n            for r in SAMPLE_RESPONSES\n        ]\n        grounding = agent._deterministic_grounding(responses)\n        assert grounding.graph_coverage == \"full\"\n        assert grounding.llm_mode == \"validate\"\n\n    def test_partial_coverage_when_mixed(self, agent):\n        responses = [\n            {**SAMPLE_RESPONSES[0], \"grounding_mode\": \"validate\",\n             \"retrieval_status\": {\"instruments_successfully_retrieved\": 2, \"instruments_attempted\": 2, \"instruments_failed\": []}},\n            {**SAMPLE_RESPONSES[1], \"grounding_mode\": \"extract\"},\n        ]\n        grounding = agent._deterministic_grounding(responses)\n        assert grounding.graph_coverage == \"partial\"\n        assert grounding.llm_mode == \"mixed\"\n\n    def test_no_coverage_when_all_extract(self, agent):\n        grounding = agent._deterministic_grounding(SAMPLE_RESPONSES)\n        assert grounding.graph_coverage == \"none\"\n        assert grounding.llm_mode == \"extract\"\n\n\n@pytest.mark.asyncio\nclass TestProcess:\n    async def test_returns_fallback_on_json_decode_error(self, agent):\n        agent._llm_client.chat = AsyncMock(return_value=\"not json at all\")\n        result = await agent.process(\"test query\", SAMPLE_RESPONSES)\n        assert isinstance(result, OrchestratorResponse)\n        assert result.overall_confidence == \"low\"\n\n    async def test_returns_valid_response_on_good_json(self, agent):\n        payload = json.dumps({\n            \"summary\": \"Direct answer\",\n            \"detailed_analysis\": \"Full analysis\",\n            \"citations\": [],\n            \"agents_consulted\": [\"staffing\"],\n            \"overall_confidence\": \"high\",\n        })\n        agent._llm_client.chat = AsyncMock(return_value=payload)\n        result = await agent.process(\"test query\", SAMPLE_RESPONSES)\n        assert result.summary == \"Direct answer\"\n        assert result.overall_confidence == \"high\"\n\n    async def test_strips_preamble_before_json(self, agent):\n        preamble = \"Here is my response:\\n\"\n        payload = json.dumps({\n            \"summary\": \"Answer\",\n            \"detailed_analysis\": \"Detail\",\n            \"citations\": [],\n            \"agents_consulted\": [],\n            \"overall_confidence\": \"medium\",\n        })\n        agent._llm_client.chat = AsyncMock(return_value=preamble + payload)\n        result = await agent.process(\"q\", SAMPLE_RESPONSES)\n        assert result.summary == \"Answer\"\n\n\n@pytest.mark.asyncio\nclass TestRoute:\n    async def test_falls_back_to_all_agents_on_llm_error(self, agent):\n        agent._llm_client.chat = AsyncMock(side_effect=RuntimeError(\"LLM offline\"))\n        result = await agent._route(\"test query\")\n        assert set(result[\"selected_agents\"]) == set(agent._specialist_agent_ids)\n\n    async def test_falls_back_on_invalid_json(self, agent):\n        agent._llm_client.chat = AsyncMock(return_value=\"not json\")\n        result = await agent._route(\"test query\")\n        assert \"selected_agents\" in result\n```\n\n---\n\n## Gap 6 — `SpecialistAgent` (zero coverage)\n\n**Untested:** `_parse_response` (valid JSON, fallback), `_build_policy_context` (empty, non-empty), `_format_triples`, `_try_graph_retrieval` (fallback_triggered, exception), `_load_instruments`.\n\n```python\n# tests/test_agents/test_specialist.py\nimport json\nimport pytest\nfrom unittest.mock import AsyncMock, MagicMock, patch\nfrom src.agents.specialist import SpecialistAgent\nfrom src.models.schemas import PolicyTriple, QueryKISSResult\n\n\ndef _make_agent(agent_id=\"staffing\") -> SpecialistAgent:\n    with patch(\"src.agents.specialist.get_client\"), \\\n         patch(\"src.agents.specialist.get_config\") as mock_cfg, \\\n         patch(\"src.agents.specialist.DatabaseManager\"), \\\n         patch.object(SpecialistAgent, \"_load_instruments\", return_value=[]):\n        mock_cfg.return_value.parsing.validate_mode_threshold = 5\n        mock_cfg.return_value.parsing.teacher_loop_enabled = False\n        agent = SpecialistAgent.__new__(SpecialistAgent)\n        agent._agent_id = agent_id\n        agent._system_prompt = \"You are a staffing specialist.\"\n        agent._llm_client = AsyncMock()\n        agent._config = mock_cfg.return_value\n        agent._instruments = []\n        agent._db = AsyncMock()\n        return agent\n\n\nVALID_LLM_RESPONSE = json.dumps({\n    \"agent_id\": \"staffing\",\n    \"findings\": \"Staffing policy requires competition.\",\n    \"citations\": [{\"instrument_title\": \"PSEA\", \"instrument_type\": \"Act\"}],\n    \"caveats\": None,\n    \"scope_flags\": [],\n    \"confidence\": \"high\",\n})\n\n\nclass TestParseResponse:\n    def test_valid_json_builds_specialist_response(self):\n        agent = _make_agent()\n        result = agent._parse_response(VALID_LLM_RESPONSE, 2, 2, [])\n        assert result.agent_id == \"staffing\"\n        assert result.confidence == \"high\"\n        assert len(result.citations) == 1\n\n    def test_invalid_json_returns_low_confidence_fallback(self):\n        agent = _make_agent()\n        result = agent._parse_response(\"this is not JSON\", 1, 0, [\"some-doc\"])\n        assert result.confidence == \"low\"\n        assert result.findings == \"this is not JSON\"\n        assert result.agent_id == \"staffing\"\n\n    def test_json_with_preamble_is_parsed(self):\n        agent = _make_agent()\n        raw = \"Here is my answer:\\n\" + VALID_LLM_RESPONSE\n        result = agent._parse_response(raw, 1, 1, [])\n        assert result.confidence == \"high\"\n\n    def test_grounding_mode_preserved(self):\n        agent = _make_agent()\n        result = agent._parse_response(VALID_LLM_RESPONSE, 1, 1, [], grounding_mode=\"validate\")\n        assert result.grounding_mode == \"validate\"\n\n\nclass TestBuildPolicyContext:\n    def test_empty_fetched_returns_empty_string(self):\n        agent = _make_agent()\n        assert agent._build_policy_context([]) == \"\"\n\n    def test_non_empty_includes_title_and_content(self):\n        agent = _make_agent()\n        instrument = {\"title\": \"PSEA\", \"type\": \"Act\", \"url\": \"https://example.com\"}\n        context = agent._build_policy_context([(instrument, \"The act states...\")])\n        assert \"PSEA\" in context\n        assert \"The act states...\" in context\n        assert \"https://example.com\" in context\n\n\nclass TestFormatTriples:\n    def test_output_contains_subject_predicate_object(self):\n        agent = _make_agent()\n        triple = PolicyTriple(\n            triple_id=\"t1\", doc_id=\"d1\",\n            source_url=\"https://example.com\",\n            instrument_title=\"Test\",\n            agent_id=\"staffing\",\n            section_heading=None,\n            sentence_text=\"Employee must attend.\",\n            subject=\"employee\", predicate=\"must\", predicate_lemma=\"must\",\n            is_deontic=True, deontic_type=\"obligation\",\n            object_=\"attend\", modifier=None, validation_flags=[],\n        )\n        output = agent._format_triples([triple])\n        assert \"employee\" in output\n        assert \"must\" in output\n        assert \"attend\" in output\n        assert \"obligation\" in output\n\n\n@pytest.mark.asyncio\nclass TestTryGraphRetrieval:\n    async def test_returns_empty_when_fallback_triggered(self):\n        agent = _make_agent()\n        kiss_result = QueryKISSResult(\n            raw_query=\"q\", entities=[], entity_types={}, verbs=[],\n            deontic_verbs=[], sentence_count=1, entity_count=0,\n            fallback_triggered=True, model_version=\"test\",\n        )\n        result = await agent._try_graph_retrieval(kiss_result)\n        assert result == []\n\n    async def test_returns_empty_when_none_passed(self):\n        agent = _make_agent()\n        result = await agent._try_graph_retrieval(None)\n        assert result == []\n\n    async def test_returns_empty_on_graph_exception(self):\n        agent = _make_agent()\n        kiss_result = QueryKISSResult(\n            raw_query=\"q\", entities=[\"employee\"], entity_types={}, verbs=[\"must\"],\n            deontic_verbs=[\"must\"], sentence_count=1, entity_count=1,\n            fallback_triggered=False, model_version=\"test\",\n        )\n        with patch(\"src.agents.specialist.get_graph_query\") as mock_gq:\n            mock_gq.return_value.search_triples_semantic = AsyncMock(\n                side_effect=RuntimeError(\"DB offline\")\n            )\n            result = await agent._try_graph_retrieval(kiss_result)\n        assert result == []\n```\n\n---\n\n## Gap 7 — `VLLMClient` (zero coverage)\n\n**Untested:** `chat_parsed` (valid JSON, parse error), `stream_chat` yielding behavior.\n\n```python\n# tests/test_llm/test_client.py\nimport pytest\nfrom unittest.mock import AsyncMock, MagicMock, patch\nfrom src.llm.client import VLLMClient\n\n\n@pytest.fixture\ndef client():\n    with patch(\"src.llm.client.get_config\") as mock_cfg, \\\n         patch(\"src.llm.client.AsyncOpenAI\"):\n        mock_cfg.return_value.model.temperature = 0.2\n        mock_cfg.return_value.model.top_p = 0.9\n        c = VLLMClient.__new__(VLLMClient)\n        c._model = \"test-model\"\n        c._config = mock_cfg.return_value\n        c._client = MagicMock()\n        return c\n\n\n@pytest.mark.asyncio\nclass TestChatParsed:\n    async def test_returns_dict_on_valid_json(self, client):\n        client._client.chat.completions.create = AsyncMock(\n            return_value=MagicMock(choices=[MagicMock(message=MagicMock(content='{\"key\": \"value\"}'))])\n        )\n        result = await client.chat_parsed(\"sys\", \"user\")\n        assert result == {\"key\": \"value\"}\n\n    async def test_returns_raw_on_json_parse_error(self, client):\n        client._client.chat.completions.create = AsyncMock(\n            return_value=MagicMock(choices=[MagicMock(message=MagicMock(content=\"not json\"))])\n        )\n        result = await client.chat_parsed(\"sys\", \"user\")\n        assert \"_raw\" in result\n        assert \"_parse_error\" in result\n\n    async def test_empty_content_returns_error_dict(self, client):\n        client._client.chat.completions.create = AsyncMock(\n            return_value=MagicMock(choices=[MagicMock(message=MagicMock(content=\"\"))])\n        )\n        result = await client.chat_parsed(\"sys\", \"user\")\n        assert \"_parse_error\" in result\n```\n\n---\n\n## Gap 8 — `SageExtractor` validation flags and cross-sentence rules\n\n**Untested:** `UNANCHORED_OBLIGATION` flag, `DISCRETIONARY_RIGHT` flag, `POTENTIAL_CONFLICT` cross-sentence rule, non-deontic sentences (skipped), `_apply_cross_sentence_rules` dedup.\n\n```python\n# tests/test_parsing/test_sage_extractor_flags.py\nimport pytest\nfrom src.parsing.kiss_parser import KISSParser\nfrom src.parsing.sage_extractor import SageExtractor\n\n\n@pytest.fixture\ndef extractor():\n    return SageExtractor(parser=KISSParser())\n\n\ndef _parse_and_extract(extractor, text):\n    parser = extractor._parser\n    doc = parser.parse_document(text, \"https://example.invalid/\", \"Test\", \"staffing\")\n    return extractor.extract_triples(doc, \"doc-test\")\n\n\nclass TestValidationFlags:\n    def test_unanchored_obligation_when_subject_not_gc_actor(self, extractor):\n        triples = _parse_and_extract(\n            extractor,\n            \"The contractor must submit the form to the department.\",\n        )\n        # \"contractor\" is not in _GC_ACTORS → UNANCHORED_OBLIGATION expected\n        deontic_triples = [t for t in triples if t.is_deontic]\n        if deontic_triples:\n            assert \"UNANCHORED_OBLIGATION\" in deontic_triples[0].validation_flags\n\n    def test_no_unanchored_obligation_for_known_gc_actor(self, extractor):\n        triples = _parse_and_extract(\n            extractor,\n            \"The employee must complete the training course.\",\n        )\n        deontic_triples = [t for t in triples if t.is_deontic]\n        for triple in deontic_triples:\n            assert \"UNANCHORED_OBLIGATION\" not in triple.validation_flags\n\n    def test_potential_conflict_added_for_same_subject_predicate_different_object(self, extractor):\n        text = (\n            \"The employee must attend the orientation. \"\n            \"The employee must complete the form.\"\n        )\n        triples = _parse_and_extract(extractor, text)\n        flags_all = [f for t in triples for f in t.validation_flags]\n        assert \"POTENTIAL_CONFLICT\" in flags_all\n\n\nclass TestNonDeonticSentences:\n    def test_sentence_with_fewer_than_2_entities_produces_no_triple(self, extractor):\n        # A sentence with only one entity or no verb should not produce a triple\n        triples = _parse_and_extract(extractor, \"Policy applies.\")\n        # Verify no crash, result may be empty list or non-empty but shouldn't error\n        assert isinstance(triples, list)\n```\n\n---\n\n## Gap 9 — `GraphQueryEngine` scoring and conflict detection\n\n**Untested:** `_score` weights (subject match +2, object match +1, verb match +1, corroboration +1), `find_conflicts` pairing logic, `get_entity_neighborhood`, `query_triples_by_url`.\n\n```python\n# tests/test_parsing/test_graph_query_scoring.py\nimport pytest\nfrom src.models.schemas import PolicyTriple\nfrom src.parsing.graph_query import GraphQueryEngine\n\n\ndef _triple(triple_id, subject, predicate_lemma, object_, flags=None):\n    return PolicyTriple(\n        triple_id=triple_id, doc_id=\"doc\", source_url=\"https://example.invalid/\",\n        instrument_title=\"Test\", agent_id=\"staffing\", section_heading=None,\n        sentence_text=f\"{subject} {predicate_lemma} {object_}.\",\n        subject=subject, predicate=predicate_lemma, predicate_lemma=predicate_lemma,\n        is_deontic=True, deontic_type=\"obligation\",\n        object_=object_, modifier=None, validation_flags=flags or [],\n    )\n\n\nclass TestScoring:\n    def test_subject_match_scores_2(self):\n        engine = GraphQueryEngine.__new__(GraphQueryEngine)\n        triple = _triple(\"t1\", \"employee\", \"must\", \"form\")\n        score = engine._score(triple, [\"employee\"], [])\n        assert score == 2\n\n    def test_object_match_scores_1(self):\n        engine = GraphQueryEngine.__new__(GraphQueryEngine)\n        triple = _triple(\"t1\", \"manager\", \"approve\", \"indeterminate\")\n        score = engine._score(triple, [\"indeterminate\"], [])\n        assert score == 1\n\n    def test_verb_match_scores_1(self):\n        engine = GraphQueryEngine.__new__(GraphQueryEngine)\n        triple = _triple(\"t1\", \"manager\", \"must\", \"attend\")\n        score = engine._score(triple, [], [\"must\"])\n        assert score == 1\n\n    def test_corroboration_flag_scores_bonus(self):\n        engine = GraphQueryEngine.__new__(GraphQueryEngine)\n        triple = _triple(\"t1\", \"manager\", \"must\", \"attend\", flags=[\"CROSS_INSTRUMENT_CORROBORATION\"])\n        score = engine._score(triple, [], [])\n        assert score == 1  # corroboration alone\n\n    def test_zero_score_when_no_match(self):\n        engine = GraphQueryEngine.__new__(GraphQueryEngine)\n        triple = _triple(\"t1\", \"manager\", \"approve\", \"form\")\n        score = engine._score(triple, [\"unrelated\"], [\"different\"])\n        assert score == 0\n\n\n@pytest.mark.asyncio\nclass TestFindConflicts:\n    async def test_find_conflicts_returns_pair_with_different_objects(self, tmp_path):\n        from src.data.db import DatabaseManager\n        from src.models.schemas import KISSDocument\n        db = DatabaseManager(tmp_path / \"test.db\")\n        await db.initialize()\n        await db.save_kiss_document(\"doc\", KISSDocument(\n            source_url=\"https://example.invalid/\", instrument_title=\"T\",\n            agent_id=\"staffing\", tokens=[], sentence_count=1, token_count=0,\n            parsed_at=\"2026-05-06\", model_version=\"test\",\n        ))\n        await db.save_policy_triples([\n            _triple(\"t1\", \"employee\", \"must\", \"form-A\"),\n            _triple(\"t2\", \"employee\", \"must\", \"form-B\"),\n        ])\n        engine = GraphQueryEngine(db)\n        conflicts = await engine.find_conflicts(\"employee\", \"must\")\n        assert len(conflicts) == 1\n        left, right = conflicts[0]\n        assert left.object_ != right.object_\n\n    async def test_no_conflicts_when_objects_are_same(self, tmp_path):\n        from src.data.db import DatabaseManager\n        from src.models.schemas import KISSDocument\n        db = DatabaseManager(tmp_path / \"test.db\")\n        await db.initialize()\n        await db.save_kiss_document(\"doc\", KISSDocument(\n            source_url=\"https://example.invalid/\", instrument_title=\"T\",\n            agent_id=\"staffing\", tokens=[], sentence_count=1, token_count=0,\n            parsed_at=\"2026-05-06\", model_version=\"test\",\n        ))\n        await db.save_policy_triples([\n            _triple(\"t1\", \"employee\", \"must\", \"form\"),\n            _triple(\"t2\", \"employee\", \"must\", \"form\"),\n        ])\n        engine = GraphQueryEngine(db)\n        conflicts = await engine.find_conflicts(\"employee\", \"must\")\n        assert conflicts == []\n```\n\n---\n\n## Gap 10 — Integration gaps (no end-to-end API tests)\n\n**Untested:** FastAPI route responses, 404 on unknown query_id, `GET /api/agents`, feedback endpoint lifecycle, WebSocket message flow.\n\n```python\n# tests/test_api/test_routes.py\nimport uuid\nimport pytest\nfrom fastapi.testclient import TestClient\nfrom unittest.mock import patch, AsyncMock\n\n\n@pytest.fixture\ndef client(tmp_path):\n    # Override DB path so tests use isolated DB\n    with patch(\"src.data.db._DB_PATH\", tmp_path / \"test.db\"):\n        from src.main import app\n        with TestClient(app) as c:\n            yield c\n\n\nclass TestAgentsEndpoint:\n    def test_returns_8_agents(self, client):\n        response = client.get(\"/api/agents\")\n        assert response.status_code == 200\n        agents = response.json()\n        assert len(agents) == 8\n        agent_ids = [a[\"agent_id\"] for a in agents]\n        assert \"staffing\" in agent_ids\n        assert \"governance\" in agent_ids\n\n\nclass TestQueriesEndpoint:\n    def test_list_queries_returns_empty_initially(self, client):\n        response = client.get(\"/api/queries\")\n        assert response.status_code == 200\n        assert response.json() == []\n\n    def test_get_unknown_query_returns_404(self, client):\n        response = client.get(f\"/api/queries/{uuid.uuid4()}\")\n        assert response.status_code == 404\n\n    def test_limit_param_validated(self, client):\n        response = client.get(\"/api/queries?limit=0\")\n        assert response.status_code == 422  # FastAPI validation error\n\n\nclass TestFeedbackEndpoint:\n    def test_submit_feedback_returns_ok(self, client):\n        # Must have a query saved first (foreign key)\n        # For simplicity, mock or disable FK enforcement in SQLite\n        import json\n        payload = {\n            \"feedback_id\": str(uuid.uuid4()),\n            \"query_id\": str(uuid.uuid4()),\n            \"rating\": \"accurate\",\n            \"comment\": \"Great answer\",\n            \"timestamp\": \"2026-05-06T12:00:00\",\n        }\n        # SQLite FK enforcement is off by default — this should succeed\n        response = client.post(\"/api/feedback\", content=json.dumps(payload),\n                               headers={\"Content-Type\": \"application/json\"})\n        assert response.status_code == 200\n        assert response.json()[\"status\"] == \"ok\"\n```\n\n---\n\n## Gap 11 — `KISSParser` missing edge cases\n\n**Untested:** empty string input, text with no deontic verbs, multi-sentence text (multiple `sentence_idx` values), GC entity lookup for unknown terms.\n\n```python\n# Additions to tests/test_parsing/test_kiss_parser.py\n\ndef test_kiss_parser_empty_text_returns_zero_tokens():\n    parser = KISSParser()\n    doc = parser.parse_document(\"\", \"https://example.invalid/\", \"Empty\", \"staffing\")\n    assert doc.token_count == 0\n    assert doc.tokens == []\n\n\ndef test_kiss_parser_no_deontic_verbs_in_plain_sentence():\n    parser = KISSParser()\n    doc = parser.parse_document(\n        \"The policy covers employees in the NCR.\",\n        \"https://example.invalid/\",\n        \"Test Policy\",\n        \"staffing\",\n    )\n    deontic = [t for t in doc.tokens if t.is_deontic]\n    assert deontic == []\n\n\ndef test_kiss_parser_multi_sentence_assigns_correct_sentence_idx():\n    parser = KISSParser()\n    doc = parser.parse_document(\n        \"The manager must approve. The employee may request leave.\",\n        \"https://example.invalid/\",\n        \"Test Policy\",\n        \"staffing\",\n    )\n    idxs = {t.sentence_idx for t in doc.tokens}\n    assert len(idxs) == 2\n```\n\n---\n\n## Gap 12 — `QueryKISSParser` edge cases\n\n**Untested:** empty query triggering fallback, very short query below `query_entity_threshold`, `deontic_verbs` field population.\n\n```python\n# Additions to tests/test_parsing/test_query_kiss_parser.py\n\ndef test_query_kiss_parser_empty_query_triggers_fallback():\n    parser = QueryKISSParser()\n    result = parser.parse(\"\")\n    assert result.fallback_triggered is True\n\n\ndef test_query_kiss_parser_populates_deontic_verbs():\n    parser = QueryKISSParser()\n    result = parser.parse(\"An employee must file a grievance. Can a manager refuse?\")\n    assert len(result.deontic_verbs) > 0\n\n\ndef test_query_kiss_parser_deduplicates_entities():\n    parser = QueryKISSParser()\n    result = parser.parse(\"The employee was told the employee must attend.\")\n    assert result.entities.count(\"employee\") == 1\n```\n\n---\n\n## Priority order for implementation\n\n| Priority | Test file | Reason |\n|----------|-----------|--------|\n| 1 | `test_agents/test_orchestrator.py` | Zero coverage; orchestrator is the core synthesis path |\n| 2 | `test_agents/test_specialist.py` | Zero coverage; `_parse_response` fallback is a runtime risk |\n| 3 | `test_data/test_db.py` | 95% of DB methods uncovered; used by all other components |\n| 4 | `test_fetch/test_cache.py` | Zero coverage; stale fallback logic is critical for resilience |\n| 5 | `test_fetch/test_engine.py` | `_normalize_url`, cache-hit and browser-fallback paths |\n| 6 | `test_parsing/test_sage_extractor_flags.py` | Validation flag logic is the deterministic-grounding value prop |\n| 7 | `test_parsing/test_graph_query_scoring.py` | `_score` weights and conflict detection untested |\n| 8 | `test_fetch/test_extractors.py` | Domain-specific selector and truncation edge cases |\n| 9 | `test_api/test_routes.py` | 404, validation, feedback lifecycle |\n| 10 | `test_llm/test_client.py` | `chat_parsed` error-handling path |\n",
