mock_model\n\n        client = GeminiClient()\n        result = await client.chat(\"sys\", \"user msg\")\n        assert result == \"Policy answer.\"\n\n    @pytest.mark.asyncio\n    async def test_chat_parsed_returns_dict(self, mock_genai):\n        from src.llm.client import GeminiClient\n        mock_response = MagicMock()\n        mock_response.text = '{\"key\": \"value\"}'\n        mock_model = AsyncMock()\n        mock_model.generate_content_async = AsyncMock(return_value=mock_response)\n        mock_genai.GenerativeModel.return_value = mock_model\n\n        client = GeminiClient()\n        result = await client.chat_parsed(\"sys\", \"user msg\")\n        assert result == {\"key\": \"value\"}\n\n    @pytest.mark.asyncio\n    async def test_chat_parsed_handles_invalid_json(self, mock_genai):\n        from src.llm.client import GeminiClient\n        mock_response = MagicMock()\n        mock_response.text = \"not json at all\"\n        mock_model = AsyncMock()\n        mock_model.generate_content_async = AsyncMock(return_value=mock_response)\n        mock_genai.GenerativeModel.return_value = mock_model\n\n        client = GeminiClient()\n        result = await client.chat_parsed(\"sys\", \"user msg\")\n        assert \"_parse_error\" in result\n\n\nclass TestGeminiRateLimit:\n    @pytest.mark.asyncio\n    async def test_retries_on_rate_limit_then_succeeds(self, mock_genai):\n        from google.api_core.exceptions import ResourceExhausted\n        from src.llm.client import GeminiClient\n\n        mock_response = MagicMock()\n        mock_response.text = \"ok\"\n        mock_model = AsyncMock()\n        mock_model.generate_content_async = AsyncMock(\n            side_effect=[ResourceExhausted(\"rate\"), mock_response]\n        )\n        mock_genai.GenerativeModel.return_value = mock_model\n\n        client = GeminiClient()\n        with patch(\"asyncio.sleep\", new_callable=AsyncMock):\n            result = await client._generate(mock_model, [])\n        assert result == \"ok\"\n\n    @pytest.mark.asyncio\n    async def test_raises_after_max_retries_exhausted(self, mock_genai):\n        from google.api_core.exceptions import ResourceExhausted\n        from src.llm.client import GeminiClient\n\n        mock_model = AsyncMock()\n        mock_model.generate_content_async = AsyncMock(\n            side_effect=ResourceExhausted(\"rate\")\n        )\n        mock_genai.GenerativeModel.return_value = mock_model\n\n        client = GeminiClient()\n        with patch(\"asyncio.sleep\", new_callable=AsyncMock):\n            with pytest.raises(ResourceExhausted):\n                await client._generate(mock_model, [], max_retries=3)"
