        "title": "tests/test_websocket_manager.py",
        "content": "\"\"\"Unit tests for WebSocketManager.\"\"\"\n\nimport pytest\nfrom unittest.mock import AsyncMock, MagicMock\n\nfrom src.api.websocket import WebSocketManager\n\n\n@pytest.fixture\ndef manager():\n    return WebSocketManager()\n\n\nclass TestConnect:\n    @pytest.mark.asyncio\n    async def test_stores_connection(self, manager):\n        ws = AsyncMock()\n        await manager.connect(\"q1\", ws)\n        assert \"q1\" in manager._connections\n        ws.accept.assert_called_once()\n\n\nclass TestDisconnect:\n    @pytest.mark.asyncio\n    async def test_removes_connection(self, manager):\n        ws = AsyncMock()\n        await manager.connect(\"q1\", ws)\n        await manager.disconnect(\"q1\")\n        assert \"q1\" not in manager._connections\n\n    @pytest.mark.asyncio\n    async def test_disconnect_missing_id_is_noop(self, manager):\n        await manager.disconnect(\"nonexistent\")  # Should not raise\n\n\nclass TestSend:\n    @pytest.mark.asyncio\n    async def test_send_to_connected_returns_true(self, manager):\n        ws = AsyncMock()\n        await manager.connect(\"q1\", ws)\n        result = await manager.send(\"q1\", {\"type\": \"test\"})\n        assert result is True\n        ws.send_json.assert_called_once_with({\"type\": \"test\"})\n\n    @pytest.mark.asyncio\n    async def test_send_to_missing_returns_false(self, manager):\n        result = await manager.send(\"unknown\", {\"type\": \"test\"})\n        assert result is False\n\n    @pytest.mark.asyncio\n    async def test_send_failure_disconnects_and_returns_false(self, manager):\n        ws = AsyncMock()\n        ws.send_json.side_effect = Exception(\"connection closed\")\n        await manager.connect(\"q1\", ws)\n        result = await manager.send(\"q1\", {\"type\": \"test\"})\n        assert result is False\n        assert \"q1\" not in manager._connections\n\n\nclass TestBroadcastError:\n    @pytest.mark.asyncio\n    async def test_sends_to_all_connections(self, manager):\n        ws1, ws2 = AsyncMock(), AsyncMock()\n        await manager.connect(\"q1\", ws1)\n        await manager.connect(\"q2\", ws2)\n        await manager.broadcast_error(\"Something went wrong\")\n        ws1.send_json.assert_called_once()\n        ws2.send_json.assert_called_once()\n\n    @pytest.mark.asyncio\n    async def test_failed_send_disconnects_client(self, manager):\n        ws = AsyncMock()\n        ws.send_json.side_effect = Exception(\"broken pipe\")\n        await manager.connect(\"q1\", ws)\n        await manager.broadcast_error(\"error\")\n        assert \"q1\" not in manager._connections\n```\n\n---\n\n",
