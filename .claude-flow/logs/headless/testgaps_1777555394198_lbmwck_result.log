port pytest\nfrom unittest.mock import AsyncMock, MagicMock, patch\nfrom src.llm.client import GeminiClient\n\n\n@pytest.fixture\ndef client():\n    with patch(\"src.llm.client.genai\"):\n        return GeminiClient(api_key=\"test-key\")\n\n\n@pytest.mark.asyncio\nasync def test_chat_returns_text(client):\n    client._model = MagicMock()\n    client._model.generate_content_async = AsyncMock(\n        return_value=MagicMock(text=\"Hello response\")\n    )\n    result = await client.chat([{\"role\": \"user\", \"content\": \"Hi\"}])\n    assert result == \"Hello response\"\n\n\n@pytest.mark.asyncio\nasync def test_chat_parsed_valid_json(client):\n    client._model = MagicMock()\n    client._model.generate_content_async = AsyncMock(\n        return_value=MagicMock(text='{\"answer\": \"yes\", \"citations\": []}')\n    )\n    result = await client.chat_parsed([{\"role\": \"user\", \"content\": \"Q\"}])\n    assert result == {\"answer\": \"yes\", \"citations\": []}\n\n\n@pytest.mark.asyncio\nasync def test_chat_parsed_malformed_json_returns_raw(client):\n    \"\"\"LLM sometimes returns prose instead of JSON — must not crash.\"\"\"\n    client._model = MagicMock()\n    client._model.generate_content_async = AsyncMock(\n        return_value=MagicMock(text=\"Sorry, I cannot answer that.\")\n    )\n    result = await client.chat_parsed([{\"role\": \"user\", \"content\": \"Q\"}])\n    # Should return the raw text or a fallback dict, not raise\n    assert result is not None\n\n\n@pytest.mark.asyncio\nasync def test_chat_parsed_truncated_json(client):\n    \"\"\"Truncated JSON from token limit — partial object.\"\"\"\n    client._model = MagicMock()\n    client._model.generate_content_async = AsyncMock(\n        return_value=MagicMock(text='{\"answer\": \"yes\", \"citation')\n    )\n    result = await client.chat_parsed([{\"role\": \"user\", \"content\": \"Q\"}])\n    assert result is not None  # Must not raise\n\n\n@pytest.mark.asyncio\nasync def test_chat_api_error_raises(client):\n    client._model = MagicMock()\n    client._model.generate_content_async = AsyncMock(side_effect=Exception(\"API error\"))\n    with pytest.raises(Exception):\n        await client.chat([{\"role\": \"user\", \"content\": \"Q\"}])\n\n\n@pytest.mark.asyncio\nasync def test_stream_chat_yields_chunks(client):\n    async def fake_stream():\n        for chunk in [\"Hello\", \" world\", \"!\"]:\n            yield MagicMock(text=chunk)\n\n    client._model = MagicMock()\n    client._model.generate_content_async = AsyncMock(return_value=fake_stream())\n    chunks = [c async for c in client.stream_chat([{\"role\": \"user\", \"content\": \"Q\"}])]\n    assert \"\".join(chunks) == \"Hello world!\"\n```\n\n---\n\n#### 2. Fetch Engine — concurrency & error handling\n\n```python\n# tests/test_fetch_engine.py\nimport asyncio\nimport pytest\nfrom unittest.mock import AsyncMock, patch, MagicMock\nfrom src.fetch.engine import FetchEngine\n\n\n@pytest.fixture\nasync def engine():\n    e = FetchEngine()\n    yield e\n    await e.close()\n\n\n@pytest.mark.asyncio\nasync def test_fetch_single_success(engine):\n    with patch.object(engine, \"_do_fetch\", AsyncMock(return_value=\"<html>content</html>\")):\n        result = await engine.fetch(\"https://laws-lois.justice.gc.ca/eng/acts/P-33.3/\")\n        assert \"content\" in result\n\n\n@pytest.mark.asyncio\nasync def test_fetch_returns_stale_on_timeout(engine):\n    \"\"\"On timeout, must return stale cache rather than raising.\"\"\"\n    with patch.object(engine, \"_do_fetch\", AsyncMock(side_effect=asyncio.TimeoutError())):\n        with patch.object(engine._cache, \"get_stale\", AsyncMock(return_value=\"stale content\")):\n            result = await engine.fetch(\"https://example.com\")\n            assert result == \"stale content\"\n\n\n@pytest.mark.asyncio\nasync def test_fetch_returns_none_when_no_cache_on_error(engine):\n    with patch.object(engine, \"_do_fetch\", AsyncMock(side_effect=Exception(\"Network error\"))):\n        with patch.object(engine._cache, \"get_stale\", AsyncMock(return_value=None)):\n            result = await engine.fetch(\"https://example.com\")\n            assert result is None\n\n\n@pytest.mark.asyncio\nasync def test_fetch_batch_partial_failure(engine):\n    \"\"\"If 1 of 3 URLs fails, the other 2 results should still be returned.\"\"\"\n    urls = [\"https://a.com\", \"https://b.com\", \"https://c.com\"]\n    responses = {\"https://a.com\": \"content A\", \"https://b.com\": None, \"https://c.com\": \"content C\"}\n\n    async def fake_fetch(url, **kw):\n        return responses.get(url)\n\n    with patch.object(engine, \"fetch\", side_effect=fake_fetch):\n        results = await engine.fetch_batch(urls)\n        assert results[\"https://a.com\"] == \"content A\"\n        assert results[\"https://b.com\"] is None\n        assert results[\"https://c.com\"] == \"content C\"\n\n\n@pytest.mark.asyncio\nasync def test_domain_concurrency_limit(engine):\n    \"\"\"Per-domain semaphore must prevent more than 3 concurrent fetches.\"\"\"\n    call_times = []\n\n    async def fake_do_fetch(url, **kw):\n        call_times.append(asyncio.get_event_loop().time())\n        await asyncio.sleep(0.1)\n        return \"<html/>\"\n\n    with patch.object(engine, \"_do_fetch\", side_effect=fake_do_fetch):\n        urls = [f\"https://laws-lois.justice.gc.ca/page{i}\" for i in range(6)]\n        await engine.fetch_batch(urls)\n        # Assert batching happened (not all started within first 10ms)\n        assert len(call_times) == 6\n\n\n@pytest.mark.asyncio\nasync def test_url_normalization_laws_lois(engine):\n    \"\"\"laws-lois.justice.gc.ca URLs should use browser fetcher.\"\"\"\n    with patch.object(engine, \"_browser_fetch\", AsyncMock(return_value=\"<html/>\")) as mock_browser:\n        await engine.fetch(\"https://laws-lois.justice.gc.ca/eng/acts/P-33.3/\")\n        mock_browser.assert_called_once()\n```\n\n---\n\n#### 3. Fetch Cache — TTL & stale fallback\n\n```python\n# tests/test_fetch_cache.py\nimport pytest\nimport asyncio\nfrom datetime import datetime, timedelta, timezone\nfrom unittest.mock import AsyncMock, patch\nfrom src.fetch.cache import FetchCache, CacheEntry\n\n\ndef test_cache_entry_valid_within_ttl():\n    entry = CacheEntry(\n        url=\"https://example.com\",\n        content=\"data\",\n        fetched_at=datetime.now(tz=timezone.utc),\n        ttl_seconds=3600,\n    )\n    assert entry.is_valid() is True\n\n\ndef test_cache_entry_expired_outside_ttl():\n    entry = CacheEntry(\n        url=\"https://example.com\",\n        content=\"data\",\n        fetched_at=datetime.now(tz=timezone.utc) - timedelta(seconds=7200),\n        ttl_seconds=3600,\n    )\n    assert entry.is_valid() is False\n\n\ndef test_cache_entry_just_expired():\n    entry = CacheEntry(\n        url=\"https://example.com\",\n        content=\"data\",\n        fetched_at=datetime.now(tz=timezone.utc) - timedelta(seconds=3601),\n        ttl_seconds=3600,\n    )\n    assert entry.is_valid() is False\n\n\n@pytest.mark.asyncio\nasync def test_get_returns_none_for_expired(tmp_path):\n    cache = FetchCache(db_path=str(tmp_path / \"cache.db\"))\n    await cache.initialize()\n    await cache.store(\"https://example.com\", \"content\", ttl_seconds=1)\n    await asyncio.sleep(1.1)\n    result = await cache.get(\"https://example.com\")\n    assert result is None\n\n\n@pytest.mark.asyncio\nasync def test_get_stale_returns_expired_content(tmp_path):\n    cache = FetchCache(db_path=str(tmp_path / \"cache.db\"))\n    await cache.initialize()\n    await cache.store(\"https://example.com\", \"stale content\", ttl_seconds=1)\n    await asyncio.sleep(1.1)\n    result = await cache.get_stale(\"https://example.com\")\n    assert result == \"stale content\"\n\n\n@pytest.mark.asyncio\nasync def test_ttl_by_domain():\n    \"\"\"laws-lois.justice.gc.ca should get a longer TTL than default.\"\"\"\n    cache = FetchCache(db_path=\":memory:\")\n    laws_ttl = cache._get_default_ttl(\"https://laws-lois.justice.gc.ca/act\")\n    other_ttl = cache._get_default_ttl(\"https://example.com\")\n    assert laws_ttl >= other_ttl  # Legal texts change rarely\n\n\n@pytest.mark.asyncio\nasync def test_clear_expired_removes_old_entries(tmp_path):\n    cache = FetchCache(db_path=str(tmp_path / \"cache.db\"))\n    await cache.initialize()\n    await cache.store(\"https://a.com\", \"a\", ttl_seconds=1)\n    await cache.store(\"https://b.com\", \"b\", ttl_seconds=9999)\n    await asyncio.sleep(1.1)\n    await cache.clear_expired()\n    assert await cache.get_stale(\"https://a.com\") is None\n    assert await cache.get(\"https://b.com\") == \"b\"\n```\n\n---\n\n#### 4. Specialist Agent — core pipeline\n\n```python\n# tests/test_specialist_agent.py\nimport pytest\nfrom unittest.mock import AsyncMock, MagicMock, patch\nfrom src.agents.specialist import SpecialistAgent\n\n\nMOCK_REGISTRY = {\n    \"staffing\": {\n        \"display_name\": \"Staffing\",\n        \"domain_description\": \"Staffing policy\",\n        \"instruments\": [\n            {\"title\": \"PSEA\", \"url\": \"https://laws-lois.justice.gc.ca/eng/acts/P-33.3/\", \"type\": \"act\"}\n        ],\n    }\n}\n\n\n@pytest.fixture\ndef agent():\n    with patch(\"src.agents.specialist.load_policy_registry\", return_value=MOCK_REGISTRY):\n        return SpecialistAgent(agent_id=\"staffing\", config=MagicMock())\n\n\n@pytest.mark.asyncio\nasync def test_process_returns_structured_response(agent):\n    mock_response = {\n        \"answer\": \"The PSEA governs staffing.\",\n        \"citations\": [{\"title\": \"PSEA\", \"section\": \"s.3\"}],\n        \"confidence\": 0.9,\n        \"caveats\": [],\n    }\n    agent._llm = MagicMock()\n    agent._llm.chat_parsed = AsyncMock(return_value=mock_response)\n    result = await agent.process(\"What governs staffing?\")\n    assert result.answer == \"The PSEA governs staffing.\"\n    assert len(result.citations) == 1\n\n\n@pytest.mark.asyncio\nasync def test_process_with_fetch_injects_policy_context(agent):\n    fetch_engine = MagicMock()\n    fetch_engine.fetch_batch = AsyncMock(\n        return_value={\"https://laws-lois.justice.gc.ca/eng/acts/P-33.3/\": \"<html>PSEA content</html>\"}\n    )\n    agent._llm = MagicMock()\n    agent._llm.chat_parsed = AsyncMock(return_value={\"answer\": \"...\", \"citations\": [], \"confidence\": 0.8, \"caveats\": []})\n    result = await agent.process_with_fetch(\"What governs staffing?\", fetch_engine=fetch_engine)\n    # Confirm fetch was called with instrument URLs\n    fetch_engine.fetch_batch.assert_called_once()\n    called_urls = list(fetch_engine.fetch_batch.call_args[0][0])\n    assert \"https://laws-lois.justice.gc.ca/eng/acts/P-33.3/\" in called_urls\n\n\n@pytest.mark.asyncio\nasync def test_process_handles_llm_json_failure(agent):\n    \"\"\"If LLM returns non-JSON, agent should return a safe fallback, not crash.\"\"\"\n    agent._llm = MagicMock()\n    agent._llm.chat_parsed = AsyncMock(return_value=\"Sorry, I cannot answer.\")\n    result = await agent.process(\"What governs staffing?\")\n    assert result is not None\n    assert hasattr(result, \"answer\")\n\n\n@pytest.mark.asyncio\nasync def test_process_with_all_fetches_failing(agent):\n    fetch_engine = MagicMock()\n    fetch_engine.fetch_batch = AsyncMock(\n        return_value={\"https://laws-lois.justice.gc.ca/eng/acts/P-33.3/\": None}\n    )\n    agent._llm = MagicMock()\n    agent._llm.chat_parsed = AsyncMock(\n        return_value={\"answer\": \"No context available.\", \"citations\": [], \"confidence\": 0.1, \"caveats\": [\"Instruments unavailable.\"]}\n    )\n    result = await agent.process_with_fetch(\"What governs staffing?\", fetch_engine=fetch_engine)\n    assert result is not None\n\n\ndef test_load_instruments_missing_registry():\n    with patch(\"src.agents.specialist.load_policy_registry\", side_effect=FileNotFoundError(\"Not found\")):\n        with pytest.raises(FileNotFoundError):\n            SpecialistAgent(agent_id=\"staffing\", config=MagicMock())\n```\n\n---\n\n#### 5. Orchestrator Agent — routing & synthesis\n\n```python\n# tests/test_orchestrator_agent.py\nimport pytest\nfrom unittest.mock import AsyncMock, MagicMock, patch\nfrom src.agents.orchestrator import OrchestratorAgent\nfrom src.models.schemas import SpecialistResponse\n\n\ndef make_specialist_response(agent_id, answer, citations=None):\n    return SpecialistResponse(\n        agent_id=agent_id,\n        answer=answer,\n        citations=citations or [],\n        confidence=0.8,\n        caveats=[],\n    )\n\n\n@pytest.fixture\ndef orchestrator():\n    with patch(\"src.agents.orchestrator.get_specialists\", return_value={}):\n        return OrchestratorAgent(config=MagicMock())\n\n\n@pytest.mark.asyncio\nasync def test_route_selects_relevant_agents(orchestrator):\n    orchestrator._llm = MagicMock()\n    orchestrator._llm.chat_parsed = AsyncMock(\n        return_value={\"agents\": [\"staffing\", \"classification\"], \"rationale\": \"query involves both\"}\n    )\n    agents = await orchestrator._route(\"What is the classification process for a PM-04?\")\n    assert \"staffing\" in agents\n    assert \"classification\" in agents\n\n\n@pytest.mark.asyncio\nasync def test_aggregate_citations_deduplicates(orchestrator):\n    citations = [\n        {\"title\": \"PSEA\", \"url\": \"https://laws-lois.justice.gc.ca/eng/acts/P-33.3/\", \"section\": \"s.3\"},\n        {\"title\": \"PSEA\", \"url\": \"https://laws-lois.justice.gc.ca/eng/acts/P-33.3/\", \"section\": \"s.3\"},\n        {\"title\": \"FAA\", \"url\": \"https://laws-lois.justice.gc.ca/eng/acts/F-11/\", \"section\": \"s.12\"},\n    ]\n    deduped = orchestrator._aggregate_citations(citations)\n    assert len(deduped) == 2\n\n\n@pytest.mark.asyncio\nasync def test_process_synthesizes_specialist_responses(orchestrator):\n    responses = [\n        make_specialist_response(\"staffing\", \"Staffing governed by PSEA\"),\n        make_specialist_response(\"classification\", \"Classification by TB directive\"),\n    ]\n    orchestrator._llm = MagicMock()\n    orchestrator._llm.chat_parsed = AsyncMock(\n        return_value={\"synthesis\": \"Combined answer.\", \"citations\": [], \"confidence\": 0.85, \"conflicts\": []}\n    )\n    result = await orchestrator.process(\"What is PM-04 classification?\", specialist_responses=responses)\n    assert result is not None\n    assert result.synthesis\n\n\n@pytest.mark.asyncio\nasync def test_process_handles_no_specialists(orchestrator):\n    \"\"\"When no specialists are routed, should return a graceful response.\"\"\"\n    orchestrator._llm = MagicMock()\n    orchestrator._llm.chat_parsed = AsyncMock(return_value={\"agents\": []})\n    result = await orchestrator.process(\"Random out-of-scope question\")\n    assert result is not None\n\n\n@pytest.mark.asyncio\nasync def test_process_handles_conflicting_findings(orchestrator):\n    responses = [\n        make_specialist_response(\"labour\", \"Employee may grieve under FPSLRA s.209\"),\n        make_specialist_response(\"staffing\", \"Staffing decisions are not grievable under PSEA\"),\n    ]\n    orchestrator._llm = MagicMock()\n    orchestrator._llm.chat_parsed = AsyncMock(\n        return_value={\n            \"synthesis\": \"There is a conflict...\",\n            \"citations\": [],\n            \"confidence\": 0.6,\n            \"conflicts\": [\"FPSLRA vs PSEA\"],\n        }\n    )\n    result = await orchestrator.process(\"Is a staffing decision grievable?\", specialist_responses=responses)\n    assert result.conflicts  # Conflicts must be surfaced, not silenced\n```\n\n---\n\n#### 6. Database — full CRUD & error handling\n\n```python\n# tests/test_database.py\nimport pytest\nimport asyncio\nfrom src.data.db import DatabaseManager\n\n\n@pytest.fixture\nasync def db(tmp_path):\n    manager = DatabaseManager(db_path=str(tmp_path / \"test.db\"))\n    await manager.initialize()\n    yield manager\n    await manager.close()\n\n\n@pytest.mark.asyncio\nasync def test_save_and_get_agent_response(db):\n    query_id = \"q-001\"\n    await db.save_query({\"id\": query_id, \"text\": \"Test query\"})\n    await db.save_agent_response(query_id=query_id, agent_id=\"staffing\", response={\"answer\": \"ok\"})\n    responses = await db.get_agent_responses(query_id)\n    assert len(responses) == 1\n    assert responses[0][\"agent_id\"] == \"staffing\"\n\n\n@pytest.mark.asyncio\nasync def test_save_orchestrator_response(db):\n    query_id = \"q-002\"\n    await db.save_query({\"id\": query_id, \"text\": \"Orchestrator test\"})\n    await db.save_orchestrator_response(query_id=query_id, response={\"synthesis\": \"answer\"})\n    result = await db.get_orchestrator_response(query_id)\n    assert result[\"synthesis\"] == \"answer\"\n\n\n@pytest.mark.asyncio\nasync def test_save_and_get_feedback(db):\n    query_id = \"q-003\"\n    await db.save_query({\"id\": query_id, \"text\": \"Feedback test\"})\n    await db.save_feedback(query_id=query_id, rating=5, comment=\"Accurate!\")\n    feedback = await db.get_feedback_for_query(query_id)\n    assert feedback[\"rating\"] == 5\n    assert feedback[\"comment\"] == \"Accurate!\"\n\n\n@pytest.mark.asyncio\nasync def test_export_feedback_returns_all(db):\n    for i in range(3):\n        qid = f\"q-fb-{i}\"\n        await db.save_query({\"id\": qid, \"text\": f\"Query {i}\"})\n        await db.save_feedback(query_id=qid, rating=i + 3)\n    records = await db.export_feedback()\n    assert len(records) >= 3\n\n\n@pytest.mark.asyncio\nasync def test_cache_set_and_get(db):\n    await db.set_cached(url=\"https://example.com\", content=\"<html/>\", ttl_seconds=3600)\n    result = await db.get_cached(\"https://example.com\")\n    assert result == \"<html/>\"\n\n\n@pytest.mark.asyncio\nasync def test_cache_expired_returns_none(db):\n    await db.set_cached(url=\"https://example.com\", content=\"<html/>\", ttl_seconds=1)\n    await asyncio.sleep(1.1)\n    result = await db.get_cached(\"https://example.com\")\n    assert result is None\n\n\n@pytest.mark.asyncio\nasync def test_cache_get_stale_returns_expired(db):\n    await db.set_cached(url=\"https://example.com\", content=\"stale\", ttl_seconds=1)\n    await asyncio.sleep(1.1)\n    result = await db.get_stale(\"https://example.com\")\n    assert result == \"stale\"\n\n\n@pytest.mark.asyncio\nasync def test_duplicate_query_id_raises_or_updates(db):\n    \"\"\"Inserting same query_id twice should not silently corrupt data.\"\"\"\n    await db.save_query({\"id\": \"q-dup\", \"text\": \"Original\"})\n    try:\n        await db.save_query({\"id\": \"q-dup\", \"text\": \"Duplicate\"})\n    except Exception:\n        pass  # Either raises or upserts — verify data integrity\n    result = await db.get_query(\"q-dup\")\n    assert result is not None\n```\n\n---\n\n#### 7. API Routes — HTTP validation & error cases\n\n```python\n# tests/test_api_routes.py\nimport pytest\nfrom httpx import AsyncClient\nfrom unittest.mock import AsyncMock, patch, MagicMock\nfrom src.main import app\n\n\n@pytest.fixture\nasync def client():\n    async with AsyncClient(app=app, base_url=\"http://test\") as ac:\n        yield ac\n\n\n@pytest.mark.asyncio\nasync def test_health_check_returns_200(client):\n    response = await client.get(\"/health\")\n    assert response.status_code == 200\n    data = response.json()\n    assert \"status\" in data\n\n\n@pytest.mark.asyncio\nasync def test_list_agents_returns_all_eight(client):\n    response = await client.get(\"/api/agents\")\n    assert response.status_code == 200\n    agents = response.json()\n    assert len(agents) == 8  # staffing, classification, labour, learning, equity, ohs, languages, governance\n\n\n@pytest.mark.asyncio\nasync def test_get_query_not_found(client):\n    response = await client.get(\"/api/queries/nonexistent-id\")\n    assert response.status_code == 404\n\n\n@pytest.mark.asyncio\nasync def test_list_queries_invalid_limit(client):\n    response = await client.get(\"/api/queries?limit=0\")\n    assert response.status_code == 422  # Pydantic validation error\n\n\n@pytest.mark.asyncio\nasync def test_list_queries_limit_too_high(client):\n    response = await client.get(\"/api/queries?limit=101\")\n    assert response.status_code == 422\n\n\n@pytest.mark.asyncio\nasync def test_submit_feedback_missing_rating(client):\n    response = await client.post(\"/api/feedback\", json={\"query_id\": \"q-001\", \"comment\": \"Good\"})\n    assert response.status_code == 422\n\n\n@pytest.mark.asyncio\nasync def test_submit_feedback_invalid_rating_range(client):\n    response = await client.post(\"/api/feedback\", json={\"query_id\": \"q-001\", \"rating\": 10})\n    assert response.status_code == 422\n\n\n@pytest.mark.asyncio\nasync def test_export_feedback_empty(client):\n    response = await client.get(\"/api/feedback/export\")\n    assert response.status_code == 200\n    assert response.json() == []\n```\n\n---\n\n#### 8. WebSocket — disconnect & error propagation\n\n```python\n# tests/test_websocket.py\nimport pytest\nimport json\nfrom unittest.mock import AsyncMock, MagicMock, patch\nfrom fastapi.testclient import TestClient\nfrom src.main import app\n\n\ndef test_websocket_accepts_connection():\n    with TestClient(app) as client:\n        with client.websocket_connect(\"/ws\") as ws:\n            ws.send_json({\"query\": \"What is the PSEA?\"})\n            # Should receive at least a status update\n            msg = ws.receive_json(timeout=5)\n            assert \"type\" in msg\n\n\ndef test_websocket_rejects_empty_query():\n    with TestClient(app) as client:\n        with client.websocket_connect(\"/ws\") as ws:\n            ws.send_json({\"query\": \"\"})\n            msg = ws.receive_json(timeout=5)\n            assert msg.get(\"type\") == \"error\"\n\n\ndef test_websocket_handles_malformed_message():\n    with TestClient(app) as client:\n        with client.websocket_connect(\"/ws\") as ws:\n            ws.send_text(\"not valid json{{{{\")\n            msg = ws.receive_json(timeout=5)\n            assert msg.get(\"type\") == \"error\"\n\n\n@pytest.mark.asyncio\nasync def test_websocket_disconnect_mid_query():\n    \"\"\"Disconnecting during processing should not leave orphaned tasks.\"\"\"\n    with TestClient(app) as client:\n        with client.websocket_connect(\"/ws\") as ws:\n            ws.send_json({\"query\": \"Long running question?\"})\n            # Immediately close — no exception should propagate server-side\n        # Server should have cancelled the task cleanly\n```\n\n---\n\n#### 9. Configuration edge cases\n\n```python\n# tests/test_config.py\nimport pytest\nimport os\nimport tempfile\nimport yaml\nfrom pathlib import Path\nfrom src.config import load_config\n\n\ndef write_config(path, data):\n    with open(path, \"w\") as f:\n        yaml.dump(data, f)\n\n\ndef test_config_loads_valid_yaml(tmp_path):\n    cfg_path = tmp_path / \"config.yaml\"\n    write_config(cfg_path, {\"model\": {\"name\": \"gemini-1.5-pro\"}, \"server\": {\"host\": \"0.0.0.0\", \"port\": 8000}})\n    config = load_config(cfg_path)\n    assert config.model.name == \"gemini-1.5-pro\"\n\n\ndef test_config_missing_file_raises():\n    with pytest.raises(FileNotFoundError):\n        load_config(\"/nonexistent/path/config.yaml\")\n\n\ndef test_config_malformed_yaml_raises(tmp_path):\n    cfg_path = tmp_path / \"config.yaml\"\n    cfg_path.write_text(\"model: {name: [unclosed\")\n    with pytest.raises(Exception):  # yaml.YAMLError\n        load_config(cfg_path)\n\n\ndef test_config_env_override_port(tmp_path, monkeypatch):\n    \"\"\"PORT env var should override config.yaml server.port.\"\"\"\n    cfg_path = tmp_path / \"config.yaml\"\n    write_config(cfg_path, {\"server\": {\"host\": \"0.0.0.0\", \"port\": 8000}})\n    monkeypatch.setenv(\"PORT\", \"9999\")\n    config = load_config(cfg_path)\n    assert config.server.port == 9999\n\n\ndef test_config_env_override_model(tmp_path, monkeypatch):\n    cfg_path = tmp_path / \"config.yaml\"\n    write_config(cfg_path, {\"model\": {\"name\": \"gemini-1.5-pro\"}})\n    monkeypatch.setenv(\"MODEL\", \"gemini-2.0-flash\")\n    config = load_config(cfg_path)\n    assert config.model.name == \"gemini-2.0-flash\"\n```\n\n---\n\n### Priority Order\n\n| Priority | File | Tests to add | Impact |\n|----------|------|-------------|--------|\n| **1** | `test_llm_client.py` | JSON parsing, malformed, truncated, API error | Every agent depends on this |\n| **2** | `test_specialist_agent.py` | Core pipeline, fetch failure, LLM failure | Primary query workflow |\n| **3** | `test_orchestrator_agent.py` | Routing, synthesis, deduplication, conflicts | End-to-end correctness |\n| **4** | `test_fetch_engine.py` | Timeout fallback, partial batch failure, rate limiting | Reliability |\n| **5** | `test_fetch_cache.py` | TTL expiry, stale fallback, domain TTLs | Resilience |\n| **6** | `test_database.py` | All CRUD methods, cache, feedback | Data integrity |\n| **7** | `test_api_routes.py` | Validation, 404s, edge cases | API contract |\n| **8** | `test_websocket.py` | Disconnect, malformed input | Real-time safety |\n| **9** | `test_config.py` | Missing file, bad YAML, env overrides | Startup safety |\n\nImplementing Tier 1–3 would bring coverage from ~9.5% to approximately 60–70% and cover every critical failure mode in production.\n",
