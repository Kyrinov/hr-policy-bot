        "title": "tests/test_orchestrator.py",
        "content": "\"\"\"Unit tests for OrchestratorAgent.\"\"\"\n\nimport json\nimport pytest\nfrom unittest.mock import AsyncMock, MagicMock, patch\n\nfrom src.agents.orchestrator import OrchestratorAgent, get_orchestrator\nfrom src.models.schemas import OrchestratorCitation\n\n\n@pytest.fixture\ndef orchestrator():\n    with patch(\"src.agents.orchestrator.get_client\") as mock_client_fn, \\\n         patch(\"src.agents.orchestrator.get_config\"):\n        mock_client_fn.return_value = AsyncMock()\n        agent = OrchestratorAgent()\n        return agent\n\n\nclass TestBuildSynthesisPrompt:\n    def test_includes_query_text(self, orchestrator):\n        prompt = orchestrator._build_synthesis_prompt(\"test query\", [])\n        assert \"test query\" in prompt\n\n    def test_includes_agent_findings(self, orchestrator):\n        responses = [{\"agent_id\": \"staffing\", \"findings\": \"Found policy X\", \"confidence\": \"high\", \"citations\": []}]\n        prompt = orchestrator._build_synthesis_prompt(\"query\", responses)\n        assert \"Found policy X\" in prompt\n        assert \"STAFFING\" in prompt\n\n    def test_includes_citation_url(self, orchestrator):\n        responses = [{\n            \"agent_id\": \"staffing\",\n            \"findings\": \"findings\",\n            \"confidence\": \"high\",\n            \"citations\": [{\"instrument_title\": \"PSEA\", \"url\": \"https://laws.gc.ca/psea\", \"relevant_section\": \"s.10\"}],\n        }]\n        prompt = orchestrator._build_synthesis_prompt(\"query\", responses)\n        assert \"https://laws.gc.ca/psea\" in prompt\n\n    def test_no_citation_block_when_empty(self, orchestrator):\n        responses = [{\"agent_id\": \"staffing\", \"findings\": \"findings\", \"confidence\": \"high\", \"citations\": []}]\n        prompt = orchestrator._build_synthesis_prompt(\"query\", responses)\n        assert \"CITATIONS:\" not in prompt\n\n\nclass TestAggregateCitations:\n    def test_deduplicates_same_title_and_url(self, orchestrator):\n        responses = [\n            {\"agent_id\": \"staffing\", \"citations\": [{\"instrument_title\": \"PSEA\", \"url\": \"https://x.ca\", \"instrument_type\": \"Act\"}]},\n            {\"agent_id\": \"classification\", \"citations\": [{\"instrument_title\": \"PSEA\", \"url\": \"https://x.ca\", \"instrument_type\": \"Act\"}]},\n        ]\n        result = orchestrator._aggregate_citations(responses)\n        assert len(result) == 1\n\n    def test_different_urls_not_deduplicated(self, orchestrator):\n        responses = [\n            {\"agent_id\": \"staffing\", \"citations\": [{\"instrument_title\": \"PSEA\", \"url\": \"https://a.ca\", \"instrument_type\": \"Act\"}]},\n            {\"agent_id\": \"labour\", \"citations\": [{\"instrument_title\": \"PSLRA\", \"url\": \"https://b.ca\", \"instrument_type\": \"Act\"}]},\n        ]\n        result = orchestrator._aggregate_citations(responses)\n        assert len(result) == 2\n\n    def test_sourced_from_agent_set(self, orchestrator):\n        responses = [{\"agent_id\": \"equity\", \"citations\": [{\"instrument_title\": \"EEA\", \"url\": \"https://c.ca\", \"instrument_type\": \"Act\"}]}]\n        result = orchestrator._aggregate_citations(responses)\n        assert result[0].sourced_from_agent == \"equity\"\n\n    def test_empty_responses(self, orchestrator):\n        assert orchestrator._aggregate_citations([]) == []\n\n\nclass TestProcess:\n    @pytest.mark.asyncio\n    async def test_happy_path_valid_json(self, orchestrator):\n        payload = {\n            \"summary\": \"Direct answer\",\n            \"detailed_analysis\": \"Full analysis\",\n            \"citations\": [],\n            \"agents_consulted\": [\"staffing\"],\n            \"overall_confidence\": \"high\",\n        }\n        orchestrator._llm_client.chat = AsyncMock(return_value=json.dumps(payload))\n        result = await orchestrator.process(\"query\", [])\n        assert result.summary == \"Direct answer\"\n        assert result.overall_confidence == \"high\"\n\n    @pytest.mark.asyncio\n    async def test_strips_preamble_before_json(self, orchestrator):\n        payload = {\"summary\": \"s\", \"detailed_analysis\": \"d\", \"citations\": [], \"agents_consulted\": [], \"overall_confidence\": \"low\"}\n        orchestrator._llm_client.chat = AsyncMock(return_value=\"Here is your answer:\\n\" + json.dumps(payload))\n        result = await orchestrator.process(\"query\", [])\n        assert result.summary == \"s\"\n\n    @pytest.mark.asyncio\n    async def test_invalid_json_returns_error_response(self, orchestrator):\n        orchestrator._llm_client.chat = AsyncMock(return_value=\"not json at all\")\n        result = await orchestrator.process(\"query\", [])\n        assert result.overall_confidence == \"low\"\n        assert \"error\" in result.summary.lower()\n\n\nclass TestRoute:\n    @pytest.mark.asyncio\n    async def test_returns_parsed_routing(self, orchestrator):\n        payload = {\"selected_agents\": [\"staffing\", \"labour\"], \"routing_rationale\": \"r\", \"sub_queries\": {\"staffing\": \"q1\", \"labour\": \"q2\"}}\n        orchestrator._llm_client.chat = AsyncMock(return_value=json.dumps(payload))\n        result = await orchestrator._route(\"test query\")\n        assert result[\"selected_agents\"] == [\"staffing\", \"labour\"]\n\n    @pytest.mark.asyncio\n    async def test_fallback_to_all_agents_on_failure(self, orchestrator):\n        orchestrator._llm_client.chat = AsyncMock(side_effect=Exception(\"LLM down\"))\n        result = await orchestrator._route(\"test query\")\n        assert set(result[\"selected_agents\"]) == set(orchestrator._specialist_agent_ids)\n\n    @pytest.mark.asyncio\n    async def test_strips_preamble_in_routing(self, orchestrator):\n        payload = {\"selected_agents\": [\"ohs\"], \"routing_rationale\": \"r\", \"sub_queries\": {\"ohs\": \"q\"}}\n        orchestrator._llm_client.chat = AsyncMock(return_value=\"Sure!\\n\" + json.dumps(payload))\n        result = await orchestrator._route(\"query\")\n        assert result[\"selected_agents\"] == [\"ohs\"]\n\n\nclass TestGetOrchestratorSingleton:\n    def test_returns_same_instance(self):\n        import src.agents.orchestrator as mod\n        mod.ORCHESTRATOR = None\n        with patch(\"src.agents.orchestrator.get_client\"), patch(\"src.agents.orchestrator.get_config\"):\n            a = get_orchestrator()\n            b = get_orchestrator()\n            assert a is b\n        mod.ORCHESTRATOR = None\n```\n\n```python\n",
        "level": 1
      },
      {
        "title": "tests/test_base_agent.py",
        "content": "\"\"\"Unit tests for GenericAgent base class.\"\"\"\n\nimport pytest\nfrom src.agents.base import GenericAgent\n\n\n@pytest.fixture\ndef agent():\n    return GenericAgent(\n        agent_id=\"test-agent\",\n        display_name=\"Test Agent\",\n        domain_description=\"Test domain\",\n        system_prompt=\"You are a test agent.\",\n    )\n\n\nclass TestGenericAgentProperties:\n    def test_agent_id(self, agent):\n        assert agent.agent_id == \"test-agent\"\n\n    def test_display_name(self, agent):\n        assert agent.display_name == \"Test Agent\"\n\n    def test_domain_description(self, agent):\n        assert agent.domain_description == \"Test domain\"\n\n    def test_system_prompt(self, agent):\n        assert agent.system_prompt == \"You are a test agent.\"\n\n\nclass TestBuildPrompt:\n    def test_includes_query(self, agent):\n        prompt = agent.build_prompt(\"What is overtime pay?\")\n        assert \"What is overtime pay?\" in prompt\n\n    def test_includes_policy_context(self, agent):\n        prompt = agent.build_prompt(\"query\", policy_context=\"Section 5.1: ...\")\n        assert \"Section 5.1\" in prompt\n\n    def test_no_policy_context_omitted(self, agent):\n        prompt = agent.build_prompt(\"query\")\n        assert \"RELEVANT POLICY CONTENT\" not in prompt\n\n    def test_includes_json_instruction(self, agent):\n        prompt = agent.build_prompt(\"query\")\n        assert \"JSON\" in prompt\n\n\nclass TestBaseProcess:\n    @pytest.mark.asyncio\n    async def test_process_raises_not_implemented(self, agent):\n        with pytest.raises(NotImplementedError):\n            await agent.process(\"query\")\n```\n\n```python\n",
        "level": 1
      },
      {
        "title": "tests/test_fetch_engine.py",
        "content": "\"\"\"Unit tests for FetchEngine.\"\"\"\n\nimport pytest\nfrom unittest.mock import AsyncMock, MagicMock, patch\n\nimport httpx\nfrom src.fetch.engine import FetchEngine, FetchError, cleanup_fetch_engine, get_fetch_engine\nfrom src.fetch.cache import CacheEntry\n\n\ndef make_engine(cache=None, extractor=None):\n    mock_cache = cache or AsyncMock()\n    mock_extractor = extractor or MagicMock()\n    with patch(\"src.fetch.engine.get_config\"):\n        return FetchEngine(cache=mock_cache, extractor=mock_extractor)\n\n\nclass TestNormalizeUrl:\n    def test_laws_act_url_rewritten(self):\n        engine = make_engine()\n        url = \"https://laws-lois.justice.gc.ca/eng/acts/P-33.3/\"\n        assert engine._normalize_url(url).endswith(\"/FullText.html\")\n\n    def test_non_laws_url_unchanged(self):\n        engine = make_engine()\n        url = \"https://tbs-sct.canada.ca/pol/some-policy\"\n        assert engine._normalize_url(url) == url\n\n    def test_laws_non_act_url_unchanged(self):\n        engine = make_engine()\n        url = \"https://laws-lois.justice.gc.ca/eng/regulations/SOR-2003-298/\"\n        # Only /acts/ pattern should be rewritten\n        result = engine._normalize_url(url)\n        assert result == url\n\n\nclass TestGetDomain:\n    def test_normal_url(self):\n        engine = make_engine()\n        assert engine._get_domain(\"https://tbs-sct.canada.ca/pol/x\") == \"tbs-sct.canada.ca\"\n\n    def test_malformed_url_returns_default(self):\n        engine = make_engine()\n        assert engine._get_domain(\"not-a-url\") == \"default\"\n\n\nclass TestFetch:\n    @pytest.mark.asyncio\n    async def test_cache_hit_returns_content(self):\n        mock_cache = AsyncMock()\n        mock_cache.get.return_value = CacheEntry(url=\"https://x.ca\", content=\"cached content\", ttl_hours=168)\n        engine = make_engine(cache=mock_cache)\n        result = await engine.fetch(\"https://x.ca\")\n        assert result == \"cached content\"\n        mock_cache.get.assert_called_once()\n\n    @pytest.mark.asyncio\n    async def test_cache_miss_fetches_and_stores(self):\n        mock_cache = AsyncMock()\n        mock_cache.get.return_value = None\n        mock_cache._get_default_ttl = MagicMock(return_value=168)\n        mock_extractor = MagicMock()\n        mock_extractor.extract.return_value = \"fetched content\"\n        engine = make_engine(cache=mock_cache, extractor=mock_extractor)\n\n        mock_response = MagicMock()\n        mock_response.text = \"<html>fetched content</html>\"\n        mock_response.status_code = 200\n        mock_response.raise_for_status = MagicMock()\n        engine._client.get = AsyncMock(return_value=mock_response)\n\n        result = await engine.fetch(\"https://x.ca\")\n        assert result == \"fetched content\"\n        mock_cache.set_cached.assert_called_once()\n\n    @pytest.mark.asyncio\n    async def test_http_failure_uses_stale_cache(self):\n        mock_cache = AsyncMock()\n        mock_cache.get.return_value = None\n        mock_cache.get_stale.return_value = CacheEntry(url=\"https://x.ca\", content=\"stale content\", ttl_hours=168)\n        engine = make_engine(cache=mock_cache)\n        engine._client.get = AsyncMock(side_effect=httpx.RequestError(\"timeout\"))\n\n        result = await engine.fetch(\"https://x.ca\")\n        assert result == \"stale content\"\n\n    @pytest.mark.asyncio\n    async def test_http_failure_no_stale_raises_fetch_error(self):\n        mock_cache = AsyncMock()\n        mock_cache.get.return_value = None\n        mock_cache.get_stale.return_value = None\n        engine = make_engine(cache=mock_cache)\n        engine._client.get = AsyncMock(side_effect=httpx.RequestError(\"timeout\"))\n\n        with pytest.raises(FetchError):\n            await engine.fetch(\"https://x.ca\")\n\n\nclass TestFetchBatch:\n    @pytest.mark.asyncio\n    async def test_returns_successful_results(self):\n        mock_cache = AsyncMock()\n        mock_cache.get.return_value = CacheEntry(url=\"\", content=\"ok\", ttl_hours=168)\n        engine = make_engine(cache=mock_cache)\n        # Patch fetch per-url\n        async def side_effect(url):\n            if url == \"https://fail.ca\":\n                raise FetchError(\"fail\")\n            return \"content\"\n        engine.fetch = side_effect\n\n        results = await engine.fetch_batch([\"https://ok.ca\", \"https://fail.ca\"])\n        assert \"https://ok.ca\" in results\n        assert \"https://fail.ca\" not in results\n\n\nclass TestCleanup:\n    @pytest.mark.asyncio\n    async def test_cleanup_clears_singleton(self):\n        import src.fetch.engine as mod\n        with patch(\"src.fetch.engine.get_config\"):\n            mod._engine = FetchEngine(cache=AsyncMock(), extractor=MagicMock())\n            mod._engine._client = AsyncMock()\n            await cleanup_fetch_engine()\n            assert mod._engine is None\n```\n\n```python\n",
        "level": 1
      },
      {
        "title": "tests/test_cache.py",
        "content": "\"\"\"Unit tests for FetchCache and CacheEntry.\"\"\"\n\nimport pytest\nfrom datetime import datetime, timedelta\nfrom unittest.mock import AsyncMock, patch\n\nfrom src.fetch.cache import CacheEntry, FetchCache\n\n\nclass TestCacheEntry:\n    def test_content_hash_is_sha256(self):\n        import hashlib\n        entry = CacheEntry(url=\"https://x.ca\", content=\"hello\", ttl_hours=24)\n        expected = hashlib.sha256(b\"hello\").hexdigest()\n        assert entry.content_hash == expected\n\n    def test_is_valid_fresh_entry(self):\n        entry = CacheEntry(url=\"https://x.ca\", content=\"c\", ttl_hours=168)\n        entry.fetched_at = datetime.utcnow().isoformat()\n        assert entry.is_valid()\n\n    def test_is_valid_expired_entry(self):\n        entry = CacheEntry(url=\"https://x.ca\", content=\"c\", ttl_hours=1)\n        entry.fetched_at = (datetime.utcnow() - timedelta(hours=2)).isoformat()\n        assert not entry.is_valid()\n\n\nclass TestFetchCache:\n    @pytest.fixture\n    def mock_db(self):\n        return AsyncMock()\n\n    @pytest.fixture\n    def cache(self, mock_db):\n        with patch(\"src.fetch.cache.get_config\") as mock_cfg:\n            mock_cfg.return_value.cache.ttl_hours = 168\n            return FetchCache(db_manager=mock_db)\n\n    @pytest.mark.asyncio\n    async def test_get_returns_none_on_miss(self, cache, mock_db):\n        mock_db.get_cached.return_value = None\n        assert await cache.get(\"https://x.ca\") is None\n\n    @pytest.mark.asyncio\n    async def test_get_returns_cache_entry_on_hit(self, cache, mock_db):\n        from src.models.schemas import FetchCacheEntry\n        mock_db.get_cached.return_value = FetchCacheEntry(\n            url=\"https://x.ca\", content_text=\"content\", content_hash=\"abc\",\n            ttl_hours=168, fetched_at=datetime.utcnow()\n        )\n        result = await cache.get(\"https://x.ca\")\n        assert result is not None\n        assert result.content == \"content\"\n\n    @pytest.mark.asyncio\n    async def test_get_stale_returns_none_on_miss(self, cache, mock_db):\n        mock_db.get_stale.return_value = None\n        assert await cache.get_stale(\"https://x.ca\") is None\n\n    @pytest.mark.asyncio\n    async def test_set_cached_calls_db(self, cache, mock_db):\n        entry = CacheEntry(url=\"https://x.ca\", content=\"c\", ttl_hours=24)\n        await cache.set_cached(entry)\n        mock_db.set_cached.assert_called_once()\n\n    def test_get_default_ttl_legislation_domain(self, cache):\n        assert cache._get_default_ttl(\"https://laws-lois.justice.gc.ca/eng/acts/x\") == 720\n\n    def test_get_default_ttl_collective_domain(self, cache):\n        assert cache._get_default_ttl(\"https://tbs-sct.canada.ca/agreements-conventions/x\") == 720\n\n    def test_get_default_ttl_default_domain(self, cache):\n        assert cache._get_default_ttl(\"https://example.com/page\") == 168\n\n    @pytest.mark.asyncio\n    async def test_clear_expired_delegates_to_db(self, cache, mock_db):\n        mock_db.clear_expired.return_value = 5\n        count = await cache.clear_expired()\n        assert count == 5\n```\n\n```python\n",
        "level": 1
      },
      {
        "title": "tests/test_extractors.py",
        "content": "\"\"\"Unit tests for ContentExtractor.\"\"\"\n\nimport pytest\nfrom src.fetch.extractors import ContentExtractor\n\n\n@pytest.fixture\ndef extractor():\n    # Use extractor with missing selectors file to force defaults\n    return ContentExtractor(selectors_path=\"/nonexistent/path.yaml\")\n\n\nclass TestExtract:\n    def test_extracts_heading_and_paragraph(self, extractor):\n        html = \"<html><body><main><h1>Title</h1><p>Body text here.</p></main></body></html>\"\n        result = extractor.extract(\"https://example.com\", html)\n        assert \"Title\" in result\n        assert \"Body text here\" in result\n\n    def test_falls_back_to_body_when_no_main(self, extractor):\n        html = \"<html><body><p>Just a paragraph.</p></body></html>\"\n        result = extractor.extract(\"https://example.com\", html)\n        assert \"Just a paragraph\" in result\n\n    def test_handles_empty_html(self, extractor):\n        result = extractor.extract(\"https://example.com\", \"\")\n        assert isinstance(result, str)\n\n    def test_max_length_respected(self, extractor):\n        long_text = \"word \" * 20000\n        html = f\"<html><body><main><p>{long_text}</p></main></body></html>\"\n        result = extractor.extract(\"https://example.com\", html, max_length=100)\n        assert len(result) <= 103  # 100 + \"...\" possible\n\n\nclass TestTruncate:\n    def test_short_text_unchanged(self, extractor):\n        assert extractor._truncate(\"hello\", 100) == \"hello\"\n\n    def test_long_text_truncated_with_ellipsis(self, extractor):\n        result = extractor._truncate(\"a\" * 200, 100)\n        assert len(result) == 100\n        assert result.endswith(\"...\")\n\n\nclass TestCleanText:\n    def test_collapses_whitespace(self, extractor):\n        result = extractor._clean_text(\"  foo   bar  \\n  baz  \", 1000)\n        assert result == \"foo bar baz\"\n\n    def test_respects_max_length(self, extractor):\n        result = extractor._clean_text(\"hello world\", 5)\n        assert len(result) == 5\n```\n\n```python\n",
        "level": 1
      },
      {
        "title": "tests/test_db_extended.py",
        "content": "\"\"\"Extended DatabaseManager tests covering untested methods.\"\"\"\n\nimport uuid\nimport pytest\nimport tempfile\nfrom pathlib import Path\nfrom datetime import datetime\n\nfrom src.data.db import DatabaseManager\nfrom src.models.schemas import (\n    AgentResponseRecord, CitationItem, FeedbackRecord,\n    FetchCacheEntry, OrchestratorResponseRecord, QueryRecord, RetrievalStatus\n)\n\n\n@pytest.fixture\nasync def db():\n    with tempfile.TemporaryDirectory() as tmpdir:\n        manager = DatabaseManager(db_path=Path(tmpdir) / \"test.db\")\n        await manager.initialize()\n        yield manager\n\n\nclass TestGetQueryMiss:\n    @pytest.mark.asyncio\n    async def test_get_nonexistent_query_returns_none(self, db):\n        result = await db.get_query(\"nonexistent-id\")\n        assert result is None\n\n\nclass TestListQueries:\n    @pytest.mark.asyncio\n    async def test_returns_empty_list_when_no_queries(self, db):\n        result = await db.list_queries()\n        assert result == []\n\n    @pytest.mark.asyncio\n    async def test_returns_queries_ordered_newest_first(self, db):\n        for i in range(3):\n            await db.save_query(QueryRecord(query_id=str(uuid.uuid4()), query_text=f\"q{i}\"))\n        result = await db.list_queries(limit=10)\n        assert len(result) == 3\n\n    @pytest.mark.asyncio\n    async def test_respects_limit(self, db):\n        for i in range(5):\n            await db.save_query(QueryRecord(query_id=str(uuid.uuid4()), query_text=f\"q{i}\"))\n        result = await db.list_queries(limit=2)\n        assert len(result) == 2\n\n\nclass TestAgentResponseRoundtrip:\n    @pytest.mark.asyncio\n    async def test_save_and_get_agent_response(self, db):\n        query_id = str(uuid.uuid4())\n        await db.save_query(QueryRecord(query_id=query_id, query_text=\"q\"))\n        record = AgentResponseRecord(\n            response_id=str(uuid.uuid4()),\n            query_id=query_id,\n            agent_id=\"staffing\",\n            findings=\"findings\",\n            confidence=\"high\",\n            retrieval_status=RetrievalStatus(\n                instruments_attempted=2, instruments_successfully_retrieved=2\n            ),\n        )\n        await db.save_agent_response(record)\n        results = await db.get_agent_responses(query_id)\n        assert len(results) == 1\n        assert results[0].agent_id == \"staffing\"\n\n\nclass TestOrchestratorResponseRoundtrip:\n    @pytest.mark.asyncio\n    async def test_save_and_get_orchestrator_response(self, db):\n        query_id = str(uuid.uuid4())\n        await db.save_query(QueryRecord(query_id=query_id, query_text=\"q\"))\n        record = OrchestratorResponseRecord(\n            response_id=str(uuid.uuid4()),\n            query_id=query_id,\n            summary=\"Summary text\",\n            overall_confidence=\"medium\",\n        )\n        await db.save_orchestrator_response(record)\n        result = await db.get_orchestrator_response(query_id)\n        assert result is not None\n        assert result.summary == \"Summary text\"\n\n    @pytest.mark.asyncio\n    async def test_get_nonexistent_orchestrator_response_returns_none(self, db):\n        assert await db.get_orchestrator_response(\"does-not-exist\") is None\n\n\nclass TestFeedbackRoundtrip:\n    @pytest.mark.asyncio\n    async def test_save_and_get_feedback(self, db):\n        query_id = str(uuid.uuid4())\n        await db.save_query(QueryRecord(query_id=query_id, query_text=\"q\"))\n        feedback = FeedbackRecord(\n            feedback_id=str(uuid.uuid4()),\n            query_id=query_id,\n            rating=\"accurate\",\n            comment=\"Very helpful\",\n        )\n        await db.save_feedback(feedback)\n        result = await db.get_feedback_for_query(query_id)\n        assert result is not None\n        assert result.rating == \"accurate\"\n\n    @pytest.mark.asyncio\n    async def test_export_feedback_returns_dicts(self, db):\n        query_id = str(uuid.uuid4())\n        await db.save_query(QueryRecord(query_id=query_id, query_text=\"q\"))\n        await db.save_feedback(FeedbackRecord(\n            feedback_id=str(uuid.uuid4()), query_id=query_id, rating=\"needs_work\"\n        ))\n        result = await db.export_feedback()\n        assert len(result) == 1\n        assert isinstance(result[0], dict)\n\n\nclass TestFetchCacheRoundtrip:\n    @pytest.mark.asyncio\n    async def test_set_and_get_cached(self, db):\n        entry = FetchCacheEntry(\n            url=\"https://x.ca\",\n            content_text=\"content\",\n            content_hash=\"hash\",\n            ttl_hours=168,\n            fetched_at=datetime.utcnow(),\n        )\n        await db.set_cached(entry)\n        result = await db.get_cached(\"https://x.ca\")\n        assert result is not None\n        assert result.content_text == \"content\"\n\n    @pytest.mark.asyncio\n    async def test_get_cached_expired_returns_none(self, db):\n        from datetime import timedelta\n        entry = FetchCacheEntry(\n            url=\"https://expired.ca\",\n            content_text=\"old\",\n            content_hash=\"h\",\n            ttl_hours=1,\n            fetched_at=datetime.utcnow() - timedelta(hours=2),\n        )\n        await db.set_cached(entry)\n        result = await db.get_cached(\"https://expired.ca\")\n        assert result is None\n\n    @pytest.mark.asyncio\n    async def test_get_stale_returns_expired_entry(self, db):\n        from datetime import timedelta\n        entry = FetchCacheEntry(\n            url=\"https://stale.ca\",\n            content_text=\"stale\",\n            content_hash=\"h\",\n            ttl_hours=1,\n            fetched_at=datetime.utcnow() - timedelta(hours=2),\n        )\n        await db.set_cached(entry)\n        result = await db.get_stale(\"https://stale.ca\")\n        assert result is not None\n        assert result.content_text == \"stale\"\n\n    @pytest.mark.asyncio\n    async def test_clear_expired_removes_entries(self, db):\n        from datetime import timedelta\n        entry = FetchCacheEntry(\n            url=\"https://old.ca\",\n            content_text=\"old\",\n            content_hash=\"h\",\n            ttl_hours=1,\n            fetched_at=datetime.utcnow() - timedelta(hours=2),\n        )\n        await db.set_cached(entry)\n        count = await db.clear_expired()\n        assert count >= 1\n        assert await db.get_stale(\"https://old.ca\") is None\n```\n\n```python\n",
        "level": 1
