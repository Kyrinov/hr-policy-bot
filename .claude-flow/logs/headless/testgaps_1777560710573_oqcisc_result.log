        "language": "python",
        "code": "# tests/test_llm_client.py\nimport asyncio\nimport pytest\nfrom unittest.mock import AsyncMock, MagicMock, patch\n\nclass TestSafeText:\n    def test_returns_text_on_success(self):\n        from src.llm.client import _safe_text\n        mock = MagicMock()\n        mock.text = \"hello\"\n        assert _safe_text(mock) == \"hello\"\n\n    def test_returns_empty_on_blocked_content(self):\n        from src.llm.client import _safe_text\n        mock = MagicMock()\n        type(mock).text = property(lambda self: (_ for _ in ()).throw(ValueError(\"blocked\")))\n        assert _safe_text(mock) == \"\"\n\nclass TestGeminiClientInit:\n    def test_raises_without_api_key(self, monkeypatch):\n        monkeypatch.delenv(\"GEMINI_API_KEY\", raising=False)\n        with patch(\"src.llm.client._client\", None):\n            from src.llm import client as llm_mod\n            llm_mod._client = None\n            with pytest.raises(RuntimeError, match=\"GEMINI_API_KEY\"):\n                from src.llm.client import GeminiClient\n                GeminiClient()\n\nclass TestGeminiGenerate:\n    @pytest.mark.asyncio\n    async def test_retries_on_rate_limit_then_succeeds(self, monkeypatch):\n        \"\"\"ResourceExhausted on first attempt, success on second.\"\"\"\n        from google.api_core.exceptions import ResourceExhausted\n        from src.llm.client import GeminiClient\n        call_count = 0\n        async def fake_generate(contents, **kwargs):\n            nonlocal call_count\n            call_count += 1\n            if call_count == 1:\n                raise ResourceExhausted(\"rate limited\")\n            mock = MagicMock()\n            mock.text = \"response\"\n            return mock\n        with patch.dict(\"os.environ\", {\"GEMINI_API_KEY\": \"fake\"}), \\\n             patch(\"google.generativeai.configure\"), \\\n             patch(\"asyncio.sleep\", new_callable=AsyncMock):\n            client = GeminiClient()\n            model = MagicMock()\n            model.generate_content_async = AsyncMock(side_effect=fake_generate)\n            result = await client._generate(model, [], max_retries=3)\n        assert result == \"response\"\n        assert call_count == 2\n\n    @pytest.mark.asyncio\n    async def test_raises_after_exhausting_retries(self, monkeypatch):\n        from google.api_core.exceptions import ResourceExhausted\n        from src.llm.client import GeminiClient\n        with patch.dict(\"os.environ\", {\"GEMINI_API_KEY\": \"fake\"}), \\\n             patch(\"google.generativeai.configure\"), \\\n             patch(\"asyncio.sleep\", new_callable=AsyncMock):\n            client = GeminiClient()\n            model = MagicMock()\n            model.generate_content_async = AsyncMock(side_effect=ResourceExhausted(\"rate\"))\n            with pytest.raises(ResourceExhausted):\n                await client._generate(model, [], max_retries=2)\n\nclass TestChatParsed:\n    @pytest.mark.asyncio\n    async def test_returns_error_dict_on_invalid_json(self):\n        from src.llm.client import GeminiClient\n        with patch.dict(\"os.environ\", {\"GEMINI_API_KEY\": \"fake\"}), \\\n             patch(\"google.generativeai.configure\"):\n            client = GeminiClient()\n            client._generate = AsyncMock(return_value=\"not-json{{{\")\n            result = await client.chat_parsed(\"sys\", \"user\")\n        assert \"_parse_error\" in result\n        assert \"_raw\" in result"
