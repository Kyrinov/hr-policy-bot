        "code": "# tests/test_specialist.py\nimport json\nimport pytest\nfrom unittest.mock import AsyncMock, MagicMock, patch\nfrom pathlib import Path\n\n\nVALID_SPECIALIST_JSON = json.dumps({\n    \"agent_id\": \"staffing\",\n    \"findings\": \"Staffing policy requires open competition.\",\n    \"citations\": [\n        {\n            \"instrument_title\": \"PSEA\",\n            \"instrument_type\": \"Act\",\n            \"url\": \"https://laws-lois.justice.gc.ca/eng/acts/P-33.01/\",\n            \"relevant_section\": \"s.30\",\n        }\n    ],\n    \"caveats\": None,\n    \"scope_flags\": [],\n    \"confidence\": \"high\",\n})\n\n\n@pytest.fixture\ndef staffing_agent():\n    with patch(\"src.llm.client.get_client\", return_value=AsyncMock()), \\\n         patch(\"src.agents.specialist.SpecialistAgent._load_instruments\", return_value=[\n             {\n                 \"id\": \"psea\",\n                 \"title\": \"Public Service Employment Act\",\n                 \"type\": \"Act\",\n                 \"url\": \"https://laws-lois.justice.gc.ca/eng/acts/P-33.01/\",\n                 \"agent_ids\": [\"staffing\"],\n             }\n         ]):\n        from src.agents.specialist import SpecialistAgent\n        return SpecialistAgent(\"staffing\", \"Staffing & Recruitment Agent\", \"Staffing domain\")\n\n\nclass TestLoadInstruments:\n    def test_filters_by_agent_id(self, tmp_path):\n        registry = [\n            {\"id\": \"a\", \"title\": \"A\", \"type\": \"Act\", \"url\": \"http://a.com\", \"agent_ids\": [\"staffing\"]},\n            {\"id\": \"b\", \"title\": \"B\", \"type\": \"Policy\", \"url\": \"http://b.com\", \"agent_ids\": [\"labour\"]},\n            {\"id\": \"c\", \"title\": \"C\", \"type\": \"Directive\", \"url\": \"http://c.com\", \"agent_ids\": [\"staffing\", \"labour\"]},\n        ]\n        registry_file = tmp_path / \"policy_registry.json\"\n        registry_file.write_text(json.dumps(registry))\n\n        with patch(\"src.agents.specialist._REGISTRY_PATH\", registry_file), \\\n             patch(\"src.llm.client.get_client\", return_value=MagicMock()):\n            from src.agents.specialist import SpecialistAgent\n            agent = SpecialistAgent.__new__(SpecialistAgent)\n            instruments = agent._load_instruments(\"staffing\")\n\n        assert len(instruments) == 2\n        assert all(\"staffing\" in i[\"agent_ids\"] for i in instruments)\n\n\nclass TestBuildPolicyContext:\n    def test_empty_fetched_returns_empty_string(self, staffing_agent):\n        result = staffing_agent._build_policy_context([])\n        assert result == \"\"\n\n    def test_populated_includes_title_and_url(self, staffing_agent):\n        instrument = {\n            \"title\": \"PSEA\",\n            \"type\": \"Act\",\n            \"url\": \"https://laws-lois.justice.gc.ca/eng/acts/P-33.01/\",\n        }\n        result = staffing_agent._build_policy_context([(instrument, \"policy text here\")])\n        assert \"PSEA\" in result\n        assert \"policy text here\" in result\n        assert \"https://laws-lois.justice.gc.ca\" in result\n\n\nclass TestParseResponse:\n    def test_valid_json_response(self, staffing_agent):\n        response = staffing_agent._parse_response(VALID_SPECIALIST_JSON, 1, 1, [])\n        assert response.agent_id == \"staffing\"\n        assert response.confidence == \"high\"\n        assert len(response.citations) == 1\n\n    def test_json_with_preamble(self, staffing_agent):\n        raw = \"Sure, here is my response:\\n\" + VALID_SPECIALIST_JSON\n        response = staffing_agent._parse_response(raw, 1, 1, [])\n        assert response.confidence == \"high\"\n\n    def test_fallback_on_invalid_json(self, staffing_agent):\n        response = staffing_agent._parse_response(\"This is plain text, not JSON.\", 1, 0, [\"PSEA\"])\n        assert response.agent_id == \"staffing\"\n        assert response.confidence == \"low\"\n        assert response.findings == \"This is plain text, not JSON.\"\n\n    def test_retrieval_status_populated(self, staffing_agent):\n        response = staffing_agent._parse_response(VALID_SPECIALIST_JSON, 3, 2, [\"FailedDoc\"])\n        assert response.retrieval_status.instruments_attempted == 3\n        assert response.retrieval_status.instruments_successfully_retrieved == 2\n        assert \"FailedDoc\" in response.retrieval_status.instruments_failed\n\n\nclass TestProcessWithFetch:\n    @pytest.mark.asyncio\n    async def test_no_fetch_engine_skips_retrieval(self, staffing_agent):\n        staffing_agent._llm_client.chat = AsyncMock(return_value=VALID_SPECIALIST_JSON)\n        result = await staffing_agent.process_with_fetch(\"What are staffing rules?\", None)\n        assert result.retrieval_status.instruments_attempted == 0\n\n    @pytest.mark.asyncio\n    async def test_with_fetch_engine_fetches_instruments(self, staffing_agent):\n        mock_engine = AsyncMock()\n        mock_engine.fetch = AsyncMock(return_value=\"policy content\")\n        staffing_agent._llm_client.chat = AsyncMock(return_value=VALID_SPECIALIST_JSON)\n        result = await staffing_agent.process_with_fetch(\"query\", mock_engine)\n        assert result.retrieval_status.instruments_attempted == 1\n        assert result.retrieval_status.instruments_successfully_retrieved == 1\n\n    @pytest.mark.asyncio\n    async def test_fetch_failure_recorded_in_status(self, staffing_agent):\n        mock_engine = AsyncMock()\n        mock_engine.fetch = AsyncMock(side_effect=Exception(\"network error\"))\n        staffing_agent._llm_client.chat = AsyncMock(return_value=VALID_SPECIALIST_JSON)\n        result = await staffing_agent.process_with_fetch(\"query\", mock_engine)\n        assert result.retrieval_status.instruments_attempted == 1\n        assert result.retrieval_status.instruments_successfully_retrieved == 0\n        assert len(result.retrieval_status.instruments_failed) == 1"
