        "code": "# tests/test_extractors.py\n\"\"\"Unit tests for ContentExtractor.\"\"\"\n\nimport pytest\nfrom src.fetch.extractors import ContentExtractor\n\n\n@pytest.fixture\ndef extractor():\n    # Use extractor with missing selectors file to force defaults\n    return ContentExtractor(selectors_path=\"/nonexistent/path.yaml\")\n\n\nclass TestExtract:\n    def test_extracts_heading_and_paragraph(self, extractor):\n        html = \"<html><body><main><h1>Title</h1><p>Body text here.</p></main></body></html>\"\n        result = extractor.extract(\"https://example.com\", html)\n        assert \"Title\" in result\n        assert \"Body text here\" in result\n\n    def test_falls_back_to_body_when_no_main(self, extractor):\n        html = \"<html><body><p>Just a paragraph.</p></body></html>\"\n        result = extractor.extract(\"https://example.com\", html)\n        assert \"Just a paragraph\" in result\n\n    def test_handles_empty_html(self, extractor):\n        result = extractor.extract(\"https://example.com\", \"\")\n        assert isinstance(result, str)\n\n    def test_max_length_respected(self, extractor):\n        long_text = \"word \" * 20000\n        html = f\"<html><body><main><p>{long_text}</p></main></body></html>\"\n        result = extractor.extract(\"https://example.com\", html, max_length=100)\n        assert len(result) <= 103  # 100 + \"...\" possible\n\n\nclass TestTruncate:\n    def test_short_text_unchanged(self, extractor):\n        assert extractor._truncate(\"hello\", 100) == \"hello\"\n\n    def test_long_text_truncated_with_ellipsis(self, extractor):\n        result = extractor._truncate(\"a\" * 200, 100)\n        assert len(result) == 100\n        assert result.endswith(\"...\")\n\n\nclass TestCleanText:\n    def test_collapses_whitespace(self, extractor):\n        result = extractor._clean_text(\"  foo   bar  \\n  baz  \", 1000)\n        assert result == \"foo bar baz\"\n\n    def test_respects_max_length(self, extractor):\n        result = extractor._clean_text(\"hello world\", 5)\n        assert len(result) == 5"
