nt_id\": \"staffing\", \"citations\": [{\"instrument_title\": \"A\", \"url\": \"https://a.com\"}]},\n            {\"agent_id\": \"classification\", \"citations\": [{\"instrument_title\": \"B\", \"url\": \"https://b.com\"}]},\n        ]\n        result = self.agent._aggregate_citations(responses)\n        assert len(result) == 2\n\n    def test_empty_responses(self):\n        assert self.agent._aggregate_citations([]) == []\n\n    def test_sourced_from_agent_set_correctly(self):\n        responses = [{\"agent_id\": \"labour\", \"citations\": [{\"instrument_title\": \"T\", \"url\": \"https://t.com\"}]}]\n        result = self.agent._aggregate_citations(responses)\n        assert result[0].sourced_from_agent == \"labour\"\n\n\nclass TestOrchestratorProcess:\n    @pytest.mark.asyncio\n    async def test_returns_low_confidence_on_json_parse_failure(self):\n        with patch(\"src.agents.orchestrator.get_client\") as mock_client_factory:\n            mock_client = AsyncMock()\n            mock_client.chat.return_value = \"this is not json at all\"\n            mock_client_factory.return_value = mock_client\n            agent = OrchestratorAgent()\n        \n        result = await agent.process(\"test query\", [])\n        assert result.overall_confidence == \"low\"\n\n    @pytest.mark.asyncio\n    async def test_returns_valid_response_on_good_json(self):\n        good_json = \"\"\"{\n            \"summary\": \"Direct answer\",\n            \"detailed_analysis\": \"Full analysis\",\n            \"citations\": [],\n            \"agents_consulted\": [\"staffing\"],\n            \"overall_confidence\": \"high\"\n        }\"\"\"\n        with patch(\"src.agents.orchestrator.get_client\") as mock_client_factory:\n            mock_client = AsyncMock()\n            mock_client.chat.return_value = good_json\n            mock_client_factory.return_value = mock_client\n            agent = OrchestratorAgent()\n\n        result = await agent.process(\"test query\", [])\n        assert result.summary == \"Direct answer\"\n        assert result.overall_confidence == \"high\"\n\n    @pytest.mark.asyncio\n    async def test_json_with_preamble_is_parsed(self):\n        \"\"\"LLM sometimes prepends text before the JSON block.\"\"\"\n        preamble_json = \"Here is my response:\\n{\\\"summary\\\": \\\"s\\\", \\\"detailed_analysis\\\": \\\"d\\\", \\\"citations\\\": [], \\\"agents_consulted\\\": [], \\\"overall_confidence\\\": \\\"medium\\\"}\"\n        with patch(\"src.agents.orchestrator.get_client\") as mock_client_factory:\n            mock_client = AsyncMock()\n            mock_client.chat.return_value = preamble_json\n            mock_client_factory.return_value = mock_client\n            agent = OrchestratorAgent()\n\n        result = await agent.process(\"q\", [])\n        assert result.overall_confidence == \"medium\"\n\n\nclass TestOrchestratorRoute:\n    @pytest.mark.asyncio\n    async def test_falls_back_to_all_agents_on_llm_failure(self):\n        with patch(\"src.agents.orchestrator.get_client\") as mock_client_factory:\n            mock_client = AsyncMock()\n            mock_client.chat.side_effect = Exception(\"LLM down\")\n            mock_client_factory.return_value = mock_client\n            agent = OrchestratorAgent()\n\n        result = await agent._route(\"What is leave policy?\")\n        assert set(result[\"selected_agents\"]) == set(agent._specialist_agent_ids)\n\n    @pytest.mark.asyncio\n    async def test_falls_back_to_all_agents_on_bad_json(self):\n        with patch(\"src.agents.orchestrator.get_client\") as mock_client_factory:\n            mock_client = AsyncMock()\n            mock_client.chat.return_value = \"not json\"\n            mock_client_factory.return_value = mock_client\n            agent = OrchestratorAgent()\n\n        result = await agent._route(\"query\")\n        assert len(result[\"selected_agents\"]) == 8\n```\n\n---\n\n",
