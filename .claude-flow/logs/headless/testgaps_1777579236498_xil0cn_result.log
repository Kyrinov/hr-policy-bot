staffing\",\n            findings=\"Some findings\",\n            citations=[CitationItem(instrument_title=\"PSEA\", instrument_type=\"Act\", url=\"https://example.com\")],\n            confidence=\"high\",\n            retrieval_status=RetrievalStatus(instruments_attempted=1, instruments_successfully_retrieved=1),\n        )\n        await db.save_agent_response(record)\n        results = await db.get_agent_responses(saved_query)\n        assert len(results) == 1\n        assert results[0].agent_id == \"staffing\"\n\n    @pytest.mark.asyncio\n    async def test_get_agent_responses_empty_for_unknown_query(self, db):\n        results = await db.get_agent_responses(\"nonexistent\")\n        assert results == []\n\n\nclass TestOrchestratorResponse:\n    @pytest.mark.asyncio\n    async def test_save_and_get_orchestrator_response(self, db, saved_query):\n        from src.models.schemas import OrchestratorResponseRecord\n        record = OrchestratorResponseRecord(\n            response_id=str(uuid.uuid4()),\n            query_id=saved_query,\n            summary=\"Summary text\",\n            overall_confidence=\"medium\",\n        )\n        await db.save_orchestrator_response(record)\n        result = await db.get_orchestrator_response(saved_query)\n        assert result is not None\n        assert result.summary == \"Summary text\"\n\n    @pytest.mark.asyncio\n    async def test_returns_none_for_missing_orchestrator_response(self, db):\n        result = await db.get_orchestrator_response(\"nonexistent\")\n        assert result is None\n\n\nclass TestFeedback:\n    @pytest.mark.asyncio\n    async def test_save_and_get_feedback(self, db, saved_query):\n        from src.models.schemas import FeedbackRecord\n        record = FeedbackRecord(\n            feedback_id=str(uuid.uuid4()),\n            query_id=saved_query,\n            rating=\"accurate\",\n            comment=\"Very helpful\",\n        )\n        await db.save_feedback(record)\n        result = await db.get_feedback_for_query(saved_query)\n        assert result is not None\n        assert result.rating == \"accurate\"\n\n    @pytest.mark.asyncio\n    async def test_export_feedback_returns_list(self, db, saved_query):\n        from src.models.schemas import FeedbackRecord\n        record = FeedbackRecord(\n            feedback_id=str(uuid.uuid4()),\n            query_id=saved_query,\n            rating=\"needs_work\",\n        )\n        await db.save_feedback(record)\n        exported = await db.export_feedback()\n        assert len(exported) >= 1\n        assert isinstance(exported[0], dict)\n\n\nclass TestCacheOperations:\n    @pytest.mark.asyncio\n    async def test_set_and_get_cached(self, db):\n        from src.models.schemas import FetchCacheEntry\n        entry = FetchCacheEntry(\n            url=\"https://example.com/doc\",\n            content_text=\"policy text\",\n            content_hash=\"abc123\",\n            ttl_hours=720,\n            status_code=200,\n        )\n        await db.set_cached(entry)\n        result = await db.get_cached(\"https://example.com/doc\")\n        assert result is not None\n        assert result.content_text == \"policy text\"\n\n    @pytest.mark.asyncio\n    async def test_get_cached_returns_none_on_miss(self, db):\n        result = await db.get_cached(\"https://nonexistent.example.com\")\n        assert result is None\n\n    @pytest.mark.asyncio\n    async def test_clear_expired_removes_old_entries(self, db):\n        from src.models.schemas import FetchCacheEntry\n        from datetime import timedelta\n        expired_entry = FetchCacheEntry(\n            url=\"https://expired.example.com\",\n            content_text=\"old\",\n            content_hash=\"def\",\n            ttl_hours=1,\n            fetched_at=datetime.utcnow() - timedelta(hours=48),\n        )\n        await db.set_cached(expired_entry)\n        deleted = await db.clear_expired()\n        assert deleted >= 1\n        result = await db.get_stale(\"https://expired.example.com\")\n        assert result is None"
