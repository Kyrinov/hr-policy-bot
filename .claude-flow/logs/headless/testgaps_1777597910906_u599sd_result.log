        "title": "tests/test_llm_client.py",
        "content": "\"\"\"Tests for GeminiClient.\"\"\"\n\nimport asyncio\nimport pytest\nfrom unittest.mock import AsyncMock, MagicMock, patch, PropertyMock\n\n\nclass TestSafeText:\n    def test_returns_text_on_valid_response(self):\n        from src.llm.client import _safe_text\n        mock_resp = MagicMock()\n        mock_resp.text = \"hello\"\n        assert _safe_text(mock_resp) == \"hello\"\n\n    def test_returns_empty_string_on_blocked_content(self):\n        from src.llm.client import _safe_text\n        mock_resp = MagicMock()\n        type(mock_resp).text = PropertyMock(side_effect=ValueError(\"blocked\"))\n        assert _safe_text(mock_resp) == \"\"\n\n\nclass TestGeminiClientInit:\n    def test_raises_without_api_key(self, monkeypatch):\n        monkeypatch.delenv(\"GEMINI_API_KEY\", raising=False)\n        # Clear singleton so __init__ runs fresh\n        import src.llm.client as mod\n        mod._client = None\n        with pytest.raises(RuntimeError, match=\"GEMINI_API_KEY\"):\n            from src.llm.client import GeminiClient\n            GeminiClient()\n\n    def test_creates_semaphore_with_max_concurrent(self, monkeypatch):\n        monkeypatch.setenv(\"GEMINI_API_KEY\", \"fake-key\")\n        with patch(\"google.generativeai.configure\"):\n            from src.llm.client import GeminiClient\n            client = GeminiClient()\n        assert client._semaphore._value == 3  # _MAX_CONCURRENT\n\n\nclass TestGeminiGenerate:\n    @pytest.mark.asyncio\n    async def test_returns_text_on_success(self, monkeypatch):\n        monkeypatch.setenv(\"GEMINI_API_KEY\", \"fake-key\")\n        with patch(\"google.generativeai.configure\"):\n            from src.llm.client import GeminiClient\n            client = GeminiClient()\n\n        mock_model = AsyncMock()\n        mock_response = MagicMock()\n        mock_response.text = \"response text\"\n        mock_model.generate_content_async = AsyncMock(return_value=mock_response)\n\n        result = await client._generate(mock_model, [])\n        assert result == \"response text\"\n\n    @pytest.mark.asyncio\n    async def test_retries_on_rate_limit_then_succeeds(self, monkeypatch):\n        monkeypatch.setenv(\"GEMINI_API_KEY\", \"fake-key\")\n        from google.api_core.exceptions import ResourceExhausted\n        with patch(\"google.generativeai.configure\"):\n            from src.llm.client import GeminiClient\n            client = GeminiClient()\n\n        mock_model = AsyncMock()\n        good_response = MagicMock()\n        good_response.text = \"ok\"\n        mock_model.generate_content_async = AsyncMock(\n            side_effect=[ResourceExhausted(\"rate limited\"), good_response]\n        )\n        with patch(\"asyncio.sleep\", new_callable=AsyncMock):\n            result = await client._generate(mock_model, [], max_retries=2)\n        assert result == \"ok\"\n\n    @pytest.mark.asyncio\n    async def test_raises_after_exhausting_retries(self, monkeypatch):\n        monkeypatch.setenv(\"GEMINI_API_KEY\", \"fake-key\")\n        from google.api_core.exceptions import ResourceExhausted\n        with patch(\"google.generativeai.configure\"):\n            from src.llm.client import GeminiClient\n            client = GeminiClient()\n\n        mock_model = AsyncMock()\n        mock_model.generate_content_async = AsyncMock(\n            side_effect=ResourceExhausted(\"rate limited\")\n        )\n        with patch(\"asyncio.sleep\", new_callable=AsyncMock):\n            with pytest.raises(ResourceExhausted):\n                await client._generate(mock_model, [], max_retries=2)\n\n    @pytest.mark.asyncio\n    async def test_chat_parsed_returns_dict(self, monkeypatch):\n        monkeypatch.setenv(\"GEMINI_API_KEY\", \"fake-key\")\n        with patch(\"google.generativeai.configure\"):\n            from src.llm.client import GeminiClient\n            client = GeminiClient()\n\n        with patch.object(client, \"_generate\", new_callable=AsyncMock) as mock_gen:\n            mock_gen.return_value = '{\"key\": \"value\"}'\n            result = await client.chat_parsed(\"sys\", \"msg\")\n        assert result == {\"key\": \"value\"}\n\n    @pytest.mark.asyncio\n    async def test_chat_parsed_returns_raw_on_json_error(self, monkeypatch):\n        monkeypatch.setenv(\"GEMINI_API_KEY\", \"fake-key\")\n        with patch(\"google.generativeai.configure\"):\n            from src.llm.client import GeminiClient\n            client = GeminiClient()\n\n        with patch.object(client, \"_generate\", new_callable=AsyncMock) as mock_gen:\n            mock_gen.return_value = \"not valid json\"\n            result = await client.chat_parsed(\"sys\", \"msg\")\n        assert \"_raw\" in result\n        assert \"_parse_error\" in result\n```\n\n```python\n",
