        "title": "tests/test_parsing/test_sage_extractor_extended.py",
        "content": "\nimport pytest\nfrom unittest.mock import AsyncMock, MagicMock\nfrom src.parsing.kiss_parser import KISSParser\nfrom src.parsing.sage_extractor import SageExtractor\nfrom src.models.schemas import KISSDocument, KISSToken\n\n\ndef _make_token(text, lemma, pos, category, is_deontic, deontic_type, start, end, sent_idx, tok_idx):\n    return KISSToken(\n        text=text, lemma=lemma, pos=pos, kiss_category=category,\n        is_deontic=is_deontic, deontic_type=deontic_type,\n        char_start=start, char_end=end,\n        sentence_idx=sent_idx, token_idx=tok_idx,\n    )\n\n\nclass TestValidationFlags:\n    def setup_method(self):\n        self.parser = KISSParser()\n        self.extractor = SageExtractor(parser=self.parser)\n\n    def test_unanchored_obligation_flag(self):\n        # Subject is \"supervisor\" (not in _GC_ACTORS), predicate is \"must\" (obligation)\n        doc = self.parser.parse_document(\n            \"The supervisor must complete the form.\", \"https://x.com\", \"Policy\", \"governance\"\n        )\n        triples = self.extractor.extract_triples(doc, \"doc-unanchored\")\n        obligation_triples = [t for t in triples if t.deontic_type == \"obligation\"]\n        unanchored = [t for t in obligation_triples if \"UNANCHORED_OBLIGATION\" in t.validation_flags]\n        assert len(unanchored) >= 1\n\n    def test_discretionary_right_flag(self):\n        doc = self.parser.parse_document(\n            \"An employee may request leave.\", \"https://x.com\", \"Policy\", \"governance\"\n        )\n        triples = self.extractor.extract_triples(doc, \"doc-discretion\")\n        discretion_triples = [t for t in triples if \"DISCRETIONARY_RIGHT\" in t.validation_flags]\n        assert len(discretion_triples) >= 1\n\n    def test_potential_conflict_flag(self):\n        parser = KISSParser()\n        extractor = SageExtractor(parser=parser)\n        doc1 = parser.parse_document(\n            \"The employee must submit the form.\", \"https://x.com\", \"P1\", \"governance\"\n        )\n        doc2 = parser.parse_document(\n            \"The employee must submit the report.\", \"https://x.com\", \"P2\", \"governance\"\n        )\n        triples = extractor.extract_triples(doc1, \"d1\") + extractor.extract_triples(doc2, \"d2\")\n        combined = extractor._apply_cross_sentence_rules(triples)\n        conflict_triples = [t for t in combined if \"POTENTIAL_CONFLICT\" in t.validation_flags]\n        assert len(conflict_triples) >= 1\n\n    def test_no_triple_when_fewer_than_two_entities(self):\n        doc = self.parser.parse_document(\n            \"Must comply.\", \"https://x.com\", \"Policy\", \"governance\"\n        )\n        triples = self.extractor.extract_triples(doc, \"doc-no-entities\")\n        assert triples == []\n\n\nclass TestInstrumentForUrl:\n    def setup_method(self):\n        self.extractor = SageExtractor()\n\n    def test_unknown_url_returns_none(self):\n        result = self.extractor._instrument_for_url(\"https://unknown-domain.example.com/policy\")\n        assert result is None\n\n    def test_fulltext_url_normalization(self):\n        # Should match instrument whose URL is the base without /FullText.html\n        result = self.extractor._instrument_for_url(\n            \"https://laws-lois.justice.gc.ca/eng/acts/P-33.3/FullText.html\"\n        )\n        # Result may be None if URL not in registry — test the matching logic\n        from pathlib import Path\n        import json\n        registry = json.loads(Path(\"src/data/policy_registry.json\").read_text())\n        for instrument in registry:\n            url = instrument.get(\"url\", \"\")\n            if url.endswith(\"/FullText.html\"):\n                base = url.removesuffix(\"/FullText.html\")\n                matched = self.extractor._instrument_for_url(base)\n                assert matched is not None\n                break\n\n\n@pytest.mark.asyncio\nasync def test_process_document_for_url_unknown_returns_empty():\n    extractor = SageExtractor()\n    result = await extractor.process_document_for_url(\"https://not-in-registry.example.com\", \"text\")\n    assert result == []\n```\n\n---\n\n",
