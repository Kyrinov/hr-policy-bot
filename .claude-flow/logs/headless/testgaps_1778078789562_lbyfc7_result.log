        "title": "tests/test_parsing/test_kiss_parser_extended.py",
        "content": "\nimport pytest\nfrom src.parsing.kiss_parser import KISSParser\nfrom src.parsing.gc_entities import GCEntityMatcher\n\n\nclass TestKISSParserGuessPOS:\n    def setup_method(self):\n        self.parser = KISSParser()\n\n    def test_guess_pos_deontic_returns_aux(self):\n        assert self.parser._guess_pos(\"must\") == \"AUX\"\n        assert self.parser._guess_pos(\"shall\") == \"AUX\"\n\n    def test_guess_pos_stopword_returns_det(self):\n        assert self.parser._guess_pos(\"the\") == \"DET\"\n        assert self.parser._guess_pos(\"a\") == \"DET\"\n\n    def test_guess_pos_common_verb_returns_verb(self):\n        assert self.parser._guess_pos(\"approve\") == \"VERB\"\n\n    def test_guess_pos_ing_suffix_returns_verb(self):\n        assert self.parser._guess_pos(\"approving\") == \"VERB\"\n\n    def test_guess_pos_uppercase_returns_propn(self):\n        assert self.parser._guess_pos(\"Treasury\") == \"PROPN\"\n\n    def test_guess_pos_digit_returns_propn(self):\n        assert self.parser._guess_pos(\"02\") == \"PROPN\"\n\n    def test_guess_pos_punct_returns_punct(self):\n        assert self.parser._guess_pos(\".\") == \"PUNCT\"\n\n\nclass TestKISSParserEdgeCases:\n    def setup_method(self):\n        self.parser = KISSParser()\n\n    def test_empty_text_produces_empty_tokens(self):\n        doc = self.parser.parse_document(\"\", \"https://example.com\", \"Test\", \"staffing\")\n        assert doc.tokens == []\n\n    def test_no_deontic_verbs(self):\n        doc = self.parser.parse_document(\n            \"The employee works in Ottawa.\", \"https://example.com\", \"Test\", \"staffing\"\n        )\n        assert not any(t.is_deontic for t in doc.tokens)\n\n    def test_multi_sentence_assigns_correct_sentence_idx(self):\n        doc = self.parser.parse_document(\n            \"The employee must comply. The manager shall approve.\",\n            \"https://example.com\",\n            \"Test\",\n            \"staffing\",\n        )\n        indices = {t.sentence_idx for t in doc.tokens}\n        assert len(indices) >= 2, \"Expected tokens in at least two sentences\"\n\n    def test_heuristic_fallback_produces_tokens(self):\n        # Force heuristic path by injecting _nlp=None\n        parser = KISSParser()\n        parser._nlp = None\n        doc = parser.parse_document(\n            \"Employee must comply.\", \"https://example.com\", \"Policy\", \"staffing\"\n        )\n        assert len(doc.tokens) > 0\n        assert doc.model_version == \"heuristic\"\n\n    def test_classify_token_punctuation(self):\n        cat, is_d, d_type = self.parser.classify_token(\".\", \".\", \"PUNCT\")\n        assert cat == \"PUNCTUATION\"\n        assert not is_d\n\n    def test_classify_token_deontic_priority(self):\n        # \"must\" should be deontic regardless of pos supplied\n        cat, is_d, d_type = self.parser.classify_token(\"must\", \"must\", \"AUX\")\n        assert cat == \"VERB\"\n        assert is_d\n        assert d_type == \"obligation\"\n\n\nclass TestSentenceSpans:\n    def setup_method(self):\n        self.parser = KISSParser()\n\n    def test_single_sentence_no_punctuation(self):\n        spans = self.parser._sentence_spans(\"no period here\")\n        assert len(spans) == 1\n\n    def test_multiple_sentences(self):\n        spans = self.parser._sentence_spans(\"First. Second. Third.\")\n        assert len(spans) >= 2\n```\n\n---\n\n",
