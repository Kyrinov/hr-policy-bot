tion remains open for next message\n            ws.send_json({\"type\": \"ping\"})\n\n\nclass TestProcessQueryFunction:\n    @pytest.mark.asyncio\n    async def test_process_query_saves_to_db(self):\n        from src.api.websocket import process_query\n        mock_ws = MagicMock()\n        mock_ws.send_json = AsyncMock()\n        mock_ws.send_text = AsyncMock()\n\n        with patch(\"src.api.websocket.get_db\") as mock_db_fn, \\\n             patch(\"src.api.websocket.get_orchestrator\") as mock_orch_fn:\n            mock_db = MagicMock()\n            mock_db.save_query = AsyncMock()\n            mock_db.save_agent_response = AsyncMock()\n            mock_db.save_orchestrator_response = AsyncMock()\n            mock_db_fn.return_value = mock_db\n\n            mock_orch = MagicMock()\n            mock_orch.process_with_streaming = AsyncMock(return_value=MagicMock(\n                query_id=\"q\", synthesis=\"s\", citations=[], confidence_summary=\"high\",\n                routing_decision=MagicMock(agents_selected=[\"staffing\"]),\n            ))\n            mock_orch_fn.return_value = mock_orch\n\n            await process_query(mock_ws, \"What is PRI?\", \"sess-1\")\n\n        assert mock_db.save_query.called\n        assert mock_db.save_orchestrator_response.called\n\n    @pytest.mark.asyncio\n    async def test_process_query_sends_ws_error_on_exception(self):\n        from src.api.websocket import process_query\n        mock_ws = MagicMock()\n        mock_ws.send_json = AsyncMock()\n\n        with patch(\"src.api.websocket.get_db\") as mock_db_fn, \\\n             patch(\"src.api.websocket.get_orchestrator\") as mock_orch_fn:\n            mock_db = MagicMock()\n            mock_db.save_query = AsyncMock()\n            mock_db_fn.return_value = mock_db\n\n            mock_orch = MagicMock()\n            mock_orch.process_with_streaming = AsyncMock(side_effect=RuntimeError(\"LLM timeout\"))\n            mock_orch_fn.return_value = mock_orch\n\n            await 