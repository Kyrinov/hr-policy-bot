        "code": "# tests/test_fetch_engine.py\nimport pytest\nfrom unittest.mock import AsyncMock, patch, MagicMock\nfrom src.fetch.engine import FetchEngine\n\n\n@pytest.fixture\ndef engine():\n    return FetchEngine()\n\n\n@pytest.mark.asyncio\nclass TestFetchSingle:\n    async def test_fetch_returns_content_on_success(self, engine):\n        with patch.object(engine, \"_fetch_url\", new_callable=AsyncMock) as mock_fetch:\n            mock_fetch.return_value = \"<html><body>Policy text</body></html>\"\n            result = await engine.fetch(\"https://laws.gc.ca/psea\")\n        assert result is not None\n        assert \"Policy\" in result\n\n    async def test_fetch_returns_none_on_http_error(self, engine):\n        with patch.object(engine, \"_fetch_url\", side_effect=Exception(\"404 Not Found\")):\n            with patch.object(engine, \"_get_stale_fallback\", new_callable=AsyncMock, return_value=None):\n                result = await engine.fetch(\"https://bad.gc.ca/missing\")\n        assert result is None\n\n    async def test_fetch_falls_back_to_stale_cache_on_failure(self, engine):\n        with patch.object(engine, \"_fetch_url\", side_effect=Exception(\"Network error\")):\n            with patch.object(engine, \"_get_stale_fallback\", new_callable=AsyncMock, return_value=\"Stale content\"):\n                result = await engine.fetch(\"https://example.gc.ca/policy\")\n        assert result == \"Stale content\"\n\n    async def test_fetch_normalizes_laws_lois_url(self, engine):\n        \"\"\"laws-lois.justice.gc.ca URLs should be rewritten to eng/acts path.\"\"\"\n        with patch.object(engine, \"_fetch_url\", new_callable=AsyncMock) as mock_fetch:\n            mock_fetch.return_value = \"<html><body>Act content</body></html>\"\n            await engine.fetch(\"https://laws-lois.justice.gc.ca/eng/acts/P-33.3/\")\n        called_url = mock_fetch.call_args[0][0]\n        assert \"laws-lois.justice.gc.ca\" in called_url\n\n\n@pytest.mark.asyncio\nclass TestFetchBatch:\n    async def test_fetch_batch_returns_dict(self, engine):\n        urls = [\"https://gc.ca/a\", \"https://gc.ca/b\"]\n        with patch.object(engine, \"fetch\", new_callable=AsyncMock) as mock_fetch:\n            mock_fetch.side_effect = [\"content-a\", \"content-b\"]\n            results = await engine.fetch_batch(urls)\n        assert len(results) == 2\n        assert results[\"https://gc.ca/a\"] == \"content-a\"\n\n    async def test_fetch_batch_partial_failure(self, engine):\n        urls = [\"https://gc.ca/ok\", \"https://gc.ca/fail\"]\n        with patch.object(engine, \"fetch\", new_callable=AsyncMock) as mock_fetch:\n            mock_fetch.side_effect = [\"content-ok\", None]\n            results = await engine.fetch_batch(urls)\n        assert results[\"https://gc.ca/ok\"] == \"content-ok\"\n        assert results[\"https://gc.ca/fail\"] is None\n\n    async def test_fetch_batch_empty_input(self, engine):\n        results = await engine.fetch_batch([])\n        assert results == {}\n\n    async def test_domain_rate_limit_respected(self, engine):\n        \"\"\"Concurrent fetches to the same domain should not exceed 3.\"\"\"\n        import asyncio\n        active = []\n        peak = [0]\n\n        async def mock_fetch(url):\n            active.append(url)\n            peak[0] = max(peak[0], len(active))\n            await asyncio.sleep(0.05)\n            active.pop()\n            return \"content\"\n\n        with patch.object(engine, \"_fetch_url\", side_effect=mock_fetch):\n            urls = [f\"https://tbs-sct.gc.ca/page{i}\" for i in range(6)]\n            await engine.fetch_batch(urls)\n        assert peak[0] <= 3"
      },
