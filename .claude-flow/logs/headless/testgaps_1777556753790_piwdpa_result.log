        "code": "# tests/test_orchestrator.py\n\"\"\"Tests for OrchestratorAgent — mocks LLM to avoid real API calls.\"\"\"\n\nimport json\nimport pytest\nfrom unittest.mock import AsyncMock, MagicMock, patch\n\n\n@pytest.fixture(autouse=True)\ndef mock_gemini(monkeypatch):\n    monkeypatch.setenv(\"GEMINI_API_KEY\", \"test-key\")\n    with patch(\"google.generativeai.configure\"), \\\n         patch(\"google.generativeai.GenerativeModel\"):\n        yield\n\n\n@pytest.fixture\ndef orchestrator():\n    # Reset singleton before each test\n    import src.agents.orchestrator as mod\n    mod.ORCHESTRATOR = None\n    import src.llm.client as llm_mod\n    llm_mod._client = None\n    from src.agents.orchestrator import OrchestratorAgent\n    orch = OrchestratorAgent()\n    orch._llm_client = MagicMock()\n    return orch\n\n\nclass TestBuildSynthesisPrompt:\n    def test_includes_query_and_agent_findings(self, orchestrator):\n        responses = [\n            {\"agent_id\": \"staffing\", \"findings\": \"Staffing rules apply.\", \"confidence\": \"high\", \"citations\": []},\n        ]\n        prompt = orchestrator._build_synthesis_prompt(\"Can I hire externally?\", responses)\n        assert \"Can I hire externally?\" in prompt\n        assert \"STAFFING\" in prompt\n        assert \"Staffing rules apply.\" in prompt\n\n    def test_empty_specialist_responses(self, orchestrator):\n        prompt = orchestrator._build_synthesis_prompt(\"Any query\", [])\n        assert \"Any query\" in prompt\n        assert \"SPECIALIST RESPONSES\" in prompt\n\n\nclass TestAggregateCitations:\n    def test_deduplicates_same_url_across_agents(self, orchestrator):\n        responses = [\n            {\"agent_id\": \"staffing\", \"citations\": [\n                {\"instrument_title\": \"PSEA\", \"instrument_type\": \"Act\", \"url\": \"https://example.com/psea\"}\n            ]},\n            {\"agent_id\": \"labour\", \"citations\": [\n                {\"instrument_title\": \"PSEA\", \"instrument_type\": \"Act\", \"url\": \"https://example.com/psea\"}\n            ]},\n        ]\n        citations = orchestrator._aggregate_citations(responses)\n        assert len(citations) == 1\n\n    def test_preserves_unique_citations(self, orchestrator):\n        responses = [\n            {\"agent_id\": \"staffing\", \"citations\": [\n                {\"instrument_title\": \"PSEA\", \"instrument_type\": \"Act\", \"url\": \"https://example.com/psea\"}\n            ]},\n            {\"agent_id\": \"labour\", \"citations\": [\n                {\"instrument_title\": \"FPSLRA\", \"instrument_type\": \"Act\", \"url\": \"https://example.com/fpslra\"}\n            ]},\n        ]\n        citations = orchestrator._aggregate_citations(responses)\n        assert len(citations) == 2\n\n    def test_empty_responses(self, orchestrator):\n        assert orchestrator._aggregate_citations([]) == []\n\n\nclass TestProcess:\n    @pytest.mark.asyncio\n    async def test_returns_orchestrator_response_on_valid_json(self, orchestrator):\n        valid_payload = {\n            \"summary\": \"Direct answer.\",\n            \"detailed_analysis\": \"Full analysis.\",\n            \"citations\": [],\n            \"agents_consulted\": [\"staffing\"],\n            \"overall_confidence\": \"high\",\n        }\n        orchestrator._llm_client.chat = AsyncMock(return_value=json.dumps(valid_payload))\n        result = await orchestrator.process(\"test query\", [])\n        assert result.summary == \"Direct answer.\"\n        assert result.overall_confidence == \"high\"\n\n    @pytest.mark.asyncio\n    async def test_returns_error_response_on_bad_json(self, orchestrator):\n        orchestrator._llm_client.chat = AsyncMock(return_value=\"not valid json {{{\")\n        result = await orchestrator.process(\"test query\", [])\n        assert result.overall_confidence == \"low\"\n        assert \"error\" in result.summary.lower()\n\n\nclass TestRoute:\n    @pytest.mark.asyncio\n    async def test_returns_parsed_routing_on_valid_response(self, orchestrator):\n        routing = {\"selected_agents\": [\"staffing\"], \"sub_queries\": {\"staffing\": \"sub q\"}}\n        orchestrator._llm_client.chat = AsyncMock(return_value=json.dumps(routing))\n        result = await orchestrator._route(\"test query\")\n        assert result[\"selected_agents\"] == [\"staffing\"]\n\n    @pytest.mark.asyncio\n    async def test_falls_back_to_all_agents_on_llm_failure(self, orchestrator):\n        orchestrator._llm_client.chat = AsyncMock(side_effect=Exception(\"LLM down\"))\n        result = await orchestrator._route(\"test query\")\n        assert len(result[\"selected_agents\"]) == 8"
