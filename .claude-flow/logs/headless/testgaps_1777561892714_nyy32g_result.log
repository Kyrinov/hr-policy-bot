esults = await db.get_agent_responses(query_id)\n        assert len(results) == 1\n        assert results[0].agent_id == \"staffing\"\n\n    @pytest.mark.asyncio\n    async def test_get_agent_responses_returns_empty_for_unknown_query(self, db):\n        result = await db.get_agent_responses(\"nonexistent-id\")\n        assert result == []\n\n\nclass TestOrchestratorResponseRoundTrip:\n    @pytest.mark.asyncio\n    async def test_save_and_retrieve_orchestrator_response(self, db):\n        query_id = str(uuid.uuid4())\n        await db.save_query(QueryRecord(query_id=query_id, query_text=\"q\"))\n\n        record = OrchestratorResponseRecord(\n            response_id=str(uuid.uuid4()),\n            query_id=query_id,\n            summary=\"Direct answer\",\n            overall_confidence=\"high\",\n        )\n        await db.save_orchestrator_response(record)\n        result = await db.get_orchestrator_response(query_id)\n        assert result is not None\n        assert result.summary == \"Direct answer\"\n\n    @pytest.mark.asyncio\n    async def test_get_orchestrator_response_returns_none_for_missing(self, db):\n        assert await db.get_orchestrator_response(\"nonexistent\") is None\n\n\nclass TestFeedback:\n    @pytest.mark.asyncio\n    async def test_save_and_retrieve_feedback(self, db):\n        query_id = str(uuid.uuid4())\n        await db.save_query(QueryRecord(query_id=query_id, query_text=\"q\"))\n\n        record = FeedbackRecord(\n            feedback_id=str(uuid.uuid4()),\n            query_id=query_id,\n            rating=\"accurate\",\n            comment=\"Very helpful\",\n        )\n        await db.save_feedback(record)\n        result = await db.get_feedback_for_query(query_id)\n        assert result is not None\n        assert result.rating == \"accurate\"\n\n    @pytest.mark.asyncio\n    async def test_export_feedback_returns_all_records(self, db):\n        query_id = str(uuid.uuid4())\n        await db.save_query(QueryRecord(query_id=query_id, query_text=\"q\"))\n        await db.save_feedback(FeedbackRecord(feedback_id=str(uuid.uuid4()), query_id=query_id, rating=\"needs_work\"))\n        exported = await db.export_feedback()\n        assert len(exported) >= 1\n        assert isinstance(exported[0], dict)\n\n\nclass TestCacheOperations:\n    @pytest.mark.asyncio\n    async def test_get_cached_returns_none_before_set(self, db):\n        result = await db.get_cached(\"https://example.com\")\n        assert result is None\n\n    @pytest.mark.asyncio\n    async def test_clear_expired_returns_row_count(self, db):\n        count = await db.clear_expired()\n        assert isinstance(count, int)\n        assert count >= 0"
