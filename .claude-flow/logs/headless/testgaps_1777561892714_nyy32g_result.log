        "content": "import pytest\nimport uuid\nfrom pathlib import Path\nfrom unittest.mock import AsyncMock, MagicMock, patch\nfrom src.data.db import DatabaseManager\nfrom src.models.schemas import QueryRecord\n\n\nclass TestFullQueryPipeline:\n    \"\"\"End-to-end: query → orchestrator → DB persistence.\"\"\"\n\n    @pytest.mark.asyncio\n    async def test_query_saved_with_confidence_after_processing(self, tmp_path):\n        db = DatabaseManager(db_path=tmp_path / \"test.db\")\n        await db.initialize()\n\n        query_id = str(uuid.uuid4())\n        record = QueryRecord(query_id=query_id, query_text=\"What is acting pay?\", agents_invoked=[\"staffing\"], overall_confidence=\"high\")\n        await db.save_query(record)\n\n        retrieved = await db.get_query(query_id)\n        assert retrieved.overall_confidence == \"high\"\n        assert \"staffing\" in retrieved.agents_invoked\n\n    @pytest.mark.asyncio\n    async def test_orchestrator_response_persisted_after_query(self, tmp_path):\n        \"\"\"Verify that saving an orchestrator response is retrievable by query_id.\"\"\"\n        from src.models.schemas import OrchestratorResponseRecord\n        db = DatabaseManager(db_path=tmp_path / \"test.db\")\n        await db.initialize()\n\n        query_id = str(uuid.uuid4())\n        await db.save_query(QueryRecord(query_id=query_id, query_text=\"q\"))\n\n        or_record = OrchestratorResponseRecord(\n            response_id=str(uuid.uuid4()),\n            query_id=query_id,\n            summary=\"Acting pay is...\",\n            overall_confidence=\"medium\",\n        )\n        await db.save_orchestrator_response(or_record)\n        result = await db.get_orchestrator_response(query_id)\n        assert result.summary == \"Acting pay is...\"\n```\n\n---\n\n",
