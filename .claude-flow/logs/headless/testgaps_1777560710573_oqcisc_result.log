        "content": "import pytest\nfrom unittest.mock import AsyncMock, MagicMock, patch\n\nclass TestBuildPolicyContext:\n    def test_empty_fetched_returns_empty_string(self):\n        from src.agents.specialist import SpecialistAgent\n        agent = SpecialistAgent.__new__(SpecialistAgent)\n        assert agent._build_policy_context([]) == \"\"\n\n    def test_includes_title_and_url(self):\n        from src.agents.specialist import SpecialistAgent\n        agent = SpecialistAgent.__new__(SpecialistAgent)\n        instrument = {\"title\": \"PSEA\", \"type\": \"Act\", \"url\": \"https://example.com\"}\n        result = agent._build_policy_context([(instrument, \"policy text here\")])\n        assert \"PSEA\" in result\n        assert \"https://example.com\" in result\n\nclass TestParseResponse:\n    def test_valid_json_parsed_correctly(self):\n        from src.agents.specialist import SpecialistAgent\n        import json\n        agent = SpecialistAgent.__new__(SpecialistAgent)\n        agent._agent_id = \"staffing\"\n        raw = json.dumps({\n            \"agent_id\": \"staffing\",\n            \"findings\": \"Finding text\",\n            \"citations\": [],\n            \"confidence\": \"high\",\n        })\n        from src.models.schemas import RetrievalStatus\n        result = agent._parse_response(raw, 2, 2, [])\n        assert result.confidence == \"high\"\n\n    def test_unparseable_returns_low_confidence_with_raw_text(self):\n        from src.agents.specialist import SpecialistAgent\n        agent = SpecialistAgent.__new__(SpecialistAgent)\n        agent._agent_id = \"staffing\"\n        from src.models.schemas import RetrievalStatus\n        result = agent._parse_response(\"this is not json\", 1, 0, [\"doc.pdf\"])\n        assert result.confidence == \"low\"\n        assert result.findings == \"this is not json\"\n        assert result.retrieval_status.instruments_failed == [\"doc.pdf\"]\n\nclass TestProcessWithFetch:\n    @pytest.mark.asyncio\n    async def test_no_fetch_engine_skips_http_calls(self):\n        from src.agents.specialist import SpecialistAgent\n        from unittest.mock import patch, AsyncMock\n        import json\n        with patch(\"src.agents.specialist.get_client\") as mock_client, \\\n             patch(\"src.agents.specialist.get_specialist_prompt\", return_value=\"prompt\"), \\\n             patch.object(SpecialistAgent, \"_load_instruments\", return_value=[]):\n            payload = json.dumps({\n                \"agent_id\": \"staffing\", \"findings\": \"No instruments\",\n                \"citations\": [], \"confidence\": \"low\",\n            })\n            mock_client.return_value.chat = AsyncMock(return_value=payload)\n            agent = SpecialistAgent(\"staffing\", \"Staffing\", \"domain\")\n            result = await agent.process_with_fetch(\"test query\", None)\n        assert result.retrieval_status.instruments_attempted == 0\n```\n\n---\n\n",
