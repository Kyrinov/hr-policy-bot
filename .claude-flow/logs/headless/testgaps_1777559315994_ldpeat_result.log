        "code": "# tests/test_fetch_engine.py\n\"\"\"Unit tests for FetchEngine.\"\"\"\n\nimport pytest\nfrom unittest.mock import AsyncMock, MagicMock, patch\n\nimport httpx\nfrom src.fetch.engine import FetchEngine, FetchError, cleanup_fetch_engine, get_fetch_engine\nfrom src.fetch.cache import CacheEntry\n\n\ndef make_engine(cache=None, extractor=None):\n    mock_cache = cache or AsyncMock()\n    mock_extractor = extractor or MagicMock()\n    with patch(\"src.fetch.engine.get_config\"):\n        return FetchEngine(cache=mock_cache, extractor=mock_extractor)\n\n\nclass TestNormalizeUrl:\n    def test_laws_act_url_rewritten(self):\n        engine = make_engine()\n        url = \"https://laws-lois.justice.gc.ca/eng/acts/P-33.3/\"\n        assert engine._normalize_url(url).endswith(\"/FullText.html\")\n\n    def test_non_laws_url_unchanged(self):\n        engine = make_engine()\n        url = \"https://tbs-sct.canada.ca/pol/some-policy\"\n        assert engine._normalize_url(url) == url\n\n    def test_laws_non_act_url_unchanged(self):\n        engine = make_engine()\n        url = \"https://laws-lois.justice.gc.ca/eng/regulations/SOR-2003-298/\"\n        # Only /acts/ pattern should be rewritten\n        result = engine._normalize_url(url)\n        assert result == url\n\n\nclass TestGetDomain:\n    def test_normal_url(self):\n        engine = make_engine()\n        assert engine._get_domain(\"https://tbs-sct.canada.ca/pol/x\") == \"tbs-sct.canada.ca\"\n\n    def test_malformed_url_returns_default(self):\n        engine = make_engine()\n        assert engine._get_domain(\"not-a-url\") == \"default\"\n\n\nclass TestFetch:\n    @pytest.mark.asyncio\n    async def test_cache_hit_returns_content(self):\n        mock_cache = AsyncMock()\n        mock_cache.get.return_value = CacheEntry(url=\"https://x.ca\", content=\"cached content\", ttl_hours=168)\n        engine = make_engine(cache=mock_cache)\n        result = await engine.fetch(\"https://x.ca\")\n        assert result == \"cached content\"\n        mock_cache.get.assert_called_once()\n\n    @pytest.mark.asyncio\n    async def test_cache_miss_fetches_and_stores(self):\n        mock_cache = AsyncMock()\n        mock_cache.get.return_value = None\n        mock_cache._get_default_ttl = MagicMock(return_value=168)\n        mock_extractor = MagicMock()\n        mock_extractor.extract.return_value = \"fetched content\"\n        engine = make_engine(cache=mock_cache, extractor=mock_extractor)\n\n        mock_response = MagicMock()\n        mock_response.text = \"<html>fetched content</html>\"\n        mock_response.status_code = 200\n        mock_response.raise_for_status = MagicMock()\n        engine._client.get = AsyncMock(return_value=mock_response)\n\n        result = await engine.fetch(\"https://x.ca\")\n        assert result == \"fetched content\"\n        mock_cache.set_cached.assert_called_once()\n\n    @pytest.mark.asyncio\n    async def test_http_failure_uses_stale_cache(self):\n        mock_cache = AsyncMock()\n        mock_cache.get.return_value = None\n        mock_cache.get_stale.return_value = CacheEntry(url=\"https://x.ca\", content=\"stale content\", ttl_hours=168)\n        engine = make_engine(cache=mock_cache)\n        engine._client.get = AsyncMock(side_effect=httpx.RequestError(\"timeout\"))\n\n        result = await engine.fetch(\"https://x.ca\")\n        assert result == \"stale content\"\n\n    @pytest.mark.asyncio\n    async def test_http_failure_no_stale_raises_fetch_error(self):\n        mock_cache = AsyncMock()\n        mock_cache.get.return_value = None\n        mock_cache.get_stale.return_value = None\n        engine = make_engine(cache=mock_cache)\n        engine._client.get = AsyncMock(side_effect=httpx.RequestError(\"timeout\"))\n\n        with pytest.raises(FetchError):\n            await engine.fetch(\"https://x.ca\")\n\n\nclass TestFetchBatch:\n    @pytest.mark.asyncio\n    async def test_returns_successful_results(self):\n        mock_cache = AsyncMock()\n        mock_cache.get.return_value = CacheEntry(url=\"\", content=\"ok\", ttl_hours=168)\n        engine = make_engine(cache=mock_cache)\n        # Patch fetch per-url\n        async def side_effect(url):\n            if url == \"https://fail.ca\":\n                raise FetchError(\"fail\")\n            return \"content\"\n        engine.fetch = side_effect\n\n        results = await engine.fetch_batch([\"https://ok.ca\", \"https://fail.ca\"])\n        assert \"https://ok.ca\" in results\n        assert \"https://fail.ca\" not in results\n\n\nclass TestCleanup:\n    @pytest.mark.asyncio\n    async def test_cleanup_clears_singleton(self):\n        import src.fetch.engine as mod\n        with patch(\"src.fetch.engine.get_config\"):\n            mod._engine = FetchEngine(cache=AsyncMock(), extractor=MagicMock())\n            mod._engine._client = AsyncMock()\n            await cleanup_fetch_engine()\n            assert mod._engine is None"
