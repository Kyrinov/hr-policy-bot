        "content": "import pytest\nfrom datetime import datetime, timedelta\nfrom src.fetch.cache import CacheEntry, FetchCache\nfrom src.data.db import DatabaseManager\n\n\n@pytest.fixture\nasync def db(tmp_path):\n    db = DatabaseManager(tmp_path / \"test.db\")\n    await db.initialize()\n    return db\n\n\n@pytest.fixture\ndef cache(db):\n    return FetchCache(db_manager=db)\n\n\nclass TestCacheEntry:\n    def test_content_hash_is_stable(self):\n        entry = CacheEntry(url=\"https://example.com\", content=\"hello\", ttl_hours=24)\n        assert entry.content_hash == entry.content_hash  # idempotent\n\n    def test_is_valid_returns_false_for_expired(self):\n        from src.models.schemas import FetchCacheEntry\n        # Can't set fetched_at directly on CacheEntry — use DB round-trip\n        # OR test the DB TTL query directly (see TestFetchCacheDB)\n\n    def test_truncation_not_triggered_under_limit(self):\n        entry = CacheEntry(url=\"https://x.com\", content=\"short\", ttl_hours=1)\n        assert entry.content == \"short\"\n\n\nclass TestFetchCacheTTL:\n    def test_legislation_domain_gets_720h_ttl(self, cache):\n        ttl = cache._get_default_ttl(\"https://laws-lois.justice.gc.ca/eng/acts/P-33.3/\")\n        assert ttl == 720\n\n    def test_collective_agreement_domain_gets_720h_ttl(self, cache):\n        ttl = cache._get_default_ttl(\"https://tbs-sct.canada.ca/agreements-conventions/view-visualiser-eng.aspx\")\n        assert ttl == 720\n\n    def test_unknown_domain_gets_config_default(self, cache):\n        ttl = cache._get_default_ttl(\"https://someotherdomain.gc.ca/policy\")\n        assert ttl == 168  # matches config.yaml default\n\n\n@pytest.mark.asyncio\nclass TestFetchCacheRoundTrip:\n    async def test_store_and_retrieve(self, cache):\n        await cache.store(\"https://example.com/doc\", \"content here\")\n        result = await cache.get(\"https://example.com/doc\")\n        assert result is not None\n        assert result.content == \"content here\"\n\n    async def test_get_returns_none_for_unknown_url(self, cache):\n        result = await cache.get(\"https://notcached.example.com/\")\n        assert result is None\n\n    async def test_get_stale_returns_entry_even_when_expired(self, cache, db):\n        # Store with TTL 0 (immediately expired)\n        from src.models.schemas import FetchCacheEntry\n        entry = FetchCacheEntry(\n            url=\"https://stale.example.com/\",\n            content_text=\"old content\",\n            content_hash=\"abc\",\n            fetched_at=datetime.utcnow() - timedelta(hours=200),\n            ttl_hours=1,\n        )\n        await db.set_cached(entry)\n        result = await cache.get_stale(\"https://stale.example.com/\")\n        assert result is not None\n        assert result.content == \"old content\"\n\n    async def test_clear_expired_removes_old_entries(self, cache, db):\n        from src.models.schemas import FetchCacheEntry\n        old = FetchCacheEntry(\n            url=\"https://old.example.com/\",\n            content_text=\"old\",\n            content_hash=\"x\",\n            fetched_at=datetime.utcnow() - timedelta(hours=500),\n            ttl_hours=1,\n        )\n        await db.set_cached(old)\n        deleted = await cache.clear_expired()\n        assert deleted >= 1\n        result = await cache.get(\"https://old.example.com/\")\n        assert result is None\n\n    async def test_health_check_returns_counts(self, cache):\n        health = await cache.health_check()\n        assert \"total\" in health\n        assert \"valid\" in health\n        assert \"expired\" in health\n```\n\n---\n\n",
        "level": 1
      },
      {
        "title": "Gap 2 — `FetchEngine` core logic (near-zero coverage)",
        "content": "\n**Untested:** `_normalize_url`, `_get_domain`, `fetch_batch`, cache-hit path in `_do_fetch`, stale-cache fallback, browser fallback, `FetchError` propagation, rate-limit delay logic.\n\n```python\n",
        "level": 2
      },
      {
        "title": "tests/test_fetch/test_engine.py",
        "content": "import asyncio\nimport pytest\nfrom unittest.mock import AsyncMock, MagicMock, patch\nfrom src.fetch.engine import FetchEngine, FetchError\nfrom src.fetch.cache import CacheEntry, FetchCache\n\n\nclass TestNormalizeURL:\n    def test_laws_lois_act_index_rewrites_to_fulltext(self):\n        engine = FetchEngine.__new__(FetchEngine)\n        result = engine._normalize_url(\"https://laws-lois.justice.gc.ca/eng/acts/P-33.3/\")\n        assert result.endswith(\"/FullText.html\")\n\n    def test_laws_lois_fulltext_url_unchanged(self):\n        engine = FetchEngine.__new__(FetchEngine)\n        url = \"https://laws-lois.justice.gc.ca/eng/acts/P-33.3/FullText.html\"\n        assert engine._normalize_url(url) == url\n\n    def test_non_laws_url_unchanged(self):\n        engine = FetchEngine.__new__(FetchEngine)\n        url = \"https://tbs-sct.canada.ca/pol/doc-eng.aspx?id=12345\"\n        assert engine._normalize_url(url) == url\n\n\nclass TestGetDomain:\n    def test_extracts_domain_correctly(self):\n        engine = FetchEngine.__new__(FetchEngine)\n        assert engine._get_domain(\"https://laws-lois.justice.gc.ca/eng/acts/\") == \"laws-lois.justice.gc.ca\"\n\n    def test_malformed_url_returns_default(self):\n        engine = FetchEngine.__new__(FetchEngine)\n        assert engine._get_domain(\"not-a-url\") == \"default\"\n\n\n@pytest.mark.asyncio\nclass TestFetchCacheHit:\n    async def test_returns_cached_content_without_http_request(self, tmp_path):\n        from src.data.db import DatabaseManager\n        db = DatabaseManager(tmp_path / \"test.db\")\n        await db.initialize()\n        cache = FetchCache(db_manager=db)\n        await cache.store(\"https://example.com/doc\", \"cached content\")\n\n        engine = FetchEngine(cache=cache)\n        # No HTTP call should be made — if it were made it would fail (no real server)\n        content = await engine.fetch(\"https://example.com/doc\")\n        assert content == \"cached content\"\n        await engine.close()\n\n    async def test_fetch_raises_fetch_error_when_all_fallbacks_fail(self, tmp_path):\n        from src.data.db import DatabaseManager\n        from src.fetch.browser import BrowserFetchError\n\n        db = DatabaseManager(tmp_path / \"test.db\")\n        await db.initialize()\n        cache = FetchCache(db_manager=db)\n        engine = FetchEngine(cache=cache)\n\n        with patch.object(engine._client, \"get\", side_effect=Exception(\"network error\")), \\\n             patch(\"src.fetch.engine.get_browser_fetcher\") as mock_browser:\n            mock_browser.return_value.fetch = AsyncMock(side_effect=BrowserFetchError(\"blocked\"))\n            with pytest.raises(FetchError):\n                await engine.fetch(\"https://example.com/unreachable\")\n        await engine.close()\n\n\n@pytest.mark.asyncio\nclass TestFetchBatch:\n    async def test_batch_returns_successful_fetches_only(self, tmp_path):\n        from src.data.db import DatabaseManager\n\n        db = DatabaseManager(tmp_path / \"test.db\")\n        await db.initialize()\n        cache = FetchCache(db_manager=db)\n        await cache.store(\"https://example.com/a\", \"content-a\")\n        # /b is not cached — fetch will fail\n\n        engine = FetchEngine(cache=cache)\n        with patch.object(engine._client, \"get\", side_effect=Exception(\"no network\")), \\\n             patch(\"src.fetch.engine.get_browser_fetcher\") as mock_browser:\n            mock_browser.return_value.fetch = AsyncMock(side_effect=Exception(\"blocked\"))\n            results = await engine.fetch_batch([\n                \"https://example.com/a\",\n                \"https://example.com/b\",\n            ])\n        assert \"https://example.com/a\" in results\n        assert \"https://example.com/b\" not in results\n        await engine.close()\n```\n\n---\n\n",
        "level": 1
      },
      {
        "title": "Gap 3 — `ContentExtractor` edge cases",
        "content": "\n**Untested:** domain-specific selector path, truncation at `max_length`, fallback when `<body>` is absent, `_format_content` heading/nested-div formatting, `_clean_text`, `_remove_elements`.\n\n```python\n",
        "level": 2
      },
      {
        "title": "tests/test_fetch/test_extractors.py",
        "content": "import pytest\nfrom src.fetch.extractors import ContentExtractor\n\n\n@pytest.fixture\ndef extractor():\n    return ContentExtractor()\n\n\nclass TestExtractorTruncation:\n    def test_content_truncated_at_max_length(self, extractor):\n        html = f\"<html><body><p>{'x' * 100_000}</p></body></html>\"\n        result = extractor.extract(\"https://example.com\", html, max_length=500)\n        assert len(result) <= 500\n\n    def test_short_content_not_truncated(self, extractor):\n        html = \"<html><body><p>short</p></body></html>\"\n        result = extractor.extract(\"https://example.com\", html, max_length=500)\n        assert \"...\" not in result\n\n\nclass TestExtractorHeadingFormatting:\n    def test_h2_heading_appears_in_output(self, extractor):\n        html = \"<html><body><h2>Section Title</h2><p>Body text.</p></body></html>\"\n        result = extractor.extract(\"https://example.com\", html)\n        assert \"Section Title\" in result\n        assert \"Body text\" in result\n\n\nclass TestExtractorRemoveElements:\n    def test_nav_elements_stripped(self, extractor):\n        html = \"<html><body><nav>Skip to main</nav><main><p>Policy text.</p></main></body></html>\"\n        result = extractor.extract(\"https://laws-lois.justice.gc.ca/eng/acts/P-33.3/\", html)\n        assert \"Skip to main\" not in result\n        assert \"Policy text\" in result\n\n\nclass TestExtractorFallback:\n    def test_empty_html_returns_empty_or_short_string(self, extractor):\n        result = extractor.extract(\"https://example.com\", \"\")\n        assert isinstance(result, str)\n\n    def test_no_body_tag_falls_back_gracefully(self, extractor):\n        result = extractor.extract(\"https://example.com\", \"<p>Just a paragraph.</p>\")\n        assert \"Just a paragraph\" in result\n```\n\n---\n\n",
        "level": 1
      },
      {
        "title": "Gap 4 — `DatabaseManager` untested methods",
        "content": "\n**Untested:** `save_agent_response`/`get_agent_responses`, `save_orchestrator_response`/`get_orchestrator_response`, `save_feedback`/`get_feedback_for_query`/`export_feedback`, `get_cached`/`get_stale`/`set_cached`/`clear_expired`, `save_policy_triples` (edge weight logic), `find_conflicting_triples`, `is_document_parsed`, `get_coverage_stats`, `list_queries`, `save_rule_refinement`.\n\n```python\n",
        "level": 2
      },
      {
        "title": "tests/test_data/test_db.py",
        "content": "import uuid\nimport pytest\nfrom datetime import datetime\nfrom src.data.db import DatabaseManager\nfrom src.models.schemas import (\n    AgentResponseRecord, CitationItem, FeedbackRecord, FetchCacheEntry,\n    KISSDocument, OrchestratorResponseRecord, OrchestratorCitation,\n    PolicyTriple, QueryRecord, RetrievalStatus,\n)\n\n\n@pytest.fixture\nasync def db(tmp_path):\n    db = DatabaseManager(tmp_path / \"test.db\")\n    await db.initialize()\n    return db\n\n\n@pytest.fixture\ndef query_id():\n    return str(uuid.uuid4())\n\n\n@pytest.fixture\nasync def saved_query(db, query_id):\n    record = QueryRecord(query_id=query_id, query_text=\"test query\", agents_invoked=[\"staffing\"])\n    await db.save_query(record)\n    return query_id\n\n\n@pytest.mark.asyncio\nclass TestAgentResponseRoundTrip:\n    async def test_save_and_retrieve(self, db, saved_query):\n        record = AgentResponseRecord(\n            response_id=str(uuid.uuid4()),\n            query_id=saved_query,\n            agent_id=\"staffing\",\n            findings=\"Some findings\",\n            confidence=\"high\",\n            retrieval_status=RetrievalStatus(\n                instruments_attempted=2,\n                instruments_successfully_retrieved=2,\n                instruments_failed=[],\n            ),\n        )\n        await db.save_agent_response(record)\n        results = await db.get_agent_responses(saved_query)\n        assert len(results) == 1\n        assert results[0].agent_id == \"staffing\"\n\n    async def test_empty_when_no_responses(self, db, saved_query):\n        results = await db.get_agent_responses(saved_query)\n        assert results == []\n\n\n@pytest.mark.asyncio\nclass TestOrchestratorResponseRoundTrip:\n    async def test_save_and_retrieve(self, db, saved_query):\n        record = OrchestratorResponseRecord(\n            response_id=str(uuid.uuid4()),\n            query_id=saved_query,\n            summary=\"Direct answer\",\n            detailed_analysis=\"Full analysis here\",\n            overall_confidence=\"medium\",\n            citations=[],\n        )\n        await db.save_orchestrator_response(record)\n        result = await db.get_orchestrator_response(saved_query)\n        assert result is not None\n        assert result.summary == \"Direct answer\"\n\n    async def test_returns_none_when_missing(self, db):\n        result = await db.get_orchestrator_response(\"nonexistent-id\")\n        assert result is None\n\n\n@pytest.mark.asyncio\nclass TestFeedbackRoundTrip:\n    async def test_save_and_retrieve(self, db, saved_query):\n        record = FeedbackRecord(\n            feedback_id=str(uuid.uuid4()),\n            query_id=saved_query,\n            rating=\"accurate\",\n            comment=\"Very helpful\",\n        )\n        await db.save_feedback(record)\n        result = await db.get_feedback_for_query(saved_query)\n        assert result is not None\n        assert result.rating == \"accurate\"\n\n    async def test_export_feedback_returns_list(self, db, saved_query):\n        await db.save_feedback(FeedbackRecord(\n            feedback_id=str(uuid.uuid4()),\n            query_id=saved_query,\n            rating=\"needs_work\",\n        ))\n        exported = await db.export_feedback()\n        assert len(exported) >= 1\n        assert \"rating\" in exported[0]\n\n\n@pytest.mark.asyncio\nclass TestListQueries:\n    async def test_returns_most_recent_first(self, db):\n        for i in range(3):\n            await db.save_query(QueryRecord(\n                query_id=str(uuid.uuid4()),\n                query_text=f\"query {i}\",\n                agents_invoked=[\"staffing\"],\n            ))\n        results = await db.list_queries(limit=10)\n        assert len(results) == 3\n\n    async def test_limit_respected(self, db):\n        for i in range(5):\n            await db.save_query(QueryRecord(\n                query_id=str(uuid.uuid4()),\n                query_text=f\"query {i}\",\n                agents_invoked=[],\n            ))\n        results = await db.list_queries(limit=2)\n        assert len(results) == 2\n\n\n@pytest.mark.asyncio\nclass TestPolicyTripleEdgeWeights:\n    async def test_cross_instrument_corroboration_gets_weight_2(self, db):\n        await db.save_kiss_document(\"doc-x\", KISSDocument(\n            source_url=\"https://example.invalid/\",\n            instrument_title=\"Test\",\n            agent_id=\"staffing\",\n            tokens=[],\n            sentence_count=1,\n            token_count=0,\n            parsed_at=\"2026-05-06T00:00:00\",\n            model_version=\"test\",\n        ))\n        triple = PolicyTriple(\n            triple_id=\"t-corr\",\n            doc_id=\"doc-x\",\n            source_url=\"https://example.invalid/\",\n            instrument_title=\"Test\",\n            agent_id=\"staffing\",\n            section_heading=None,\n            sentence_text=\"Employee must attend.\",\n            subject=\"employee\",\n            predicate=\"must\",\n            predicate_lemma=\"must\",\n            is_deontic=True,\n            deontic_type=\"obligation\",\n            object_=\"attend\",\n            modifier=None,\n            validation_flags=[\"CROSS_INSTRUMENT_CORROBORATION\"],\n        )\n        await db.save_policy_triples([triple])\n        async with __import__(\"aiosqlite\").connect(db._db_path) as conn:\n            async with conn.execute(\"SELECT weight FROM graph_edges WHERE triple_id = ?\", (\"t-corr\",)) as cur:\n                row = await cur.fetchone()\n        assert row is not None\n        assert row[0] == 2.0\n\n\n@pytest.mark.asyncio\nclass TestCoverageAndConflicts:\n    async def test_get_coverage_stats(self, db):\n        stats = await db.get_coverage_stats()\n        assert set(stats.keys()) == {\"documents\", \"triples\", \"nodes\", \"edges\"}\n\n    async def test_is_document_parsed_false_when_absent(self, db):\n        assert await db.is_document_parsed(\"https://notparsed.example.com/\") is False\n\n    async def test_find_conflicting_triples_returns_empty_when_no_conflict(self, db):\n        result = await db.find_conflicting_triples(\"employee\", \"must\")\n        assert result == []\n```\n\n---\n\n",
        "level": 1
      },
      {
        "title": "Gap 5 — `OrchestratorAgent` (zero coverage)",
        "content": "\n**Untested:** `_build_synthesis_prompt`, `_aggregate_citations` (dedup), `_deterministic_grounding` (all three coverage branches), `_route` (happy path + LLM failure fallback), `process` (JSON parse failure path).\n\n```python\n",
        "level": 2
      },
      {
        "title": "tests/test_agents/test_orchestrator.py",
        "content": "import json\nimport pytest\nfrom unittest.mock import AsyncMock, patch\nfrom src.agents.orchestrator import OrchestratorAgent\nfrom src.models.schemas import OrchestratorResponse\n\n\n@pytest.fixture\ndef agent():\n    with patch(\"src.agents.orchestrator.get_client\"), \\\n         patch(\"src.agents.orchestrator.get_config\"):\n        a = OrchestratorAgent.__new__(OrchestratorAgent)\n        a._specialist_agent_ids = [\"staffing\", \"classification\"]\n        a._config = _make_config()\n        a._llm_client = AsyncMock()\n        return a\n\n\ndef _make_config():\n    from unittest.mock import MagicMock\n    cfg = MagicMock()\n    cfg.parsing.validate_mode_threshold = 5\n    return cfg\n\n\nSAMPLE_RESPONSES = [\n    {\n        \"agent_id\": \"staffing\",\n        \"findings\": \"Staffing finding\",\n        \"confidence\": \"high\",\n        \"citations\": [{\"instrument_title\": \"PSEA\", \"instrument_type\": \"Act\", \"url\": \"https://laws.gc.ca/PSEA\", \"relevant_section\": \"s.30\"}],\n        \"grounding_mode\": \"extract\",\n    },\n    {\n        \"agent_id\": \"classification\",\n        \"findings\": \"Classification finding\",\n        \"confidence\": \"medium\",\n        \"citations\": [{\"instrument_title\": \"PSEA\", \"instrument_type\": \"Act\", \"url\": \"https://laws.gc.ca/PSEA\", \"relevant_section\": \"s.12\"}],\n        \"grounding_mode\": \"extract\",\n    },\n]\n\n\nclass TestBuildSynthesisPrompt:\n    def test_includes_query_and_all_agent_ids(self, agent):\n        prompt = agent._build_synthesis_prompt(\"what is leave?\", SAMPLE_RESPONSES)\n        assert \"what is leave?\" in prompt\n        assert \"STAFFING\" in prompt\n        assert \"CLASSIFICATION\" in prompt\n\n    def test_includes_citation_url(self, agent):\n        prompt = agent._build_synthesis_prompt(\"q\", SAMPLE_RESPONSES)\n        assert \"https://laws.gc.ca/PSEA\" in prompt\n\n\nclass TestAggregateCitations:\n    def test_deduplicates_same_title_and_url(self, agent):\n        citations = agent._aggregate_citations(SAMPLE_RESPONSES)\n        urls = [c.url for c in citations]\n        assert urls.count(\"https://laws.gc.ca/PSEA\") == 1\n\n    def test_preserves_sourced_from_agent(self, agent):\n        citations = agent._aggregate_citations(SAMPLE_RESPONSES)\n        assert any(c.sourced_from_agent == \"staffing\" for c in citations)\n\n    def test_empty_responses_returns_empty_list(self, agent):\n        assert agent._aggregate_citations([]) == []\n\n\nclass TestDeterministicGrounding:\n    def test_full_coverage_when_all_validate(self, agent):\n        responses = [\n            {**r, \"grounding_mode\": \"validate\",\n             \"retrieval_status\": {\"instruments_successfully_retrieved\": 3, \"instruments_attempted\": 3, \"instruments_failed\": []}}\n            for r in SAMPLE_RESPONSES\n        ]\n        grounding = agent._deterministic_grounding(responses)\n        assert grounding.graph_coverage == \"full\"\n        assert grounding.llm_mode == \"validate\"\n\n    def test_partial_coverage_when_mixed(self, agent):\n        responses = [\n            {**SAMPLE_RESPONSES[0], \"grounding_mode\": \"validate\",\n             \"retrieval_status\": {\"instruments_successfully_retrieved\": 2, \"instruments_attempted\": 2, \"instruments_failed\": []}},\n            {**SAMPLE_RESPONSES[1], \"grounding_mode\": \"extract\"},\n        ]\n        grounding = agent._deterministic_grounding(responses)\n        assert grounding.graph_coverage == \"partial\"\n        assert grounding.llm_mode == \"mixed\"\n\n    def test_no_coverage_when_all_extract(self, agent):\n        grounding = agent._deterministic_grounding(SAMPLE_RESPONSES)\n        assert grounding.graph_coverage == \"none\"\n        assert grounding.llm_mode == \"extract\"\n\n\n@pytest.mark.asyncio\nclass TestProcess:\n    async def test_returns_fallback_on_json_decode_error(self, agent):\n        agent._llm_client.chat = AsyncMock(return_value=\"not json at all\")\n        result = await agent.process(\"test query\", SAMPLE_RESPONSES)\n        assert isinstance(result, OrchestratorResponse)\n        assert result.overall_confidence == \"low\"\n\n    async def test_returns_valid_response_on_good_json(self, agent):\n        payload = json.dumps({\n            \"summary\": \"Direct answer\",\n            \"detailed_analysis\": \"Full analysis\",\n            \"citations\": [],\n            \"agents_consulted\": [\"staffing\"],\n            \"overall_confidence\": \"high\",\n        })\n        agent._llm_client.chat = AsyncMock(return_value=payload)\n        result = await agent.process(\"test query\", SAMPLE_RESPONSES)\n        assert result.summary == \"Direct answer\"\n        assert result.overall_confidence == \"high\"\n\n    async def test_strips_preamble_before_json(self, agent):\n        preamble = \"Here is my response:\\n\"\n        payload = json.dumps({\n            \"summary\": \"Answer\",\n            \"detailed_analysis\": \"Detail\",\n            \"citations\": [],\n            \"agents_consulted\": [],\n            \"overall_confidence\": \"medium\",\n        })\n        agent._llm_client.chat = AsyncMock(return_value=preamble + payload)\n        result = await agent.process(\"q\", SAMPLE_RESPONSES)\n        assert result.summary == \"Answer\"\n\n\n@pytest.mark.asyncio\nclass TestRoute:\n    async def test_falls_back_to_all_agents_on_llm_error(self, agent):\n        agent._llm_client.chat = AsyncMock(side_effect=RuntimeError(\"LLM offline\"))\n        result = await agent._route(\"test query\")\n        assert set(result[\"selected_agents\"]) == set(agent._specialist_agent_ids)\n\n    async def test_falls_back_on_invalid_json(self, agent):\n        agent._llm_client.chat = AsyncMock(return_value=\"not json\")\n        result = await agent._route(\"test query\")\n        assert \"selected_agents\" in result\n```\n\n---\n\n",
        "level": 1
      },
