st_cache_hit_skips_http(self, engine):\n        from src.fetch.cache import CacheEntry\n        eng, cache = engine\n        cache.get.return_value = CacheEntry(\n            url=\"https://example.com\", content=\"cached content\", ttl_hours=24\n        )\n        result = await eng.fetch(\"https://example.com\")\n        assert result == \"cached content\"\n        # No HTTP call made\n        cache.set_cached.assert_not_called()\n\n    @pytest.mark.asyncio\n    async def test_cache_miss_fetches_and_stores(self, engine):\n        eng, cache = engine\n        cache.get.return_value = None\n        cache._get_default_ttl = MagicMock(return_value=168)\n\n        mock_response = MagicMock()\n        mock_response.status_code = 200\n        mock_response.text = \"<html><body>Hello</body></html>\"\n        mock_response.raise_for_status = MagicMock()\n\n        with patch.object(eng._client, \"get\", return_value=mock_response) as mock_get:\n            mock_get.__aenter__ = AsyncMock(return_value=mock_response)\n            # Simulate async client.get\n            async def fake_get(url):\n                return mock_response\n            eng._client.get = fake_get\n            result = await eng.fetch(\"https://example.com\")\n\n        assert result == \"extracted content\"\n        cache.set_cached.assert_called_once()\n\n    @pytest.mark.asyncio\n    async def test_http_failure_falls_back_to_stale(self, engine):\n        from src.fetch.cache import CacheEntry\n        eng, cache = engine\n        cache.get.return_value = None\n        stale = CacheEntry(url=\"https://example.com\", content=\"stale content\", ttl_hours=0)\n        cache.get_stale.return_value = stale\n\n        async def fake_get(url):\n            raise httpx.RequestError(\"connection error\")\n        eng._client.get = fake_get\n\n        result = await eng.fetch(\"https://example.com\")\n        assert result == \"stale content\"\n\n    @pytest.mark.asyncio\n    async def test_http_failure_no_stale_raises_fetch_error(self, engine):\n        from src.fetch.engine import FetchError\n        eng, cache = engine\n        cache.get.return_value = None\n        cache.get_stale.return_value = None\n\n        async def fake_get(url):\n            raise httpx.RequestError(\"connection error\")\n        eng._client.get = fake_get\n\n        with pytest.raises(FetchError):\n            await eng.fetch(\"https://example.com\")\n\n\nclass TestFetchBatch:\n    @pytest.mark.asyncio\n    async def test_batch_all_succeed(self):\n        from src.fetch.engine import FetchEngine\n        eng = FetchEngine(cache=AsyncMock(), extractor=MagicMock())\n\n        async def fake_fetch(url):\n            return f\"content:{url}\"\n        eng.fetch = fake_fetch\n\n        urls = [\"https://a.com\", \"https://b.com\"]\n        result = await eng.fetch_batch(urls)\n        assert result == {\"https://a.com\": \"content:https://a.com\", \"https://b.com\": \"content:https://b.com\"}\n\n    @pytest.mark.asyncio\n    async def test_batch_partial_failure_omits_failed(self):\n        from src.fetch.engine import FetchEngine, FetchError\n        eng = FetchEngine(cache=AsyncMock(), extractor=MagicMock())\n\n        async def fake_fetch(url):\n            if \"fail\" in url:\n                raise FetchError(\"bad\")\n            return \"content\"\n        eng.fetch = fake_fetch\n\n        result = await eng.fetch_batch([\"https://good.com\", \"https://fail.com\"])\n        assert \"https://good.com\" in result\n        assert \"https://fail.com\" not in result\n```\n\n```python\n# tests/test_fetch_cache.py\n\"\"\"Unit tests for FetchCache and CacheEntry.\"\"\"\nimport pytest\nfrom datetime import datetime, timedelta\nfrom unittest.mock import AsyncMock, MagicMock\n\n\nclass TestCacheEntry:\n    def test_content_hash_is_sha256(self):\n        import hashlib\n        from src.fetch.cache import CacheEntry\n        entry = CacheEntry(url=\"u\", content=\"hello\", ttl_hours=1)\n        expected = hashlib.sha256(\"hello\".encode()).hexdigest()\n        assert entry.content_hash == expected\n\n    def test_is_valid_within_ttl(self):\n        from src.fetch.cache import CacheEntry\n        entry = CacheEntry(url=\"u\", content=\"c\", ttl_hours=24)\n        entry.fetched_at = datetime.utcnow().isoformat()\n        assert entry.is_valid() is True\n\n    def test_is_not_valid_past_ttl(self):\n        from src.fetch.cache import CacheEntry\n        entry = CacheEntry(url=\"u\", content=\"c\", ttl_hours=1)\n        past = (datetime.utcnow() - timedelta(hours=2)).isoformat()\n        entry.fetched_at = past\n        assert entry.is_valid() is False\n\n\nclass TestFetchCacheDefaultTTL:\n    @pytest.fixture\n    def cache(self):\n        from src.fetch.cache import FetchCache\n        db = AsyncMock()\n        return FetchCache(db_manager=db)\n\n    def test_laws_lois_returns_720(self, cache):\n        url = \"https://laws-lois.justice.gc.ca/eng/acts/P-33.3/FullText.html\"\n        assert cache._get_default_ttl(url) == 720\n\n    def test_collective_domain_returns_720(self, cache):\n        url = \"https://tbs-sct.canada.ca/agreements-conventions/index-eng.aspx\"\n        assert cache._get_default_ttl(url) == 720\n\n    def test_other_url_returns_config_default(self, cache):\n        url = \"https://www.canada.ca/some-page\"\n        ttl = cache._get_default_ttl(url)\n        assert isinstance(ttl, int)\n        assert ttl > 0\n\n\nclass TestFetchCacheGetSet:\n    @pytest.fixture\n    async def cache_with_db(self, tmp_path):\n        from src.data.db import DatabaseManager\n        from src.fetch.cache import FetchCache\n        db_path = tmp_path / \"test.db\"\n        db = DatabaseManager(db_path=db_path)\n        await db.initialize()\n        return FetchCache(db_manager=db)\n\n    @pytest.mark.asyncio\n    async def test_get_returns_none_when_missing(self, tmp_path):\n        from src.data.db import DatabaseManager\n        from src.fetch.cache import FetchCache\n        db = DatabaseManager(db_path=tmp_path / \"test.db\")\n        await db.initialize()\n        cache = FetchCache(db_manager=db)\n        result = await cache.get(\"https://nonexistent.example.com\")\n        assert result is None\n\n    @pytest.mark.asyncio\n    async def test_set_and_get_roundtrip(self, tmp_path):\n        from src.data.db import DatabaseManager\n        from src.fetch.cache import FetchCache\n        db = DatabaseManager(db_path=tmp_path / \"test.db\")\n        await db.initialize()\n        cache = FetchCache(db_manager=db)\n\n        await cache.store(\"https://example.com\", \"page content\", ttl_hours=168)\n        result = await cache.get(\"https://example.com\")\n        assert result is not None\n        assert result.content == \"page content\"\n\n    @pytest.mark.asyncio\n    async def test_get_stale_returns_expired_entry(self, tmp_path):\n        from src.data.db import DatabaseManager\n        from src.fetch.cache import FetchCache, CacheEntry\n        from src.models.schemas import FetchCacheEntry\n        db = DatabaseManager(db_path=tmp_path / \"test.db\")\n        await db.initialize()\n        cache = FetchCache(db_manager=db)\n\n        # Store an entry that's already expired\n        past = datetime.utcnow() - timedelta(hours=2)\n        entry = FetchCacheEntry(\n            url=\"https://stale.example.com\",\n            content_text=\"old content\",\n            content_hash=\"abc\",\n            fetched_at=past,\n            ttl_hours=1,\n        )\n        await db.set_cached(entry)\n\n        # get() should return None (expired), get_stale() should return the entry\n        fresh = await cache.get(\"https://stale.example.com\")\n        assert fresh is None\n        stale = await cache.get_stale(\"https://stale.example.com\")\n        assert stale is not None\n        assert stale.content == \"old content\"\n\n    @pytest.mark.asyncio\n    async def test_clear_expired_removes_old_entries(self, tmp_path):\n        from src.data.db import DatabaseManager\n        from src.fetch.cache import FetchCache\n        from src.models.schemas import FetchCacheEntry\n        db = DatabaseManager(db_path=tmp_path / \"test.db\")\n        await db.initialize()\n        cache = FetchCache(db_manager=db)\n\n        past = datetime.utcnow() - timedelta(hours=48)\n        entry = FetchCacheEntry(\n            url=\"https://expired.example.com\",\n            content_text=\"old\",\n            content_hash=\"x\",\n            fetched_at=past,\n            ttl_hours=1,\n        )\n        await db.set_cached(entry)\n        deleted = await cache.clear_expired()\n        assert deleted >= 1\n```\n\n```python\n# tests/test_extractors.py\n\"\"\"Unit tests for ContentExtractor beyond the existing basic test.\"\"\"\nimport pytest\nfrom src.fetch.extractors import ContentExtractor\n\n\nclass TestExtractorFallbacks:\n    def test_missing_selectors_file_does_not_crash(self):\n        extractor = ContentExtractor(selectors_path=\"/nonexistent/selectors.yaml\")\n        assert extractor is not None\n\n    def test_no_content_selector_match_falls_back_to_body(self):\n        extractor = ContentExtractor(selectors_path=\"/nonexistent/selectors.yaml\")\n        html = \"<html><body><p>Body text</p></body></html>\"\n        result = extractor.extract(\"https://unknown.example.com\", html)\n        assert \"Body text\" in result\n\n    def test_no_body_falls_back_to_get_text(self):\n        extractor = ContentExtractor(selectors_path=\"/nonexistent/selectors.yaml\")\n        html = \"<p>Just text</p>\"\n        result = extractor.extract(\"https://unknown.example.com\", html)\n        assert \"Just text\" in result\n\n    def test_truncation_appends_ellipsis(self):\n        extractor = ContentExtractor(selectors_path=\"/nonexistent/selectors.yaml\")\n        content = \"A\" * 1000\n        result = extractor._truncate(content, max_length=10)\n        assert result.endswith(\"...\")\n        assert len(result) == 10\n\n    def test_truncation_leaves_short_text_unchanged(self):\n        extractor = ContentExtractor(selectors_path=\"/nonexistent/selectors.yaml\")\n        content = \"short\"\n        assert extractor._truncate(content, max_length=100) == \"short\"\n\n    def test_remove_elements_removes_nav(self):\n        from bs4 import BeautifulSoup\n        extractor = ContentExtractor(selectors_path=\"/nonexistent/selectors.yaml\")\n        html = \"<div><nav>Navigation</nav><p>Main</p></div>\"\n        soup = BeautifulSoup(html, \"lxml\")\n        elem = soup.find(\"div\")\n        extractor._remove_elements(elem, [\"nav\"])\n        assert \"Navigation\" not in elem.get_text()\n        assert \"Main\" in elem.get_text()\n\n    def test_format_content_handles_headings_and_paragraphs(self):\n        from bs4 import BeautifulSoup\n        extractor = ContentExtractor(selectors_path=\"/nonexistent/selectors.yaml\")\n        html = \"<div><h2>Title</h2><p>Content paragraph.</p></div>\"\n        soup = BeautifulSoup(html, \"lxml\")\n        elem = soup.find(\"div\")\n        result = extractor._format_content(elem)\n        assert \"Title\" in result\n        assert \"Content paragraph\" in result\n\n    def test_clean_text_collapses_whitespace(self):\n        extractor = ContentExtractor(selectors_path=\"/nonexistent/selectors.yaml\")\n        text = \"  hello   world  \"\n        result = extractor._clean_text(text, max_length=1000)\n        assert result == \"hello world\"\n\n    def test_max_length_respected_in_extract(self):\n        extractor = ContentExtractor(selectors_path=\"/nonexistent/selectors.yaml\")\n        long_text = \"word \" * 10000\n        html = f\"<html><body><p>{long_text}</p></body></html>\"\n        result = extractor.extract(\"https://example.com\", html, max_length=100)\n        assert len(result) <= 100\n```\n\n```python\n# tests/test_database.py\n\"\"\"Extended database tests covering all untested operations.\"\"\"\nimport json\nimport uuid\nimport pytest\nfrom datetime import datetime\nfrom pathlib import Path\n\nfrom src.data.db import DatabaseManager\nfrom src.models.schemas import (\n    AgentResponseRecord,\n    CitationItem,\n    FeedbackRecord,\n    OrchestratorCitation,\n    OrchestratorResponseRecord,\n    QueryRecord,\n    RetrievalStatus,\n)\n\n\n@pytest.fixture\nasync def db(tmp_path):\n    manager = DatabaseManager(db_path=tmp_path / \"test.db\")\n    await manager.initialize()\n    return manager\n\n\nclass TestListQueries:\n    @pytest.mark.asyncio\n    async def test_empty_db_returns_empty_list(self, db):\n        result = await db.list_queries()\n        assert result == []\n\n    @pytest.mark.asyncio\n    async def test_respects_limit(self, db):\n        for _ in range(5):\n            record = QueryRecord(query_id=str(uuid.uuid4()), query_text=\"q\", agents_invoked=[])\n            await db.save_query(record)\n        result = await db.list_queries(limit=3)\n        assert len(result) == 3\n\n\nclass TestAgentResponseRoundtrip:\n    @pytest.mark.asyncio\n    async def test_save_and_get_agent_responses(self, db):\n        qid = str(uuid.uuid4())\n        await db.save_query(QueryRecord(query_id=qid, query_text=\"q\", agents_invoked=[]))\n        record = AgentResponseRecord(\n            response_id=str(uuid.uuid4()),\n            query_id=qid,\n            agent_id=\"staffing\",\n            findings=\"Some findings\",\n            citations=[CitationItem(instrument_title=\"PSEA\", instrument_type=\"Act\", url=\"https://example.com\")],\n            confidence=\"high\",\n            retrieval_status=RetrievalStatus(instruments_attempted=1, instruments_successfully_retrieved=1),\n        )\n        await db.save_agent_response(record)\n        results = await db.get_agent_responses(qid)\n        assert len(results) == 1\n        assert results[0].agent_id == \"staffing\"\n        assert results[0].findings == \"Some findings\"\n\n\nclass TestOrchestratorResponseRoundtrip:\n    @pytest.mark.asyncio\n    async def test_save_and_get_orchestrator_response(self, db):\n        qid = str(uuid.uuid4())\n        await db.save_query(QueryRecord(query_id=qid, query_text=\"q\", agents_invoked=[]))\n        record = OrchestratorResponseRecord(\n            response_id=str(uuid.uuid4()),\n            query_id=qid,\n            summary=\"Direct answer\",\n            detailed_analysis=\"Full analysis\",\n            overall_confidence=\"medium\",\n            citations=[OrchestratorCitation(\n                instrument_title=\"PSEA\", instrument_type=\"Act\", sourced_from_agent=\"staffing\"\n            )],\n        )\n        await db.save_orchestrator_response(record)\n        retrieved = await db.get_orchestrator_response(qid)\n        assert retrieved is not None\n        assert retrieved.summary == \"Direct answer\"\n\n    @pytest.mark.asyncio\n    async def test_get_orchestrator_response_returns_none_for_unknown(self, db):\n        result = await db.get_orchestrator_response(\"nonexistent-id\")\n        assert result is None\n\n\nclass TestFeedbackRoundtrip:\n    @pytest.mark.asyncio\n    async def test_save_and_get_feedback(self, db):\n        qid = str(uuid.uuid4())\n        await db.save_query(QueryRecord(query_id=qid, query_text=\"q\", agents_invoked=[]))\n        record = FeedbackRecord(\n            feedback_id=str(uuid.uuid4()),\n            query_id=qid,\n            rating=\"accurate\",\n            comment=\"Very helpful\",\n        )\n        await db.save_feedback(record)\n        retrieved = await db.get_feedback_for_query(qid)\n        assert retrieved is not None\n        assert retrieved.rating == \"accurate\"\n\n    @pytest.mark.asyncio\n    async def test_export_feedback_returns_list(self, db):\n        qid = str(uuid.uuid4())\n        await db.save_query(QueryRecord(query_id=qid, query_text=\"q\", agents_invoked=[]))\n        await db.save_feedback(FeedbackRecord(\n            feedback_id=str(uuid.uuid4()), query_id=qid, rating=\"needs_work\"\n        ))\n        result = await db.export_feedback()\n        assert isinstance(result, list)\n        assert len(result) >= 1\n\n    @pytest.mark.asyncio\n    async def test_get_feedback_returns_none_for_unknown(self, db):\n        result = await db.get_feedback_for_query(\"nonexistent\")\n        assert result is None\n```\n\n```python\n# tests/test_orchestrator.py\n\"\"\"Unit tests for OrchestratorAgent.\"\"\"\nimport json\nimport pytest\nfrom unittest.mock import AsyncMock, MagicMock, patch\n\n\n@pytest.fixture\ndef orchestrator():\n    with patch(\"src.llm.client.get_client\"), patch(\"src.config.get_config\"):\n        from src.agents.orchestrator import OrchestratorAgent\n        orch = MagicMock(spec=OrchestratorAgent)\n        # Use the real methods bound to a real instance would require full mocking;\n        # instantiate with mocked LLM client instead\n        return orch\n\n\nclass TestBuildSynthesisPrompt:\n    def test_includes_query_and_agent_findings(self):\n        with patch(\"src.llm.client.get_client\"), patch(\"google.generativeai.configure\"):\n            with patch.dict(\"os.environ\", {\"GEMINI_API_KEY\": \"fake\"}):\n                from src.agents.orchestrator import OrchestratorAgent\n                with patch(\"src.llm.client.GeminiClient.__init__\", return_value=None):\n                    orch = object.__new__(OrchestratorAgent)\n                    orch._specialist_agent_ids = []\n\n        specialist_responses = [\n            {\n                \"agent_id\": \"staffing\",\n                \"findings\": \"The PSEA applies here.\",\n                \"confidence\": \"high\",\n                \"citations\": [{\"instrument_title\": \"PSEA\", \"url\": \"https://example.com\", \"relevant_section\": \"s.3\"}],\n            }\n        ]\n        from src.agents.orchestrator import OrchestratorAgent as OA\n        prompt = OA._build_synthesis_prompt(orch, \"What are staffing rules?\", specialist_responses)\n        assert \"What are staffing rules?\" in prompt\n        assert \"staffing\" in prompt.lower()\n        assert \"The PSEA applies here.\" in prompt\n        assert \"PSEA\" in prompt\n\n\nclass TestAggregateCitations:\n    def test_deduplicates_by_title_and_url(self):\n        with patch(\"src.llm.client.get_client\"), patch(\"google.generativeai.configure\"):\n            with patch.dict(\"os.environ\", {\"GEMINI_API_KEY\": \"fake\"}):\n                with patch(\"src.llm.client.GeminiClient.__init__\", return_value=None):\n                    from src.agents.orchestrator import OrchestratorAgent\n                    orch = object.__new__(OrchestratorAgent)\n\n        responses = [\n            {\"agent_id\": \"staffing\", \"citations\": [{\"instrument_title\": \"PSEA\", \"url\": \"https://x.com\", \"instrument_type\": \"Act\"}]},\n            {\"agent_id\": \"classification\", \"citations\": [{\"instrument_title\": \"PSEA\", \"url\": \"https://x.com\", \"instrument_type\": \"Act\"}]},\n        ]\n        from src.agents.orchestrator import OrchestratorAgent as OA\n        result = OA._aggregate_citations(orch, responses)\n        assert len(result) == 1  # duplicate removed\n\n    def test_preserves_different_instruments(self):\n        with patch(\"src.llm.client.get_client\"), patch(\"google.generativeai.configure\"):\n            with patch.dict(\"os.environ\", {\"GEMINI_API_KEY\": \"fake\"}):\n                with patch(\"src.llm.client.GeminiClient.__init__\", return_value=None):\n                    from src.agents.orchestrator import OrchestratorAgent\n                    orch = object.__new__(OrchestratorAgent)\n\n        responses = [\n            {\"agent_id\": \"staffing\", \"citations\": [{\"instrument_title\": \"PSEA\", \"url\": \"https://a.com\", \"instrument_type\": \"Act\"}]},\n            {\"agent_id\": \"labour\", \"citations\": [{\"instrument_title\": \"PSLRA\", \"url\": \"https://b.com\", \"instrument_type\": \"Act\"}]},\n        ]\n        from src.agents.orchestrator import OrchestratorAgent as OA\n        result = OA._aggregate_citations(orch, responses)\n        assert len(result) == 2\n\n\nclass TestOrchestratorProcess:\n    @pytest.mark.asyncio\n    async def test_process_valid_json_response(self):\n        payload = {\n            \"summary\": \"Answer here\",\n            \"detailed_analysis\": \"Full detail\",\n            \"citations\": [],\n            \"agents_consulted\": [\"staffing\"],\n            \"overall_confidence\": \"high\",\n        }\n        mock_llm = AsyncMock()\n        mock_llm.chat.return_value = json.dumps(payload)\n\n        with patch(\"src.llm.client.get_client\", return_value=mock_llm):\n            with patch(\"src.config.get_config\"):\n                from src.agents.orchestrator import OrchestratorAgent\n                with patch.object(OrchestratorAgent, \"__init__\", lambda self: None):\n                    orch = OrchestratorAgent.__new__(OrchestratorAgent)\n                    orch._llm_client = mock_llm\n                    orch._specialist_agent_ids = []\n\n                    result = await orch.process(\"test query\", [])\n        assert result.summary == \"Answer here\"\n        assert result.overall_confidence == \"high\"\n\n    @pytest.mark.asyncio\n    async def test_process_malformed_json_returns_fallback(self):\n        mock_llm = AsyncMock()\n        mock_llm.chat.return_value = \"not json at all\"\n\n        with patch(\"src.llm.client.get_client\", return_value=mock_llm):\n            from src.agents.orchestrator import OrchestratorAgent\n            with patch.object(OrchestratorAgent, \"__init__\", lambda self: None):\n                orch = OrchestratorAgent.__new__(OrchestratorAgent)\n                orch._llm_client = mock_llm\n                orch._specialist_agent_ids = []\n\n                result = await orch.process(\"test query\", [])\n        assert result.overall_confidence == \"low\"\n        assert \"error\" in result.summary.lower()\n\n    @pytest.mark.asyncio\n    async def test_process_json_with_preamble_still_parsed(self):\n        payload = {\n            \"summary\": \"Preamble stripped\",\n            \"detailed_analysis\": \"detail\",\n            \"citations\": [],\n            \"agents_consulted\": [],\n            \"overall_confidence\": \"medium\",\n        }\n        mock_llm = AsyncMock()\n        mock_llm.chat.return_value = \"Here is my response:\\n\" + json.dumps(payload)\n\n        with patch(\"src.llm.client.get_client\", return_value=mock_llm):\n            from src.agents.orchestrator import OrchestratorAgent\n            with patch.object(OrchestratorAgent, \"__init__\", lambda self: None):\n                orch = OrchestratorAgent.__new__(OrchestratorAgent)\n                orch._llm_client = mock_llm\n                orch._specialist_agent_ids = []\n\n                result = await orch.process(\"test query\", [])\n        assert result.summary == \"Preamble stripped\"\n\n\nclass TestOrchestratorRoute:\n    @pytest.mark.asyncio\n    async def test_route_returns_parsed_json(self):\n        routing = {\n            \"selected_agents\": [\"staffing\", \"classification\"],\n            \"routing_rationale\": \"relevant\",\n            \"sub_queries\": {\"staffing\": \"staffing question\", \"classification\": \"class question\"},\n        }\n        mock_llm = AsyncMock()\n        mock_llm.chat.return_value = json.dumps(routing)\n\n        from src.agents.orchestrator import OrchestratorAgent\n        with patch.object(OrchestratorAgent, \"__init__\", lambda self: None):\n            orch = OrchestratorAgent.__new__(OrchestratorAgent)\n            orch._llm_client = mock_llm\n            orch._specialist_agent_ids = [\"staffing\", \"classification\", \"labour\"]\n            result = await orch._route(\"test query\")\n        assert result[\"selected_agents\"] == [\"staffing\", \"classification\"]\n\n    @pytest.mark.asyncio\n    async def test_route_fallback_on_llm_failure(self):\n        mock_llm = AsyncMock()\n        mock_llm.chat.side_effect = Exception(\"LLM down\")\n\n        from src.agents.orchestrator import OrchestratorAgent\n        with patch.object(OrchestratorAgent, \"__init__\", lambda self: None):\n            orch = OrchestratorAgent.__new__(OrchestratorAgent)\n            orch._llm_client = mock_llm\n            orch._specialist_agent_ids = [\"staffing\", \"classification\"]\n            result = await orch._route(\"test query\")\n        # Fallback: all agents selected\n        assert set(result[\"selected_agents\"]) == {\"staffing\", \"classification\"}\n```\n\n```python\n# tests/test_specialist.py\n\"\"\"Unit tests for SpecialistAgent.\"\"\"\nimport json\nimport pytest\nfrom unittest.mock import AsyncMock, MagicMock, patch\n\nfrom src.models.schemas import RetrievalStatus\n\n\nclass TestBuildPolicyContext:\n    @pytest.fixture\n    def agent(self):\n        with patch(\"src.agents.specialist.get_client\"), \\\n             patch(\"src.agents.specialist.get_specialist_prompt\", return_value=\"sys\"), \\\n             patch(\"src.agents.specialist.SpecialistAgent._load_instruments\", return_value=[]):\n            from src.agents.specialist import SpecialistAgent\n            return SpecialistAgent(\"staffing\", \"Staffing Agent\", \"Staffing domain\")\n\n    def test_empty_fetched_returns_empty_string(self, agent):\n        assert agent._build_policy_context([]) == \"\"\n\n    def test_non_empty_includes_title_and_url(self, agent):\n        instrument = {\"title\": \"PSEA\", \"type\": \"Act\", \"url\": \"https://example.com\"}\n        result = agent._build_policy_context([(instrument, \"some policy text\")])\n        assert \"PSEA\" in result\n        assert \"https://example.com\" in result\n        assert \"some policy text\" in result\n\n\nclass TestParseResponse:\n    @pytest.fixture\n    def agent(self):\n        with patch(\"src.agents.specialist.get_client\"), \\\n             patch(\"src.agents.specialist.get_specialist_prompt\", return_value=\"sys\"), \\\n             patch(\"src.agents.specialist.SpecialistAgent._load_instruments\", return_value=[]):\n            from src.agents.specialist import SpecialistAgent\n            return SpecialistAgent(\"staffing\", \"Staffing Agent\", \"Staffing domain\")\n\n    def test_valid_json_parsed_correctly(self, agent):\n        payload = {\n            \"agent_id\": \"staffing\",\n            \"findings\": \"Relevant findings\",\n            \"citations\": [{\"instrument_title\": \"PSEA\", \"instrument_type\": \"Act\", \"url\": \"https://x.com\"}],\n            \"confidence\": \"high\",\n        }\n        status = RetrievalStatus(instruments_attempted=1, instruments_successfully_retrieved=1)\n        result = agent._parse_response(json.dumps(payload), 1, 1, [])\n        assert result.findings == \"Relevant findings\"\n        assert result.confidence == \"high\"\n        assert len(result.citations) == 1\n\n    def test_malformed_json_returns_fallback(self, agent):\n        result = agent._parse_response(\"not json\", 1, 0, [\"PSEA\"])\n        assert result.confidence == \"low\"\n        assert result.findings == \"not json\"\n        assert result.agent_id == \"staffing\"\n\n    def test_json_with_preamble_stripped(self, agent):\n        payload = {\"agent_id\": \"staffing\", \"findings\": \"ok\", \"citations\": [], \"confidence\": \"medium\"}\n        raw = \"Here is the JSON:\\n\" + json.dumps(payload)\n        result = agent._parse_response(raw, 0, 0, [])\n        assert result.findings == \"ok\"\n\n\nclass TestProcessWithFetch:\n    @pytest.mark.asyncio\n    async def test_process_without_fetch_engine(self):\n        mock_llm = AsyncMock()\n        mock_llm.chat.return_value = json.dumps({\n            \"agent_id\": \"staffing\",\n            \"findings\": \"No policy retrieved\",\n            \"citations\": [],\n            \"confidence\": \"low\",\n        })\n        with patch(\"src.agents.specialist.get_client\", return_value=mock_llm), \\\n             patch(\"src.agents.specialist.get_specialist_prompt\", return_value=\"sys\"), \\\n             patch(\"src.agents.specialist.SpecialistAgent._load_instruments\", return_value=[]):\n            from src.agents.specialist import SpecialistAgent\n            agent = SpecialistAgent(\"staffing\", \"Staffing Agent\", \"domain\")\n            result = await agent.process_with_fetch(\"What are staffing rules?\", None)\n        assert result.retrieval_status.instruments_attempted == 0\n\n    @pytest.mark.asyncio\n    async def test_partial_fetch_failure_tracked(self):\n        instruments = [\n            {\"url\": \"https://good.com\", \"title\": \"PSEA\", \"type\": \"Act\", \"agent_ids\": [\"staffing\"]},\n            {\"url\": \"https://bad.com\", \"title\": \"PSER\", \"type\": \"Reg\", \"agent_ids\": [\"staffing\"]},\n        ]\n        mock_fetch_engine = MagicMock()\n\n        async def fake_fetch(url):\n            if \"bad\" in url:\n                raise Exception(\"network error\")\n            return \"policy content\"\n\n        mock_fetch_engine.fetch = fake_fetch\n        mock_llm = AsyncMock()\n        mock_llm.chat.return_value = json.dumps({\n            \"agent_id\": \"staffing\", \"findings\": \"partial\", \"citations\": [], \"confidence\": \"medium\"\n        })\n\n        with patch(\"src.agents.specialist.get_client\", return_value=mock_llm), \\\n             patch(\"src.agents.specialist.get_specialist_prompt\", return_value=\"sys\"), \\\n             patch(\"src.agents.specialist.SpecialistAgent._load_instruments\", return_value=instruments):\n            from src.agents.specialist import SpecialistAgent\n            agent = SpecialistAgent(\"staffing\", \"Staffing Agent\", \"domain\")\n            result = await agent.process_with_fetch(\"query\", mock_fetch_engine)\n\n        assert result.retrieval_status.instruments_attempted == 2\n        assert result.retrieval_status.instruments_successfully_retrieved == 1\n        assert \"PSER\" in result.retrieval_status.instruments_failed\n```\n\n```python\n# tests/test_websocket_manager.py\n\"\"\"Unit tests for WebSocketManager.\"\"\"\nimport pytest\nfrom unittest.mock import AsyncMock, MagicMock\n\n\nclass TestWebSocketManager:\n    @pytest.fixture\n    def manager(self):\n        import src.api.websocket as m\n        m._manager = None\n        from src.api.websocket import WebSocketManager\n        return WebSocketManager()\n\n    @pytest.mark.asyncio\n    async def test_send_returns_false_when_not_connected(self, manager):\n        result = await manager.send(\"nonexistent-id\", {\"type\": \"test\"})\n        assert result is False\n\n    @pytest.mark.asyncio\n    async def test_send_disconnects_on_exception(self, manager):\n        mock_ws = AsyncMock()\n        mock_ws.send_json.side_effect = Exception(\"connection reset\")\n        await manager.connect(\"qid\", mock_ws)\n        result = await manager.send(\"qid\", {\"type\": \"test\"})\n        assert result is False\n        assert \"qid\" not in manager._connections\n\n    @pytest.mark.asyncio\n    async def test_disconnect_removes_connection(self, manager):\n        mock_ws = AsyncMock()\n        await manager.connect(\"qid\", mock_ws)\n        assert \"qid\" in manager._connections\n        await manager.disconnect(\"qid\")\n        assert \"qid\" not in manager._connections\n\n    @pytest.mark.asyncio\n    async def test_broadcast_error_reaches_all_connections(self, manager):\n        ws1, ws2 = AsyncMock(), AsyncMock()\n        await manager.connect(\"q1\", ws1)\n        await manager.connect(\"q2\", ws2)\n        await manager.broadcast_error(\"something broke\")\n        ws1.send_json.assert_called_once()\n        ws2.send_json.assert_called_once()\n```\n\n```python\n# tests/test_api_routes.py\n\"\"\"Integration tests for REST API routes using FastAPI TestClient.\"\"\"\nimport pytest\nfrom unittest.mock import AsyncMock, MagicMock, patch\nfrom fastapi.testclient import TestClien