.clear_expired = AsyncMock(return_value=5)\n        count = await cache.clear_expired()\n        assert count == 5\n```\n\n---\n\n### 6. `DatabaseManager` — Mostly Untested (`src/data/db.py`)\n\n**Untested:** `save_agent_response()`, `get_agent_responses()`, `save_orchestrator_response()`, `get_orchestrator_response()`, `save_feedback()` / `get_feedback_for_query()`, `export_feedback()`, `list_queries()`, cache CRUD, `clear_expired()`.\n\n```python\n# tests/test_database_extended.py\nimport uuid\nimport pytest\nimport tempfile\nfrom pathlib import Path\nfrom datetime import datetime\n\n\n@pytest.fixture\nasync def db(tmp_path):\n    from src.data.db import DatabaseManager\n    manager = DatabaseManager(db_path=tmp_path / \"test.db\")\n    await manager.initialize()\n    return manager\n\n\n@pytest.fixture\ndef sample_query_id():\n    return str(uuid.uuid4())\n\n\n@pytest.fixture\nasync def saved_query(db, sample_query_id):\n    from src.models.schemas import QueryRecord\n    record = QueryRecord(query_id=sample_query_id, query_text=\"test query\", agents_invoked=[\"staffing\"])\n    await db.save_query(record)\n    return record\n\n\nclass TestQueryOperations:\n    @pytest.mark.asyncio\n    async def test_get_query_returns_none_for_missing_id(self, db):\n        result = await db.get_query(\"nonexistent-id\")\n        assert result is None\n\n    @pytest.mark.asyncio\n    async def test_list_queries_respects_limit(self, db):\n        from src.models.schemas import QueryRecord\n        for i in range(5):\n            r = QueryRecord(query_id=str(uuid.uuid4()), query_text=f\"q{i}\", agents_invoked=[])\n            await db.save_query(r)\n        results = await db.list_queries(limit=3)\n        assert len(results) <= 3\n\n    @pytest.mark.asyncio\n    async def test_save_query_is_idempotent(self, db, saved_query):\n        \"\"\"INSERT OR REPLACE should not raise on duplicate key.\"\"\"\n        from src.models.schemas import QueryRecord\n        same_id = QueryRecord(\n            query_id=saved_query.query_id,\n            query_text=\"updated text\",\n            agents_invoked=[\"labour\"],\n        )\n        await db.save_query(same_id)\n        retrieved = await db.get_query(saved_query.query_id)\n        assert retrieved.query_text == \"updated text\"\n\n\nclass TestAgentResponseOperations:\n    @pytest.mark.asyncio\n    async def test_save_and_retrieve_agent_response(self, db, saved_query):\n        from src.models.schemas import AgentResponseRecord, CitationItem, RetrievalStatus\n        record = AgentResponseRecord(\n            response_id=str(uuid.uuid4()),\n            query_id=saved_query.query_id,\n            agent_id=\"staffing\",\n            findings=\"Found policy.\",\n            citations=[CitationItem(instrument_title=\"PSEA\", instrument_type=\"Act\")],\n            confidence=\"high\",\n            retrieval_status=RetrievalStatus(instruments_attempted=1, instruments_successfully_retrieved=1),\n        )\n        await db.save_agent_response(record)\n        results = await db.get_agent_responses(saved_query.query_id)\n        assert len(results) == 1\n        assert results[0].agent_id == \"staffing\"\n\n    @pytest.mark.asyncio\n    async def test_get_agent_responses_empty_for_unknown_query(self, db):\n        results = await db.get_agent_responses(\"unknown-id\")\n        assert results == []\n\n\nclass TestOrchestratorResponseOperations:\n    @pytest.mark.asyncio\n    async def test_save_and_retrieve_orchestrator_response(self, db, saved_query):\n        from src.models.schemas import OrchestratorResponseRecord\n        record = OrchestratorResponseRecord(\n            response_id=str(uuid.uuid4()),\n            query_id=saved_query.query_id,\n            summary=\"Answer here.\",\n            citations=[],\n            overall_confidence=\"high\",\n        )\n        await db.save_orchestrator_response(record)\n        retrieved = await db.get_orchestrator_response(saved_query.query_id)\n        assert retrieved is not None\n        assert retrieved.summary == \"Answer here.\"\n\n    @pytest.mark.asyncio\n    async def test_get_orchestrator_response_returns_none_if_absent(self, db, saved_query):\n        result = await db.get_orchestrator_response(saved_query.query_id)\n        assert result is None\n\n\nclass TestFeedbackOperations:\n    @pytest.mark.asyncio\n    async def test_save_and_retrieve_feedback(self, db, saved_query):\n        from src.models.schemas import FeedbackRecord\n        record = FeedbackRecord(\n            feedback_id=str(uuid.uuid4()),\n            query_id=saved_query.query_id,\n            rating=\"accurate\",\n            comment=\"Very helpful\",\n        )\n        await db.save_feedback(record)\n        retrieved = await db.get_feedback_for_query(saved_query.query_id)\n        assert retrieved is not None\n        assert retrieved.rating == \"accurate\"\n\n    @pytest.mark.asyncio\n    async def test_export_feedback_returns_list(self, db, saved_query):\n        from src.models.schemas import FeedbackRecord\n        record = FeedbackRecord(\n            feedback_id=str(uuid.uuid4()),\n            query_id=saved_query.query_id,\n            rating=\"needs_work\",\n        )\n        await db.save_feedback(record)\n        exported = await db.export_feedback()\n        assert isinstance(exported, list)\n        assert len(exported) >= 1\n\n\nclass TestFetchCacheDb:\n    @pytest.mark.asyncio\n    async def test_get_cached_returns_none_before_init(self, db):\n        result = await db.get_cached(\"https://example.com\")\n        assert result is None\n\n    @pytest.mark.asyncio\n    async def test_clear_expired_returns_int(self, db):\n        count = await db.clear_expired()\n        assert isinstance(count, int)\n```\n\n---\n\n### 7. `ContentExtractor` — Partially Tested (`src/fetch/extractors.py`)\n\n**Untested:** `_get_selectors()` domain matching, `_truncate()`, `_clean_text()`, `_format_content()` nested divs, extraction failure fallback.\n\n```python\n# tests/test_extractor_extended.py\nimport pytest\n\n\n@pytest.fixture\ndef extractor():\n    from src.fetch.extractors import ContentExtractor\n    with pytest.MonkeyPatch().context() as m:\n        m.setattr(\"builtins.open\", lambda *a, **kw: (_ for _ in ()).throw(FileNotFoundError))\n        return ContentExtractor(selectors_path=\"/nonexistent/path\")\n\n\nclass TestTruncate:\n    def test_no_truncation_when_within_limit(self, extractor):\n        text = \"hello\"\n        assert extractor._truncate(text, 100) == \"hello\"\n\n    def test_truncates_and_adds_ellipsis(self, extractor):\n        text = \"a\" * 200\n        result = extractor._truncate(text, 100)\n        assert len(result) == 100\n        assert result.endswith(\"...\")\n\n\nclass TestCleanText:\n    def test_collapses_whitespace(self, extractor):\n        result = extractor._clean_text(\"  hello   world  \", 1000)\n        assert result == \"hello world\"\n\n    def test_respects_max_length(self, extractor):\n        result = extractor._clean_text(\"a\" * 200, 100)\n        assert len(result) <= 100\n\n\nclass TestExtractFallback:\n    def test_extraction_handles_empty_html(self, extractor):\n        result = extractor.extract(\"https://example.com\", \"\")\n        assert isinstance(result, str)\n\n    def test_extraction_handles_html_without_body(self, extractor):\n        result = extractor.extract(\"https://example.com\", \"<html></html>\")\n        assert isinstance(result, str)\n\n    def test_extraction_returns_string_on_parser_failure(self, extractor):\n        result = extractor.extract(\"https://example.com\", \"<<not html>>\")\n        assert isinstance(result, str)\n```\n\n---\n\n### 8. API Routes — Completely Untested (`src/api/routes.py`)\n\n**Untested:** all six endpoints, 404 handling, query limit validation, feedback submission.\n\n```python\n# tests/test_api_routes.py\nimport uuid\nimport pytest\nfrom unittest.mock import AsyncMock, patch\nfrom fastapi.testclient import TestClient\n\n\n@pytest.fixture\ndef app():\n    from src.main import app\n    return app\n\n\n@pytest.fixture\ndef client(app):\n    return TestClient(app)\n\n\nclass TestHealthEndpoint:\n    def test_health_returns_200(self, client):\n        with patch(\"src.api.routes.ollama\") as mock_ollama:\n            mock_client = AsyncMock()\n            mock_client.list = AsyncMock(return_value=MagicMock(models=[]))\n            mock_ollama.AsyncClient.return_value = mock_client\n            response = client.get(\"/api/health\")\n        assert response.status_code == 200\n        data = response.json()\n        assert \"status\" in data\n        assert \"components\" in data\n\n\nclass TestAgentsEndpoint:\n    def test_returns_eight_agents(self, client):\n        response = client.get(\"/api/agents\")\n        assert response.status_code == 200\n        data = response.json()\n        assert len(data) == 8\n        agent_ids = {a[\"agent_id\"] for a in data}\n        assert \"staffing\" in agent_ids\n        assert \"governance\" in agent_ids\n\n\nclass TestQueriesEndpoint:\n    def test_returns_empty_list_initially(self, client, tmp_path):\n        with patch(\"src.api.routes.DatabaseManager\") as MockDB:\n            mock_db = AsyncMock()\n            mock_db.list_queries = AsyncMock(return_value=[])\n            MockDB.return_value = mock_db\n            response = client.get(\"/api/queries\")\n        assert response.status_code == 200\n        assert response.json() == []\n\n    def test_limit_parameter_respected(self, client):\n        with patch(\"src.api.routes.DatabaseManager\") as MockDB:\n            mock_db = AsyncMock()\n            mock_db.list_queries = AsyncMock(return_value=[])\n            MockDB.return_value = mock_db\n            response = client.get(\"/api/queries?limit=10\")\n        assert response.status_code == 200\n\n    def test_limit_above_100_rejected(self, client):\n        response = client.get(\"/api/queries?limit=999\")\n        assert response.status_code == 422\n\n    def test_limit_below_1_rejected(self, client):\n        response = client.get(\"/api/queries?limit=0\")\n        assert response.status_code == 422\n\n\nclass TestGetQueryEndpoint:\n    def test_returns_404_for_missing_query(self, client):\n        with patch(\"src.api.routes.DatabaseManager\") as MockDB:\n            mock_db = AsyncMock()\n            mock_db.get_query = AsyncMock(return_value=None)\n            MockDB.return_value = mock_db\n            response = client.get(\"/api/queries/nonexistent-id\")\n        assert response.status_code == 404\n\n\nclass TestFeedbackEndpoint:\n    def test_submit_feedback_returns_ok(self, client):\n        from src.models.schemas import FeedbackRecord\n        payload = {\n            \"feedback_id\": str(uuid.uuid4()),\n            \"query_id\": str(uuid.uuid4()),\n            \"rating\": \"accurate\",\n            \"comment\": \"Great response\",\n        }\n        with patch(\"src.api.routes.DatabaseManager\") as MockDB:\n            mock_db = AsyncMock()\n            mock_db.save_feedback = AsyncMock()\n            MockDB.return_value = mock_db\n            response = client.post(\"/api/feedback\", json=payload)\n        assert response.status_code == 200\n        assert response.json()[\"status\"] == \"ok\"\n\n    def test_export_feedback_returns_list(self, client):\n        with patch(\"src.api.routes.DatabaseManager\") as MockDB:\n            mock_db = AsyncMock()\n            mock_db.export_feedback = AsyncMock(return_value=[])\n            MockDB.return_value = mock_db\n            response = client.get(\"/api/feedback/export\")\n        assert response.status_code == 200\n        assert isinstance(response.json(), list)\n```\n\n---\n\n### 9. Schema Model Edge Cases — Partially Tested\n\n**Untested:** `ModelConfig` defaults, `RoutingDecision`, `WSResponseComplete`, `WSError`, invalid confidence values, `FetchCacheEntry` timestamp handling.\n\n```python\n# tests/test_schemas_extended.py\nimport pytest\nfrom src.models.schemas import (\n    ModelConfig, OrchestratorCitation, RoutingDecision,\n    WSError, WSAgentStatusUpdate, WSResponseComplete, OrchestratorResponse,\n)\n\n\nclass TestModelConfig:\n    def test_default_values(self):\n        config = ModelConfig()\n        assert config.temperature == 0.2\n        assert config.top_p == 0.9\n        assert config.num_ctx == 32768\n\n\nclass TestWSMessages:\n    def test_ws_agent_status_has_correct_type(self):\n        msg = WSAgentStatusUpdate(agent_id=\"staffing\", status=\"working\")\n        assert msg.type == \"agent_status_update\"\n\n    def test_ws_error_with_optional_query_id(self):\n        err = WSError(message=\"Something went wrong\")\n        assert err.query_id is None\n        assert err.type == \"error\"\n\n    def test_ws_response_complete(self):\n        orch = OrchestratorResponse(\n            summary=\"s\", detailed_analysis=\"d\", overall_confidence=\"high\",\n            agents_consulted=[\"staffing\"],\n        )\n        msg = WSResponseComplete(query_id=\"q1\", orchestrator_response=orch, processing_time_ms=1200)\n        assert msg.processing_time_ms == 1200\n\n\nclass TestOrchestratorCitation:\n    def test_optional_fields_default_to_none(self):\n        citation = OrchestratorCitation(\n            instrument_title=\"PSEA\",\n            instrument_type=\"Act\",\n            sourced_from_agent=\"staffing\",\n        )\n        assert citation.url is None\n        assert citation.relevant_section is None\n```\n\n---\n\n### Summary of Coverage Gaps\n\n| Module | Current Coverage | Priority Gaps |\n|---|---|---|\n| `src/llm/client.py` | 0% | API key guard, retry logic, JSON parse fallback |\n| `src/agents/orchestrator.py` | 0% | All public methods, JSON parse fallback, routing |\n| `src/agents/specialist.py` | 0% | All 8 specialists, fetch failures, parse fallback |\n| `src/fetch/engine.py` | ~10% | URL normalization, cache hit/miss/stale, batch failures |\n| `src/fetch/cache.py` | 0% | TTL branching, `is_valid()`, `clear_expired()` |\n| `src/data/db.py` | ~20% | Agent/orchestrator/feedback CRUD, list/limit, cache DB |\n| `src/fetch/extractors.py` | ~30% | Truncation, domain selectors, extraction failure |\n| `src/api/routes.py` | 0% | All six endpoints, 404/422 errors |\n| `src/models/schemas.py` | ~25% | WS types, `ModelConfig` defaults, optional fields |\n\nThe most critical gaps for a policy advisory system are error handling paths in the LLM client (rate limits, blocked content), the orchestrator's JSON parse fallback (which silently returns low-confidence on malformed output), and the fetch engine's stale-cache fallback which is the resilience layer against network failures.\n",
