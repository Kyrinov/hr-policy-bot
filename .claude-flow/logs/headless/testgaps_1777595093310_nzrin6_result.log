        "code": "# tests/test_cache.py\nimport pytest\nfrom unittest.mock import AsyncMock, patch, MagicMock\nfrom src.fetch.cache import FetchCache, CacheEntry\nfrom datetime import datetime, timedelta\n\n\n@pytest.fixture\ndef cache():\n    return FetchCache()\n\n\nclass TestCacheEntry:\n    def test_is_valid_within_ttl(self):\n        entry = CacheEntry(\n            url=\"https://example.gc.ca\",\n            content=\"text\",\n            fetched_at=datetime.utcnow(),\n            ttl_hours=24,\n            content_hash=\"abc\",\n        )\n        assert entry.is_valid() is True\n\n    def test_is_invalid_after_expiry(self):\n        entry = CacheEntry(\n            url=\"https://example.gc.ca\",\n            content=\"text\",\n            fetched_at=datetime.utcnow() - timedelta(hours=25),\n            ttl_hours=24,\n            content_hash=\"abc\",\n        )\n        assert entry.is_valid() is False\n\n\n@pytest.mark.asyncio\nclass TestFetchCacheOperations:\n    async def test_get_returns_none_on_miss(self, cache):\n        with patch.object(cache, \"_db\") as mock_db:\n            mock_db.get_cached = AsyncMock(return_value=None)\n            result = await cache.get(\"https://notcached.gc.ca/x\")\n        assert result is None\n\n    async def test_get_returns_content_on_valid_hit(self, cache):\n        entry = MagicMock()\n        entry.is_valid.return_value = True\n        entry.content = \"Cached policy text\"\n        with patch.object(cache, \"_db\") as mock_db:\n            mock_db.get_cached = AsyncMock(return_value=entry)\n            result = await cache.get(\"https://canada.ca/policy\")\n        assert result == \"Cached policy text\"\n\n    async def test_get_returns_none_for_expired(self, cache):\n        entry = MagicMock()\n        entry.is_valid.return_value = False\n        with patch.object(cache, \"_db\") as mock_db:\n            mock_db.get_cached = AsyncMock(return_value=entry)\n            result = await cache.get(\"https://canada.ca/old\")\n        assert result is None\n\n    async def test_get_stale_returns_expired_content(self, cache):\n        entry = MagicMock()\n        entry.content = \"Stale content\"\n        with patch.object(cache, \"_db\") as mock_db:\n            mock_db.get_stale = AsyncMock(return_value=entry)\n            result = await cache.get_stale(\"https://canada.ca/stale\")\n        assert result == \"Stale content\"\n\n    async def test_store_uses_long_ttl_for_legislation_domain(self, cache):\n        with patch.object(cache, \"_db\") as mock_db:\n            mock_db.set_cached = AsyncMock()\n            await cache.store(\"https://laws-lois.justice.gc.ca/eng/acts/P-33.3/\", \"Act content\")\n            call_kwargs = mock_db.set_cached.call_args\n        ttl = call_kwargs[1].get(\"ttl_hours\") or call_kwargs[0][2]\n        assert ttl >= 720\n\n    async def test_store_uses_default_ttl_for_generic_domain(self, cache):\n        with patch.object(cache, \"_db\") as mock_db:\n            mock_db.set_cached = AsyncMock()\n            await cache.store(\"https://canada.ca/generic\", \"content\")\n            call_kwargs = mock_db.set_cached.call_args\n        ttl = call_kwargs[1].get(\"ttl_hours\") or call_kwargs[0][2]\n        assert ttl < 720"
      },
