        "title": "tests/test_schemas.py",
        "content": "import pytest\nfrom pydantic import ValidationError\nfrom src.models.schemas import (\n    OrchestratorResponse, OrchestratorCitation, RoutingDecision,\n    WSUserQuery, WSAgentStatusUpdate, WSResponseChunk, WSResponseComplete, WSError,\n    QueryRecord, FeedbackRecord, CitationItem, RetrievalStatus, SpecialistResponse,\n)\n\n\nclass TestOrchestratorResponse:\n    def test_full_construction(self):\n        resp = OrchestratorResponse(\n            query_id=\"qid-1\",\n            query_text=\"Can I promote without competition?\",\n            synthesis=\"Based on PSEA...\",\n            citations=[OrchestratorCitation(title=\"PSEA\", url=\"https://laws.gc.ca/psea\", source_agent=\"staffing\")],\n            routing_decision=RoutingDecision(agents_selected=[\"staffing\"], rationale=\"staffing domain\"),\n            confidence_summary=\"high\",\n        )\n        assert resp.query_id == \"qid-1\"\n        assert len(resp.citations) == 1\n\n    def test_optional_fields_default_none(self):\n        resp = OrchestratorResponse(\n            query_id=\"q\", query_text=\"q\", synthesis=\"s\",\n            citations=[], routing_decision=RoutingDecision(agents_selected=[], rationale=\"\"),\n            confidence_summary=\"medium\",\n        )\n        assert resp.policy_tensions is None\n        assert resp.gaps_and_limitations is None\n\n    def test_invalid_confidence_rejected(self):\n        # confidence_summary is a free string in current schema;\n        # this test documents the expectation if an enum is added\n        pass  # Update when enum constraint is enforced\n\n\nclass TestWebSocketMessages:\n    def test_ws_user_query(self):\n        msg = WSUserQuery(query_text=\"What is bilingualism policy?\", session_id=\"sess-1\")\n        assert msg.type == \"query_start\"\n\n    def test_ws_agent_status_update(self):\n        msg = WSAgentStatusUpdate(agent_id=\"staffing\", status=\"running\", message=\"Fetching documents\")\n        assert msg.type == \"agent_status\"\n\n    def test_ws_response_complete(self):\n        resp = OrchestratorResponse(\n            query_id=\"q\", query_text=\"q\", synthesis=\"s\",\n            citations=[], routing_decision=RoutingDecision(agents_selected=[], rationale=\"\"),\n            confidence_summary=\"low\",\n        )\n        msg = WSResponseComplete(response=resp)\n        assert msg.type == \"response_complete\"\n\n    def test_ws_error(self):\n        msg = WSError(message=\"Internal error\", code=\"PROCESSING_FAILED\")\n        assert msg.type == \"error\"\n\n    def test_ws_user_query_missing_text_raises(self):\n        with pytest.raises(ValidationError):\n            WSUserQuery()  # missing query_text\n\n\nclass TestFeedbackRecord:\n    def test_valid_ratings(self):\n        for rating in (\"accurate\", \"needs_work\"):\n            r = FeedbackRecord(query_id=\"q\", rating=rating)\n            assert r.rating == rating\n\n    def test_invalid_rating_rejected(self):\n        with pytest.raises(ValidationError):\n            FeedbackRecord(query_id=\"q\", rating=\"wrong_value\")\n```\n\n---\n\n",
        "level": 1
      },
      {
        "title": "Gap 2 — Config: Environment Variable Overrides & Missing File",
        "content": "\n```python\n",
        "level": 2
      },
      {
        "title": "tests/test_config.py",
        "content": "import os\nimport pytest\nimport importlib\n\n\nclass TestConfigEnvOverrides:\n    def test_api_key_override(self, monkeypatch):\n        monkeypatch.setenv(\"GEMINI_API_KEY\", \"test-key-123\")\n        # Re-import to pick up new env\n        import src.config as cfg\n        importlib.reload(cfg)\n        config = cfg.get_config()\n        assert config.model.api_key == \"test-key-123\"\n\n    def test_port_override(self, monkeypatch):\n        monkeypatch.setenv(\"PORT\", \"9090\")\n        import src.config as cfg\n        importlib.reload(cfg)\n        config = cfg.get_config()\n        assert config.server.port == 9090\n\n    def test_missing_config_file_uses_defaults(self, tmp_path, monkeypatch):\n        monkeypatch.chdir(tmp_path)\n        import src.config as cfg\n        importlib.reload(cfg)\n        config = cfg.get_config()\n        assert config is not None  # must not raise\n\n    def test_config_is_singleton(self):\n        from src.config import get_config\n        a = get_config()\n        b = get_config()\n        assert a is b\n```\n\n---\n\n",
        "level": 1
      },
      {
        "title": "Gap 3 — Database: Uncovered CRUD Methods",
        "content": "\n```python\n",
        "level": 2
      },
      {
        "title": "tests/test_db.py",
        "content": "import pytest\nimport uuid\nfrom datetime import datetime\nfrom src.data.db import DatabaseManager\nfrom src.models.schemas import (\n    QueryRecord, AgentResponseRecord, OrchestratorResponseRecord,\n    FeedbackRecord, RetrievalStatus, SpecialistResponse,\n)\n\n\n@pytest.fixture\nasync def db(tmp_path):\n    mgr = DatabaseManager(db_path=str(tmp_path / \"test.db\"))\n    await mgr.initialize()\n    return mgr\n\n\n@pytest.mark.asyncio\nclass TestQueryCRUD:\n    async def test_list_queries_empty(self, db):\n        results = await db.list_queries(limit=10)\n        assert results == []\n\n    async def test_list_queries_after_insert(self, db):\n        for i in range(3):\n            await db.save_query(QueryRecord(query_id=str(uuid.uuid4()), query_text=f\"q{i}\", agents_invoked=[]))\n        results = await db.list_queries(limit=10)\n        assert len(results) == 3\n\n    async def test_list_queries_respects_limit(self, db):\n        for i in range(5):\n            await db.save_query(QueryRecord(query_id=str(uuid.uuid4()), query_text=f\"q{i}\", agents_invoked=[]))\n        results = await db.list_queries(limit=2)\n        assert len(results) == 2\n\n    async def test_get_nonexistent_query_returns_none(self, db):\n        result = await db.get_query(\"nonexistent-id\")\n        assert result is None\n\n    async def test_save_duplicate_query_id_raises(self, db):\n        qid = str(uuid.uuid4())\n        record = QueryRecord(query_id=qid, query_text=\"q\", agents_invoked=[])\n        await db.save_query(record)\n        with pytest.raises(Exception):\n            await db.save_query(record)  # duplicate primary key\n\n\n@pytest.mark.asyncio\nclass TestAgentResponseCRUD:\n    async def test_save_and_get_agent_response(self, db):\n        qid = str(uuid.uuid4())\n        await db.save_query(QueryRecord(query_id=qid, query_text=\"q\", agents_invoked=[\"staffing\"]))\n        record = AgentResponseRecord(\n            query_id=qid, agent_id=\"staffing\",\n            findings=\"Test findings\", citations=[], confidence=\"high\",\n            retrieval_status=RetrievalStatus(instruments_attempted=1, instruments_successfully_retrieved=1, instruments_failed=[]),\n        )\n        await db.save_agent_response(record)\n        results = await db.get_agent_responses(qid)\n        assert len(results) == 1\n        assert results[0].agent_id == \"staffing\"\n\n    async def test_get_agent_responses_empty(self, db):\n        qid = str(uuid.uuid4())\n        await db.save_query(QueryRecord(query_id=qid, query_text=\"q\", agents_invoked=[]))\n        results = await db.get_agent_responses(qid)\n        assert results == []\n\n\n@pytest.mark.asyncio\nclass TestFeedbackCRUD:\n    async def test_save_and_get_feedback(self, db):\n        qid = str(uuid.uuid4())\n        await db.save_query(QueryRecord(query_id=qid, query_text=\"q\", agents_invoked=[]))\n        fb = FeedbackRecord(query_id=qid, rating=\"accurate\", comment=\"Good answer\")\n        await db.save_feedback(fb)\n        results = await db.get_feedback_for_query(qid)\n        assert len(results) == 1\n        assert results[0].rating == \"accurate\"\n\n    async def test_export_feedback_returns_list(self, db):\n        qid = str(uuid.uuid4())\n        await db.save_query(QueryRecord(query_id=qid, query_text=\"q\", agents_invoked=[]))\n        await db.save_feedback(FeedbackRecord(query_id=qid, rating=\"needs_work\"))\n        exported = await db.export_feedback()\n        assert len(exported) >= 1\n\n\n@pytest.mark.asyncio\nclass TestCacheCRUD:\n    async def test_set_and_get_cache(self, db):\n        url = \"https://example.gc.ca/policy\"\n        await db.set_cached(url, \"Policy content here\", ttl_hours=24)\n        entry = await db.get_cached(url)\n        assert entry is not None\n        assert \"Policy content\" in entry.content\n\n    async def test_get_stale_returns_expired_entry(self, db):\n        url = \"https://example.gc.ca/old-policy\"\n        await db.set_cached(url, \"Old content\", ttl_hours=-1)  # already expired\n        stale = await db.get_stale(url)\n        assert stale is not None\n\n    async def test_get_cached_miss_returns_none(self, db):\n        result = await db.get_cached(\"https://notcached.gc.ca/x\")\n        assert result is None\n\n    async def test_clear_expired_removes_old_entries(self, db):\n        await db.set_cached(\"https://example.gc.ca/expired\", \"content\", ttl_hours=-1)\n        await db.clear_expired()\n        result = await db.get_cached(\"https://example.gc.ca/expired\")\n        assert result is None\n```\n\n---\n\n",
        "level": 1
      },
      {
        "title": "Gap 4 — Fetch Engine: fetch(), fetch_batch(), Rate Limiting, Cache Fallback",
        "content": "\n```python\n",
        "level": 2
      },
      {
        "title": "tests/test_fetch_engine.py",
        "content": "import pytest\nfrom unittest.mock import AsyncMock, patch, MagicMock\nfrom src.fetch.engine import FetchEngine\n\n\n@pytest.fixture\ndef engine():\n    return FetchEngine()\n\n\n@pytest.mark.asyncio\nclass TestFetchSingle:\n    async def test_fetch_returns_content_on_success(self, engine):\n        with patch.object(engine, \"_fetch_url\", new_callable=AsyncMock) as mock_fetch:\n            mock_fetch.return_value = \"<html><body>Policy text</body></html>\"\n            result = await engine.fetch(\"https://laws.gc.ca/psea\")\n        assert result is not None\n        assert \"Policy\" in result\n\n    async def test_fetch_returns_none_on_http_error(self, engine):\n        with patch.object(engine, \"_fetch_url\", side_effect=Exception(\"404 Not Found\")):\n            with patch.object(engine, \"_get_stale_fallback\", new_callable=AsyncMock, return_value=None):\n                result = await engine.fetch(\"https://bad.gc.ca/missing\")\n        assert result is None\n\n    async def test_fetch_falls_back_to_stale_cache_on_failure(self, engine):\n        with patch.object(engine, \"_fetch_url\", side_effect=Exception(\"Network error\")):\n            with patch.object(engine, \"_get_stale_fallback\", new_callable=AsyncMock, return_value=\"Stale content\"):\n                result = await engine.fetch(\"https://example.gc.ca/policy\")\n        assert result == \"Stale content\"\n\n    async def test_fetch_normalizes_laws_lois_url(self, engine):\n        \"\"\"laws-lois.justice.gc.ca URLs should be rewritten to eng/acts path.\"\"\"\n        with patch.object(engine, \"_fetch_url\", new_callable=AsyncMock) as mock_fetch:\n            mock_fetch.return_value = \"<html><body>Act content</body></html>\"\n            await engine.fetch(\"https://laws-lois.justice.gc.ca/eng/acts/P-33.3/\")\n        called_url = mock_fetch.call_args[0][0]\n        assert \"laws-lois.justice.gc.ca\" in called_url\n\n\n@pytest.mark.asyncio\nclass TestFetchBatch:\n    async def test_fetch_batch_returns_dict(self, engine):\n        urls = [\"https://gc.ca/a\", \"https://gc.ca/b\"]\n        with patch.object(engine, \"fetch\", new_callable=AsyncMock) as mock_fetch:\n            mock_fetch.side_effect = [\"content-a\", \"content-b\"]\n            results = await engine.fetch_batch(urls)\n        assert len(results) == 2\n        assert results[\"https://gc.ca/a\"] == \"content-a\"\n\n    async def test_fetch_batch_partial_failure(self, engine):\n        urls = [\"https://gc.ca/ok\", \"https://gc.ca/fail\"]\n        with patch.object(engine, \"fetch\", new_callable=AsyncMock) as mock_fetch:\n            mock_fetch.side_effect = [\"content-ok\", None]\n            results = await engine.fetch_batch(urls)\n        assert results[\"https://gc.ca/ok\"] == \"content-ok\"\n        assert results[\"https://gc.ca/fail\"] is None\n\n    async def test_fetch_batch_empty_input(self, engine):\n        results = await engine.fetch_batch([])\n        assert results == {}\n\n    async def test_domain_rate_limit_respected(self, engine):\n        \"\"\"Concurrent fetches to the same domain should not exceed 3.\"\"\"\n        import asyncio\n        active = []\n        peak = [0]\n\n        async def mock_fetch(url):\n            active.append(url)\n            peak[0] = max(peak[0], len(active))\n            await asyncio.sleep(0.05)\n            active.pop()\n            return \"content\"\n\n        with patch.object(engine, \"_fetch_url\", side_effect=mock_fetch):\n            urls = [f\"https://tbs-sct.gc.ca/page{i}\" for i in range(6)]\n            await engine.fetch_batch(urls)\n        assert peak[0] <= 3\n```\n\n---\n\n",
        "level": 1
      },
      {
        "title": "Gap 5 — Fetch Cache: TTL, Domain-Based TTL, Stale Behaviour",
        "content": "\n```python\n",
        "level": 2
      },
      {
        "title": "tests/test_cache.py",
        "content": "import pytest\nfrom unittest.mock import AsyncMock, patch, MagicMock\nfrom src.fetch.cache import FetchCache, CacheEntry\nfrom datetime import datetime, timedelta\n\n\n@pytest.fixture\ndef cache():\n    return FetchCache()\n\n\nclass TestCacheEntry:\n    def test_is_valid_within_ttl(self):\n        entry = CacheEntry(\n            url=\"https://example.gc.ca\",\n            content=\"text\",\n            fetched_at=datetime.utcnow(),\n            ttl_hours=24,\n            content_hash=\"abc\",\n        )\n        assert entry.is_valid() is True\n\n    def test_is_invalid_after_expiry(self):\n        entry = CacheEntry(\n            url=\"https://example.gc.ca\",\n            content=\"text\",\n            fetched_at=datetime.utcnow() - timedelta(hours=25),\n            ttl_hours=24,\n            content_hash=\"abc\",\n        )\n        assert entry.is_valid() is False\n\n\n@pytest.mark.asyncio\nclass TestFetchCacheOperations:\n    async def test_get_returns_none_on_miss(self, cache):\n        with patch.object(cache, \"_db\") as mock_db:\n            mock_db.get_cached = AsyncMock(return_value=None)\n            result = await cache.get(\"https://notcached.gc.ca/x\")\n        assert result is None\n\n    async def test_get_returns_content_on_valid_hit(self, cache):\n        entry = MagicMock()\n        entry.is_valid.return_value = True\n        entry.content = \"Cached policy text\"\n        with patch.object(cache, \"_db\") as mock_db:\n            mock_db.get_cached = AsyncMock(return_value=entry)\n            result = await cache.get(\"https://canada.ca/policy\")\n        assert result == \"Cached policy text\"\n\n    async def test_get_returns_none_for_expired(self, cache):\n        entry = MagicMock()\n        entry.is_valid.return_value = False\n        with patch.object(cache, \"_db\") as mock_db:\n            mock_db.get_cached = AsyncMock(return_value=entry)\n            result = await cache.get(\"https://canada.ca/old\")\n        assert result is None\n\n    async def test_get_stale_returns_expired_content(self, cache):\n        entry = MagicMock()\n        entry.content = \"Stale content\"\n        with patch.object(cache, \"_db\") as mock_db:\n            mock_db.get_stale = AsyncMock(return_value=entry)\n            result = await cache.get_stale(\"https://canada.ca/stale\")\n        assert result == \"Stale content\"\n\n    async def test_store_uses_long_ttl_for_legislation_domain(self, cache):\n        with patch.object(cache, \"_db\") as mock_db:\n            mock_db.set_cached = AsyncMock()\n            await cache.store(\"https://laws-lois.justice.gc.ca/eng/acts/P-33.3/\", \"Act content\")\n            call_kwargs = mock_db.set_cached.call_args\n        ttl = call_kwargs[1].get(\"ttl_hours\") or call_kwargs[0][2]\n        assert ttl >= 720\n\n    async def test_store_uses_default_ttl_for_generic_domain(self, cache):\n        with patch.object(cache, \"_db\") as mock_db:\n            mock_db.set_cached = AsyncMock()\n            await cache.store(\"https://canada.ca/generic\", \"content\")\n            call_kwargs = mock_db.set_cached.call_args\n        ttl = call_kwargs[1].get(\"ttl_hours\") or call_kwargs[0][2]\n        assert ttl < 720\n```\n\n---\n\n",
        "level": 1
      },
      {
        "title": "Gap 6 — Content Extractor: Domain Selectors, Truncation, Malformed HTML",
        "content": "\n```python\n",
        "level": 2
      },
      {
        "title": "tests/test_extractors.py",
        "content": "import pytest\nfrom src.fetch.extractors import ContentExtractor\n\n\n@pytest.fixture\ndef extractor():\n    return ContentExtractor()\n\n\nclass TestExtractorEdgeCases:\n    def test_empty_html_returns_empty_string(self, extractor):\n        result = extractor.extract(\"https://example.gc.ca\", \"\")\n        assert result == \"\"\n\n    def test_malformed_html_does_not_raise(self, extractor):\n        result = extractor.extract(\"https://example.gc.ca\", \"<html><body><p>Unclosed tag\")\n        assert isinstance(result, str)\n\n    def test_content_truncated_at_48kb(self, extractor):\n        large_content = \"<p>\" + (\"A\" * 50_000) + \"</p>\"\n        html = f\"<html><body>{large_content}</body></html>\"\n        result = extractor.extract(\"https://example.gc.ca\", html)\n        assert len(result) <= 48 * 1024 + 100  # small tolerance for whitespace\n\n    def test_nav_elements_removed(self, extractor):\n        html = \"\"\"\n        <html><body>\n          <nav>Skip to main content</nav>\n          <main><p>Actual policy content</p></main>\n          <footer>Footer text</footer>\n        </body></html>\n        \"\"\"\n        result = extractor.extract(\"https://example.gc.ca\", html)\n        assert \"Skip to main content\" not in result\n        assert \"Footer text\" not in result\n        assert \"Actual policy content\" in result\n\n    def test_heading_hierarchy_preserved(self, extractor):\n        html = \"\"\"\n        <html><body>\n          <h1>Part 1</h1>\n          <h2>Section 1.1</h2>\n          <p>Content here.</p>\n        </body></html>\n        \"\"\"\n        result = extractor.extract(\"https://example.gc.ca\", html)\n        assert \"Part 1\" in result\n        assert \"Section 1.1\" in result\n\n    def test_domain_specific_selector_applied(self, extractor):\n        \"\"\"gc.ca pages may have a #wb-cont main content selector.\"\"\"\n        html = \"\"\"\n        <html><body>\n          <div id=\"wb-cont\"><p>Policy body text</p></div>\n          <div id=\"wb-info\">Footer boilerplate</div>\n        </body></html>\n        \"\"\"\n        result = extractor.extract(\"https://tbs-sct.gc.ca/directive\", html)\n        assert \"Policy body text\" in result\n```\n\n---\n\n",
        "level": 1
      },
      {
        "title": "Gap 7 — LLM Client: Retry Logic, Safety Filters, JSON Parsing",
        "content": "\n```python\n",
        "level": 2
      },
      {
        "title": "tests/test_llm_client.py",
        "content": "import pytest\nfrom unittest.mock import AsyncMock, MagicMock, patch\n\n\n@pytest.fixture\ndef client():\n    with patch.dict(\"os.environ\", {\"GEMINI_API_KEY\": \"fake-key\"}):\n        from src.llm.client import GeminiClient\n        return GeminiClient()\n\n\n@pytest.mark.asyncio\nclass TestGeminiClientChat:\n    async def test_chat_returns_string(self, client):\n        mock_response = MagicMock()\n        mock_response.text = \"LLM answer text\"\n        with patch.object(client, \"_model\") as mock_model:\n            mock_model.generate_content_async = AsyncMock(return_value=mock_response)\n            result = await client.chat(\"What is the staffing policy?\", \"You are an advisor.\")\n        assert result == \"LLM answer text\"\n\n    async def test_chat_retries_on_resource_exhausted(self, client):\n        from google.api_core.exceptions import ResourceExhausted\n        mock_ok = MagicMock()\n        mock_ok.text = \"Retry succeeded\"\n        with patch.object(client, \"_model\") as mock_model:\n            mock_model.generate_content_async = AsyncMock(\n                side_effect=[ResourceExhausted(\"rate limit\"), mock_ok]\n            )\n            result = await client.chat(\"query\", \"system\")\n        assert result == \"Retry succeeded\"\n\n    async def test_chat_returns_empty_on_safety_block(self, client):\n        mock_response = MagicMock()\n        mock_response.text = None\n        mock_response.candidates = []\n        with patch.object(client, \"_model\") as mock_model:\n            mock_model.generate_content_async = AsyncMock(return_value=mock_response)\n            result = await client.chat(\"query\", \"system\")\n        assert result == \"\"\n\n    async def test_chat_parsed_returns_dict_on_valid_json(self, client):\n        valid_json = '{\"findings\": \"Policy allows X\", \"confidence\": \"high\"}'\n        with patch.object(client, \"chat\", new_callable=AsyncMock, return_value=valid_json):\n            result = await client.chat_parsed(\"query\", \"system\")\n        assert isinstance(result, dict)\n        assert result[\"confidence\"] == \"high\"\n\n    async def test_chat_parsed_returns_none_on_invalid_json(self, client):\n        with patch.object(client, \"chat\", new_callable=AsyncMock, return_value=\"Not valid JSON\"):\n            result = await client.chat_parsed(\"query\", \"system\")\n        assert result is None\n\n    async def test_stream_chat_yields_tokens(self, client):\n        async def mock_stream(*args, **kwargs):\n            for token in [\"token1\", \" token2\", \" token3\"]:\n                chunk = MagicMock()\n                chunk.text = token\n                yield chunk\n\n        with patch.object(client, \"_model\") as mock_model:\n            mock_model.generate_content_async = AsyncMock(return_value=mock_stream())\n            tokens = []\n            async for token in client.stream_chat(\"q\", \"sys\"):\n                tokens.append(token)\n        assert \"\".join(tokens) == \"token1 token2 token3\"\n\n    async def test_missing_api_key_raises_on_init(self):\n        with patch.dict(\"os.environ\", {}, clear=True):\n            with pytest.raises(ValueError, match=\"GEMINI_API_KEY\"):\n                from src.llm import client as llm_mod\n                import importlib\n                importlib.reload(llm_mod)\n                llm_mod.GeminiClient()\n```\n\n---\n\n",
        "level": 1
      },
      {
        "title": "Gap 8 — Base Agent: build_prompt(), Property Accessors",
        "content": "\n```python\n",
        "level": 2
      },
      {
        "title": "tests/test_base_agent.py",
        "content": "import pytest\nfrom src.agents.base import GenericAgent\n\n\n@pytest.fixture\ndef agent():\n    return GenericAgent(\n        agent_id=\"staffing\",\n        display_name=\"Staffing Advisor\",\n        domain_description=\"Public service staffing law\",\n        system_prompt=\"You are a staffing specialist.\",\n    )\n\n\nclass TestGenericAgent:\n    def test_properties(self, agent):\n        assert agent.agent_id == \"staffing\"\n        assert agent.display_name == \"Staffing Advisor\"\n        assert \"staffing\" in agent.domain_description.lower()\n\n    def test_build_prompt_without_context(self, agent):\n        prompt = agent.build_prompt(\"How do I promote an employee?\")\n        assert \"How do I promote\" in prompt\n        assert \"policy context\" not in prompt.lower()\n\n    def test_build_prompt_with_policy_context(self, agent):\n        prompt = agent.build_prompt(\n            \"How do I promote an employee?\",\n            policy_context=\"PSEA Section 30 governs appointment processes.\",\n        )\n        assert \"PSEA Section 30\" in prompt\n        assert \"How do I promote\" in prompt\n\n    def test_process_raises_not_implemented(self, agent):\n        with pytest.raises(NotImplementedError):\n            import asyncio\n            asyncio.run(agent.process(\"query\"))\n```\n\n---\n\n",
        "level": 1
      },
      {
        "title": "Gap 9 — Specialist Agent: fetch path, instrument loading, retrieval tracking",
        "content": "\n```python\n",
        "level": 2
      },
      {
        "title": "tests/test_specialist.py",
        "content": "import pytest\nfrom unittest.mock import AsyncMock, patch, MagicMock\nfrom src.agents.specialist import SpecialistAgent\n\n\n@pytest.fixture\ndef specialist():\n    return SpecialistAgent(\n        agent_id=\"staffing\",\n        display_name=\"Staffing\",\n        domain_description=\"Staffing policy\",\n        system_prompt=\"You are a staffing advisor.\",\n    )\n\n\n@pytest.mark.asyncio\nclass TestSpecialistAgent:\n    async def test_process_without_fetch_returns_response(self, specialist):\n        with patch(\"src.agents.specialist.get_client\") as mock_client_fn:\n            mock_client = MagicMock()\n            mock_client.chat_parsed = AsyncMock(return_value={\n                \"findings\": \"PSEA governs merit-based appointments.\",\n                \"citations\": [],\n                \"confidence\": \"high\",\n            })\n            mock_client_fn.return_value = mock_client\n            response = await specialist.process(\"What are merit principles?\")\n        assert response.agent_id == \"staffing\"\n        assert response.confidence == \"high\"\n\n    async def test_process_with_fetch_tracks_retrieval_status(self, specialist):\n        with patch(\"src.agents.specialist.get_fetch_engine\") as mock_engine_fn, \\\n             patch(\"src.agents.specialist.get_client\") as mock_client_fn:\n            mock_engine = MagicMock()\n            mock_engine.fetch = AsyncMock(return_value=\"Policy content\")\n            mock_engine_fn.return_value = mock_engine\n\n            mock_client = MagicMock()\n            mock_client.chat_parsed = AsyncMock(return_value={\n                \"findings\": \"PSEA Section 30 applies.\",\n                \"citations\": [],\n                \"confidence\": \"medium\",\n            })\n            mock_client_fn.return_value = mock_client\n\n            response = await specialist.process_with_fetch(\"What is merit?\")\n\n        assert response.retrieval_status.instruments_attempted > 0\n        assert response.retrieval_status.instruments_successfully_retrieved >= 0\n\n    async def test_process_with_fetch_limits_to_4_documents(self, specialist):\n        fetched_urls = []\n\n        async def track_fetch(url):\n            fetched_urls.append(url)\n            return \"content\"\n\n        with patch(\"src.agents.specialist.get_fetch_engine\") as mock_engine_fn, \\\n             patch(\"src.agents.specialist.get_client\") as mock_client_fn, \\\n             patch.object(specialist, \"_load_instruments\") as mock_instruments:\n            # Provide 8 instruments — only 4 should be fetched\n            mock_instruments.return_value = [\n                MagicMock(url=f\"https://gc.ca/policy{i}\") for i in range(8)\n            ]\n            mock_engine = MagicMock()\n            mock_engine.fetch = AsyncMock(side_effect=track_fetch)\n            mock_engine_fn.return_value = mock_engine\n\n            mock_client = MagicMock()\n            mock_client.chat_parsed = AsyncMock(return_value={\n                \"findings\": \"Summary.\", \"citations\": [], \"confidence\": \"low\",\n            })\n            mock_client_fn.return_value = mock_client\n\n            await specialist.process_with_fetch(\"query\")\n\n        assert len(fetched_urls) <= 4\n\n    async def test_failed_fetch_recorded_in_retrieval_status(self, specialist):\n        with patch(\"src.agents.specialist.get_fetch_engine\") as mock_engine_fn, \\\n             patch(\"src.agents.specialist.get_client\") as mock_client_fn:\n            mock_engine = MagicMock()\n            mock_engine.fetch = AsyncMock(return_value=None)  # all fail\n            mock_engine_fn.return_value = mock_engine\n\n            mock_client = MagicMock()\n            mock_client.chat_parsed = AsyncMock(return_value={\n                \"findings\": \"Cannot retrieve.\", \"citations\": [], \"confidence\": \"low\",\n            })\n            mock_client_fn.return_value = mock_client\n\n            response = await specialist.process_with_fetch(\"query\")\n\n        assert response.retrieval_status.instruments_successfully_retrieved == 0\n        assert len(response.retrieval_status.instruments_failed) > 0\n```\n\n---\n\n",
        "level": 1
      },
      {
        "title": "Gap 10 — Orchestrator: Routing, Citation Deduplication, JSON Fallback",
        "content": "\n```python\n",
        "level": 2
      },
      {
        "title": "tests/test_orchestrator.py",
        "content": "import pytest\nfrom unittest.mock import AsyncMock, patch, MagicMock\nfrom src.agents.orchestrator import OrchestratorAgent\nfrom src.models.schemas import SpecialistResponse, RetrievalStatus\n\n\ndef make_specialist_response(agent_id, findings, citations=None):\n    return SpecialistResponse(\n        agent_id=agent_id,\n        findings=findings,\n        citations=citations or [],\n        confidence=\"high\",\n        retrieval_status=RetrievalStatus(\n            instruments_attempted=1,\n            instruments_successfully_retrieved=1,\n            instruments_failed=[],\n        ),\n    )\n\n\n@pytest.fixture\ndef orchestrator():\n    return OrchestratorAgent()\n\n\n@pytest.mark.asyncio\nclass TestOrchestratorRouting:\n    async def test_route_returns_list_of_agent_ids(self, orchestrator):\n        with patch(\"src.agents.orchestrator.get_client\") as mock_fn:\n            mock_client = MagicMock()\n            mock_client.chat_parsed = AsyncMock(return_value={\n                \"agents_selected\": [\"staffing\", \"classification\"],\n                \"rationale\": \"Query relates to staffing and classification domains.\",\n            })\n            mock_fn.return_value = mock_client\n            decision = await orchestrator._route(\"How do I reclassify a position?\")\n        assert \"classification\" in decision.agents_selected\n        assert \"staffing\" in decision.agents_selected\n\n    async def test_route_fallback_on_json_parse_failure(self, orchestrator):\n        with patch(\"src.agents.orchestrator.get_client\") as mock_fn:\n            mock_client = MagicMock()\n            mock_client.chat_parsed = AsyncMock(return_value=None)  # parse failed\n            mock_fn.return_value = mock_client\n            # Should not raise — return default routing\n            decision = await orchestrator._route(\"ambiguous query\")\n        assert isinstance(decision.agents_selected, list)\n\n\n@pytest.mark.asyncio\nclass TestOrchestratorSynthesis:\n    async def test_process_synthesizes_multiple_specialists(self, orchestrator):\n        responses = [\n            make_specialist_response(\"staffing\", \"PSEA merit-based appointments.\"),\n            make_specialist_response(\"classification\", \"OC classification standards apply.\"),\n        ]\n        with patch(\"src.agents.orchestrator.get_client\") as mock_fn:\n            mock_client = MagicMock()\n            mock_client.chat = AsyncMock(return_value='{\"synthesis\": \"Both policies apply.\", \"citations\": [], \"confidence_summary\": \"high\"}')\n            mock_fn.return_value = mock_client\n            result = await orchestrator.process(\"How do staffing and classification interact?\", responses)\n        assert result.synthesis is not None\n\n    async def test_aggregate_citations_deduplicates_by_url(self, orchestrator):\n        from src.models.schemas import CitationItem\n        shared_url = \"https://laws.gc.ca/psea\"\n        resp1 = make_specialist_response(\"staffing\", \"text\", citations=[\n            CitationItem(title=\"PSEA\", url=shared_url, excerpt=\"s.30\")\n        ])\n        resp2 = make_specialist_response(\"classification\", \"text\", citations=[\n            CitationItem(title=\"PSEA\", url=shared_url, excerpt=\"s.30\")\n        ])\n        citations = orchestrator._aggregate_citations([resp1, resp2])\n        urls = [c.url for c in citations]\n        assert urls.count(shared_url) == 1\n\n    async def test_process_with_streaming_calls_status_callback(self, orchestrator):\n        status_events = []\n\n        async def on_status(event):\n            status_events.append(event)\n\n        with patch.object(orchestrator, \"_route\", new_callable=AsyncMock) as mock_route, \\\n             patch(\"src.agents.orchestrator.get_specialists\") as mock_specialists_fn, \\\n             patch.object(orchestrator, \"process\", new_callable=AsyncMock) as mock_process:\n            from src.models.schemas import RoutingDecision, OrchestratorResponse\n            mock_route.return_value = RoutingDecision(agents_selected=[\"staffing\"], rationale=\"domain match\")\n            mock_specialist = MagicMock()\n            mock_specialist.process_with_fetch = AsyncMock(return_value=make_specialist_response(\"staffing\", \"f\"))\n            mock_specialists_fn.return_value = {\"staffing\": mock_specialist}\n            mock_process.return_value = OrchestratorResponse(\n                query_id=\"q\", query_text=\"q\", synthesis=\"s\",\n                citations=[], routing_decision=RoutingDecision(agents_selected=[\"staffing\"], rationale=\"r\"),\n                confidence_summary=\"high\",\n            )\n            result = await orchestrator.process_with_streaming(\"How is merit defined?\", on_status)\n\n        assert any(\"staffing\" in str(e) for e in status_events)\n```\n\n---\n\n",
        "level": 1
      },
      {
        "title": "Gap 11 — REST API Endpoints",
        "content": "\n```python\n",
        "level": 2
      },
      {
        "title": "tests/test_api_routes.py",
        "content": "import pytest\nfrom fastapi.testclient import TestClient\nfrom unittest.mock import AsyncMock, patch, MagicMock\nfrom src.main import app\n\nclient = TestClient(app)\n\n\nclass TestHealthEndpoint:\n    def test_health_returns_200(self):\n        with patch(\"src.api.routes.get_db\") as mock_db_fn:\n            mock_db = MagicMock()\n            mock_db.get_stats = AsyncMock(return_value={\"total_queries\": 5})\n            mock_db_fn.return_value = mock_db\n            response = client.get(\"/health\")\n        assert response.status_code == 200\n        assert \"status\" in response.json()\n\n    def test_health_includes_db_status(self):\n        with patch(\"src.api.routes.get_db\"):\n            response = client.get(\"/health\")\n        data = response.json()\n        assert \"database\" in data or \"status\" in data\n\n\nclass TestAgentsEndpoint:\n    def test_agents_returns_list(self):\n        response = client.get(\"/agents\")\n        assert response.status_code == 200\n        agents = response.json()\n        assert isinstance(agents, list)\n        assert len(agents) == 8\n\n    def test_agents_include_required_fields(self):\n        response = client.get(\"/agents\")\n        for agent in response.json():\n            assert \"agent_id\" in agent\n            assert \"display_name\" in agent\n\n\nclass TestQueriesEndpoint:\n    def test_list_queries_returns_200(self):\n        with patch(\"src.api.routes.get_db\") as mock_db_fn:\n            mock_db = MagicMock()\n            mock_db.list_queries = AsyncMock(return_value=[])\n            mock_db_fn.return_value = mock_db\n            response = client.get(\"/queries\")\n        assert response.status_code == 200\n\n    def test_list_queries_default_limit_50(self):\n        with patch(\"src.api.routes.get_db\") as mock_db_fn:\n            mock_db = MagicMock()\n            mock_db.list_queries = AsyncMock(return_value=[])\n            mock_db_fn.return_value = mock_db\n            client.get(\"/queries\")\n            call_kwargs = mock_db.list_queries.call_args\n        limit = call_kwargs[1].get(\"limit\") or call_kwargs[0][0]\n        assert limit == 50\n\n    def test_list_queries_rejects_limit_over_100(self):\n        response = client.get(\"/queries?limit=200\")\n        assert response.status_code == 422\n\n    def test_get_query_not_found_returns_404(self):\n        with patch(\"src.api.routes.get_db\") as mock_db_fn:\n            mock_db = MagicMock()\n            mock_db.get_query = AsyncMock(return_value=None)\n            mock_db_fn.return_value = mock_db\n            response = client.get(\"/queries/nonexistent-id\")\n        assert response.status_code == 404\n\n\nclass TestFeedbackEndpoint:\n    def test_post_feedback_returns_201(self):\n        with patch(\"src.api.routes.get_db\") as mock_db_fn:\n            mock_db = MagicMock()\n            mock_db.save_feedback = AsyncMock()\n            mock_db_fn.return_value = mock_db\n            response = client.post(\"/feedback\", json={\"query_id\": \"q-1\", \"rating\": \"accurate\"})\n        assert response.status_code in (200, 201)\n\n    def test_post_feedback_invalid_rating_returns_422(self):\n        response = client.post(\"/feedback\", json={\"query_id\": \"q-1\", \"rating\": \"invalid\"})\n        assert response.status_code == 422\n\n    def test_feedback_export_returns_list(self):\n        with patch(\"src.api.routes.get_db\") as mock_db_fn:\n            mock_db = MagicMock()\n            mock_db.export_feedback = AsyncMock(return_value=[])\n            mock_db_fn.return_value = mock_db\n            response = client.get(\"/feedback/export\")\n        assert response.status_code == 200\n        assert isinstance(response.json(), list)\n```\n\n---\n\n",
        "level": 1
      },
      {
        "title": "Gap 12 — WebSocket: Lifecycle, Disconnect, Error Handling",
        "content": "\n```python\n",
        "level": 2
      },
      {
        "title": "tests/test_websocket.py",
        "content": "import pytest\nimport json\nfrom unittest.mock import AsyncMock, MagicMock, patch\nfrom fastapi.testclient import TestClient\nfrom src.main import app\n\n\nclass TestWebSocketLifecycle:\n    def test_websocket_connects_and_receives_welcome(self):\n        with TestClient(app).websocket_connect(\"/ws\") as ws:\n            welcome = ws.receive_json()\n            assert welcome[\"type\"] == \"session_start\"\n            assert \"session_id\" in welcome\n\n    def test_websocket_query_start_triggers_processing(self):\n        with patch(\"src.api.websocket.process_query\", new_callable=AsyncMock) as mock_process:\n            mock_process.return_value = None\n            with TestClient(app).websocket_connect(\"/ws\") as ws:\n                ws.receive_json()  # welcome\n                ws.send_json({\"type\": \"query_start\", \"query_text\": \"What is bilingualism policy?\"})\n                # Allow brief processing — just verify no crash\n        assert mock_process.called\n\n    def test_websocket_sends_error_on_missing_query_text(self):\n        with TestClient(app).websocket_connect(\"/ws\") as ws:\n            ws.receive_json()  # welcome\n            ws.send_json({\"type\": \"query_start\"})  # missing query_text\n            response = ws.receive_json()\n        assert response[\"type\"] == \"error\"\n\n    def test_websocket_sends_error_on_invalid_json(self):\n        with TestClient(app).websocket_connect(\"/ws\") as ws:\n            ws.receive_json()  # welcome\n            ws.send_text(\"not-valid-json\")\n            response = ws.receive_json()\n        assert response[\"type\"] == \"error\"\n\n    def test_websocket_handles_unknown_message_type_gracefully(self):\n        with TestClient(app).websocket_connect(\"/ws\") as ws:\n            ws.receive_json()  # welcome\n            ws.send_json({\"type\": \"unknown_type\"})\n            # Should not crash; may return error or ignore\n            # Verify connection remains open for next message\n            ws.send_json({\"type\": \"ping\"})\n\n\nclass TestProcessQueryFunction:\n    @pytest.mark.asyncio\n    async def test_process_query_saves_to_db(self):\n        from src.api.websocket import process_query\n        mock_ws = MagicMock()\n        mock_ws.send_json = AsyncMock()\n        mock_ws.send_text = AsyncMock()\n\n        with patch(\"src.api.websocket.get_db\") as mock_db_fn, \\\n             patch(\"src.api.websocket.get_orchestrator\") as mock_orch_fn:\n            mock_db = MagicMock()\n            mock_db.save_query = AsyncMock()\n            mock_db.save_agent_response = AsyncMock()\n            mock_db.save_orchestrator_response = AsyncMock()\n            mock_db_fn.return_value = mock_db\n\n            mock_orch = MagicMock()\n            mock_orch.process_with_streaming = AsyncMock(return_value=MagicMock(\n                query_id=\"q\", synthesis=\"s\", citations=[], confidence_summary=\"high\",\n                routing_decision=MagicMock(agents_selected=[\"staffing\"]),\n            ))\n            mock_orch_fn.return_value = mock_orch\n\n            await process_query(mock_ws, \"What is PRI?\", \"sess-1\")\n\n        assert mock_db.save_query.called\n        assert mock_db.save_orchestrator_response.called\n\n    @pytest.mark.asyncio\n    async def test_process_query_sends_ws_error_on_exception(self):\n        from src.api.websocket import process_query\n        mock_ws = MagicMock()\n        mock_ws.send_json = AsyncMock()\n\n        with patch(\"src.api.websocket.get_db\") as mock_db_fn, \\\n             patch(\"src.api.websocket.get_orchestrator\") as mock_orch_fn:\n            mock_db = MagicMock()\n            mock_db.save_query = AsyncMock()\n            mock_db_fn.return_value = mock_db\n\n            mock_orch = MagicMock()\n            mock_orch.process_with_streaming = AsyncMock(side_effect=RuntimeError(\"LLM timeout\"))\n            mock_orch_fn.return_value = mock_orch\n\n            await process_query(mock_ws, \"query\", \"sess-1\")\n\n        sent_messages = [call.args[0] for call in mock_ws.send_json.call_args_list]\n        assert any(m.get(\"type\") == \"error\" for m in sent_messages)\n```\n\n---\n\n",
        "level": 1
      },
      {
        "title": "Gap Summary Table",
        "content": "| Gap | Module | Severity | Type |\n|---|---|---|---|\n| All WebSocket message types | `schemas.py` | Medium | Unit |\n| confidence/rating enum validation | `schemas.py` | High | Unit |\n| Env var config overrides | `config.py` | Medium | Unit |\n| `list_queries`, `save_agent_response`, feedback CRUD, cache CRUD | `db.py` | High | Unit |\n| `fetch()` cache-fallback, rate-limit, URL normalization | `fetch/engine.py` | High | Unit |\n| `fetch_batch()` partial failure | `fetch/engine.py` | High | Unit |\n| TTL boundary, stale fallback, domain-based TTL | `fetch/cache.py` | High | Unit |\n| Empty/malformed HTML, 48KB truncation, nav removal | `fetch/extractors.py` | Medium | Unit |\n| Retry on `ResourceExhausted`, safety filter, JSON parse failure | `llm/client.py` | Critical | Unit |\n| `build_prompt()` with/without context | `agents/base.py` | Low | Unit |\n| `process_with_fetch()` 4-doc limit, retrieval tracking | `agents/specialist.py` | High | Unit |\n| `_route()` fallback, citation dedup, streaming callback | `agents/orchestrator.py` | High | Unit |\n| All REST endpoints, 404/422 responses | `api/routes.py` | High | Integration |\n| WebSocket connect/disconnect, error on bad JSON | `api/websocket.py` | Critical | Integration |\n| Full query→response→DB pipeline | end-to-end | Critical | E2E |\n\nThe most critical gaps are the **LLM client retry/safety handling** and the **WebSocket error paths** — both are production failure modes with no current test coverage at all.",
        "level": 2
      }
    ],
    "codeBlocks": [
      {
        "language": "python",
        "code": "# tests/test_schemas.py\nimport pytest\nfrom pydantic import ValidationError\nfrom src.models.schemas import (\n    OrchestratorResponse, OrchestratorCitation, RoutingDecision,\n    WSUserQuery, WSAgentStatusUpdate, WSResponseChunk, WSResponseComplete, WSError,\n    QueryRecord, FeedbackRecord, CitationItem, RetrievalStatus, SpecialistResponse,\n)\n\n\nclass TestOrchestratorResponse:\n    def test_full_construction(self):\n        resp = OrchestratorResponse(\n            query_id=\"qid-1\",\n            query_text=\"Can I promote without competition?\",\n            synthesis=\"Based on PSEA...\",\n            citations=[OrchestratorCitation(title=\"PSEA\", url=\"https://laws.gc.ca/psea\", source_agent=\"staffing\")],\n            routing_decision=RoutingDecision(agents_selected=[\"staffing\"], rationale=\"staffing domain\"),\n            confidence_summary=\"high\",\n        )\n        assert resp.query_id == \"qid-1\"\n        assert len(resp.citations) == 1\n\n    def test_optional_fields_default_none(self):\n        resp = OrchestratorResponse(\n            query_id=\"q\", query_text=\"q\", synthesis=\"s\",\n            citations=[], routing_decision=RoutingDecision(agents_selected=[], rationale=\"\"),\n            confidence_summary=\"medium\",\n        )\n        assert resp.policy_tensions is None\n        assert resp.gaps_and_limitations is None\n\n    def test_invalid_confidence_rejected(self):\n        # confidence_summary is a free string in current schema;\n        # this test documents the expectation if an enum is added\n        pass  # Update when enum constraint is enforced\n\n\nclass TestWebSocketMessages:\n    def test_ws_user_query(self):\n        msg = WSUserQuery(query_text=\"What is bilingualism policy?\", session_id=\"sess-1\")\n        assert msg.type == \"query_start\"\n\n    def test_ws_agent_status_update(self):\n        msg = WSAgentStatusUpdate(agent_id=\"staffing\", status=\"running\", message=\"Fetching documents\")\n        assert msg.type == \"agent_status\"\n\n    def test_ws_response_complete(self):\n        resp = OrchestratorResponse(\n            query_id=\"q\", query_text=\"q\", synthesis=\"s\",\n            citations=[], routing_decision=RoutingDecision(agents_selected=[], rationale=\"\"),\n            confidence_summary=\"low\",\n        )\n        msg = WSResponseComplete(response=resp)\n        assert msg.type == \"response_complete\"\n\n    def test_ws_error(self):\n        msg = WSError(message=\"Internal error\", code=\"PROCESSING_FAILED\")\n        assert msg.type == \"error\"\n\n    def test_ws_user_query_missing_text_raises(self):\n        with pytest.raises(ValidationError):\n            WSUserQuery()  # missing query_text\n\n\nclass TestFeedbackRecord:\n    def test_valid_ratings(self):\n        for rating in (\"accurate\", \"needs_work\"):\n            r = FeedbackRecord(query_id=\"q\", rating=rating)\n            assert r.rating == rating\n\n    def test_invalid_rating_rejected(self):\n        with pytest.raises(ValidationError):\n            FeedbackRecord(query_id=\"q\", rating=\"wrong_value\")"
