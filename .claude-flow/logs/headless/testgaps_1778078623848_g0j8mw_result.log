        "code": "# tests/test_orchestrator.py\n\"\"\"Unit tests for OrchestratorAgent methods that don't require LLM calls.\"\"\"\nimport pytest\n\nfrom src.agents.orchestrator import OrchestratorAgent\nfrom src.models.schemas import CitationItem, RetrievalStatus, SpecialistResponse\n\n\ndef make_specialist_response(agent_id: str, citations: list[CitationItem] | None = None):\n    return SpecialistResponse(\n        agent_id=agent_id,\n        findings=\"Some findings\",\n        citations=citations or [],\n        confidence=\"high\",\n        retrieval_status=RetrievalStatus(\n            instruments_attempted=1,\n            instruments_successfully_retrieved=1,\n            instruments_failed=[],\n        ),\n    )\n\n\nclass TestAggregrateCitations:\n    def setup_method(self):\n        self.orch = OrchestratorAgent()\n\n    def test_deduplicates_same_url(self):\n        citation = CitationItem(\n            instrument_title=\"PSEA\",\n            instrument_type=\"Act\",\n            url=\"https://example.com/psea\",\n        )\n        resp_a = make_specialist_response(\"staffing\", [citation])\n        resp_b = make_specialist_response(\"labour\", [citation])\n        result = self.orch._aggregate_citations([resp_a.model_dump(), resp_b.model_dump()])\n        urls = [c.url for c in result]\n        assert urls.count(\"https://example.com/psea\") == 1\n\n    def test_empty_responses_returns_empty(self):\n        result = self.orch._aggregate_citations([])\n        assert result == []\n\n    def test_preserves_distinct_citations(self):\n        c1 = CitationItem(instrument_title=\"A\", instrument_type=\"Policy\", url=\"https://a.com\")\n        c2 = CitationItem(instrument_title=\"B\", instrument_type=\"Directive\", url=\"https://b.com\")\n        resp = make_specialist_response(\"staffing\", [c1, c2])\n        result = self.orch._aggregate_citations([resp.model_dump()])\n        assert len(result) == 2\n\n\nclass TestDeterministicGrounding:\n    def setup_method(self):\n        self.orch = OrchestratorAgent()\n\n    def test_validate_mode_detected(self):\n        resp = make_specialist_response(\"staffing\")\n        resp.grounding_mode = \"validate\"\n        grounding = self.orch._deterministic_grounding([resp.model_dump()])\n        assert grounding.agents_in_validate_mode == [\"staffing\"]\n\n    def test_no_validate_mode(self):\n        resp = make_specialist_response(\"staffing\")\n        grounding = self.orch._deterministic_grounding([resp.model_dump()])\n        assert grounding.agents_in_validate_mode == []\n\n\nclass TestBuildSynthesisPrompt:\n    def setup_method(self):\n        self.orch = OrchestratorAgent()\n\n    def test_prompt_contains_query(self):\n        resp = make_specialist_response(\"staffing\")\n        prompt = self.orch._build_synthesis_prompt(\"Who can hire?\", [resp.model_dump()])\n        assert \"Who can hire?\" in prompt\n\n    def test_prompt_contains_agent_findings(self):\n        resp = make_specialist_response(\"staffing\")\n        prompt = self.orch._build_synthesis_prompt(\"query\", [resp.model_dump()])\n        assert \"staffing\" in prompt.lower() or \"Some findings\" in prompt"
