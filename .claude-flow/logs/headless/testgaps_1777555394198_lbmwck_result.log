        "code": "# tests/test_config.py\nimport pytest\nimport os\nimport tempfile\nimport yaml\nfrom pathlib import Path\nfrom src.config import load_config\n\n\ndef write_config(path, data):\n    with open(path, \"w\") as f:\n        yaml.dump(data, f)\n\n\ndef test_config_loads_valid_yaml(tmp_path):\n    cfg_path = tmp_path / \"config.yaml\"\n    write_config(cfg_path, {\"model\": {\"name\": \"gemini-1.5-pro\"}, \"server\": {\"host\": \"0.0.0.0\", \"port\": 8000}})\n    config = load_config(cfg_path)\n    assert config.model.name == \"gemini-1.5-pro\"\n\n\ndef test_config_missing_file_raises():\n    with pytest.raises(FileNotFoundError):\n        load_config(\"/nonexistent/path/config.yaml\")\n\n\ndef test_config_malformed_yaml_raises(tmp_path):\n    cfg_path = tmp_path / \"config.yaml\"\n    cfg_path.write_text(\"model: {name: [unclosed\")\n    with pytest.raises(Exception):  # yaml.YAMLError\n        load_config(cfg_path)\n\n\ndef test_config_env_override_port(tmp_path, monkeypatch):\n    \"\"\"PORT env var should override config.yaml server.port.\"\"\"\n    cfg_path = tmp_path / \"config.yaml\"\n    write_config(cfg_path, {\"server\": {\"host\": \"0.0.0.0\", \"port\": 8000}})\n    monkeypatch.setenv(\"PORT\", \"9999\")\n    config = load_config(cfg_path)\n    assert config.server.port == 9999\n\n\ndef test_config_env_override_model(tmp_path, monkeypatch):\n    cfg_path = tmp_path / \"config.yaml\"\n    write_config(cfg_path, {\"model\": {\"name\": \"gemini-1.5-pro\"}})\n    monkeypatch.setenv(\"MODEL\", \"gemini-2.0-flash\")\n    config = load_config(cfg_path)\n    assert config.model.name == \"gemini-2.0-flash\""
