        "code": "# tests/test_parsing/test_graph_query_extended.py\n\nimport pytest\nfrom src.models.schemas import PolicyTriple\nfrom src.parsing.graph_query import GraphQueryEngine\n\n\ndef _triple(subject, object_, deontic_type=None, flags=None):\n    return PolicyTriple(\n        triple_id=\"t1\", doc_id=\"d1\",\n        source_url=\"https://x.com\", instrument_title=\"P\",\n        agent_id=\"staffing\", section_heading=None,\n        sentence_text=\"test\",\n        subject=subject, predicate=\"must\", predicate_lemma=\"must\",\n        is_deontic=True, deontic_type=deontic_type or \"obligation\",\n        object_=object_, modifier=None,\n        validation_flags=flags or [],\n    )\n\n\nclass TestGraphQueryScoring:\n    def setup_method(self):\n        self.graph = GraphQueryEngine()\n\n    def test_zero_score_when_no_match(self):\n        triple = _triple(\"manager\", \"form\")\n        score = self.graph._score(triple, query_entities=[\"employee\"], query_verbs=[\"may\"])\n        assert score == 0\n\n    def test_object_match_contributes_one(self):\n        triple = _triple(\"manager\", \"indeterminate\")\n        score = self.graph._score(triple, query_entities=[\"indeterminate\"], query_verbs=[])\n        assert score == 1\n\n    def test_subject_and_object_match(self):\n        triple = _triple(\"employee\", \"form\")\n        score = self.graph._score(\n            triple, query_entities=[\"employee\", \"form\"], query_verbs=[]\n        )\n        assert score == 3  # 2 for subject + 1 for object\n\n    def test_corroboration_flag_adds_one(self):\n        triple = _triple(\"manager\", \"form\", flags=[\"CROSS_INSTRUMENT_CORROBORATION\"])\n        score = self.graph._score(triple, query_entities=[], query_verbs=[])\n        assert score == 1\n\n\nclass TestFindConflicts:\n    def setup_method(self):\n        self.graph = GraphQueryEngine()\n\n    def test_same_object_no_conflict(self):\n        t1 = _triple(\"employee\", \"form\")\n        t2 = _triple(\"employee\", \"form\")\n        conflicts = self.graph._pair_conflicts([t1, t2])\n        assert conflicts == []\n\n    def test_different_objects_produce_conflict(self):\n        t1 = _triple(\"employee\", \"form\")\n        t2 = _triple(\"employee\", \"report\")\n        conflicts = self.graph._pair_conflicts([t1, t2])\n        assert len(conflicts) == 1\n\n    def _pair_conflicts(self, triples):\n        # Inline the pairing logic (avoids DB) — replicate _find_conflicts logic\n        conflicts = []\n        for i, left in enumerate(triples):\n            for right in triples[i + 1:]:\n                if left.object_.lower() != right.object_.lower():\n                    conflicts.append((left, right))\n        return conflicts"
