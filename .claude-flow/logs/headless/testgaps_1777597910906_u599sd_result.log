        "title": "tests/test_websocket_manager.py",
        "content": "\"\"\"Tests for WebSocketManager.\"\"\"\n\nimport pytest\nfrom unittest.mock import AsyncMock, MagicMock\n\n\nclass TestWebSocketManager:\n    @pytest.mark.asyncio\n    async def test_connect_accepts_websocket(self):\n        from src.api.websocket import WebSocketManager\n        manager = WebSocketManager()\n        mock_ws = AsyncMock()\n        await manager.connect(\"q1\", mock_ws)\n        mock_ws.accept.assert_called_once()\n        assert \"q1\" in manager._connections\n\n    @pytest.mark.asyncio\n    async def test_disconnect_removes_connection(self):\n        from src.api.websocket import WebSocketManager\n        manager = WebSocketManager()\n        mock_ws = AsyncMock()\n        await manager.connect(\"q1\", mock_ws)\n        await manager.disconnect(\"q1\")\n        assert \"q1\" not in manager._connections\n\n    @pytest.mark.asyncio\n    async def test_send_returns_false_for_unknown_query(self):\n        from src.api.websocket import WebSocketManager\n        manager = WebSocketManager()\n        result = await manager.send(\"nonexistent\", {\"type\": \"test\"})\n        assert result is False\n\n    @pytest.mark.asyncio\n    async def test_send_removes_connection_on_failure(self):\n        from src.api.websocket import WebSocketManager\n        manager = WebSocketManager()\n        mock_ws = AsyncMock()\n        mock_ws.send_json = AsyncMock(side_effect=Exception(\"broken pipe\"))\n        await manager.connect(\"q1\", mock_ws)\n        result = await manager.send(\"q1\", {\"type\": \"test\"})\n        assert result is False\n        assert \"q1\" not in manager._connections\n\n    @pytest.mark.asyncio\n    async def test_broadcast_error_sends_to_all_connections(self):\n        from src.api.websocket import WebSocketManager\n        manager = WebSocketManager()\n        ws1, ws2 = AsyncMock(), AsyncMock()\n        await manager.connect(\"q1\", ws1)\n        await manager.connect(\"q2\", ws2)\n        await manager.broadcast_error(\"Something broke\")\n        ws1.send_json.assert_called_once()\n        ws2.send_json.assert_called_once()\n```\n\n---\n\n",
        "level": 1
      },
