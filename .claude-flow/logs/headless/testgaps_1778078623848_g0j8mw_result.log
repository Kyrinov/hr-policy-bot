        "language": "python",
        "code": "# tests/test_db_extended.py\n\"\"\"Extended DatabaseManager tests covering untested CRUD paths.\"\"\"\nimport uuid\nfrom datetime import datetime, timedelta\nfrom pathlib import Path\n\nimport pytest\n\nfrom src.data.db import DatabaseManager\nfrom src.models.schemas import (\n    AgentResponseRecord,\n    FeedbackRecord,\n    FetchCacheEntry,\n    OrchestratorResponseRecord,\n    QueryRecord,\n)\n\n\n@pytest.fixture\nasync def db(tmp_path):\n    mgr = DatabaseManager(db_path=tmp_path / \"test.db\")\n    await mgr.initialize()\n    return mgr\n\n\n@pytest.fixture\nasync def saved_query(db):\n    record = QueryRecord(\n        query_id=str(uuid.uuid4()),\n        query_text=\"test query\",\n        agents_invoked=[\"staffing\"],\n    )\n    await db.save_query(record)\n    return record\n\n\nclass TestQueryCRUD:\n    @pytest.mark.asyncio\n    async def test_get_query_missing_returns_none(self, db):\n        result = await db.get_query(\"nonexistent-id\")\n        assert result is None\n\n    @pytest.mark.asyncio\n    async def test_list_queries_empty(self, db):\n        result = await db.list_queries()\n        assert result == []\n\n    @pytest.mark.asyncio\n    async def test_list_queries_respects_limit(self, db):\n        for _ in range(5):\n            await db.save_query(QueryRecord(\n                query_id=str(uuid.uuid4()),\n                query_text=\"q\",\n                agents_invoked=[],\n            ))\n        result = await db.list_queries(limit=3)\n        assert len(result) == 3\n\n\nclass TestAgentResponseCRUD:\n    @pytest.mark.asyncio\n    async def test_save_and_get_agent_responses(self, db, saved_query):\n        record = AgentResponseRecord(\n            response_id=str(uuid.uuid4()),\n            query_id=saved_query.query_id,\n            agent_id=\"staffing\",\n            findings=\"some findings\",\n            confidence=\"high\",\n        )\n        await db.save_agent_response(record)\n        results = await db.get_agent_responses(saved_query.query_id)\n        assert len(results) == 1\n        assert results[0].agent_id == \"staffing\"\n\n    @pytest.mark.asyncio\n    async def test_get_agent_responses_unknown_query(self, db):\n        results = await db.get_agent_responses(\"nonexistent\")\n        assert results == []\n\n\nclass TestOrchestratorResponseCRUD:\n    @pytest.mark.asyncio\n    async def test_save_and_get_orchestrator_response(self, db, saved_query):\n        record = OrchestratorResponseRecord(\n            response_id=str(uuid.uuid4()),\n            query_id=saved_query.query_id,\n            summary=\"Test summary\",\n            overall_confidence=\"medium\",\n        )\n        await db.save_orchestrator_response(record)\n        result = await db.get_orchestrator_response(saved_query.query_id)\n        assert result is not None\n        assert result.summary == \"Test summary\"\n\n    @pytest.mark.asyncio\n    async def test_get_orchestrator_response_missing(self, db):\n        result = await db.get_orchestrator_response(\"nonexistent\")\n        assert result is None\n\n\nclass TestFetchCache:\n    @pytest.mark.asyncio\n    async def test_cache_miss_returns_none(self, db):\n        result = await db.get_cached(\"https://example.com/missing\")\n        assert result is None\n\n    @pytest.mark.asyncio\n    async def test_set_and_get_cached(self, db):\n        entry = FetchCacheEntry(\n            url=\"https://example.com/page\",\n            content_text=\"some text\",\n            content_hash=\"abc123\",\n            ttl_hours=168,\n        )\n        await db.set_cached(entry)\n        result = await db.get_cached(\"https://example.com/page\")\n        assert result is not None\n        assert result.content_text == \"some text\"\n\n    @pytest.mark.asyncio\n    async def test_clear_expired_removes_stale(self, db):\n        entry = FetchCacheEntry(\n            url=\"https://example.com/old\",\n            content_text=\"old content\",\n            content_hash=\"def456\",\n            ttl_hours=0,  # Expired immediately\n        )\n        await db.set_cached(entry)\n        removed = await db.clear_expired()\n        assert removed >= 1\n\n\nclass TestFeedback:\n    @pytest.mark.asyncio\n    async def test_save_and_export_feedback(self, db, saved_query):\n        record = FeedbackRecord(\n            feedback_id=str(uuid.uuid4()),\n            query_id=saved_query.query_id,\n            rating=\"helpful\",\n            comment=\"Good answer\",\n        )\n        await db.save_feedback(record)\n        exported = await db.export_feedback()\n        assert any(r[\"query_id\"] == saved_query.query_id for r in exported)\n\n    @pytest.mark.asyncio\n    async def test_get_feedback_missing_returns_none(self, db):\n        result = await db.get_feedback_for_query(\"nonexistent\")\n        assert result is None"
