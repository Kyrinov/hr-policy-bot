        "code": "# tests/test_specialist_agent.py\nimport pytest\nfrom unittest.mock import AsyncMock, MagicMock, patch\nfrom src.agents.specialist import SpecialistAgent\n\n\nMOCK_REGISTRY = {\n    \"staffing\": {\n        \"display_name\": \"Staffing\",\n        \"domain_description\": \"Staffing policy\",\n        \"instruments\": [\n            {\"title\": \"PSEA\", \"url\": \"https://laws-lois.justice.gc.ca/eng/acts/P-33.3/\", \"type\": \"act\"}\n        ],\n    }\n}\n\n\n@pytest.fixture\ndef agent():\n    with patch(\"src.agents.specialist.load_policy_registry\", return_value=MOCK_REGISTRY):\n        return SpecialistAgent(agent_id=\"staffing\", config=MagicMock())\n\n\n@pytest.mark.asyncio\nasync def test_process_returns_structured_response(agent):\n    mock_response = {\n        \"answer\": \"The PSEA governs staffing.\",\n        \"citations\": [{\"title\": \"PSEA\", \"section\": \"s.3\"}],\n        \"confidence\": 0.9,\n        \"caveats\": [],\n    }\n    agent._llm = MagicMock()\n    agent._llm.chat_parsed = AsyncMock(return_value=mock_response)\n    result = await agent.process(\"What governs staffing?\")\n    assert result.answer == \"The PSEA governs staffing.\"\n    assert len(result.citations) == 1\n\n\n@pytest.mark.asyncio\nasync def test_process_with_fetch_injects_policy_context(agent):\n    fetch_engine = MagicMock()\n    fetch_engine.fetch_batch = AsyncMock(\n        return_value={\"https://laws-lois.justice.gc.ca/eng/acts/P-33.3/\": \"<html>PSEA content</html>\"}\n    )\n    agent._llm = MagicMock()\n    agent._llm.chat_parsed = AsyncMock(return_value={\"answer\": \"...\", \"citations\": [], \"confidence\": 0.8, \"caveats\": []})\n    result = await agent.process_with_fetch(\"What governs staffing?\", fetch_engine=fetch_engine)\n    # Confirm fetch was called with instrument URLs\n    fetch_engine.fetch_batch.assert_called_once()\n    called_urls = list(fetch_engine.fetch_batch.call_args[0][0])\n    assert \"https://laws-lois.justice.gc.ca/eng/acts/P-33.3/\" in called_urls\n\n\n@pytest.mark.asyncio\nasync def test_process_handles_llm_json_failure(agent):\n    \"\"\"If LLM returns non-JSON, agent should return a safe fallback, not crash.\"\"\"\n    agent._llm = MagicMock()\n    agent._llm.chat_parsed = AsyncMock(return_value=\"Sorry, I cannot answer.\")\n    result = await agent.process(\"What governs staffing?\")\n    assert result is not None\n    assert hasattr(result, \"answer\")\n\n\n@pytest.mark.asyncio\nasync def test_process_with_all_fetches_failing(agent):\n    fetch_engine = MagicMock()\n    fetch_engine.fetch_batch = AsyncMock(\n        return_value={\"https://laws-lois.justice.gc.ca/eng/acts/P-33.3/\": None}\n    )\n    agent._llm = MagicMock()\n    agent._llm.chat_parsed = AsyncMock(\n        return_value={\"answer\": \"No context available.\", \"citations\": [], \"confidence\": 0.1, \"caveats\": [\"Instruments unavailable.\"]}\n    )\n    result = await agent.process_with_fetch(\"What governs staffing?\", fetch_engine=fetch_engine)\n    assert result is not None\n\n\ndef test_load_instruments_missing_registry():\n    with patch(\"src.agents.specialist.load_policy_registry\", side_effect=FileNotFoundError(\"Not found\")):\n        with pytest.raises(FileNotFoundError):\n            SpecialistAgent(agent_id=\"staffing\", config=MagicMock())"
