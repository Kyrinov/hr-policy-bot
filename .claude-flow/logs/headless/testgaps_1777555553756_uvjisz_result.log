       monkeypatch.setenv(\"SERVER_HOST\", \"192.168.1.1\")\n        monkeypatch.setenv(\"SERVER_PORT\", \"9000\")\n        from src import config as cfg_module\n        cfg_module.get_config.cache_clear()\n        config = cfg_module.get_config()\n        assert config.server.host == \"192.168.1.1\"\n        assert config.server.port == 9000\n\n    def test_get_config_is_singleton(self):\n        from src.config import get_config\n        assert get_config() is get_config()\n```\n\n---\n\n### 2. `src/data/db.py` — `DatabaseManager`\n\n**Untested:**\n- `list_queries(limit=N)` returns at most N results, ordered by timestamp DESC\n- `save_agent_response` / `get_agent_responses` round-trip (JSON serialization of citations)\n- `save_orchestrator_response` / `get_orchestrator_response` round-trip\n- `save_feedback` / `get_feedback_for_query` round-trip\n- `export_feedback()` returns all rows as dicts\n- `get_cached()` returns `None` when TTL expired\n- `get_stale()` returns entry regardless of TTL\n- `clear_expired()` returns correct rowcount\n- `get_query()` returns `None` for unknown query_id\n\n**Skeleton:**\n```python\n# tests/test_db.py\nimport pytest, uuid\nfrom datetime import datetime, timedelta\nfrom src.data.db import DatabaseManager\nfrom src.models.schemas import (\n    QueryRecord, AgentResponseRecord, OrchestratorResponseRecord,\n    FeedbackRecord, FetchCacheEntry, RetrievalStatus,\n)\n\n@pytest.fixture\nasync def db(tmp_path):\n    mgr = DatabaseManager(db_path=tmp_path / \"test.db\")\n    await mgr.initialize()\n    return mgr\n\nclass TestQueryCRUD:\n    @pytest.mark.asyncio\n    async def test_get_missing_query_returns_none(self, db):\n        assert await db.get_query(\"does-not-exist\") is None\n\n    @pytest.mark.asyncio\n    async def test_list_queries_respects_limit(self, db):\n        for _ in range(5):\n            await db.save_query(QueryRecord(query_id=str(uuid.uuid4()), query_text=\"q\", agents_invoked=[]))\n        results = await db.list_queries(limit=3)\n        assert len(results) <= 3\n\nclass TestAgentResponseRoundTrip:\n    @pytest.mark.asyncio\n    async def test_citations_serialized_and_deserialized(self, db):\n        qid = str(uuid.uuid4())\n        await db.save_query(QueryRecord(query_id=qid, query_text=\"q\", agents_invoked=[\"staffing\"]))\n        record = AgentResponseRecord(\n            query_id=qid,\n            agent_id=\"staffing\",\n            findings=\"some findings\",\n            citations=[{\"instrument_title\": \"PSEA\", \"type\": \"Act\", \"url\": \"http://x.com\", \"relevant_section\": \"s.5\"}],\n            confidence=\"high\",\n            retrieval_status={\"instruments_attempted\": 1, \"instruments_successfully_retrieved\": 1, \"instruments_failed\": []},\n        )\n        await db.save_agent_response(record)\n        results = await db.get_agent_responses(qid)\n        assert len(results) == 1\n        assert results[0].citations[0][\"instrument_title\"] == \"PSEA\"\n\nclass TestCacheTTL:\n    @pytest.mark.asyncio\n    async def test_expired_entry_returns_none(self, db):\n        entry = FetchCacheEntry(\n            url=\"https://example.com\",\n            content=\"content\",\n            ttl_hours=0,  # immediately expired\n            status_code=200,\n            content_length=7,\n            fetched_at=(datetime.utcnow() - timedelta(hours=1)).isoformat(),\n        )\n        await db.set_cached(entry)\n        assert await db.get_cached(\"https://example.com\") is None\n\n    @pytest.mark.asyncio\n    async def test_stale_returns_expired_entry(self, db):\n        entry = FetchCacheEntry(\n            url=\"https://example.com\",\n            content=\"stale\",\n            ttl_hours=0,\n            status_code=200,\n            content_length=5,\n            fetched_at=(datetime.utcnow() - timedelta(hours=1)).isoformat(),\n        )\n        await db.set_cached(entry)\n        stale = await db.get_stale(\"https://example.com\")\n        assert stale is not None\n        assert stale.content == \"stale\"\n\n    @pytest.mark.asyncio\n    async def test_clear_expired_returns_count(self, db):\n        for i in range(3):\n            await db.set_cached(FetchCacheEntry(\n                url=f\"https://example.com/{i}\",\n                content=\"x\",\n                ttl_hours=0,\n                status_code=200,\n                content_length=1,\n                fetched_at=(datetime.utcnow() - timedelta(hours=1)).isoformat(),\n            ))\n        count = await db.clear_expired()\n        assert count == 3\n```\n\n---\n\n### 3. `src/fetch/engine.py` — `FetchEngine`\n\n**Untested:**\n- `_normalize_url()`: Canadian laws URL rewritten to `FullText.html`\n- `_normalize_url()`: Non-matching URL passes through unchanged\n- `_do_fetch()`: Cache hit returns cached content without HTTP call\n- `_do_fetch()`: HTTP error falls back to stale cache\n- `_do_fetch()`: Raises `FetchError` when both HTTP and stale cache fail\n- `fetch_batch()`: Returns partial dict when some URLs fail\n- `_get_domain()`: Malformed URL returns `\"default\"`\n\n**Skeleton:**\n```python\n# tests/test_fetch_engine.py\nimport pytest\nfrom unittest.mock import AsyncMock, MagicMock, patch\nfrom src.fetch.engine import FetchEngine, FetchError\n\nclass TestURLNormalization:\n    def test_laws_url_rewritten_to_fulltext(self):\n        engine = FetchEngine.__new__(FetchEngine)\n        result = engine._normalize_url(\n            \"https://laws-lois.justice.gc.ca/eng/acts/P-33.01/index.html\"\n        )\n        assert result.endswith(\"FullText.html\")\n\n    def test_non_laws_url_unchanged(self):\n        engine = FetchEngine.__new__(FetchEngine)\n        url = \"https://www.tbs-sct.gc.ca/pol/doc-eng.aspx?id=12345\"\n        assert engine._normalize_url(url) == url\n\nclass TestDomainExtraction:\n    def test_malformed_url_returns_default(self):\n        engine = FetchEngine.__new__(FetchEngine)\n        assert engine._get_domain(\"not-a-url\") == \"default\"\n\nclass TestFetchWithCache:\n    @pytest.mark.asyncio\n    async def test_cache_hit_skips_http(self):\n        mock_cache = AsyncMock()\n        mock_cache.get.return_value = MagicMock(content=\"cached content\")\n        engine = FetchEngine(cache=mock_cache, extractor=MagicMock())\n        result = await engine._do_fetch(\"https://example.com\")\n        assert result == \"cached content\"\n        mock_cache.get.assert_called_once()\n\n    @pytest.mark.asyncio\n    async def test_http_error_falls_back_to_stale(self):\n        import httpx\n        mock_cache = AsyncMock()\n        mock_cache.get.return_value = None\n        mock_cache.get_stale.return_value = MagicMock(content=\"stale content\")\n        engine = FetchEngine(cache=mock_cache, extractor=MagicMock())\n        engine._client = AsyncMock()\n        engine._client.get.side_effect = httpx.RequestError(\"timeout\")\n        result = await engine._do_fetch(\"https://example.com\")\n        assert result == \"stale content\"\n\n    @pytest.mark.asyncio\n    async def test_no_cache_and_http_error_raises_fetch_error(self):\n        import httpx\n        mock_cache = AsyncMock()\n        mock_cache.get.return_value = None\n        mock_cache.get_stale.return_value = None\n        engine = FetchEngine(cache=mock_cache, extractor=MagicMock())\n        engine._client = AsyncMock()\n        engine._client.get.side_effect = httpx.RequestError(\"timeout\")\n        with pytest.raises(FetchError):\n            await engine._do_fetch(\"https://example.com\")\n\nclass TestFetchBatch:\n    @pytest.mark.asyncio\n    async def test_batch_returns_partial_on_failure(self):\n        engine = FetchEngine.__new__(FetchEngine)\n        engine.fetch = AsyncMock(side_effect=[\n            \"content A\",\n            FetchError(\"failed\"),\n            \"content C\",\n        ])\n        results = await engine.fetch_batch([\n            \"https://a.com\", \"https://b.com\", \"https://c.com\"\n        ])\n        assert \"https://a.com\" in results\n        assert \"https://b.com\" not in results\n        assert \"https://c.com\" in results\n```\n\n---\n\n### 4. `src/fetch/cache.py` — `FetchCache` / `CacheEntry`\n\n**Untested:**\n- `CacheEntry.expires_at` with `fetched_at` as a `datetime` object (not a string)\n- `CacheEntry.is_valid()` returns `False` when expired\n- `CacheEntry.content_hash` is a 64-char hex string\n- `_get_default_ttl()`: legislation URL → 720h; generic URL → config default\n- `health_check()` returns error dict on DB exception\n\n**Skeleton:**\n```python\n# tests/test_cache.py\nfrom datetime import datetime, timedelta\nfrom src.fetch.cache import CacheEntry\n\nclass TestCacheEntry:\n    def test_expires_at_with_datetime_type(self):\n        entry = CacheEntry(\n            url=\"http://x.com\",\n            content=\"c\",\n            ttl_hours=24,\n            status_code=200,\n            content_length=1,\n            fetched_at=datetime.utcnow() - timedelta(hours=1),\n        )\n        assert entry.expires_at > datetime.utcnow()\n\n    def test_is_valid_false_when_expired(self):\n        entry = CacheEntry(\n            url=\"http://x.com\",\n            content=\"c\",\n            ttl_hours=1,\n            status_code=200,\n            content_length=1,\n            fetched_at=(datetime.utcnow() - timedelta(hours=2)).isoformat(),\n        )\n        assert entry.is_valid() is False\n\n    def test_content_hash_is_sha256_hex(self):\n        entry = CacheEntry(url=\"http://x.com\", content=\"hello\", ttl_hours=1, status_code=200, content_length=5)\n        assert len(entry.content_hash) == 64\n\nclass TestDefaultTTL:\n    def test_legislation_url_gets_720h(self):\n        from src.fetch.cache import FetchCache\n        cache = FetchCache.__new__(FetchCache)\n        ttl = cache._get_default_ttl(\"https://laws-lois.justice.gc.ca/eng/acts/P-33.01/FullText.html\")\n        assert ttl == 720\n\n    def test_generic_url_gets_config_default(self):\n        from src.fetch.cache import FetchCache\n        from src.config import get_config\n        cache = FetchCache.__new__(FetchCache)\n        ttl = cache._get_default_ttl(\"https://tbs-sct.gc.ca/policy/doc.html\")\n        assert ttl == get_config().cache.ttl_hours\n```\n\n---\n\n### 5. `src/fetch/extractors.py` — `ContentExtractor`\n\n**Untested:**\n- `_load_selectors()` returns defaults when YAML file missing\n- `extract()` falls back to `body` when no configured selector matches\n- `extract()` returns truncated plain text when BeautifulSoup fails\n- `_clean_text()` collapses whitespace and trims\n- `_truncate()` appends `\"...\"` only when content exceeds max_length\n\n**Skeleton:**\n```python\n# tests/test_extractors.py\nfrom src.fetch.extractors import ContentExtractor\n\nclass TestSelectorFallback:\n    def test_missing_selectors_file_uses_defaults(self, tmp_path):\n        extractor = ContentExtractor(selectors_path=str(tmp_path / \"nope.yaml\"))\n        assert extractor._selectors is not None\n\n    def test_extract_falls_back_to_body_when_no_selector_match(self):\n        extractor = ContentExtractor()\n        html = \"<html><body><p>Body content</p></body></html>\"\n        result = extractor.extract(\"https://unknown-domain.example.com\", html)\n        assert \"Body content\" in result\n\nclass TestTruncation:\n    def test_extract_truncates_long_content(self):\n        extractor = ContentExtractor()\n        big_html = \"<html><body><p>\" + (\"word \" * 20000) + \"</p></body></html>\"\n        result = extractor.extract(\"https://example.com\", big_html, max_length=100)\n        assert len(result) <= 103  # 100 + \"...\"\n\n    def test_short_content_not_truncated(self):\n        extractor = ContentExtractor()\n        html = \"<html><body><p>Short</p></body></html>\"\n        result = extractor.extract(\"https://example.com\", html, max_length=1000)\n        assert \"...\" not in result\n\nclass TestCleanText:\n    def test_whitespace_collapsed(self):\n        extractor = ContentExtractor()\n        html = \"<html><body><p>too   many    spaces</p></body></html>\"\n        result = extractor.extract(\"https://example.com\", html)\n        assert \"too   many\" not in result\n```\n\n---\n\n### 6. `src/llm/client.py` — `GeminiClient`\n\n**Untested (critical — all error paths):**\n- `__init__` raises `RuntimeError` when `GEMINI_API_KEY` not set\n- `chat_parsed()` returns `_parse_error` key when LLM returns non-JSON\n- `stream_chat()` skips empty/None chunks\n- `get_client()` singleton raises without env var\n\n**Skeleton:**\n```python\n# tests/test_llm_client.py\nimport pytest\nfrom unittest.mock import MagicMock, AsyncMock, patch\n\nclass TestGeminiClientInit:\n    def test_raises_without_api_key(self, monkeypatch):\n        monkeypatch.delenv(\"GEMINI_API_KEY\", raising=False)\n        import importlib, src.llm.client as mod\n        mod._client = None\n        with pytest.raises(RuntimeError, match=\"GEMINI_API_KEY\"):\n            mod.get_client()\n\nclass TestChatParsed:\n    @pytest.mark.asyncio\n    async def test_returns_parse_error_on_invalid_json(self, monkeypatch):\n        monkeypatch.setenv(\"GEMINI_API_KEY\", \"fake-key\")\n        with patch(\"src.llm.client.genai\"):\n            client = __import__(\"src.llm.client\", fromlist=[\"GeminiClient\"]).GeminiClient()\n            client._model = MagicMock()\n            client._model.generate_content = MagicMock(return_value=MagicMock(text=\"not JSON\"))\n            result = await client.chat_parsed(\"sys\", \"user\")\n            assert \"_parse_error\" in result\n            assert \"_raw\" in result\n\nclass TestStreamChat:\n    @pytest.mark.asyncio\n    async def test_skips_empty_chunks(self, monkeypatch):\n        monkeypatch.setenv(\"GEMINI_API_KEY\", \"fake-key\")\n        with patch(\"src.llm.client.genai\"):\n            from src.llm.client import GeminiClient\n            client = GeminiClient.__new__(GeminiClient)\n            client._model = MagicMock()\n            client._model.generate_content_async = AsyncMock(\n                return_value=MagicMock(__aiter__=lambda s: iter([\n                    MagicMock(text=\"hello\"),\n                    MagicMock(text=None),\n                    MagicMock(text=\"\"),\n                    MagicMock(text=\" world\"),\n                ]))\n            )\n            chunks = [c async for c in client.stream_chat(\"sys\", \"user\")]\n            assert chunks == [\"hello\", \" world\"]\n```\n\n---\n\n### 7. `src/agents/base.py` — `BaseAgent` / `GenericAgent`\n\n**Untested:**\n- `GenericAgent.process()` raises `NotImplementedError`\n- `build_prompt()` omits policy context block when `policy_context=\"\"`\n- `build_prompt()` includes policy context when non-empty\n\n**Skeleton:**\n```python\n# tests/test_agents_base.py\nimport pytest\nfrom src.agents.base import GenericAgent\n\nclass TestGenericAgent:\n    def _make_agent(self):\n        return GenericAgent(\"test-id\", \"Test Agent\", \"Test domain\", \"System prompt here.\")\n\n    def test_process_raises_not_implemented(self):\n        agent = self._make_agent()\n        with pytest.raises(NotImplementedError):\n            import asyncio\n            asyncio.get_event_loop().run_until_complete(agent.process(\"query\"))\n\n    def test_build_prompt_without_context(self):\n        agent = self._make_agent()\n        prompt = agent.build_prompt(\"What is policy X?\")\n        assert \"policy X\" in prompt\n        assert \"POLICY DOCUMENTS\" not in prompt\n\n    def test_build_prompt_with_context(self):\n        agent = self._make_agent()\n        prompt = agent.build_prompt(\"What is policy X?\", policy_context=\"## Doc A\\nContent here\")\n        assert \"Content here\" in prompt\n```\n\n---\n\n### 8. `src/agents/specialist.py` — `SpecialistAgent`\n\n**Untested:**\n- `_load_instruments()` raises when `policy_registry.json` is missing\n- `process_with_fetch()` returns response without policy context when `fetch_engine=None`