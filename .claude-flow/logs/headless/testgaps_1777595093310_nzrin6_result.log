        "code": "# tests/test_extractors.py\nimport pytest\nfrom src.fetch.extractors import ContentExtractor\n\n\n@pytest.fixture\ndef extractor():\n    return ContentExtractor()\n\n\nclass TestExtractorEdgeCases:\n    def test_empty_html_returns_empty_string(self, extractor):\n        result = extractor.extract(\"https://example.gc.ca\", \"\")\n        assert result == \"\"\n\n    def test_malformed_html_does_not_raise(self, extractor):\n        result = extractor.extract(\"https://example.gc.ca\", \"<html><body><p>Unclosed tag\")\n        assert isinstance(result, str)\n\n    def test_content_truncated_at_48kb(self, extractor):\n        large_content = \"<p>\" + (\"A\" * 50_000) + \"</p>\"\n        html = f\"<html><body>{large_content}</body></html>\"\n        result = extractor.extract(\"https://example.gc.ca\", html)\n        assert len(result) <= 48 * 1024 + 100  # small tolerance for whitespace\n\n    def test_nav_elements_removed(self, extractor):\n        html = \"\"\"\n        <html><body>\n          <nav>Skip to main content</nav>\n          <main><p>Actual policy content</p></main>\n          <footer>Footer text</footer>\n        </body></html>\n        \"\"\"\n        result = extractor.extract(\"https://example.gc.ca\", html)\n        assert \"Skip to main content\" not in result\n        assert \"Footer text\" not in result\n        assert \"Actual policy content\" in result\n\n    def test_heading_hierarchy_preserved(self, extractor):\n        html = \"\"\"\n        <html><body>\n          <h1>Part 1</h1>\n          <h2>Section 1.1</h2>\n          <p>Content here.</p>\n        </body></html>\n        \"\"\"\n        result = extractor.extract(\"https://example.gc.ca\", html)\n        assert \"Part 1\" in result\n        assert \"Section 1.1\" in result\n\n    def test_domain_specific_selector_applied(self, extractor):\n        \"\"\"gc.ca pages may have a #wb-cont main content selector.\"\"\"\n        html = \"\"\"\n        <html><body>\n          <div id=\"wb-cont\"><p>Policy body text</p></div>\n          <div id=\"wb-info\">Footer boilerplate</div>\n        </body></html>\n        \"\"\"\n        result = extractor.extract(\"https://tbs-sct.gc.ca/directive\", html)\n        assert \"Policy body text\" in result"
