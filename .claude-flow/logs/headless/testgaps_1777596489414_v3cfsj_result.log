        "code": "# tests/test_database.py\n\"\"\"Extended database tests covering all untested operations.\"\"\"\nimport json\nimport uuid\nimport pytest\nfrom datetime import datetime\nfrom pathlib import Path\n\nfrom src.data.db import DatabaseManager\nfrom src.models.schemas import (\n    AgentResponseRecord,\n    CitationItem,\n    FeedbackRecord,\n    OrchestratorCitation,\n    OrchestratorResponseRecord,\n    QueryRecord,\n    RetrievalStatus,\n)\n\n\n@pytest.fixture\nasync def db(tmp_path):\n    manager = DatabaseManager(db_path=tmp_path / \"test.db\")\n    await manager.initialize()\n    return manager\n\n\nclass TestListQueries:\n    @pytest.mark.asyncio\n    async def test_empty_db_returns_empty_list(self, db):\n        result = await db.list_queries()\n        assert result == []\n\n    @pytest.mark.asyncio\n    async def test_respects_limit(self, db):\n        for _ in range(5):\n            record = QueryRecord(query_id=str(uuid.uuid4()), query_text=\"q\", agents_invoked=[])\n            await db.save_query(record)\n        result = await db.list_queries(limit=3)\n        assert len(result) == 3\n\n\nclass TestAgentResponseRoundtrip:\n    @pytest.mark.asyncio\n    async def test_save_and_get_agent_responses(self, db):\n        qid = str(uuid.uuid4())\n        await db.save_query(QueryRecord(query_id=qid, query_text=\"q\", agents_invoked=[]))\n        record = AgentResponseRecord(\n            response_id=str(uuid.uuid4()),\n            query_id=qid,\n            agent_id=\"staffing\",\n            findings=\"Some findings\",\n            citations=[CitationItem(instrument_title=\"PSEA\", instrument_type=\"Act\", url=\"https://example.com\")],\n            confidence=\"high\",\n            retrieval_status=RetrievalStatus(instruments_attempted=1, instruments_successfully_retrieved=1),\n        )\n        await db.save_agent_response(record)\n        results = await db.get_agent_responses(qid)\n        assert len(results) == 1\n        assert results[0].agent_id == \"staffing\"\n        assert results[0].findings == \"Some findings\"\n\n\nclass TestOrchestratorResponseRoundtrip:\n    @pytest.mark.asyncio\n    async def test_save_and_get_orchestrator_response(self, db):\n        qid = str(uuid.uuid4())\n        await db.save_query(QueryRecord(query_id=qid, query_text=\"q\", agents_invoked=[]))\n        record = OrchestratorResponseRecord(\n            response_id=str(uuid.uuid4()),\n            query_id=qid,\n            summary=\"Direct answer\",\n            detailed_analysis=\"Full analysis\",\n            overall_confidence=\"medium\",\n            citations=[OrchestratorCitation(\n                instrument_title=\"PSEA\", instrument_type=\"Act\", sourced_from_agent=\"staffing\"\n            )],\n        )\n        await db.save_orchestrator_response(record)\n        retrieved = await db.get_orchestrator_response(qid)\n        assert retrieved is not None\n        assert retrieved.summary == \"Direct answer\"\n\n    @pytest.mark.asyncio\n    async def test_get_orchestrator_response_returns_none_for_unknown(self, db):\n        result = await db.get_orchestrator_response(\"nonexistent-id\")\n        assert result is None\n\n\nclass TestFeedbackRoundtrip:\n    @pytest.mark.asyncio\n    async def test_save_and_get_feedback(self, db):\n        qid = str(uuid.uuid4())\n        await db.save_query(QueryRecord(query_id=qid, query_text=\"q\", agents_invoked=[]))\n        record = FeedbackRecord(\n            feedback_id=str(uuid.uuid4()),\n            query_id=qid,\n            rating=\"accurate\",\n            comment=\"Very helpful\",\n        )\n        await db.save_feedback(record)\n        retrieved = await db.get_feedback_for_query(qid)\n        assert retrieved is not None\n        assert retrieved.rating == \"accurate\"\n\n    @pytest.mark.asyncio\n    async def test_export_feedback_returns_list(self, db):\n        qid = str(uuid.uuid4())\n        await db.save_query(QueryRecord(query_id=qid, query_text=\"q\", agents_invoked=[]))\n        await db.save_feedback(FeedbackRecord(\n            feedback_id=str(uuid.uuid4()), query_id=qid, rating=\"needs_work\"\n        ))\n        result = await db.export_feedback()\n        assert isinstance(result, list)\n        assert len(result) >= 1\n\n    @pytest.mark.asyncio\n    async def test_get_feedback_returns_none_for_unknown(self, db):\n        result = await db.get_feedback_for_query(\"nonexistent\")\n        assert result is None"
