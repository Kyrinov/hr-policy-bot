.asyncio\nclass TestGeminiClientChat:\n    async def test_chat_returns_string(self, client):\n        mock_response = MagicMock()\n        mock_response.text = \"LLM answer text\"\n        with patch.object(client, \"_model\") as mock_model:\n            mock_model.generate_content_async = AsyncMock(return_value=mock_response)\n            result = await client.chat(\"What is the staffing policy?\", \"You are an advisor.\")\n        assert result == \"LLM answer text\"\n\n    async def test_chat_retries_on_resource_exhausted(self, client):\n        from google.api_core.exceptions import ResourceExhausted\n        mock_ok = MagicMock()\n        mock_ok.text = \"Retry succeeded\"\n        with patch.object(client, \"_model\") as mock_model:\n            mock_model.generate_content_async = AsyncMock(\n                side_effect=[ResourceExhausted(\"rate limit\"), mock_ok]\n            )\n            result = await client.chat(\"query\", \"system\")\n        assert result == \"Retry succeeded\"\n\n    async def test_chat_returns_empty_on_safety_block(self, client):\n        mock_response = MagicMock()\n        mock_response.text = None\n        mock_response.candidates = []\n        with patch.object(client, \"_model\") as mock_model:\n            mock_model.generate_content_async = AsyncMock(return_value=mock_response)\n            result = await client.chat(\"query\", \"system\")\n        assert result == \"\"\n\n    async def test_chat_parsed_returns_dict_on_valid_json(self, client):\n        valid_json = '{\"findings\": \"Policy allows X\", \"confidence\": \"high\"}'\n        with patch.object(client, \"chat\", new_callable=AsyncMock, return_value=valid_json):\n            result = await client.chat_parsed(\"query\", \"system\")\n        assert isinstance(result, dict)\n        assert result[\"confidence\"] == \"high\"\n\n    async def test_chat_parsed_returns_none_on_invalid_json(self, client):\n        with patch.object(client, \"chat\", new_callable=AsyncMock, return_value=\"Not valid JSON\"):\n            result = await client.chat_parsed(\"query\", \"system\")\n        assert result is None\n\n    async def test_stream_chat_yields_tokens(self, client):\n        async def mock_stream(*args, **kwargs):\n            for token in [\"token1\", \" token2\", \" token3\"]:\n                chunk = MagicMock()\n                chunk.text = token\n                yield chunk\n\n        with patch.object(client, \"_model\") as mock_model:\n            mock_model.generate_content_async = AsyncMock(return_value=mock_stream())\n            tokens = []\n            async for token in client.stream_chat(\"q\", \"sys\"):\n                tokens.append(token)\n        assert \"\".join(tokens) == \"token1 token2 token3\"\n\n    async def test_missing_api_key_raises_on_init(self):\n        with patch.dict(\"os.environ\", {}, clear=True):\n            with pytest.raises(ValueError, match=\"GEMINI_API_KEY\"):\n                from src.llm import client as llm_mod\n                import importlib\n                importlib.reload(llm_mod)\n                llm_mod.GeminiClient()\n```\n\n---\n\n## Gap 8 — Base Agent: build_prompt(), Property Accessors\n\n```python\n# tests/test_base_agent.py\nimport pytest\nfrom src.agents.base import GenericAgent\n\n\n@pytest.fixture\ndef agent():\n    return GenericAgent(\n        agent_id=\"staffing\",\n        display_name=\"Staffing Advisor\",\n        domain_description=\"Public service staffing law\",\n        system_prompt=\"You are a staffing specialist.\",\n    )\n\n\nclass TestGenericAgent:\n    def test_properties(self, agent):\n        assert agent.agent_id == \"staffing\"\n        assert agent.display_name == \"Staffing Advisor\"\n        assert \"staffing\" in agent.domain_description.lower()\n\n    def test_build_prompt_without_context(self, agent):\n        prompt = agent.build_prompt(\"How do I promote an employee?\")\n        assert \"How do I promote\" in prompt\n        assert \"policy context\" not in prompt.lower()\n\n    def test_build_prompt_with_policy_context(self, agent):\n        prompt = agent.build_prompt(\n            \"How do I promote an employee?\",\n            policy_context=\"PSEA Section 30 governs appointment processes.\",\n        )\n        assert \"PSEA Section 30\" in prompt\n        assert \"How do I promote\" in prompt\n\n    def test_process_raises_not_implemented(self, agent):\n        with pytest.raises(NotImplementedError):\n            import asyncio\n            asyncio.run(agent.process(\"query\"))\n```\n\n---\n\n## Gap 9 — Specialist Agent: fetch path, instrument loading, retrieval tracking\n\n```python\n# tests/test_specialist.py\nimport pytest\nfrom unittest.mock import AsyncMock, patch, MagicMock\nfrom src.agents.specialist import SpecialistAgent\n\n\n@pytest.fixture\ndef specialist():\n    return SpecialistAgent(\n        agent_id=\"staffing\",\n        display_name=\"Staffing\",\n        domain_description=\"Staffing policy\",\n        system_prompt=\"You are a staffing advisor.\",\n    )\n\n\n@pytest.mark.asyncio\nclass TestSpecialistAgent:\n    async def test_process_without_fetch_returns_response(self, specialist):\n        with patch(\"src.agents.specialist.get_client\") as mock_client_fn:\n            mock_client = MagicMock()\n            mock_client.chat_parsed = AsyncMock(return_value={\n                \"findings\": \"PSEA governs merit-based appointments.\",\n                \"citations\": [],\n                \"confidence\": \"high\",\n            })\n            mock_client_fn.return_value = mock_client\n            response = await specialist.process(\"What are merit principles?\")\n        assert response.agent_id == \"staffing\"\n        assert response.confidence == \"high\"\n\n    async def test_process_with_fetch_tracks_retrieval_status(self, specialist):\n        with patch(\"src.agents.specialist.get_fetch_engine\") as mock_engine_fn, \\\n             patch(\"src.agents.specialist.get_client\") as mock_client_fn:\n            mock_engine = MagicMock()\n            mock_engine.fetch = AsyncMock(return_value=\"Policy content\")\n            mock_engine_fn.return_value = mock_engine\n\n            mock_client = MagicMock()\n            mock_client.chat_parsed = AsyncMock(return_value={\n                \"findings\": \"PSEA Section 30 applies.\",\n                \"citations\": [],\n                \"confidence\": \"medium\",\n            })\n            mock_client_fn.return_value = mock_client\n\n            response = await specialist.process_with_fetch(\"What is merit?\")\n\n        assert response.retrieval_status.instruments_attempted > 0\n        assert response.retrieval_status.instruments_successfully_retrieved >= 0\n\n    async def test_process_with_fetch_limits_to_4_documents(self, specialist):\n        fetched_urls = []\n\n        async def track_fetch(url):\n            fetched_urls.append(url)\n            return \"content\"\n\n        with patch(\"src.agents.specialist.get_fetch_engine\") as mock_engine_fn, \\\n             patch(\"src.agents.specialist.get_client\") as mock_client_fn, \\\n             patch.object(specialist, \"_load_instruments\") as mock_instruments:\n            # Provide 8 instruments — only 4 should be fetched\n            mock_instruments.return_value = [\n                MagicMock(url=f\"https://gc.ca/policy{i}\") for i in range(8)\n            ]\n            mock_engine = MagicMock()\n            mock_engine.fetch = AsyncMock(side_effect=track_fetch)\n            mock_engine_fn.return_value = mock_engine\n\n            mock_client = MagicMock()\n            mock_client.chat_parsed = AsyncMock(return_value={\n                \"findings\": \"Summary.\", \"citations\": [], \"confidence\": \"low\",\n            })\n            mock_client_fn.return_value = mock_client\n\n            await specialist.process_with_fetch(\"query\")\n\n        assert len(fetched_urls) <= 4\n\n    async def test_failed_fetch_recorded_in_retrieval_status(self, specialist):\n        with patch(\"src.agents.specialist.get_fetch_engine\") as mock_engine_fn, \\\n             patch(\"src.agents.specialist.get_client\") as mock_client_fn:\n            mock_engine = MagicMock()\n            mock_engine.fetch = AsyncMock(return_value=None)  # all fail\n            mock_engine_fn.return_value = mock_engine\n\n            mock_client = MagicMock()\n            mock_client.chat_parsed = AsyncMock(return_value={\n                \"findings\": \"Cannot retrieve.\", \"citations\": [], \"confidence\": \"low\",\n            })\n            mock_client_fn.return_value = mock_client\n\n            response = await specialist.process_with_fetch(\"query\")\n\n        assert response.retrieval_status.instruments_successfully_retrieved == 0\n        assert len(response.retrieval_status.instruments_failed) > 0\n```\n\n---\n\n## Gap 10 — Orchestrator: Routing, Citation Deduplication, JSON Fallback\n\n```python\n# tests/test_orchestrator.py\nimport pytest\nfrom unittest.mock import AsyncMock, patch, MagicMock\nfrom src.agents.orchestrator import OrchestratorAgent\nfrom src.models.schemas import SpecialistResponse, RetrievalStatus\n\n\ndef make_specialist_response(agent_id, findings, citations=None):\n    return SpecialistResponse(\n        agent_id=agent_id,\n        findings=findings,\n        citations=citations or [],\n        confidence=\"high\",\n        retrieval_status=RetrievalStatus(\n            instruments_attempted=1,\n            instruments_successfully_retrieved=1,\n            instruments_failed=[],\n        ),\n    )\n\n\n@pytest.fixture\ndef orchestrator():\n    return OrchestratorAgent()\n\n\n@pytest.mark.asyncio\nclass TestOrchestratorRouting:\n    async def test_route_returns_list_of_agent_ids(self, orchestrator):\n        with patch(\"src.agents.orchestrator.get_client\") as mock_fn:\n            mock_client = MagicMock()\n            mock_client.chat_parsed = AsyncMock(return_value={\n                \"agents_selected\": [\"staffing\", \"classification\"],\n                \"rationale\": \"Query relates to staffing and classification domains.\",\n            })\n            mock_fn.return_value = mock_client\n            decision = await orchestrator._route(\"How do I reclassify a position?\")\n        assert \"classification\" in decision.agents_selected\n        assert \"staffing\" in decision.agents_selected\n\n    async def test_route_fallback_on_json_parse_failure(self, orchestrator):\n        with patch(\"src.agents.orchestrator.get_client\") as mock_fn:\n            mock_client = MagicMock()\n            mock_client.chat_parsed = AsyncMock(return_value=None)  # parse failed\n            mock_fn.return_value = mock_client\n            # Should not raise — return default routing\n            decision = await orchestrator._route(\"ambiguous query\")\n        assert isinstance(decision.agents_selected, list)\n\n\n@pytest.mark.asyncio\nclass TestOrchestratorSynthesis:\n    async def test_process_synthesizes_multiple_specialists(self, orchestrator):\n        responses = [\n            make_specialist_response(\"staffing\", \"PSEA merit-based appointments.\"),\n            make_specialist_response(\"classification\", \"OC classification standards apply.\"),\n        ]\n        with patch(\"src.agents.orchestrator.get_client\") as mock_fn:\n            mock_client = MagicMock()\n            mock_client.chat = AsyncMock(return_value='{\"synthesis\": \"Both policies apply.\", \"citations\": [], \"confidence_summary\": \"high\"}')\n            mock_fn.return_value = mock_client\n            result = await orchestrator.process(\"How do staffing and classification interact?\", responses)\n        assert result.synthesis is not None\n\n    async def test_aggregate_citations_deduplicates_by_url(self, orchestrator):\n        from src.models.schemas import CitationItem\n        shared_url = \"https://laws.gc.ca/psea\"\n        resp1 = make_specialist_response(\"staffing\", \"text\", citations=[\n            CitationItem(title=\"PSEA\", url=shared_url, excerpt=\"s.30\")\n        ])\n        resp2 = make_specialist_response(\"classification\", \"text\", citations=[\n            CitationItem(title=\"PSEA\", url=shared_url, excerpt=\"s.30\")\n        ])\n        citations = orchestrator._aggregate_citations([resp1, resp2])\n        urls = [c.url for c in citations]\n        assert urls.count(shared_url) == 1\n\n    async def test_process_with_streaming_calls_status_callback(self, orchestrator):\n        status_events = []\n\n        async def on_status(event):\n            status_events.append(event)\n\n        with patch.object(orchestrator, \"_route\", new_callable=AsyncMock) as mock_route, \\\n             patch(\"src.agents.orchestrator.get_specialists\") as mock_specialists_fn, \\\n             patch.object(orchestrator, \"process\", new_callable=AsyncMock) as mock_process:\n            from src.models.schemas import RoutingDecision, OrchestratorResponse\n            mock_route.return_value = RoutingDecision(agents_selected=[\"staffing\"], rationale=\"domain match\")\n            mock_specialist = MagicMock()\n            mock_specialist.process_with_fetch = AsyncMock(return_value=make_specialist_response(\"staffing\", \"f\"))\n            mock_specialists_fn.return_value = {\"staffing\": mock_specialist}\n            mock_process.return_value = OrchestratorResponse(\n                query_id=\"q\", query_text=\"q\", synthesis=\"s\",\n                citations=[], routing_decision=RoutingDecision(agents_selected=[\"staffing\"], rationale=\"r\"),\n                confidence_summary=\"high\",\n            )\n            result = await orchestrator.process_with_streaming(\"How is merit defined?\", on_status)\n\n        assert any(\"staffing\" in str(e) for e in status_events)\n```\n\n---\n\n## Gap 11 — REST API Endpoints\n\n```python\n# tests/test_api_routes.py\nimport pytest\nfrom fastapi.testclient import TestClient\nfrom unittest.mock import AsyncMock, patch, MagicMock\nfrom src.main import app\n\nclient = TestClient(app)\n\n\nclass TestHealthEndpoint:\n    def test_health_returns_200(self):\n        with patch(\"src.api.routes.get_db\") as mock_db_fn:\n            mock_db = MagicMock()\n            mock_db.get_stats = AsyncMock(return_value={\"total_queries\": 5})\n            mock_db_fn.return_value = mock_db\n            response = client.get(\"/health\")\n        assert response.status_code == 200\n        assert \"status\" in response.json()\n\n    def test_health_includes_db_status(self):\n        with patch(\"src.api.routes.get_db\"):\n            response = client.get(\"/health\")\n        data = response.json()\n        assert \"database\" in data or \"status\" in data\n\n\nclass TestAgentsEndpoint:\n    def test_agents_returns_list(self):\n        response = client.get(\"/agents\")\n        assert response.status_code == 200\n        agents = response.json()\n        assert isinstance(agents, list)\n        assert len(agents) == 8\n\n    def test_agents_include_required_fields(self):\n        response = client.get(\"/agents\")\n        for agent in response.json():\n            assert \"agent_id\" in agent\n            assert \"display_name\" in agent\n\n\nclass TestQueriesEndpoint:\n    def test_list_queries_returns_200(self):\n        with patch(\"src.api.routes.get_db\") as mock_db_fn:\n            mock_db = MagicMock()\n            mock_db.list_queries = AsyncMock(return_value=[])\n            mock_db_fn.return_value = mock_db\n            response = client.get(\"/queries\")\n        assert response.status_code == 200\n\n    def test_list_queries_default_limit_50(self):\n        with patch(\"src.api.routes.get_db\") as mock_db_fn:\n            mock_db = MagicMock()\n            mock_db.list_queries = AsyncMock(return_value=[])\n            mock_db_fn.return_value = mock_db\n            client.get(\"/queries\")\n            call_kwargs = mock_db.list_queries.call_args\n        limit = call_kwargs[1].get(\"limit\") or call_kwargs[0][0]\n        assert limit == 50\n\n    def test_list_queries_rejects_limit_over_100(self):\n        response = client.get(\"/queries?limit=200\")\n        assert response.status_code == 422\n\n    def test_get_query_not_found_returns_404(self):\n        with patch(\"src.api.routes.get_db\") as mock_db_fn:\n            mock_db = MagicMock()\n            mock_db.get_query = AsyncMock(return_value=None)\n            mock_db_fn.return_value = mock_db\n            response = client.get(\"/queries/nonexistent-id\")\n        assert response.status_code == 404\n\n\nclass TestFeedbackEndpoint:\n    def test_post_feedback_returns_201(self):\n        with patch(\"src.api.routes.get_db\") as mock_db_fn:\n            mock_db = MagicMock()\n            mock_db.save_feedback = AsyncMock()\n            mock_db_fn.return_value = mock_db\n            response = client.post(\"/feedback\", json={\"query_id\": \"q-1\", \"rating\": \"accurate\"})\n        assert response.status_code in (200, 201)\n\n    def test_post_feedback_invalid_rating_returns_422(self):\n        response = client.post(\"/feedback\", json={\"query_id\": \"q-1\", \"rating\": \"invalid\"})\n        assert response.status_code == 422\n\n    def test_feedback_export_returns_list(self):\n        with patch(\"src.api.routes.get_db\") as mock_db_fn:\n            mock_db = MagicMock()\n            mock_db.export_feedback = AsyncMock(return_value=[])\n            mock_db_fn.return_value = mock_db\n            response = client.get(\"/feedback/export\")\n        assert response.status_code == 200\n        assert isinstance(response.json(), list)\n```\n\n---\n\n## Gap 12 — WebSocket: Lifecycle, Disconnect, Error Handling\n\n```python\n# tests/test_websocket.py\nimport pytest\nimport json\nfrom unittest.mock import AsyncMock, MagicMock, patch\nfrom fastapi.testclient import TestClient\nfrom src.main import app\n\n\nclass TestWebSocketLifecycle:\n    def test_websocket_connects_and_receives_welcome(self):\n        with TestClient(app).websocket_connect(\"/ws\") as ws:\n            welcome = ws.receive_json()\n            assert welcome[\"type\"] == \"session_start\"\n            assert \"session_id\" in welcome\n\n    def test_websocket_query_start_triggers_processing(self):\n        with patch(\"src.api.websocket.process_query\", new_callable=AsyncMock) as mock_process:\n            mock_process.return_value = None\n            with TestClient(app).websocket_connect(\"/ws\") as ws:\n                ws.receive_json()  # welcome\n                ws.send_json({\"type\": \"query_start\", \"query_text\": \"What is bilingualism policy?\"})\n                # Allow brief processing — just verify no crash\n        assert mock_process.called\n\n    def test_websocket_sends_error_on_missing_query_text(self):\n        with TestClient(app).websocket_connect(\"/ws\") as ws:\n            ws.receive_json()  # welcome\n            ws.send_json({\"type\": \"query_start\"})  # missing query_text\n            response = ws.receive_json()\n        assert response[\"type\"] == \"error\"\n\n    def test_websocket_sends_error_on_invalid_json(self):\n        with TestClient(app).websocket_connect(\"/ws\") as ws:\n            ws.receive_json()  # welcome\n            ws.send_text(\"not-valid-json\")\n            response = ws.receive_json()\n        assert response[\"type\"] == \"error\"\n\n    def test_websocket_handles_unknown_message_type_gracefully(self):\n        with TestClient(app).websocket_connect(\"/ws\") as ws:\n            ws.receive_json()  # welcome\n            ws.send_json({\"type\": \"unknown_type\"})\n            # Should not crash; may return error or ignore\n            # Verify connection remains open for next message\n            ws.send_json({\"type\": \"ping\"})\n\n\nclass TestProcessQueryFunction:\n    @pytest.mark.asyncio\n    async def test_process_query_saves_to_db(self):\n        from src.api.websocket import process_query\n        mock_ws = MagicMock()\n        mock_ws.send_json = AsyncMock()\n        mock_ws.send_text = AsyncMock()\n\n        with patch(\"src.api.websocket.get_db\") as mock_db_fn, \\\n             patch(\"src.api.websocket.get_orchestrator\") as mock_orch_fn:\n            mock_db = MagicMock()\n            mock_db.save_query = AsyncMock()\n            mock_db.save_agent_response = AsyncMock()\n            mock_db.save_orchestrator_response = AsyncMock()\n            mock_db_fn.return_value = mock_db\n\n            mock_orch = MagicMock()\n            mock_orch.process_with_streaming = AsyncMock(return_value=MagicMock(\n                query_id=\"q\", synthesis=\"s\", citations=[], confidence_summary=\"high\",\n                routing_decision=MagicMock(agents_selected=[\"staffing\"]),\n            ))\n            mock_orch_fn.return_value = mock_orch\n\n            await process_query(mock_ws, \"What is PRI?\", \"sess-1\")\n\n        assert mock_db.save_query.called\n        assert mock_db.save_orchestrator_response.called\n\n    @pytest.mark.asyncio\n    async def test_process_query_sends_ws_error_on_exception(self):\n        from src.api.websocket import process_query\n        mock_ws = MagicMock()\n        mock_ws.send_json = AsyncMock()\n\n        with patch(\"src.api.websocket.get_db\") as mock_db_fn, \\\n             patch(\"src.api.websocket.get_orchestrator\") as mock_orch_fn:\n            mock_db = MagicMock()\n            mock_db.save_query = AsyncMock()\n            mock_db_fn.return_value = mock_db\n\n            mock_orch = MagicMock()\n            mock_orch.process_with_streaming = AsyncMock(side_effect=RuntimeError(\"LLM timeout\"))\n            mock_orch_fn.return_value = mock_orch\n\n            await process_query(mock_ws, \"query\", \"sess-1\")\n\n        sent_messages = [call.args[0] for call in mock_ws.send_json.call_args_list]\n        assert any(m.get(\"type\") == \"error\" for m in sent_messages)\n```\n\n---\n\n## Gap Summary Table\n\n| Gap | Module | Severity | Type |\n|---|---|---|---|\n| All WebSocket message types | `schemas.py` | Medium | Unit |\n| confidence/rating enum validation | `schemas.py` | High | Unit |\n| Env var config overrides | `config.py` | Medium | Unit |\n| `list_queries`, `save_agent_response`, feedback CRUD, cache CRUD | `db.py` | High | Unit |\n| `fetch()` cache-fallback, rate-limit, URL normalization | `fetch/engine.py` | High | Unit |\n| `fetch_batch()` partial failure | `fetch/engine.py` | High | Unit |\n| TTL boundary, stale fallback, domain-based TTL | `fetch/cache.py` | High | Unit |\n| Empty/malformed HTML, 48KB truncation, nav removal | `fetch/extractors.py` | Medium | Unit |\n| Retry on `ResourceExhausted`, safety filter, JSON parse failure | `llm/client.py` | Critical | Unit |\n| `build_prompt()` with/without context | `agents/base.py` | Low | Unit |\n| `process_with_fetch()` 4-doc limit, retrieval tracking | `agents/specialist.py` | High | Unit |\n| `_route()` fallback, citation dedup, streaming callback | `agents/orchestrator.py` | High | Unit |\n| All REST endpoints, 404/422 responses | `api/routes.py` | High | Integration |\n| WebSocket connect/disconnect, error on bad JSON | `api/websocket.py` | Critical | Integration |\n| Full query→response→DB pipeline | end-to-end | Critical | E2E |\n\nThe most critical gaps are the **LLM client retry/safety handling** and the **WebSocket error paths** — both are production failure modes with no current test coverage at all.\n",
