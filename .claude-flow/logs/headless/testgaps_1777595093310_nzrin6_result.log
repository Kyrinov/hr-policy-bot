        "code": "# tests/test_llm_client.py\nimport pytest\nfrom unittest.mock import AsyncMock, MagicMock, patch\n\n\n@pytest.fixture\ndef client():\n    with patch.dict(\"os.environ\", {\"GEMINI_API_KEY\": \"fake-key\"}):\n        from src.llm.client import GeminiClient\n        return GeminiClient()\n\n\n@pytest.mark.asyncio\nclass TestGeminiClientChat:\n    async def test_chat_returns_string(self, client):\n        mock_response = MagicMock()\n        mock_response.text = \"LLM answer text\"\n        with patch.object(client, \"_model\") as mock_model:\n            mock_model.generate_content_async = AsyncMock(return_value=mock_response)\n            result = await client.chat(\"What is the staffing policy?\", \"You are an advisor.\")\n        assert result == \"LLM answer text\"\n\n    async def test_chat_retries_on_resource_exhausted(self, client):\n        from google.api_core.exceptions import ResourceExhausted\n        mock_ok = MagicMock()\n        mock_ok.text = \"Retry succeeded\"\n        with patch.object(client, \"_model\") as mock_model:\n            mock_model.generate_content_async = AsyncMock(\n                side_effect=[ResourceExhausted(\"rate limit\"), mock_ok]\n            )\n            result = await client.chat(\"query\", \"system\")\n        assert result == \"Retry succeeded\"\n\n    async def test_chat_returns_empty_on_safety_block(self, client):\n        mock_response = MagicMock()\n        mock_response.text = None\n        mock_response.candidates = []\n        with patch.object(client, \"_model\") as mock_model:\n            mock_model.generate_content_async = AsyncMock(return_value=mock_response)\n            result = await client.chat(\"query\", \"system\")\n        assert result == \"\"\n\n    async def test_chat_parsed_returns_dict_on_valid_json(self, client):\n        valid_json = '{\"findings\": \"Policy allows X\", \"confidence\": \"high\"}'\n        with patch.object(client, \"chat\", new_callable=AsyncMock, return_value=valid_json):\n            result = await client.chat_parsed(\"query\", \"system\")\n        assert isinstance(result, dict)\n        assert result[\"confidence\"] == \"high\"\n\n    async def test_chat_parsed_returns_none_on_invalid_json(self, client):\n        with patch.object(client, \"chat\", new_callable=AsyncMock, return_value=\"Not valid JSON\"):\n            result = await client.chat_parsed(\"query\", \"system\")\n        assert result is None\n\n    async def test_stream_chat_yields_tokens(self, client):\n        async def mock_stream(*args, **kwargs):\n            for token in [\"token1\", \" token2\", \" token3\"]:\n                chunk = MagicMock()\n                chunk.text = token\n                yield chunk\n\n        with patch.object(client, \"_model\") as mock_model:\n            mock_model.generate_content_async = AsyncMock(return_value=mock_stream())\n            tokens = []\n            async for token in client.stream_chat(\"q\", \"sys\"):\n                tokens.append(token)\n        assert \"\".join(tokens) == \"token1 token2 token3\"\n\n    async def test_missing_api_key_raises_on_init(self):\n        with patch.dict(\"os.environ\", {}, clear=True):\n            with pytest.raises(ValueError, match=\"GEMINI_API_KEY\"):\n                from src.llm import client as llm_mod\n                import importlib\n                importlib.reload(llm_mod)\n                llm_mod.GeminiClient()"
