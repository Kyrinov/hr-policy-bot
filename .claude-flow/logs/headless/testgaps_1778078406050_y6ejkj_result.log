        "title": "tests/test_api/test_routes.py",
        "content": "import uuid\nimport pytest\nfrom fastapi.testclient import TestClient\nfrom unittest.mock import patch, AsyncMock\n\n\n@pytest.fixture\ndef client(tmp_path):\n    # Override DB path so tests use isolated DB\n    with patch(\"src.data.db._DB_PATH\", tmp_path / \"test.db\"):\n        from src.main import app\n        with TestClient(app) as c:\n            yield c\n\n\nclass TestAgentsEndpoint:\n    def test_returns_8_agents(self, client):\n        response = client.get(\"/api/agents\")\n        assert response.status_code == 200\n        agents = response.json()\n        assert len(agents) == 8\n        agent_ids = [a[\"agent_id\"] for a in agents]\n        assert \"staffing\" in agent_ids\n        assert \"governance\" in agent_ids\n\n\nclass TestQueriesEndpoint:\n    def test_list_queries_returns_empty_initially(self, client):\n        response = client.get(\"/api/queries\")\n        assert response.status_code == 200\n        assert response.json() == []\n\n    def test_get_unknown_query_returns_404(self, client):\n        response = client.get(f\"/api/queries/{uuid.uuid4()}\")\n        assert response.status_code == 404\n\n    def test_limit_param_validated(self, client):\n        response = client.get(\"/api/queries?limit=0\")\n        assert response.status_code == 422  # FastAPI validation error\n\n\nclass TestFeedbackEndpoint:\n    def test_submit_feedback_returns_ok(self, client):\n        # Must have a query saved first (foreign key)\n        # For simplicity, mock or disable FK enforcement in SQLite\n        import json\n        payload = {\n            \"feedback_id\": str(uuid.uuid4()),\n            \"query_id\": str(uuid.uuid4()),\n            \"rating\": \"accurate\",\n            \"comment\": \"Great answer\",\n            \"timestamp\": \"2026-05-06T12:00:00\",\n        }\n        # SQLite FK enforcement is off by default — this should succeed\n        response = client.post(\"/api/feedback\", content=json.dumps(payload),\n                               headers={\"Content-Type\": \"application/json\"})\n        assert response.status_code == 200\n        assert response.json()[\"status\"] == \"ok\"\n```\n\n---\n\n",
