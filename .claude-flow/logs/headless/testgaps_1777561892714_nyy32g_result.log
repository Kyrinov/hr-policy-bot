ery_text=\"q\"))\n\n        record = AgentResponseRecord(\n            response_id=str(uuid.uuid4()),\n            query_id=query_id,\n            agent_id=\"staffing\",\n            findings=\"Some findings\",\n            citations=[CitationItem(instrument_title=\"PSEA\", instrument_type=\"Act\")],\n            confidence=\"high\",\n            retrieval_status=RetrievalStatus(instruments_attempted=1, instruments_successfully_retrieved=1),\n        )\n        await db.save_agent_response(record)\n        results = await db.get_agent_responses(query_id)\n        assert len(results) == 1\n        assert results[0].agent_id == \"staffing\"\n\n    @pytest.mark.asyncio\n    async def test_get_agent_responses_returns_empty_for_unknown_query(self, db):\n        result = await db.get_agent_responses(\"nonexistent-id\")\n        assert result == []\n\n\nclass TestOrchestratorResponseRoundTrip:\n    @pytest.mark.asyncio\n    async def test_save_and_retrieve_orchestrator_response(self, db):\n        query_id = str(uuid.uuid4())\n        await db.save_query(QueryRecord(query_id=query_id, query_text=\"q\"))\n\n        record = OrchestratorResponseRecord(\n            response_id=str(uuid.uuid4()),\n            query_id=query_id,\n            summary=\"Direct answer\",\n            overall_confidence=\"high\",\n        )\n        await db.save_orchestrator_response(record)\n        result = await db.get_orchestrator_response(query_id)\n        assert result is not None\n        assert result.summary == \"Direct answer\"\n\n    @pytest.mark.asyncio\n    async def test_get_orchestrator_response_returns_none_for_missing(self, db):\n        assert await db.get_orchestrator_response(\"nonexistent\") is None\n\n\nclass TestFeedback:\n    @pytest.mark.asyncio\n    async def test_save_and_retrieve_feedback(self, db):\n        query_id = str(uuid.uuid4())\n        await db.save_query(QueryRecord(query_id=query_id, query_text=\"q\"))\n\n        record = FeedbackRecord(\n            feedback_id=str(uuid.uuid4()),\n            query_id=query_id,\n            rating=\"accurate\",\n            comment=\"Very helpful\",\n        )\n        await db.save_feedback(record)\n        result = await db.get_feedback_for_query(query_id)\n        assert result is not None\n        assert result.rating == \"accurate\"\n\n    @pytest.mark.asyncio\n    async def test_export_feedback_returns_all_records(self, db):\n        query_id = str(uuid.uuid4())\n        await db.save_query(QueryRecord(query_id=query_id, query_text=\"q\"))\n        await db.save_feedback(FeedbackRecord(feedback_id=str(uuid.uuid4()), query_id=query_id, rating=\"needs_work\"))\n        exported = await db.export_feedback()\n        assert len(exported) >= 1\n        assert isinstance(exported[0], dict)\n\n\nclass TestCacheOperations:\n    @pytest.mark.asyncio\n    async def test_get_cached_returns_none_before_set(self, db):\n        result = await db.get_cached(\"https://example.com\")\n        assert result is None\n\n    @pytest.mark.asyncio\n    async def test_clear_expired_returns_row_count(self, db):\n        count = await db.clear_expired()\n        assert isinstance(count, int)\n        assert count >= 0\n```\n\n---\n\n### 6. `src/api/websocket.py` — WebSocketManager untested\n\n| Untested | Risk |\n|---|---|\n| `connect()` / `disconnect()` lifecycle | Connection map never verified |\n| `send()` to disconnected client | Exception swallowed, connection removed silently |\n| `broadcast_error()` | Error broadcast never verified |\n| `process_query()` full flow | DB save + orchestrator + response message never e2e tested |\n\n**Skeletons:**\n\n```python\n# tests/test_websocket.py\nimport pytest\nfrom unittest.mock import AsyncMock, MagicMock\nfrom src.api.websocket import WebSocketManager\n\n\nclass TestWebSocketManager:\n    def setup_method(self):\n        self.manager = WebSocketManager()\n\n    @pytest.mark.asyncio\n    async def test_connect_and_send(self):\n        mock_ws = AsyncMock()\n        await self.manager.connect(\"q1\", mock_ws)\n        mock_ws.accept.assert_called_once()\n\n        result = await self.manager.send(\"q1\", {\"type\": \"test\"})\n        assert result is True\n        mock_ws.send_json.assert_called_once_with({\"type\": \"test\"})\n\n    @pytest.mark.asyncio\n    async def test_send_to_unknown_query_returns_false(self):\n        result = await self.manager.send(\"nonexistent\", {\"type\": \"test\"})\n        assert result is False\n\n    @pytest.mark.asyncio\n    async def test_send_failure_disconnects_client(self):\n        mock_ws = AsyncMock()\n        mock_ws.send_json.side_effect = Exception(\"connection lost\")\n        await self.manager.connect(\"q1\", mock_ws)\n\n        result = await self.manager.send(\"q1\", {\"type\": \"test\"})\n        assert result is False\n        assert \"q1\" not in self.manager._connections\n\n    @pytest.mark.asyncio\n    async def test_disconnect_removes_connection(self):\n        mock_ws = AsyncMock()\n        await self.manager.connect(\"q1\", mock_ws)\n        await self.manager.disconnect(\"q1\")\n        assert \"q1\" not in self.manager._connections\n\n    @pytest.mark.asyncio\n    async def test_broadcast_error_reaches_all_clients(self):\n        ws1, ws2 = AsyncMock(), AsyncMock()\n        await self.manager.connect(\"q1\", ws1)\n        await self.manager.connect(\"q2\", ws2)\n        await self.manager.broadcast_error(\"system error\")\n        ws1.send_json.assert_called_once()\n        ws2.send_json.assert_called_once()\n```\n\n---\n\n### 7. `src/agents/base.py` — `build_prompt()` untested\n\n```python\n# tests/test_base_agent.py\nimport pytest\nfrom src.agents.base import GenericAgent\n\n\nclass ConcreteAgent(GenericAgent):\n    async def process(self, query_text):\n        raise NotImplementedError\n\n\nclass TestGenericAgentBuildPrompt:\n    def setup_method(self):\n        self.agent = ConcreteAgent(\"test\", \"Test Agent\", \"Test domain\", \"You are a test agent.\