        "language": "python",
        "code": "# tests/test_llm_client.py\n\"\"\"Unit tests for GeminiClient.\"\"\"\nimport asyncio\nimport json\nimport os\nimport pytest\nfrom unittest.mock import AsyncMock, MagicMock, patch\n\n\nclass TestSafeText:\n    def test_returns_text_when_present(self):\n        from src.llm.client import _safe_text\n        response = MagicMock()\n        response.text = \"hello\"\n        assert _safe_text(response) == \"hello\"\n\n    def test_returns_empty_string_on_value_error(self):\n        from src.llm.client import _safe_text\n        response = MagicMock()\n        type(response).text = property(lambda self: (_ for _ in ()).throw(ValueError(\"blocked\")))\n        assert _safe_text(response) == \"\"\n\n    def test_returns_empty_string_when_text_is_none(self):\n        from src.llm.client import _safe_text\n        response = MagicMock()\n        response.text = None\n        assert _safe_text(response) == \"\"\n\n\nclass TestGeminiClientInit:\n    def test_raises_when_api_key_missing(self, monkeypatch):\n        monkeypatch.delenv(\"GEMINI_API_KEY\", raising=False)\n        # Reset singleton\n        import src.llm.client as m\n        m._client = None\n        from src.llm.client import GeminiClient\n        with pytest.raises(RuntimeError, match=\"GEMINI_API_KEY\"):\n            GeminiClient()\n\n    def test_initializes_with_api_key(self, monkeypatch):\n        monkeypatch.setenv(\"GEMINI_API_KEY\", \"fake-key\")\n        with patch(\"google.generativeai.configure\"):\n            from src.llm.client import GeminiClient\n            client = GeminiClient()\n            assert client is not None\n\n\nclass TestGeminiClientChat:\n    @pytest.fixture\n    def client(self, monkeypatch):\n        monkeypatch.setenv(\"GEMINI_API_KEY\", \"fake-key\")\n        with patch(\"google.generativeai.configure\"):\n            from src.llm.client import GeminiClient\n            return GeminiClient()\n\n    @pytest.mark.asyncio\n    async def test_chat_returns_text(self, client):\n        mock_response = MagicMock()\n        mock_response.text = \"response text\"\n        with patch.object(client, \"_generate\", return_value=\"response text\"):\n            result = await client.chat(\"system\", \"user message\")\n        assert result == \"response text\"\n\n    @pytest.mark.asyncio\n    async def test_chat_parsed_returns_dict(self, client):\n        payload = {\"key\": \"value\"}\n        with patch.object(client, \"_generate\", return_value=json.dumps(payload)):\n            result = await client.chat_parsed(\"system\", \"user message\")\n        assert result == payload\n\n    @pytest.mark.asyncio\n    async def test_chat_parsed_on_bad_json_returns_error_dict(self, client):\n        with patch.object(client, \"_generate\", return_value=\"not json\"):\n            result = await client.chat_parsed(\"system\", \"user message\")\n        assert \"_parse_error\" in result\n        assert \"_raw\" in result\n\n\nclass TestGeminiGenerateRetry:\n    @pytest.fixture\n    def client(self, monkeypatch):\n        monkeypatch.setenv(\"GEMINI_API_KEY\", \"fake-key\")\n        with patch(\"google.generativeai.configure\"):\n            from src.llm.client import GeminiClient\n            return GeminiClient()\n\n    @pytest.mark.asyncio\n    async def test_retries_on_resource_exhausted(self, client):\n        from google.api_core.exceptions import ResourceExhausted\n\n        mock_model = MagicMock()\n        call_count = 0\n\n        async def flaky_generate(contents, **kwargs):\n            nonlocal call_count\n            call_count += 1\n            if call_count < 2:\n                raise ResourceExhausted(\"rate limited\")\n            result = MagicMock()\n            result.text = \"success\"\n            return result\n\n        mock_model.generate_content_async = flaky_generate\n\n        with patch(\"asyncio.sleep\", new_callable=AsyncMock):\n            result = await client._generate(mock_model, [])\n        assert result == \"success\"\n        assert call_count == 2\n\n    @pytest.mark.asyncio\n    async def test_raises_after_max_retries(self, client):\n        from google.api_core.exceptions import ResourceExhausted\n\n        mock_model = MagicMock()\n        mock_model.generate_content_async = AsyncMock(side_effect=ResourceExhausted(\"rate limited\"))\n\n        with patch(\"asyncio.sleep\", new_callable=AsyncMock):\n            with pytest.raises(ResourceExhausted):\n                await client._generate(mock_model, [], max_retries=3)\n\n\nclass TestGetClientSingleton:\n    def test_returns_same_instance(self, monkeypatch):\n        monkeypatch.setenv(\"GEMINI_API_KEY\", \"fake-key\")\n        import src.llm.client as m\n        m._client = None\n        with patch(\"google.generativeai.configure\"):\n            from src.llm.client import get_client\n            c1 = get_client()\n            c2 = get_client()\n        assert c1 is c2\n        m._client = None  # cleanup"
