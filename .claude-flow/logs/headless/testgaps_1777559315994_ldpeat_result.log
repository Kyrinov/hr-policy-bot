        "title": "tests/test_api_routes.py",
        "content": "\"\"\"Tests for REST API routes.\"\"\"\n\nimport pytest\nfrom unittest.mock import AsyncMock, patch, MagicMock\nfrom fastapi.testclient import TestClient\n\nfrom src.main import app  # adjust if app factory differs\n\n\n@pytest.fixture\ndef client():\n    return TestClient(app)\n\n\nclass TestHealthEndpoint:\n    def test_healthy_returns_200(self, client):\n        with patch(\"src.api.routes.ollama\") as mock_ollama, \\\n             patch(\"src.api.routes.aiosqlite\"):\n            response = client.get(\"/api/health\")\n        assert response.status_code == 200\n\n    def test_degraded_when_ollama_fails(self, client):\n        with patch(\"ollama.AsyncClient\", side_effect=Exception(\"connection refused\")):\n            response = client.get(\"/api/health\")\n        assert response.status_code == 200\n        assert response.json()[\"status\"] == \"degraded\"\n\n\nclass TestAgentsEndpoint:\n    def test_returns_eight_agents(self, client):\n        response = client.get(\"/api/agents\")\n        assert response.status_code == 200\n        data = response.json()\n        assert len(data) == 8\n        agent_ids = [a[\"agent_id\"] for a in data]\n        assert \"staffing\" in agent_ids\n        assert \"governance\" in agent_ids\n\n\nclass TestQueriesEndpoints:\n    def test_list_queries_returns_200(self, client):\n        with patch(\"src.api.routes.DatabaseManager\") as MockDB:\n            instance = AsyncMock()\n            instance.list_queries.return_value = []\n            MockDB.return_value = instance\n            response = client.get(\"/api/queries\")\n        assert response.status_code == 200\n\n    def test_get_query_not_found_returns_404(self, client):\n        with patch(\"src.api.routes.DatabaseManager\") as MockDB:\n            instance = AsyncMock()\n            instance.get_query.return_value = None\n            MockDB.return_value = instance\n            response = client.get(\"/api/queries/nonexistent-id\")\n        assert response.status_code == 404\n\n\nclass TestFeedbackEndpoint:\n    def test_submit_feedback_returns_ok(self, client):\n        import uuid\n        with patch(\"src.api.routes.DatabaseManager\") as MockDB:\n            instance = AsyncMock()\n            MockDB.return_value = instance\n            payload = {\n                \"feedback_id\": str(uuid.uuid4()),\n                \"query_id\": str(uuid.uuid4()),\n                \"rating\": \"accurate\",\n            }\n            response = client.post(\"/api/feedback\", json=payload)\n        assert response.status_code == 200\n        assert response.json()[\"status\"] == \"ok\"\n```\n\n```python\n",
