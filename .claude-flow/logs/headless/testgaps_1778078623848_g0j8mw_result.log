        "language": "python",
        "code": "# tests/test_llm_client.py\n\"\"\"Tests for VLLMClient — requires mocking the AsyncOpenAI client.\"\"\"\nimport json\nfrom unittest.mock import AsyncMock, MagicMock, patch\n\nimport pytest\n\nfrom src.llm.client import VLLMClient\n\n\n@pytest.fixture\ndef mock_completion():\n    msg = MagicMock()\n    msg.content = '{\"findings\": \"test\"}'\n    choice = MagicMock()\n    choice.message = msg\n    completion = MagicMock()\n    completion.choices = [choice]\n    return completion\n\n\n@pytest.fixture\ndef client_with_mock(mock_completion):\n    with patch(\"src.llm.client.AsyncOpenAI\") as mock_openai:\n        instance = mock_openai.return_value\n        instance.chat = MagicMock()\n        instance.chat.completions = MagicMock()\n        instance.chat.completions.create = AsyncMock(return_value=mock_completion)\n        yield VLLMClient(), instance\n\n\nclass TestVLLMClientChat:\n    @pytest.mark.asyncio\n    async def test_chat_returns_content(self, client_with_mock):\n        client, _ = client_with_mock\n        result = await client.chat(\"system prompt\", \"user message\")\n        assert result == '{\"findings\": \"test\"}'\n\n    @pytest.mark.asyncio\n    async def test_chat_parsed_valid_json(self, client_with_mock):\n        client, _ = client_with_mock\n        result = await client.chat_parsed(\"system\", \"user\")\n        assert result == {\"findings\": \"test\"}\n\n    @pytest.mark.asyncio\n    async def test_chat_parsed_malformed_json(self):\n        \"\"\"chat_parsed must return a dict with _raw on bad JSON, not raise.\"\"\"\n        with patch(\"src.llm.client.AsyncOpenAI\") as mock_openai:\n            msg = MagicMock()\n            msg.content = \"This is not JSON at all\"\n            choice = MagicMock()\n            choice.message = msg\n            completion = MagicMock()\n            completion.choices = [choice]\n            instance = mock_openai.return_value\n            instance.chat.completions.create = AsyncMock(return_value=completion)\n\n            client = VLLMClient()\n            result = await client.chat_parsed(\"system\", \"user\")\n            assert \"_raw\" in result\n            assert \"_parse_error\" in result\n\n    @pytest.mark.asyncio\n    async def test_stream_chat_yields_chunks(self):\n        \"\"\"stream_chat must yield each non-empty delta content.\"\"\"\n        with patch(\"src.llm.client.AsyncOpenAI\") as mock_openai:\n            chunks = []\n            for text in [\"Hello\", \" world\", \"!\"]:\n                delta = MagicMock()\n                delta.content = text\n                choice = MagicMock()\n                choice.delta = delta\n                chunk = MagicMock()\n                chunk.choices = [choice]\n                chunks.append(chunk)\n\n            async def async_iter():\n                for c in chunks:\n                    yield c\n\n            instance = mock_openai.return_value\n            instance.chat.completions.create = AsyncMock(return_value=async_iter())\n\n            client = VLLMClient()\n            results = []\n            async for part in client.stream_chat(\"system\", \"user\"):\n                results.append(part)\n\n            assert results == [\"Hello\", \" world\", \"!\"]\n\n    @pytest.mark.asyncio\n    async def test_stream_chat_skips_empty_chunks(self):\n        \"\"\"Empty delta content strings must not be yielded.\"\"\"\n        with patch(\"src.llm.client.AsyncOpenAI\") as mock_openai:\n            chunks = []\n            for text in [\"data\", \"\", \"more\"]:\n                delta = MagicMock()\n                delta.content = text\n                choice = MagicMock()\n                choice.delta = delta\n                chunk = MagicMock()\n                chunk.choices = [choice]\n                chunks.append(chunk)\n\n            async def async_iter():\n                for c in chunks:\n                    yield c\n\n            instance = mock_openai.return_value\n            instance.chat.completions.create = AsyncMock(return_value=async_iter())\n\n            client = VLLMClient()\n            results = [p async for p in client.stream_chat(\"sys\", \"usr\")]\n            assert \"\" not in results\n            assert len(results) == 2"
