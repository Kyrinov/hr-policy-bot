        "title": "tests/test_fetch_cache.py",
        "content": "import pytest\nfrom datetime import datetime, timedelta\nfrom unittest.mock import AsyncMock, MagicMock\n\n\nclass TestCacheEntry:\n    def test_content_hash_is_sha256(self):\n        import hashlib\n        from src.fetch.cache import CacheEntry\n        entry = CacheEntry(url=\"http://a.com\", content=\"hello\", ttl_hours=1)\n        expected = hashlib.sha256(\"hello\".encode()).hexdigest()\n        assert entry.content_hash == expected\n\n    def test_is_valid_within_ttl(self):\n        from src.fetch.cache import CacheEntry\n        entry = CacheEntry(url=\"http://a.com\", content=\"text\", ttl_hours=24)\n        entry.fetched_at = datetime.utcnow().isoformat()\n        assert entry.is_valid() is True\n\n    def test_is_valid_expired(self):\n        from src.fetch.cache import CacheEntry\n        entry = CacheEntry(url=\"http://a.com\", content=\"text\", ttl_hours=1)\n        past = datetime.utcnow() - timedelta(hours=2)\n        entry.fetched_at = past.isoformat()\n        assert entry.is_valid() is False\n\n\nclass TestGetDefaultTtl:\n    def test_legislation_domain_returns_720(self):\n        from src.fetch.cache import FetchCache\n        cache = FetchCache.__new__(FetchCache)\n        cache._config = MagicMock()\n        cache._config.cache.ttl_hours = 168\n        assert cache._get_default_ttl(\"https://laws-lois.justice.gc.ca/eng/acts/P-33.01/\") == 720\n\n    def test_collective_agreement_domain_returns_720(self):\n        from src.fetch.cache import FetchCache\n        cache = FetchCache.__new__(FetchCache)\n        cache._config = MagicMock()\n        cache._config.cache.ttl_hours = 168\n        assert cache._get_default_ttl(\"https://tbs-sct.canada.ca/agreements-conventions/foo\") == 720\n\n    def test_default_domain_returns_config_ttl(self):\n        from src.fetch.cache import FetchCache\n        cache = FetchCache.__new__(FetchCache)\n        cache._config = MagicMock()\n        cache._config.cache.ttl_hours = 168\n        assert cache._get_default_ttl(\"https://tbs-sct.canada.ca/pol/doc-eng.aspx?id=32592\") == 168\n\n\nclass TestFetchCacheGetSet:\n    @pytest.mark.asyncio\n    async def test_get_returns_none_on_miss(self):\n        mock_db = AsyncMock()\n        mock_db.get_cached = AsyncMock(return_value=None)\n        from src.fetch.cache import FetchCache\n        cache = FetchCache(db_manager=mock_db)\n        result = await cache.get(\"https://example.com\")\n        assert result is None\n\n    @pytest.mark.asyncio\n    async def test_get_returns_entry_on_hit(self):\n        from src.models.schemas import FetchCacheEntry\n        mock_entry = FetchCacheEntry(\n            url=\"https://example.com\",\n            content_text=\"content\",\n            content_hash=\"abc\",\n            ttl_hours=168,\n        )\n        mock_db = AsyncMock()\n        mock_db.get_cached = AsyncMock(return_value=mock_entry)\n        from src.fetch.cache import FetchCache\n        cache = FetchCache(db_manager=mock_db)\n        result = await cache.get(\"https://example.com\")\n        assert result is not None\n        assert result.content == \"content\"\n\n    @pytest.mark.asyncio\n    async def test_set_cached_calls_db(self):\n        mock_db = AsyncMock()\n        mock_db.set_cached = AsyncMock()\n        from src.fetch.cache import FetchCache, CacheEntry\n        cache = FetchCache(db_manager=mock_db)\n        entry = CacheEntry(url=\"https://example.com\", content=\"text\", ttl_hours=168)\n        await cache.set_cached(entry)\n        mock_db.set_cached.assert_called_once()\n\n    @pytest.mark.asyncio\n    async def test_store_uses_auto_ttl(self):\n        mock_db = AsyncMock()\n        mock_db.set_cached = AsyncMock()\n        from src.fetch.cache import FetchCache\n        cache = FetchCache(db_manager=mock_db)\n        cache._config = MagicMock()\n        cache._config.cache.ttl_hours = 168\n        await cache.store(\"https://tbs-sct.canada.ca/pol/doc-eng.aspx\", \"content\")\n        call_args = mock_db.set_cached.call_args[0][0]\n        assert call_args.ttl_hours == 168\n```\n\n---\n\n",
