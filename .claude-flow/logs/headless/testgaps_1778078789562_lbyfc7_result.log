        "code": "# tests/test_agents/test_orchestrator.py\n\nimport json\nimport pytest\nfrom unittest.mock import AsyncMock\nfrom src.agents.orchestrator import OrchestratorAgent\nfrom src.models.schemas import OrchestratorResponse\n\n\n@pytest.fixture\ndef agent():\n    orch = OrchestratorAgent.__new__(OrchestratorAgent)\n    orch._config = None  # not needed for pure-logic tests\n    orch._specialist_agent_ids = [\n        \"staffing\", \"classification\", \"labour\", \"learning\",\n        \"equity\", \"ohs\", \"languages\", \"governance\",\n    ]\n    return orch\n\n\nclass TestBuildSynthesisPrompt:\n    def test_includes_agent_findings(self, agent):\n        responses = [{\"agent_id\": \"staffing\", \"findings\": \"You must use advertised process.\", \"confidence\": \"high\", \"citations\": []}]\n        prompt = agent._build_synthesis_prompt(\"How do I hire?\", responses)\n        assert \"STAFFING\" in prompt\n        assert \"advertised process\" in prompt\n\n    def test_includes_citations(self, agent):\n        responses = [{\n            \"agent_id\": \"staffing\",\n            \"findings\": \"See PSEA.\",\n            \"confidence\": \"high\",\n            \"citations\": [{\"instrument_title\": \"PSEA\", \"url\": \"https://laws-lois.justice.gc.ca/PSEA\", \"relevant_section\": \"s. 30\"}],\n        }]\n        prompt = agent._build_synthesis_prompt(\"Hiring?\", responses)\n        assert \"PSEA\" in prompt\n        assert \"s. 30\" in prompt\n\n\nclass TestAggregateCitations:\n    def test_deduplicates_same_title_and_url(self, agent):\n        responses = [\n            {\"agent_id\": \"staffing\", \"citations\": [{\"instrument_title\": \"PSEA\", \"url\": \"https://x.com\", \"instrument_type\": \"Act\"}]},\n            {\"agent_id\": \"labour\", \"citations\": [{\"instrument_title\": \"PSEA\", \"url\": \"https://x.com\", \"instrument_type\": \"Act\"}]},\n        ]\n        citations = agent._aggregate_citations(responses)\n        assert len(citations) == 1\n\n    def test_different_urls_not_deduplicated(self, agent):\n        responses = [\n            {\"agent_id\": \"staffing\", \"citations\": [{\"instrument_title\": \"PSEA\", \"url\": \"https://x.com\", \"instrument_type\": \"Act\"}]},\n            {\"agent_id\": \"labour\", \"citations\": [{\"instrument_title\": \"PSEA\", \"url\": \"https://y.com\", \"instrument_type\": \"Act\"}]},\n        ]\n        citations = agent._aggregate_citations(responses)\n        assert len(citations) == 2\n\n\nclass TestDeterministicGrounding:\n    def test_full_coverage_when_all_validate(self, agent):\n        responses = [\n            {\"grounding_mode\": \"validate\", \"citations\": [], \"retrieval_status\": {\"instruments_successfully_retrieved\": 3}},\n            {\"grounding_mode\": \"validate\", \"citations\": [], \"retrieval_status\": {\"instruments_successfully_retrieved\": 2}},\n        ]\n        grounding = agent._deterministic_grounding(responses)\n        assert grounding.graph_coverage == \"full\"\n        assert grounding.llm_mode == \"validate\"\n\n    def test_no_coverage_when_none_validate(self, agent):\n        responses = [{\"grounding_mode\": \"extract\", \"citations\": []}]\n        grounding = agent._deterministic_grounding(responses)\n        assert grounding.graph_coverage == \"none\"\n        assert grounding.llm_mode == \"extract\"\n\n    def test_partial_coverage_mixed_modes(self, agent):\n        responses = [\n            {\"grounding_mode\": \"validate\", \"citations\": [], \"retrieval_status\": {\"instruments_successfully_retrieved\": 1}},\n            {\"grounding_mode\": \"extract\", \"citations\": []},\n        ]\n        grounding = agent._deterministic_grounding(responses)\n        assert grounding.graph_coverage == \"partial\"\n\n\n@pytest.mark.asyncio\nclass TestRouteWithMockedLLM:\n    async def test_route_fallback_on_invalid_json(self):\n        agent = OrchestratorAgent.__new__(OrchestratorAgent)\n        agent._specialist_agent_ids = [\"staffing\", \"labour\"]\n        agent._llm_client = MagicMock()\n        agent._llm_client.chat = AsyncMock(return_value=\"not json at all\")\n        result = await agent._route(\"Test query\")\n        assert \"selected_agents\" in result\n        assert set(result[\"selected_agents\"]) == {\"staffing\", \"labour\"}"
