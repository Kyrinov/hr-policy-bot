cts/P-33.01/\")\n        assert result.endswith(\"/FullText.html\")\n\n    def test_leaves_fulltext_url_unchanged(self):\n        from src.fetch.engine import FetchEngine\n        engine = FetchEngine.__new__(FetchEngine)\n        url = \"https://laws-lois.justice.gc.ca/eng/acts/P-33.01/FullText.html\"\n        assert engine._normalize_url(url) == url\n\n    def test_leaves_non_laws_url_unchanged(self):\n        from src.fetch.engine import FetchEngine\n        engine = FetchEngine.__new__(FetchEngine)\n        url = \"https://tbs-sct.canada.ca/pol/doc-eng.aspx?id=32592\"\n        assert engine._normalize_url(url) == url\n\n\nclass TestGetDomain:\n    def test_extracts_standard_domain(self):\n        from src.fetch.engine import FetchEngine\n        engine = FetchEngine.__new__(FetchEngine)\n        assert engine._get_domain(\"https://laws-lois.justice.gc.ca/eng/acts/\") == \"laws-lois.justice.gc.ca\"\n\n    def test_malformed_url_returns_default(self):\n        from src.fetch.engine import FetchEngine\n        engine = FetchEngine.__new__(FetchEngine)\n        result = engine._get_domain(\"\")\n        assert result == \"default\"\n\n\nclass TestDoFetch:\n    @pytest.mark.asyncio\n    async def test_cache_hit_returns_cached_content(self, engine):\n        from src.fetch.cache import CacheEntry\n        entry = MagicMock()\n        entry.content = \"cached content\"\n        engine._cache.get = AsyncMock(return_value=entry)\n        result = await engine._do_fetch(\"https://example.com\")\n        assert result == \"cached content\"\n\n    @pytest.mark.asyncio\n    async def test_cache_miss_fetches_and_stores(self, engine):\n        engine._cache.get = AsyncMock(return_value=None)\n        engine._cache.set_cached = AsyncMock()\n        mock_response = MagicMock()\n        mock_response.text = \"<html><body>content</body></html>\"\n        mock_response.status_code = 200\n        mock_response.raise_for_status = MagicMock()\n        engine._client = AsyncMock()\n        engine._client.get = AsyncMock(return_value=mock_response)\n        result = await engine._do_fetch(\"https://example.com\")\n        assert result == \"extracted content\"\n        engine._cache.set_cached.assert_called_once()\n\n    @pytest.mark.asyncio\n    async def test_fetch_failure_falls_back_to_stale(self, engine):\n        engine._cache.get = AsyncMock(return_value=None)\n        engine._client = AsyncMock()\n        engine._client.get = AsyncMock(side_effect=httpx.RequestError(\"timeout\"))\n        stale_entry = MagicMock()\n        stale_entry.content = \"stale content\"\n        engine._cache.get_stale = AsyncMock(return_value=stale_entry)\n        result = await engine._do_fetch(\"https://example.com\")\n        assert result == \"stale content\"\n\n    @pytest.mark.asyncio\n    async def test_fetch_failure_no_stale_raises_fetch_error(self, engine):\n        from src.fetch.engine import FetchError\n        engine._cache.get = AsyncMock(return_value=None)\n        engine._cache.get_stale = AsyncMock(return_value=None)\n        engine._client = AsyncMock()\n        engine._client.get = AsyncMock(side_effect=httpx.RequestError(\"timeout\"))\n        with pytest.raises(FetchError):\n            await engine._do_fetch(\"https://example.com\")\n\n    @pytest.mark.asyncio\n    async def test_http_status_error_falls_back_to_stale(self, engine):\n        from src.fetch.engine import FetchError\n        engine._cache.get = AsyncMock(return_value=None)\n        engine._cache.get_stale = AsyncMock(return_value=None)\n        engine._client = AsyncMock()\n        mock_response = MagicMock()\n        mock_response.raise_for_status = MagicMock(\n            side_effect=httpx.HTTPStatusError(\"404\", request=MagicMock(), response=MagicMock())\n        )\n        engine._client.get = AsyncMock(return_value=mock_response)\n        with pytest.raises(FetchError):\n            await engine._do_fetch(\"https://example.com\")\n\n\nclass TestFetchBatch:\n    @pytest.mark.asyncio\n    async def test_returns_successful_results(self, engine):\n        engine._cache.get = AsyncMock(return_value=None)\n        engine._cache.get_stale = AsyncMock(return_value=None)\n        mock_response = MagicMock()\n        mock_response.text = \"<html>content</html>\"\n        mock_response.status_code = 200\n        mock_response.raise_for_status = MagicMock()\n        engine._client = AsyncMock()\n        engine._client.get = AsyncMock(return_value=mock_response)\n        engine._cache.set_cached = AsyncMock()\n        results = await engine.fetch_batch([\"https://a.com\", \"https://b.com\"])\n        assert len(results) == 2\n\n    @pytest.mark.asyncio\n    async def test_partial_failure_returns_successes_only(self, engine):\n        from src.fetch.engine import FetchError\n        async def side_effect(url):\n            if \"fail\" in url:\n                raise FetchError(\"fail\")\n            entry = MagicMock()\n            entry.content = \"ok\"\n            return entry.content\n\n        engine.fetch = AsyncMock(side_effect=side_effect)\n        results = await engine.fetch_batch([\"https://ok.com\", \"https://fail.com\"])\n        assert \"https://ok.com\" in results\n        assert \"https://fail.com\" not in results\n```\n\n---\n\n#### 5. `src/fetch/cache.py` — **0% tested**\n\nUntested: `FetchCache.get` (valid vs expired), `get_stale`, `set_cached`, `store` (auto TTL), `_get_default_ttl` (legislation domain 720h, collective domain 720h, default), `clear_expired`, `health_check`, `CacheEntry.is_valid`, `CacheEntry.content_hash`.\n\n```python\n# tests/test_fetch_cache.py\nimport pytest\nfrom datetime import datetime, timedelta\nfrom unittest.mock import AsyncMock, MagicMock\n\n\nclass TestCacheEntry:\n    def test_content_hash_is_sha256(self):\n        import hashlib\n        from src.fetch.cache import CacheEntry\n        entry = CacheEntry(url=\"http://a.com\", content=\"hello\", ttl_hours=1)\n        expected = hashlib.sha256(\"hello\".encode()).hexdigest()\n        assert entry.content_hash == expected\n\n    def test_is_valid_within_ttl(self):\n        from src.fetch.cache import CacheEntry\n        entry = CacheEntry(url=\"http://a.com\", content=\"text\", ttl_hours=24)\n        entry.fetched_at = datetime.utcnow().isoformat()\n        assert entry.is_valid() is True\n\n    def test_is_valid_expired(self):\n        from src.fetch.cache import CacheEntry\n        entry = CacheEntry(url=\"http://a.com\", content=\"text\", ttl_hours=1)\n        past = datetime.utcnow() - timedelta(hours=2)\n        entry.fetched_at = past.isoformat()\n        assert entry.is_valid() is False\n\n\nclass TestGetDefaultTtl:\n    def test_legislation_domain_returns_720(self):\n        from src.fetch.cache import FetchCache\n        cache = FetchCache.__new__(FetchCache)\n        cache._config = MagicMock()\n        cache._config.cache.ttl_hours = 168\n        assert cache._get_default_ttl(\"https://laws-lois.justice.gc.ca/eng/acts/P-33.01/\") == 720\n\n    def test_collective_agreement_domain_returns_720(self):\n        from src.fetch.cache import FetchCache\n        cache = FetchCache.__new__(FetchCache)\n        cache._config = MagicMock()\n        cache._config.cache.ttl_hours = 168\n        assert cache._get_default_ttl(\"https://tbs-sct.canada.ca/agreements-conventions/foo\") == 720\n\n    def test_default_domain_returns_config_ttl(self):\n        from src.fetch.cache import FetchCache\n        cache = FetchCache.__new__(FetchCache)\n        cache._config = MagicMock()\n        cache._config.cache.ttl_hours = 168\n        assert cache._get_default_ttl(\"https://tbs-sct.canada.ca/pol/doc-eng.aspx?id=32592\") == 168\n\n\nclass TestFetchCacheGetSet:\n    @pytest.mark.asyncio\n    async def test_get_returns_none_on_miss(self):\n        mock_db = AsyncMock()\n        mock_db.get_cached = AsyncMock(return_value=None)\n        from src.fetch.cache import FetchCache\n        cache = FetchCache(db_manager=mock_db)\n        result = await cache.get(\"https://example.com\")\n        assert result is None\n\n    @pytest.mark.asyncio\n    async def test_get_returns_entry_on_hit(self):\n        from src.models.schemas import FetchCacheEntry\n        mock_entry = FetchCacheEntry(\n            url=\"https://example.com\",\n            content_text=\"content\",\n            content_hash=\"abc\",\n            ttl_hours=168,\n        )\n        mock_db = AsyncMock()\n        mock_db.get_cached = AsyncMock(return_value=mock_entry)\n        from src.fetch.cache import FetchCache\n        cache = FetchCache(db_manager=mock_db)\n        result = await cache.get(\"https://example.com\")\n        assert result is not None\n        assert result.content == \"content\"\n\n    @pytest.mark.asyncio\n    async def test_set_cached_calls_db(self):\n        mock_db = AsyncMock()\n        mock_db.set_cached = AsyncMock()\n        from src.fetch.cache import FetchCache, CacheEntry\n        cache = FetchCache(db_manager=mock_db)\n        entry = CacheEntry(url=\"https://example.com\", content=\"text\", ttl_hours=168)\n        await cache.set_cached(entry)\n        mock_db.set_cached.assert_called_once()\n\n    @pytest.mark.asyncio\n    async def test_store_uses_auto_ttl(self):\n        mock_db = AsyncMock()\n        mock_db.set_cached = AsyncMock()\n        from src.fetch.cache import FetchCache\n        cache = FetchCache(db_manager=mock_db)\n        cache._config = MagicMock()\n        cache._config.cache.ttl_hours = 168\n        await cache.store(\"https://tbs-sct.canada.ca/pol/doc-eng.aspx\", \"content\")\n        call_args = mock_db.set_cached.call_args[0][0]\n        assert call_args.ttl_hours == 168\n```\n\n---\n\n#### 6. `src/fetch/extractors.py` — **partially tested**\n\nUntested: domain-specific selector application, `_remove_elements`, `_truncate`, `_clean_text`, missing selectors file fallback, deeply nested `div`/`section` recursion, empty body.\n\n```python\n# tests/test_extractors.py\nimport pytest\n\n\n@pytest.fixture\ndef extractor():\n    from src.fetch.extractors import ContentExtractor\n    return ContentExtractor()\n\n\nclass TestExtractTruncation:\n    def test_truncates_at_max_length(self, extractor):\n        long_html = f\"<html><body><p>{'x' * 100000}</p></body></html>\"\n        result = extractor.extract(\"https://example.com\", long_html, max_length=100)\n        assert len(result) <= 100\n\n    def test_adds_ellipsis_when_truncated(self, extractor):\n        long_html = f\"<html><body><p>{'x' * 100000}</p></body></html>\"\n        result = extractor.extract(\"https://example.com\", long_html, max_length=50)\n        assert result.endswith(\"...\")\n\n\nclass TestExtractRemoveElements:\n    def test_removes_navigation(self, extractor):\n        html = \"\"\"<html><body><main>\n            <nav>Skip to main</nav>\n            <p>Policy content here.</p>\n        </main></body></html>\"\"\"\n        result = extractor.extract(\"https://tbs-sct.canada.ca/pol/doc-eng.aspx\", html)\n        assert \"Skip to main\" not in result\n        assert \"Policy content here\" in result\n\n\nclass TestExtractHeadings:\n    def test_headings_preserved(self, extractor):\n        html = \"<html><body><main><h1>Title</h1><p>Body</p></main></body></html>\"\n        result = extractor.extract(\"https://example.com\", html)\n        assert \"Title\" in result\n        assert \"Body\" in result\n\n\nclass TestExtractEmptyAndMalformed:\n    def test_empty_html(self, extractor):\n        result = extractor.extract(\"https://example.com\", \"\")\n        assert isinstance(result, str)\n\n    def test_no_body_tag(self, extractor):\n        result = extractor.extract(\"https://example.com\", \"<p>Just a paragraph.</p>\")\n        assert isinstance(result, str)\n\n\nclass TestGetSelectors:\n    def test_falls_back_to_default_for_unknown_domain(self, extractor):\n        selectors = extractor._get_selectors(\"https://unknown-domain.example.com/page\")\n        assert isinstance(selectors, dict)\n\n    def test_returns_domain_specific_selectors(self, extractor):\n        laws_selectors = extractor._get_selectors(\"https://laws-lois.justice.gc.ca/eng/acts/P-33.01/\")\n        default_selectors = extractor._get_selectors(\"https://unknown.example.com/\")\n        # Laws domain should have specific selectors configured\n        assert isinstance(laws_selectors, dict)\n```\n\n---\n\n#### 7. `src/data/db.py` — **partially tested**\n\nUntested: `list_queries`, `save_agent_response`/`get_agent_responses`, `save_orchestrator_response`/`get_orchestrator_response`, `save_feedback`/`get_feedback_for_query`/`export_feedback`, cache operations (`get_cached`/`get_stale`/`set_cached`/`clear_expired`), `get_query` returning `None` for missing ID.\n\n```python\n# tests/test_db.py\nimport pytest\nimport uuid\nfrom pathlib import Path\nfrom datetime import datetime\n\n\n@pytest.fixture\nasync def db(tmp_path):\n    from src.data.db import DatabaseManager\n    manager = DatabaseManager(db_path=tmp_path / \"test.db\")\n    await manager.initialize()\n    return manager\n\n\n@pytest.fixture\ndef query_id():\n    return str(uuid.uuid4())\n\n\n@pytest.fixture\nasync def saved_query(db, query_id):\n    from src.models.schemas import QueryRecord\n    record = QueryRecord(query_id=query_id, query_text=\"Test query\", agents_invoked=[\"staffing\"])\n    await db.save_query(record)\n    return query_id\n\n\nclass TestListQueries:\n    @pytest.mark.asyncio\n    async def test_empty_db_returns_empty_list(self, db):\n        result = await db.list_queries()\n        assert result == []\n\n    @pytest.mark.asyncio\n    async def test_returns_saved_queries(self, db, saved_query):\n        result = await db.list_queries()\n        assert len(result) == 1\n        assert result[0].query_id == saved_query\n\n    @pytest.mark.asyncio\n    async def test_limit_respected(self, db):\n        from src.models.schemas import QueryRecord\n        for i in range(5):\n            r = QueryRecord(query_id=str(uuid.uuid4()), query_text=f\"q{i}\", agents_invoked=[])\n            await db.save_query(r)\n        result = await db.list_queries(limit=3)\n        assert len(result) == 3\n\n\nclass TestGetQueryMissing:\n    @pytest.mark.asyncio\n    async def test_returns_none_for_missing_id(self, db):\n        result = await db.get_query(\"nonexistent-id\")\n        assert result is None\n\n\nclass TestAgentResponses:\n    @pytest.mark.asyncio\n    async def test_save_and_get_agent_response(self, db, saved_query):\n        from src.models.schemas import AgentResponseRecord, CitationItem, RetrievalStatus\n        record = AgentResponseRecord(\n            response_id=str(uuid.uuid4()),\n            query_id=saved_query,\n            agent_id=\"staffing\",\n            findings=\"Some findings\",\n            citations=[CitationItem(instrument_title=\"PSEA\", instrument_type=\"Act\", url=\"https://example.com\")],\n            confidence=\"high\",\n            retrieval_status=RetrievalStatus(instruments_attempted=1, instruments_successfully_retrieved=1),\n        )\n        await db.save_agent_response(record)\n        results = await db.get_agent_responses(saved_query)\n        assert len(results) == 1\n        assert results[0].agent_id == \"staffing\"\n\n    @pytest.mark.asyncio\n    async def test_get_agent_responses_empty_for_unknown_query(self, db):\n        results = await db.get_agent_responses(\"nonexistent\")\n        assert results == []\n\n\nclass TestOrchestratorResponse:\n    @pytest.mark.asyncio\n    async def test_save_and_get_orchestrator_response(self, db, saved_query):\n        from src.models.schemas import OrchestratorResponseRecord\n        record = OrchestratorResponseRecord(\n            response_id=str(uuid.uuid4()),\n            query_id=saved_query,\n            summary=\"Summary text\",\n            overall_confidence=\"medium\",\n        )\n        await db.save_orchestrator_response(record)\n        result = await db.get_orchestrator_response(saved_query)\n        assert result is not None\n        assert result.summary == \"Summary text\"\n\n    @pytest.mark.asyncio\n    async def test_returns_none_for_missing_orchestrator_response(self, db):\n        result = await db.get_orchestrator_response(\"nonexistent\")\n        assert result is None\n\n\nclass TestFeedback:\n    @pytest.mark.asyncio\n    async def test_save_and_get_feedback(self, db, saved_query):\n        from src.models.schemas import FeedbackRecord\n        record = FeedbackRecord(\n            feedback_id=str(uuid.uuid4()),\n            query_id=saved_query,\n            rating=\"accurate\",\n            comment=\"Very helpful\",\n        )\n        await db.save_feedback(record)\n        result = await db.get_feedback_for_query(saved_query)\n        assert result is not None\n        assert result.rating == \"accurate\"\n\n    @pytest.mark.asyncio\n    async def test_export_feedback_returns_list(self, db, saved_query):\n        from src.models.schemas import FeedbackRecord\n        record = FeedbackRecord(\n            feedback_id=str(uuid.uuid4()),\n            query_id=saved_query,\n            rating=\"needs_work\",\n        )\n        await db.save_feedback(record)\n        exported = await db.export_feedback()\n        assert len(exported) >= 1\n        assert isinstance(exported[0], dict)\n\n\nclass TestCacheOperations:\n    @pytest.mark.asyncio\n    async def test_set_and_get_cached(self, db):\n        from src.models.schemas import FetchCacheEntry\n        entry = FetchCacheEntry(\n            url=\"https://example.com/doc\",\n            content_text=\"policy text\",\n            content_hash=\"abc123\",\n            ttl_hours=720,\n            status_code=200,\n        )\n        await db.set_cached(entry)\n        result = await db.get_cached(\"https://example.com/doc\")\n        assert result is not None\n        assert result.content_text == \"policy text\"\n\n    @pytest.mark.asyncio\n    async def test_get_cached_returns_none_on_miss(self, db):\n        result = await db.get_cached(\"https://nonexistent.example.com\")\n        assert result is None\n\n    @pytest.mark.asyncio\n    async def test_clear_expired_removes_old_entries(self, db):\n        from src.models.schemas import FetchCacheEntry\n        from datetime import timedelta\n        expired_entry = FetchCacheEntry(\n            url=\"https://expired.example.com\",\n            content_text=\"old\",\n            content_hash=\"def\",\n            ttl_hours=1,\n            fetched_at=datetime.utcnow() - timedelta(hours=48),\n        )\n        await db.set_cached(expired_entry)\n        deleted = await db.clear_expired()\n        assert deleted >= 1\n        result = await db.get_stale(\"https://expired.example.com\")\n        assert result is None\n```\n\n---\n\n#### 8. `src/api/routes.py` — **0% tested**\n\nUntested: `GET /health` (healthy + degraded), `GET /agents`, `GET /queries` (pagination), `GET /queries/{id}` (found + 404), `POST /feedback`, `GET /feedback/export`.\n\n```python\n# tests/test_api_routes.py\nimport pytest\nimport uuid\nfrom unittest.mock import AsyncMock, MagicMock, patch\nfrom fastapi.testclient import TestClient\n\n\n@pytest.fixture\ndef client(tmp_path):\n    from src.main import app\n    with TestClient(app) as c:\n        yield c\n\n\nclass TestHealthEndpoint:\n    def test_health_returns_200(self, client):\n        with patch(\"ollama.AsyncClient\") as mock_ollama:\n            mock_ollama.return_value.list = AsyncMock(return_value=MagicMock(models=[]))\n            response = client.get(\"/api/health\")\n        assert response.status_code == 200\n        assert \"status\" in response.json()\n\n    def test_health_degrades_on_ollama_failure(self, client):\n        with patch(\"ollama.AsyncClient\", side_effect=Exception(\"connection refused\")):\n            response = client.get(\"/api/health\")\n        data = response.json()\n        assert data[\"status\"] in (\"healthy\", \"degraded\")\n\n\nclass TestAgentsEndpoint:\n    def test_returns_8_agents(self, client):\n        response = client.get(\"/api/agents\")\n        assert response.status_code == 200\n        agents = response.json()\n        assert len(agents) == 8\n        agent_ids = [a[\"agent_id\"] for a in agents]\n        assert \"staffing\" in agent_ids\n        assert \"governance\" in agent_ids\n\n\nclass TestQueriesEndpoint:\n    def test_empty_list(self, client):\n        with patch(\"src.data.db.DatabaseManager.list_queries\", new_callable=AsyncMock, return_value=[]):\n            response = client.get(\"/api/queries\")\n        assert response.status_code == 200\n        assert response.json() == []\n\n    def test_limit_parameter_validated(self, client):\n        response = client.get(\"/api/queries?limit=0\")\n        assert response.status_code == 422  # validation error\n\n    def test_limit_over_100_rejected(self, client):\n        response = client.get(\"/api/queries?limit=200\")\n        assert response.status_code == 422\n\n\nclass TestGetQueryEndpoint:\n    def test_returns_404_for_unknown_id(self, client):\n        with patch(\"src.data.db.DatabaseManager.get_query\", new_callable=AsyncMock, return_value=None):\n            response = client.get(f\"/api/queries/{uuid.uuid4()}\")\n        assert response.status_code == 404\n\n    def test_returns_query_with_responses(self, client):\n        from src.models.schemas import QueryRecord\n        mock_query = QueryRecord(\n            query_id=\"test-id\", query_text=\"test\", agents_invoked=[\"staffing\"]\n        )\n        with patch(\"src.data.db.DatabaseManager.get_query\", new_callable=AsyncMock, return_value=mock_query), \\\n             patch(\"src.data.db.DatabaseManager.get_agent_responses\", new_callable=AsyncMock, return_value=[]), \\\n             patch(\"src.data.db.DatabaseManager.get_orchestrator_response\", new_callable=AsyncMock, return_value=None), \\\n             patch(\"src.data.db.DatabaseManager.get_feedback_for_query\", new_callable=AsyncMock, return_value=None):\n            response = client.get(\"/api/queries/test-id\")\n        assert response.status_code == 200\n        assert response.json()[\"query_id\"] == \"test-id\"\n\n\nclass TestFeedbackEndpoint:\n    def test_submit_feedback(self, client):\n        payload = {\n            \"feedback_id\": str(uuid.uuid4()),\n            \"query_id\": str(uuid.uuid4()),\n            \"rating\": \"accurate\",\n            \"comment\": \"Great answer\",\n            \"timestamp\": \"2026-04-30T12:00:00\",\n        }\n        with patch(\"src.data.db.DatabaseManager.save_feedback\", new_callable=AsyncMock):\n            response = client.post(\"/api/feedback\", json=payload)\n        assert response.status_code == 200\n        assert response.json()[\"status\"] == \"ok\"\n\n    def test_export_feedback(self, client):\n        with patch(\"src.data.db.DatabaseManager.export_feedback\", new_callable=AsyncMock, return_value=[]):\n            response = client.get(\"/api/feedback/export\")\n        assert response.status_code == 200\n        assert isinstance(response.json(), list)\n```\n\n---\n\n#### 9. `src/api/websocket.py` — **0% tested**\n\nUntested: `WebSocketManager.connect/disconnect/send/broadcast_error`, `process_query` (happy path, DB persistence, `WebSocketDisconnect` mid-flight, processing exception → error message), `websocket_endpoint` (cancel on disconnect).\n\n```python\n# tests/test_websocket.py\nimport pytest\nfrom unittest.mock import AsyncMock, MagicMock, patch\n\n\nclass TestWebSocketManager:\n    @pytest.mark.asyncio\n    async def test_send_returns_false_when_no_connection(self):\n        from src.api.websocket import WebSocketManager\n        manager = WebSocketManager()\n        result = await manager.send(\"unknown-id\", {\"type\": \"test\"})\n        assert result is False\n\n    @pytest.mark.asyncio\n    async def test_connect_and_send(self):\n        from src.api.websocket import WebSocketManager\n        manager = WebSocketManager()\n        mock_ws = AsyncMock()\n        await manager.connect(\"q1\", mock_ws)\n        result = await manager.send(\"q1\", {\"type\": \"test\"})\n        assert result is True\n        mock_ws.send_json.assert_called_once_with({\"type\": \"test\"})\n\n    @pytest.mark.asyncio\n    async def test_disconnect_removes_connection(self):\n        from src.api.websocket import WebSocketManager\n        manager = WebSocketManager()\n        mock_ws = AsyncMock()\n        await manager.connect(\"q1\", mock_ws)\n        await manager.disconnect(\"q1\")\n        result = await manager.send(\"q1\", {\"type\": \"test\"})\n        assert result is False\n\n    @pytest.mark.asyncio\n    async def test_send_disconnects_on_send_failure(self):\n        from src.api.websocket import WebSocketManager\n        manager = WebSocketManager()\n        mock_ws = AsyncMock()\n        mock_ws.send_json = AsyncMock(side_effect=Exception(\"broken pipe\"))\n        await manager.connect(\"q1\", mock_ws)\n        result = await manager.send(\"q1\", {\"type\": \"test\"})\n        assert result is False\n        assert \"q1\" not in manager._connections\n\n    @pytest.mark.asyncio\n    async def test_broadcast_error_reaches_all_connections(self):\n        from src.api.websocket import WebSocketManager\n        manager = WebSocketManager()\n        ws1, ws2 = AsyncMock(), AsyncMock()\n        await manager.connect(\"q1\", ws1)\n        await manager.connect(\"q2\", ws2)\n        await manager.broadcast_error(\"system failure\")\n        assert ws1.send_json.called\n        assert ws2.send_json.called\n\n\nclass TestProcessQuery:\n    @pytest.mark.asyncio\n    async def test_happy_path_saves_to_db_and_sends_complete(self):\n        from src.api.websocket import process_query\n        from src.models.schemas import OrchestratorResponse\n\n        mock_response = OrchestratorResponse(\n            summary=\"Answer\",\n            detailed_analysis=\"Detail\",\n            agents_consulted=[\"staffing\"],\n            overall_confidence=\"high\",\n        )\n        mock_orchestrator = AsyncMock()\n        mock_orchestrator.process_with_streaming = AsyncMock(return_value=mock_response)\n        mock_db = AsyncMock()\n        mock_ws_manager = AsyncMock()\n        mock_ws_manager.send = AsyncMock(return_value=True)\n        mock_ws = MagicMock()\n\n        await process_query(\n            \"q-123\", mock_ws, \"staffing query\",\n            mock_orchestrator, AsyncMock(), mock_db, mock_ws_manager,\n        )\n\n        # Verify query was saved twice (initial + update with confidence)\n        assert mock_db.save_query.call_count == 2\n        mock_db.save_orchestrator_response.assert_called_once()\n\n        # Verify response_complete message sent\n        sent_calls = mock_ws_manager.send.call_args_list\n        types = [call[0][1].get(\"type\") for call in sent_calls]\n        assert \"response_complete\" in types\n\n    @pytest.mark.asyncio\n    async def test_orchestrator_error_sends_error_message(self):\n        from src.api.websocket import process_query\n\n        mock_orchestrator = AsyncMock()\n        mock_orchestrator.process_with_streaming = AsyncMock(side_effect=RuntimeError(\"LLM error\"))\n        mock_db = AsyncMock()\n        mock_ws_manager = AsyncMock()\n        mock_ws_manager.send = AsyncMock(return_value=True)\n\n        await process_query(\n            \"q-err\", MagicMock(), \"query\",\n            mock_orchestrator, AsyncMock(), mock_db, mock_ws_manager,\n        )\n\n        sent_calls = mock_ws_manager.send.call_args_list\n        types = [call[0][1].get(\"type\") for call in sent_calls]\n        assert \"error\" in types\n```\n\n---\n\n#### 10. `src/agents/base.py` — **0% tested**\n\nUntested: `GenericAgent.build_prompt` (with/without context), `GenericAgent.process` raises `NotImplementedError`.\n\n```python\n# tests/test_base_agent.py\nimport pytest\n\n\nclass TestGenericAgent:\n    def test_build_prompt_without_context(self):\n        from src.agents.base import GenericAgent\n        agent = GenericAgent(\"test\", \"Test Agent\", \"test domain\", \"You are a test agent.\")\n        prompt = agent.build_prompt(\"what is the policy?\")\n        assert \"what is the policy?\" in prompt\n        assert \"You are a test agent.\" in prompt\n\n    def test_build_prompt_with_context(self):\n        from src.agents.base import GenericAgent\n        agent = GenericAgent(\"test\", \"Test Agent\", \"test domain\", \"System prompt.\")\n        prompt = agent.build_prompt(\"query\", policy_context=\"Policy excerpt here.\")\n        assert \"Policy excerpt here.\" in prompt\n        assert \"query\" in prompt\n\n    @pytest.mark.asyncio\n    async def test_process_raises_not_implemented(self):\n        from src.agents.base import GenericAgent\n        agent = GenericAgent(\"test\", \"Test\", \"domain\", \"prompt\")\n        with pytest.raises(NotImplementedError):\n            await agent.process(\"query\")\n\n    def test_properties_accessible(self):\n        from src.agents.base import GenericAgent\n        agent = GenericAgent(\"my-id\", \"Display\", \"Domain desc\", \"Prompt\")\n        assert agent.agent_id == \"my-id\"\n        assert agent.display_name == \"Display\"\n        assert agent.domain_description == \"Domain desc\"\n        assert agent.system_prompt == \"Prompt\"\n```\n\n---\n\n### Summary of all gaps\n\n| Module | Coverage estimate | Critical gaps |\n|---|---|---|\n| `src/llm/client.py` | 0% | Missing API key, rate-limit retry/exhaust, blocked content, `chat_parsed` JSON error |\n| `src/agents/orchestrator.py` | 0% | JSON parse fallback, citation deduplication, routing LLM failure, specialist exception capture |\n| `src/agents/specialist.py` | 0% | `_load_instruments` filtering, partial fetch failure, `_parse_response` fallback |\n| `src/fetch/engine.py` | ~20% | Stale fallback, `FetchError` on no stale, URL normalization, batch