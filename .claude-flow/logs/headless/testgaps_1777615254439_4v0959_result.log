t = agent._parse_response(raw, 0, 0, [])\n        assert result.confidence == \"low\"\n        assert result.findings == raw\n\n    def test_json_embedded_in_preamble_is_extracted(self):\n        \"\"\"LLM sometimes wraps JSON in prose — the extractor strips it.\"\"\"\n        from src.agents.specialist import SpecialistAgent\n\n        agent = SpecialistAgent.__new__(SpecialistAgent)\n        agent._agent_id = \"staffing\"\n\n        preamble = \"Sure, here is the response: \"\n        payload = {\"agent_id\": \"staffing\", \"findings\": \"ok\", \"citations\": [], \"confidence\": \"medium\"}\n        raw = preamble + json.dumps(payload)\n\n        result = agent._parse_response(raw, 0, 0, [])\n        assert result.confidence == \"medium\"\n\n    def test_failed_instruments_are_recorded(self):\n        from src.agents.specialist import SpecialistAgent\n\n        agent = SpecialistAgent.__new__(SpecialistAgent)\n        agent._agent_id = \"ohs\"\n\n        raw = json.dumps({\"findings\": \"limited info\", \"citations\": [], \"confidence\": \"low\"})\n        result = agent._parse_response(raw, 3, 1, [\"Instrument A\", \"Instrument B\"])\n        assert result.retrieval_status.instruments_failed == [\"Instrument A\", \"Instrument B\"]\n        assert result.retrieval_status.instruments_attempted == 3\n\n\n@pytest.mark.asyncio\nclass TestSpecialistAgentProcessWithFetch:\n    async def test_process_without_fetch_engine(self):\n        \"\"\"process_with_fetch with fetch_engine=None skips retrieval.\"\"\"\n        from src.agents.specialist import SpecialistAgent\n\n        agent = SpecialistAgent.__new__(SpecialistAgent)\n        agent._agent_id = \"governance\"\n        agent._instruments = []\n        agent._system_prompt = \"You are a governance specialist.\"\n        agent._llm_client = AsyncMock()\n        agent._llm_client.chat.return_value = json.dumps({\n            \"findings\": \"No specific instruments retrieved.\",\n            \"citations\": [],\n            \"confidence\": \"low\",\n        })\n\n        result = await agent.process_with_fetch(\"What is the Values and Ethics Code?\", None)\n        assert result.agent_id == \"governance\"\n\n    async def test_fetch_errors_are_caught_per_instrument(self):\n        \"\"\"If fetch fails for one instrument, others still proceed.\"\"\"\n        from src.fetch.engine import FetchError\n        from src.agents.specialist import SpecialistAgent\n\n        agent = SpecialistAgent.__new__(SpecialistAgent)\n        agent._agent_id = \"staffing\"\n        agent._instruments = [\n            {\"url\": \"https://bad.example.com/doc\", \"title\": \"Bad Doc\", \"type\": \"Directive\"},\n            {\"url\": \"https://good.example.com/doc\", \"title\": \"Good Doc\", \"type\": \"Policy\"},\n        ]\n        agent._system_prompt = \"You are staffing.\"\n        agent._llm_client = AsyncMock()\n        agent._llm_client.chat.return_value = json.dumps({\n            \"findings\": \"partial findings\",\n            \"citations\": [],\n            \"confidence\": \"medium\",\n        })\n\n        mock_fetch = AsyncMock()\n        mock_fetch.fetch.side_effect = lambda url: (\n            asyncio.coroutine(lambda: (_ for _ in ()).throw(FetchError(\"timeout\")))()\n            if \"bad\" in url else asyncio.coroutine(lambda: \"good content\")()\n        )\n\n        result = await agent.process_with_fetch(\"staffing query\", mock_fetch)\n        assert \"Bad Doc\" in result.retrieval_status.instruments_failed\n\n\n# ---------------------------------------------------------------------------\n# 7. ORCHESTRATOR AGENT\n# ---------------------------------------------------------------------------\n\nclass TestOrchestratorBuildSynthesisPrompt:\n    def test_includes_query_and_agent_findings(self):\n        from src.agents.orchestrator import OrchestratorAgent\n\n        agent = OrchestratorAgent.__new__(OrchestratorAgent)\n        specialist_responses = [\n            {\n                \"agent_id\": \"staffing\",\n                \"findings\": \"External posting is allowed under s.30 PSEA.\",\n                \"confidence\": \"high\",\n                \"citations\": [{\"instrument_title\": \"PSEA\", \"url\": \"https://ex.com\", \"relevant_section\": \"s.30\"}],\n            }\n        ]\n        prompt = agent._build_synthesis_prompt(\"Can I post externally?\", specialist_responses)\n        assert \"Can I post externally?\" in prompt\n        assert \"STAFFING\" in prompt.upper()\n        assert \"External posting\" in prompt\n\n    def test_handles_empty_specialist_responses(self):\n        from src.agents.orchestrator import OrchestratorAgent\n\n        agent = OrchestratorAgent.__new__(OrchestratorAgent)\n        prompt = agent._build_synthesis_prompt(\"What are the leave provisions?\", [])\n        assert \"What are the leave provisions?\" in prompt\n\n\nclass TestOrchestratorAggregateCitations:\n    def test_deduplicates_by_title_and_url(self):\n        from src.agents.orchestrator import OrchestratorAgent\n\n        agent = OrchestratorAgent.__new__(OrchestratorAgent)\n        responses = [\n            {\"agent_id\": \"staffing\", \"citations\": [{\"instrument_title\": \"PSEA\", \"url\": \"https://ex.com\", \"instrument_type\": \"Act\"}]},\n            {\"agent_id\": \"labour\", \"citations\": [{\"instrument_title\": \"PSEA\", \"url\": \"https://ex.com\", \"instrument_type\": \"Act\"}]},\n        ]\n        citations = agent._aggregate_citations(responses)\n        assert len(citations) == 1  # deduped\n\n    def test_preserves_different_instruments(self):\n        from src.agents.orchestrator import OrchestratorAgent\n\n        agent = OrchestratorAgent.__new__(OrchestratorAgent)\n        responses = [\n            {\"agent_id\": \"staffing\", \"citations\": [{\"instrument_title\": \"PSEA\", \"url\": \"https://ex.com/psea\", \"instrument_type\": \"Act\"}]},\n            {\"agent_id\": \"labour\", \"citations\": [{\"instrument_title\": \"FPSLRA\", \"url\": \"https://ex.com/fpslra\", \"instrument_type\": \"Act\"}]},\n        ]\n        citations = agent._aggregate_citations(responses)\n        assert len(citations) == 2\n\n    def test_sourced_from_agent_is_set(self):\n        from src.agents.orchestrator import OrchestratorAgent\n\n        agent = OrchestratorAgent.__new__(OrchestratorAgent)\n        responses = [\n            {\"agent_id\": \"equity\", \"citations\": [{\"instrument_title\": \"EEA\", \"url\": \"https://ex.com\", \"instrument_type\": \"Act\"}]},\n        ]\n        citations = agent._aggregate_citations(responses)\n        assert citations[0].sourced_from_agent == \"equity\"\n\n\n@pytest.mark.asyncio\nclass TestOrchestratorProcess:\n    async def test_process_parses_valid_json(self):\n        from src.agents.orchestrator import OrchestratorAgent\n\n        agent = OrchestratorAgent.__new__(OrchestratorAgent)\n        agent._llm_client = AsyncMock()\n        agent._llm_client.chat.return_value = json.dumps({\n            \"summary\": \"You may post externally.\",\n            \"detailed_analysis\": \"Under s.30 of the PSEA...\",\n            \"policy_tensions\": None,\n            \"citations\": [],\n            \"gaps_and_limitations\": None,\n            \"recommended_consultation\": None,\n            \"agents_consulted\": [\"staffing\"],\n            \"overall_confidence\": \"high\",\n        })\n\n        specialist_responses = [{\"agent_id\": \"staffing\", \"findings\": \"ok\", \"confidence\": \"high\", \"citations\": []}]\n        result = await agent.process(\"External posting?\", specialist_responses)\n        assert result.summary == \"You may post externally.\"\n        assert result.overall_confidence == \"high\"\n\n    async def test_process_returns_error_response_on_bad_json(self):\n        from src.agents.orchestrator import OrchestratorAgent\n\n        agent = OrchestratorAgent.__new__(OrchestratorAgent)\n        agent._llm_client = AsyncMock()\n        agent._llm_client.chat.return_value = \"Not valid JSON at all.\"\n\n        result = await agent.process(\"query\", [])\n        assert result.overall_confidence == \"low\"\n        assert \"error\" in result.summary.lower()\n\n    async def test_process_strips_json_from_preamble(self):\n        \"\"\"JSON buried after LLM preamble text is still extracted.\"\"\"\n        from src.agents.orchestrator import OrchestratorAgent\n\n        agent = OrchestratorAgent.__new__(OrchestratorAgent)\n        agent._llm_client = AsyncMock()\n        payload = {\n            \"summary\": \"Direct answer.\",\n            \"detailed_analysis\": \"Details.\",\n            \"citations\": [],\n            \"agents_consulted\": [\"governance\"],\n            \"overall_confidence\": \"medium\",\n        }\n        agent._llm_client.chat.return_value = \"Here is my response:\\n\" + json.dumps(payload)\n\n        result = await agent.process(\"query\", [])\n        assert result.summary == \"Direct answer.\"\n\n\n@pytest.mark.asyncio\nclass TestOrchestratorRoute:\n    async def test_route_returns_all_agents_on_llm_failure(self):\n        from src.agents.orchestrator import OrchestratorAgent\n\n        agent = OrchestratorAgent.__new__(OrchestratorAgent)\n        agent._specialist_agent_ids = [\"staffing\", \"labour\", \"governance\"]\n        agent._llm_client = AsyncMock()\n        agent._llm_client.chat.side_effect = Exception(\"LLM unavailable\")\n\n        result = await agent._route(\"What is the leave policy?\")\n        assert set(result[\"selected_agents\"]) == {\"staffing\", \"labour\", \"governance\"}\n\n    async def test_route_parses_valid_json_selection(self):\n        from src.agents.orchestrator import OrchestratorAgent\n\n        agent = OrchestratorAgent.__new__(OrchestratorAgent)\n        agent._specialist_agent_ids = [\"staffing\", \"labour\"]\n        agent._llm_client = AsyncMock()\n        agent._llm_client.chat.return_value = json.dumps({\n            \"selected_agents\": [\"staffing\"],\n            \"routing_rationale\": \"Only staffing is relevant.\",\n            \"sub_queries\": {\"staffing\": \"focused question\"},\n        })\n\n        result = await agent._route(\"Can I hire students?\")\n        assert result[\"selected_agents\"] == [\"staffing\"]\n\n\n# ---------------------------------------------------------------------------\n# 8. DATABASE MANAGER\n# ---------------------------------------------------------------------------\n\n@pytest.fixture\ndef tmp_db(tmp_path):\n    from src.data.db import DatabaseManager\n\n    db = DatabaseManager(db_path=tmp_path / \"test.db\")\n    return db\n\n\n@pytest.mark.asyncio\nclass TestDatabaseManagerFull:\n    async def test_save_and_get_agent_response(self, tmp_db):\n        from src.models.schemas import AgentResponseRecord, CitationItem, RetrievalStatus\n\n        await tmp_db.initialize()\n        qid = str(uuid.uuid4())\n        # Must save parent query first due to FK constraint\n        from src.models.schemas import QueryRecord\n        await tmp_db.save_query(QueryRecord(query_id=qid, query_text=\"test\"))\n\n        record = AgentResponseRecord(\n            response_id=str(uuid.uuid4()),\n            query_id=qid,\n            agent_id=\"staffing\",\n            findings=\"Some findings.\",\n            citations=[CitationItem(instrument_title=\"PSEA\", instrument_type=\"Act\")],\n            confidence=\"medium\",\n        )\n        await tmp_db.save_agent_response(record)\n        results = await tmp_db.get_agent_responses(qid)\n        assert len(results) == 1\n        assert results[0].agent_id == \"staffing\"\n\n    async def test_save_and_get_orchestrator_response(self, tmp_db):\n        from src.models.schemas import OrchestratorResponseRecord, QueryRecord\n\n        await tmp_db.initialize()\n        qid = str(uuid.uuid4())\n        await tmp_db.save_query(QueryRecord(query_id=qid, query_text=\"test\"))\n\n        record = OrchestratorResponseRecord(\n            response_id=str(uuid.uuid4()),\n            query_id=qid,\n            summary=\"Short answer.\",\n            overall_confidence=\"high\",\n        )\n        await tmp_db.save_orchestrator_response(record)\n        result = await tmp_db.get_orchestrator_response(qid)\n        assert result is not None\n        assert result.summary == \"Short answer.\"\n\n    async def test_get_orchestrator_response_returns_none_for_missing(self, tmp_db):\n        await tmp_db.initialize()\n        result = await tmp_db.get_orchestrator_response(\"nonexistent-id\")\n        assert result is None\n\n    async def test_save_and_get_feedback(self, tmp_db):\n        from src.models.schemas import FeedbackRecord, QueryRecord\n\n        await tmp_db.initialize()\n        qid = str(uuid.uuid4())\n        await tmp_db.save_query(QueryRecord(query_id=qid, query_text=\"test\"))\n\n        record = FeedbackRecord(\n            feedback_id=str(uuid.uuid4()),\n            query_id=qid,\n            rating=\"accurate\",\n            comment=\"Very helpful.\",\n        )\n        await tmp_db.save_feedback(record)\n        result = await tmp_db.get_feedback_for_query(qid)\n        assert result is not None\n        assert result.rating == \"accurate\"\n\n    async def test_export_feedback_returns_list(self, tmp_db):\n        await tmp_db.initialize()\n        result = await tmp_db.export_feedback()\n        assert isinstance(result, list)\n\n    async def test_list_queries_respects_limit(self, tmp_db):\n        from src.models.schemas import QueryRecord\n\n        await tmp_db.initialize()\n        for i in range(5):\n            await tmp_db.save_query(QueryRecord(query_id=str(uuid.uuid4()), query_text=f\"q{i}\"))\n\n        results = await tmp_db.list_queries(limit=3)\n        assert len(results) == 3\n\n    async def test_set_and_get_cached(self, tmp_db):\n        from src.models.schemas import FetchCacheEntry\n\n        await tmp_db.initialize()\n        entry = FetchCacheEntry(\n            url=\"https://example.com/page\",\n            content_text=\"policy text\",\n            content_hash=\"abc123\",\n            ttl_hours=168,\n            status_code=200,\n            content_length=100,\n        )\n        await tmp_db.set_cached(entry)\n        result = await tmp_db.get_cached(\"https://example.com/page\")\n        assert result is not None\n        assert result.content_text == \"policy text\"\n\n    async def test_get_stale_returns_expired_entry(self, tmp_db):\n        \"\"\"get_stale() returns entries regardless of TTL expiry.\"\"\"\n        from src.models.schemas import FetchCacheEntry\n\n        await tmp_db.initialize()\n        past = (datetime.utcnow() - timedelta(hours=200)).isoformat()\n        entry = FetchCacheEntry(\n            url=\"https://example.com/stale\",\n            content_text=\"old content\",\n            content_hash=\"def456\",\n            fetched_at=datetime.utcnow() - timedelta(hours=200),\n            ttl_hours=1,  # expired\n        )\n        await tmp_db.set_cached(entry)\n        # get_cached should return None (expired)\n        fresh = await tmp_db.get_cached(\"https://example.com/stale\")\n        assert fresh is None\n        # get_stale should return it anyway\n        stale = await tmp_db.get_stale(\"https://example.com/stale\")\n        assert stale is not None\n        assert stale.content_text == \"old content\"\n\n    async def test_clear_expired_removes_old_entries(self, tmp_db):\n        from src.models.schemas import FetchCacheEntry\n\n        await tmp_db.initialize()\n        entry = FetchCacheEntry(\n            url=\"https://example.com/old\",\n            content_text=\"old\",\n            content_hash=\"aaa\",\n            fetched_at=datetime.utcnow() - timedelta(hours=200),\n            ttl_hours=1,\n        )\n        await tmp_db.set_cached(entry)\n        count = await tmp_db.clear_expired()\n        assert count >= 1\n\n\n# ---------------------------------------------------------------------------\n# 9. API ROUTES\n# ---------------------------------------------------------------------------\n\n@pytest.fixture\ndef test_client(tmp_path, monkeypatch):\n    \"\"\"FastAPI TestClient with in-memory DB.\"\"\"\n    monkeypatch.setenv(\"GEMINI_API_KEY\", \"fake-key\")\n    from fastapi.testclient import TestClient\n    from src.main import app\n\n    return TestClient(app)\n\n\nclass TestApiRoutes:\n    def test_list_agents_returns_8_agents(self, test_client):\n        response = test_client.get(\"/api/agents\")\n        assert response.status_code == 200\n        agents = response.json()\n        assert len(agents) == 8\n        agent_ids = {a[\"agent_id\"] for a in agents}\n        assert \"staffing\" in agent_ids\n        assert \"governance\" in agent_ids\n\n    def test_list_queries_returns_list(self, test_client):\n        response = test_client.get(\"/api/queries\")\n        assert response.status_code == 200\n        assert isinstance(response.json(), list)\n\n    def test_list_queries_limit_out_of_range(self, test_client):\n        response = test_client.get(\"/api/queries?limit=0\")\n        assert response.status_code == 422  # FastAPI validation error\n\n    def test_get_query_404_for_unknown_id(self, test_client):\n        response = test_client.get(\"/api/queries/nonexistent-query-id\")\n        assert response.status_code == 404\n\n    def test_submit_feedback(self, test_client):\n        \"\"\"Submitting feedback for a non-existent query still returns 200 (FK not enforced in SQLite).\"\"\"\n        payload = {\n            \"feedback_id\": str(uuid.uuid4()),\n            \"query_id\": str(uuid.uuid4()),\n            \"rating\": \"accurate\",\n            \"comment\": \"Good answer\",\n            \"timestamp\": datetime.utcnow().isoformat(),\n        }\n        response = test_client.post(\"/api/feedback\", json=payload)\n        # Either 200 (success) or 500 (FK constraint in SQLite) — document actual behavior\n        assert response.status_code in (200, 500)\n\n    def test_export_feedback_returns_list(self, test_client):\n        response = test_client.get(\"/api/feedback/export\")\n        assert response.status_code == 200\n        assert isinstance(response.json(), list)\n\n\n# ---------------------------------------------------------------------------\n# 10. WEBSOCKET MANAGER\n# ---------------------------------------------------------------------------\n\n@pytest.mark.asyncio\nclass TestWebSocketManager:\n    async def test_send_to_unknown_query_returns_false(self):\n        from src.api.websocket import WebSocketManager\n\n        manager = WebSocketManager()\n        result = await manager.send(\"nonexistent-id\", {\"type\": \"test\"})\n        assert result is False\n\n    async def test_disconnect_removes_connection(self):\n        from src.api.websocket import WebSocketManager\n\n        manager = WebSocketManager()\n        mock_ws = AsyncMock()\n        await manager.connect(\"q1\", mock_ws)\n        assert \"q1\" in manager._connections\n        await manager.disconnect(\"q1\")\n        assert \"q1\" not in manager._connections\n\n    async def test_disconnect_nonexistent_is_safe(self):\n        from src.api.websocket import WebSocketManager\n\n        manager = WebSocketManager()\n        await manager.disconnect(\"does-not-exist\")  # must not raise\n\n    async def test_broadcast_error_sends_to_all_connections(self):\n        from src.api.websocket import WebSocketManager\n\n        manager = WebSocketManager()\n        ws1 = AsyncMock()\n        ws2 = AsyncMock()\n        await manager.connect(\"q1\", ws1)\n        await manager.connect(\"q2\", ws2)\n        await manager.broadcast_error(\"system error\")\n        ws1.send_json.assert_awaited_once()\n        ws2.send_json.assert_awaited_once()\n\n\n# ---------------------------------------------------------------------------\n# 11. INTEGRATION — full pipeline (mocked LLM)\n# ---------------------------------------------------------------------------\n\n@pytest.mark.asyncio\nclass TestFullPipelineIntegration:\n    \"\"\"End-to-end pipeline with LLM mocked but real DB, cache, and extractor.\"\"\"\n\n    async def test_orchestrator_with_mocked_llm_and_real_db(self, tmp_path):\n        \"\"\"Runs a full query through orchestrator → specialists → synthesis.\"\"\"\n        from src.agents.orchestrator import OrchestratorAgent\n        from src.agents.specialist import SpecialistAgent, _SPECIALIST_METADATA\n\n        specialist_payload = json.dumps({\n            \"agent_id\": \"staffing\",\n            \"findings\": \"External posting permitted under s.30 PSEA.\",\n            \"citations\": [{\"instrument_title\": \"PSEA\", \"instrument_type\": \"Act\"}],\n            \"confidence\": \"high\",\n        })\n        orchestrator_payload = json.dumps({\n            \"summary\": \"External posting is permitted.\",\n            \"detailed_analysis\": \"s.30 PSEA allows it.\",\n            \"citations\": [],\n            \"agents_consulted\": [\"staffing\"],\n            \"overall_confidence\": \"high\",\n        })\n        routing_payload = json.dumps({\n            \"selected_agents\": [\"staffing\"],\n            \"routing_rationale\": \"Staffing domain.\",\n            \"sub_queries\": {\"staffing\": \"Can I post externally?\"},\n        })\n\n        mock_llm = AsyncMock()\n        mock_llm.chat.side_effect = [\n            routing_payload,      # _route call\n            specialist_payload,   # specialist LLM call\n            orchestrator_payload, # synthesis call\n        ]\n\n        with patch(\"src.agents.orchestrator.get_client\", return_value=mock_llm), \\\n             patch(\"src.agents.specialist.get_client\", return_value=mock_llm):\n\n            status_updates = []\n\n            async def record_status(update):\n                status_updates.append(update)\n\n            orch = OrchestratorAgent()\n            result = await orch.process_with_streaming(\n                \"Can I post a position externally?\",\n                None,  # no fetch engine — skips live retrieval\n                record_status,\n            )\n\n        assert result.overall_confidence == \"high\"\n        agent_ids_seen = {u.agent_id for u in status_updates}\n        assert \"orchestrator\" in agent_ids_seen\n```\n\n---\n\n## Summary of gaps and priority\n\n| Priority | Gap | Reason |\n|---|---|---|\n| **Critical** | `_aggregate_citations()` deduplication | Silently produces duplicate citations in responses |\n| **Critical** | `_route()` fallback to all agents | LLM failure silently invokes all 8 specialists — expensive and untested |\n| **Critical** | `_parse_response()` JSON fallback path | Raw LLM text leaks into `findings` field with no validation |\n| **High** | Stale cache fallback in `_do_fetch()` | The entire resilience mechanism for transient network failures is untested |\n| **High** | `GeminiClient._generate()` retry logic | Rate-limit retry with exponential backoff is the only guard against API exhaustion |\n| **High** | All `DatabaseManager` write/read methods except `save_query` / `get_query` | Feedback, orchestrator responses, agent responses never verified round-trip |\n| **Medium** | `_normalize_url()` for laws-lois | URL rewriting for full-text retrieval is a subtle correctness concern |\n| **Medium** | All REST API endpoints | No contract tests for `/api/queries/{id}` 404, feedback submit, export |\n| **Medium** | `WebSocketManager` send/broadcast | Core real-time channel is completely untested |\n| **Low** | Schema models (`WSError`, `WSAgentStatusUpdate`, etc.) | Missing serialization contract tests |\n",
