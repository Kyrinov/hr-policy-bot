        "code": "# tests/test_fetch_engine.py\n\"\"\"FetchEngine unit tests — URL normalization, domain extraction, batch errors.\"\"\"\nimport pytest\n\nfrom src.fetch.engine import FetchEngine, FetchError\n\n\nclass TestNormalizeUrl:\n    def setup_method(self):\n        self.engine = FetchEngine()\n\n    def test_laws_lois_bilingual_rewrite(self):\n        # laws-lois serves bilingual HTML — engine should prefer English\n        url = \"https://laws-lois.justice.gc.ca/eng/acts/P-33.01/\"\n        result = self.engine._normalize_url(url)\n        assert \"laws-lois.justice.gc.ca\" in result\n\n    def test_non_laws_url_unchanged(self):\n        url = \"https://www.tbs-sct.gc.ca/pol/doc-eng.aspx?id=19134\"\n        assert self.engine._normalize_url(url) == url\n\n\nclass TestGetDomain:\n    def setup_method(self):\n        self.engine = FetchEngine()\n\n    def test_extracts_hostname(self):\n        assert self.engine._get_domain(\"https://www.tbs-sct.gc.ca/pol/\") == \"www.tbs-sct.gc.ca\"\n\n    def test_different_subdomains_are_separate(self):\n        d1 = self.engine._get_domain(\"https://api.example.com/\")\n        d2 = self.engine._get_domain(\"https://www.example.com/\")\n        assert d1 != d2\n\n\nclass TestFetchBatch:\n    @pytest.mark.asyncio\n    async def test_partial_failures_isolated(self, mocker):\n        engine = FetchEngine()\n        call_count = {\"n\": 0}\n\n        async def mock_fetch(url):\n            call_count[\"n\"] += 1\n            if \"bad\" in url:\n                raise FetchError(f\"failed: {url}\")\n            return f\"content of {url}\"\n\n        mocker.patch.object(engine, \"fetch\", side_effect=mock_fetch)\n\n        results = await engine.fetch_batch([\n            \"https://good.com/page\",\n            \"https://bad.com/page\",\n        ])\n        assert \"https://good.com/page\" in results\n        assert results[\"https://good.com/page\"] == \"content of https://good.com/page\"\n        assert \"https://bad.com/page\" not in results\n\n    @pytest.mark.asyncio\n    async def test_empty_batch_returns_empty(self):\n        engine = FetchEngine()\n        results = await engine.fetch_batch([])\n        assert results == {}"
