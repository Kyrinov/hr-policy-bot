        "language": "python",
        "code": "# tests/test_fetch_cache.py\nimport pytest\nimport asyncio\nfrom datetime import datetime, timedelta, timezone\nfrom unittest.mock import AsyncMock, patch\nfrom src.fetch.cache import FetchCache, CacheEntry\n\n\ndef test_cache_entry_valid_within_ttl():\n    entry = CacheEntry(\n        url=\"https://example.com\",\n        content=\"data\",\n        fetched_at=datetime.now(tz=timezone.utc),\n        ttl_seconds=3600,\n    )\n    assert entry.is_valid() is True\n\n\ndef test_cache_entry_expired_outside_ttl():\n    entry = CacheEntry(\n        url=\"https://example.com\",\n        content=\"data\",\n        fetched_at=datetime.now(tz=timezone.utc) - timedelta(seconds=7200),\n        ttl_seconds=3600,\n    )\n    assert entry.is_valid() is False\n\n\ndef test_cache_entry_just_expired():\n    entry = CacheEntry(\n        url=\"https://example.com\",\n        content=\"data\",\n        fetched_at=datetime.now(tz=timezone.utc) - timedelta(seconds=3601),\n        ttl_seconds=3600,\n    )\n    assert entry.is_valid() is False\n\n\n@pytest.mark.asyncio\nasync def test_get_returns_none_for_expired(tmp_path):\n    cache = FetchCache(db_path=str(tmp_path / \"cache.db\"))\n    await cache.initialize()\n    await cache.store(\"https://example.com\", \"content\", ttl_seconds=1)\n    await asyncio.sleep(1.1)\n    result = await cache.get(\"https://example.com\")\n    assert result is None\n\n\n@pytest.mark.asyncio\nasync def test_get_stale_returns_expired_content(tmp_path):\n    cache = FetchCache(db_path=str(tmp_path / \"cache.db\"))\n    await cache.initialize()\n    await cache.store(\"https://example.com\", \"stale content\", ttl_seconds=1)\n    await asyncio.sleep(1.1)\n    result = await cache.get_stale(\"https://example.com\")\n    assert result == \"stale content\"\n\n\n@pytest.mark.asyncio\nasync def test_ttl_by_domain():\n    \"\"\"laws-lois.justice.gc.ca should get a longer TTL than default.\"\"\"\n    cache = FetchCache(db_path=\":memory:\")\n    laws_ttl = cache._get_default_ttl(\"https://laws-lois.justice.gc.ca/act\")\n    other_ttl = cache._get_default_ttl(\"https://example.com\")\n    assert laws_ttl >= other_ttl  # Legal texts change rarely\n\n\n@pytest.mark.asyncio\nasync def test_clear_expired_removes_old_entries(tmp_path):\n    cache = FetchCache(db_path=str(tmp_path / \"cache.db\"))\n    await cache.initialize()\n    await cache.store(\"https://a.com\", \"a\", ttl_seconds=1)\n    await cache.store(\"https://b.com\", \"b\", ttl_seconds=9999)\n    await asyncio.sleep(1.1)\n    await cache.clear_expired()\n    assert await cache.get_stale(\"https://a.com\") is None\n    assert await cache.get(\"https://b.com\") == \"b\""
      },
