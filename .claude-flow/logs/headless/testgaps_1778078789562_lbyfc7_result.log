        "title": "5. `ContentExtractor` — missing branches",
        "content": "\n**Untested:**\n- Truncation at `max_length` appends `\"...\"`\n- URL with no matching domain selector falls through to `default`\n- Missing `<main>` falls back to `<body>`\n- Heading elements formatted with newlines in `_format_content`\n- `_load_selectors()` failure gracefully returns defaults\n\n```python\n",
        "level": 4
      },
      {
        "title": "tests/test_fetch/test_extractors.py",
        "content": "\nimport pytest\nfrom src.fetch.extractors import ContentExtractor\n\n\nclass TestContentExtractorTruncation:\n    def setup_method(self):\n        self.extractor = ContentExtractor()\n\n    def test_truncation_adds_ellipsis(self):\n        long_html = f\"<html><body><p>{'x' * 50000}</p></body></html>\"\n        result = self.extractor.extract(\"https://example.com\", long_html, max_length=100)\n        assert result.endswith(\"...\")\n        assert len(result) == 100\n\n    def test_no_truncation_when_within_limit(self):\n        html = \"<html><body><p>Short text.</p></body></html>\"\n        result = self.extractor.extract(\"https://example.com\", html, max_length=1000)\n        assert \"Short text.\" in result\n        assert not result.endswith(\"...\")\n\n\nclass TestContentExtractorSelectors:\n    def setup_method(self):\n        self.extractor = ContentExtractor()\n\n    def test_fallback_to_body_when_no_main(self):\n        html = \"<html><body><p>Body content.</p></body></html>\"\n        result = self.extractor.extract(\"https://unknown.example.com\", html)\n        assert \"Body content.\" in result\n\n    def test_headings_extracted(self):\n        html = \"<html><body><main><h2>Policy Section</h2><p>Details.</p></main></body></html>\"\n        result = self.extractor.extract(\"https://tbs-sct.canada.ca/test\", html)\n        assert \"Policy Section\" in result\n\n    def test_unknown_domain_uses_default_selectors(self):\n        html = \"<html><body><main><p>Main content.</p></main></body></html>\"\n        result = self.extractor.extract(\"https://totally-unknown-domain.ca/page\", html)\n        assert \"Main content.\" in result\n\n    def test_load_selectors_failure_returns_defaults(self):\n        extractor = ContentExtractor(selectors_path=\"/nonexistent/path.yaml\")\n        html = \"<html><body><p>Fallback content.</p></body></html>\"\n        result = extractor.extract(\"https://example.com\", html)\n        assert \"Fallback content.\" in result\n```\n\n---\n\n",
        "level": 1
      },
      {
        "title": "6. `FetchEngine` — zero error path tests",
        "content": "\n**Untested:**\n- `_normalize_url()` rewrites `laws-lois` act index URLs\n- `_get_domain()` on a malformed URL\n- `fetch_batch()` with a mix of successes and failures\n- `FetchError` raised when both httpx and browser fallback fail\n- Cache hit path in `_do_fetch()` skips network\n\n```python\n",
        "level": 4
      },
      {
        "title": "tests/test_fetch/test_engine.py",
        "content": "\nimport pytest\nfrom unittest.mock import AsyncMock, MagicMock, patch\nfrom src.fetch.engine import FetchEngine, FetchError\nfrom src.fetch.cache import CacheEntry\n\n\nclass TestURLNormalization:\n    def setup_method(self):\n        self.engine = FetchEngine()\n\n    def test_normalize_act_index_appends_fulltext(self):\n        url = \"https://laws-lois.justice.gc.ca/eng/acts/P-33.3/\"\n        assert self.engine._normalize_url(url).endswith(\"/FullText.html\")\n\n    def test_normalize_does_not_alter_fulltext_url(self):\n        url = \"https://laws-lois.justice.gc.ca/eng/acts/P-33.3/FullText.html\"\n        assert self.engine._normalize_url(url) == url\n\n    def test_normalize_non_laws_url_unchanged(self):\n        url = \"https://tbs-sct.canada.ca/pol/doc-eng.aspx?id=12345\"\n        assert self.engine._normalize_url(url) == url\n\n\nclass TestGetDomain:\n    def setup_method(self):\n        self.engine = FetchEngine()\n\n    def test_extracts_domain(self):\n        assert self.engine._get_domain(\"https://laws-lois.justice.gc.ca/eng/acts/\") == \"laws-lois.justice.gc.ca\"\n\n    def test_malformed_url_returns_default(self):\n        assert self.engine._get_domain(\"not-a-url\") == \"default\"\n\n\n@pytest.mark.asyncio\nclass TestFetchCache:\n    async def test_cache_hit_skips_http(self):\n        engine = FetchEngine()\n        cached_content = \"cached policy text\"\n        engine._cache.get = AsyncMock(\n            return_value=CacheEntry(url=\"https://x.com\", content=cached_content, ttl_hours=168)\n        )\n        engine._client.get = AsyncMock(side_effect=AssertionError(\"should not call HTTP\"))\n        engine._config.parsing.enabled = False  # suppress parsing side effect\n\n        result = await engine._do_fetch(\"https://x.com\")\n        assert result == cached_content\n\n\n@pytest.mark.asyncio\nclass TestFetchBatch:\n    async def test_batch_skips_failed_urls(self):\n        engine = FetchEngine()\n        async def fake_fetch(url):\n            if \"good\" in url:\n                return \"content\"\n            raise FetchError(\"bad url\")\n\n        engine.fetch = fake_fetch\n        results = await engine.fetch_batch([\"https://good.com\", \"https://bad.com\"])\n        assert \"https://good.com\" in results\n        assert \"https://bad.com\" not in results\n```\n\n---\n\n",
        "level": 1
