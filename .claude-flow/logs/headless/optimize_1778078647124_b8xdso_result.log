        "code": "async def save_policy_triples(self, triples: list[PolicyTriple]) -> None:\n    async with aiosqlite.connect(self._db_path) as db:\n        # Batch insert all triples\n        await db.executemany(\n            \"INSERT OR REPLACE INTO policy_triples (...) VALUES (...)\",\n            [self._triple_params(t) for t in triples],\n        )\n\n        # Deduplicate nodes, then batch upsert\n        node_params = {}\n        for t in triples:\n            for text in (t.subject, t.object_):\n                node_id = hashlib.sha256(text.lower().encode()).hexdigest()\n                node_params[node_id] = (node_id, text, None, t.source_url)\n        await db.executemany(\n            \"\"\"INSERT INTO graph_nodes (node_id, entity_text, entity_type, first_seen_url)\n               VALUES (?, ?, ?, ?)\n               ON CONFLICT(entity_text) DO UPDATE SET mention_count = mention_count + 1\"\"\",\n            list(node_params.values()),\n        )\n\n        # Batch insert edges\n        def _node_id(text: str) -> str:\n            return hashlib.sha256(text.lower().encode()).hexdigest()\n\n        await db.executemany(\n            \"INSERT OR REPLACE INTO graph_edges (...) VALUES (?, ?, ?, ?, ?, ?)\",\n            [\n                (\n                    f\"{t.triple_id}:edge\",\n                    _node_id(t.subject),\n                    t.predicate_lemma,\n                    _node_id(t.object_),\n                    t.triple_id,\n                    2.0 if \"CROSS_INSTRUMENT_CORROBORATION\" in t.validation_flags else 1.0,\n                )\n                for t in triples\n            ],\n        )\n        await db.commit()"
