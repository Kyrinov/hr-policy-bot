        "title": "tests/test_cache.py",
        "content": "import pytest\nfrom datetime import datetime, timedelta\nfrom src.fetch.cache import CacheEntry, FetchCache\nfrom unittest.mock import AsyncMock, MagicMock, patch\n\n\nclass TestCacheEntry:\n    def _make_entry(self, ttl_hours=168, fetched_at=None):\n        entry = CacheEntry(url=\"https://example.com\", content=\"text\", ttl_hours=ttl_hours)\n        entry.fetched_at = fetched_at or datetime.utcnow().isoformat()\n        return entry\n\n    def test_is_valid_returns_true_for_fresh_entry(self):\n        entry = self._make_entry(ttl_hours=168)\n        assert entry.is_valid() is True\n\n    def test_is_valid_returns_false_for_expired_entry(self):\n        past = (datetime.utcnow() - timedelta(hours=200)).isoformat()\n        entry = self._make_entry(ttl_hours=168, fetched_at=past)\n        assert entry.is_valid() is False\n\n    def test_content_hash_is_sha256_hex(self):\n        entry = self._make_entry()\n        entry.fetched_at = datetime.utcnow().isoformat()\n        assert len(entry.content_hash) == 64  # SHA-256 hex length\n\n\nclass TestFetchCacheGetDefaultTtl:\n    def setup_method(self):\n        with patch(\"src.fetch.cache.get_config\") as mock_config:\n            mock_config.return_value.cache.ttl_hours = 168\n            self.cache = FetchCache(db_manager=AsyncMock())\n\n    def test_legislation_url_gets_720h_ttl(self):\n        assert self.cache._get_default_ttl(\"https://laws-lois.justice.gc.ca/eng/acts/P-33.01/FullText.html\") == 720\n\n    def test_collective_agreement_url_gets_720h_ttl(self):\n        assert self.cache._get_default_ttl(\"https://tbs-sct.canada.ca/agreements-conventions/nreo-eng.aspx\") == 720\n\n    def test_standard_url_gets_default_ttl(self):\n        assert self.cache._get_default_ttl(\"https://tbs-sct.canada.ca/pol/doc-eng.aspx?id=32614\") == 168\n```\n\n---\n\n",
