ry\", [])\n        assert result.summary == \"Direct answer\"\n        assert result.overall_confidence == \"high\"\n\n    @pytest.mark.asyncio\n    async def test_strips_preamble_before_json(self, orchestrator):\n        payload = {\"summary\": \"s\", \"detailed_analysis\": \"d\", \"citations\": [], \"agents_consulted\": [], \"overall_confidence\": \"low\"}\n        orchestrator._llm_client.chat = AsyncMock(return_value=\"Here is your answer:\\n\" + json.dumps(payload))\n        result = await orchestrator.process(\"query\", [])\n        assert result.summary == \"s\"\n\n    @pytest.mark.asyncio\n    async def test_invalid_json_returns_error_response(self, orchestrator):\n        orchestrator._llm_client.chat = AsyncMock(return_value=\"not json at all\")\n        result = await orchestrator.process(\"query\", [])\n        assert result.overall_confidence == \"low\"\n        assert \"error\" in result.summary.lower()\n\n\nclass TestRoute:\n    @pytest.mark.asyncio\n    async def test_returns_parsed_routing(self, orchestrator):\n        payload = {\"selected_agents\": [\"staffing\", \"labour\"], \"routing_rationale\": \"r\", \"sub_queries\": {\"staffing\": \"q1\", \"labour\": \"q2\"}}\n        orchestrator._llm_client.chat = AsyncMock(return_value=json.dumps(payload))\n        result = await orchestrator._route(\"test query\")\n        assert result[\"selected_agents\"] == [\"staffing\", \"labour\"]\n\n    @pytest.mark.asyncio\n    async def test_fallback_to_all_agents_on_failure(self, orchestrator):\n        orchestrator._llm_client.chat = AsyncMock(side_effect=Exception(\"LLM down\"))\n        result = await orchestrator._route(\"test query\")\n        assert set(result[\"selected_agents\"]) == set(orchestrator._specialist_agent_ids)\n\n    @pytest.mark.asyncio\n    async def test_strips_preamble_in_routing(self, orchestrator):\n        payload = {\"selected_agents\": [\"ohs\"], \"routing_rationale\": \"r\", \"sub_queries\": {\"ohs\": \"q\"}}\n        orchestrator.