ngs\": \"test\"}\n\n    @pytest.mark.asyncio\n    async def test_chat_parsed_malformed_json(self):\n        \"\"\"chat_parsed must return a dict with _raw on bad JSON, not raise.\"\"\"\n        with patch(\"src.llm.client.AsyncOpenAI\") as mock_openai:\n            msg = MagicMock()\n            msg.content = \"This is not JSON at all\"\n            choice = MagicMock()\n            choice.message = msg\n            completion = MagicMock()\n            completion.choices = [choice]\n            instance = mock_openai.return_value\n            instance.chat.completions.create = AsyncMock(return_value=completion)\n\n            client = VLLMClient()\n            result = await client.chat_parsed(\"system\", \"user\")\n            assert \"_raw\" in result\n            assert \"_parse_error\" in result\n\n    @pytest.mark.asyncio\n    async def test_stream_chat_yields_chunks(self):\n        \"\"\"stream_chat must yield each non-empty delta content.\"\"\"\n        with patch(\"src.llm.client.AsyncOpenAI\") as mock_openai:\n            chunks = []\n            for text in [\"Hello\", \" world\", \"!\"]:\n                delta = MagicMock()\n                delta.content = text\n                choice = MagicMock()\n                choice.delta = delta\n                chunk = MagicMock()\n                chunk.choices = [choice]\n                chunks.append(chunk)\n\n            async def async_iter():\n                for c in chunks:\n                    yield c\n\n            instance = mock_openai.return_value\n            instance.chat.completions.create = AsyncMock(return_value=async_iter())\n\n            client = VLLMClient()\n            results = []\n            async for part in client.stream_chat(\"system\", \"user\"):\n                results.append(part)\n\n            assert results == [\"Hello\", \" world\", \"!\"]\n\n    @pytest.mark.asyncio\n    async def test_stream_chat_skips_empty_chunks(self):\n        \"\"\"Empty delta content strings must not be yielded.\"\"\"\n        with patch(\"src.llm.client.AsyncOpenAI\") as mock_openai:\n            chunks = []\n            for text in [\"data\", \"\", \"more\"]:\n                delta = MagicMock()\n                delta.content = text\n                choice = MagicMock()\n                choice.delta = delta\n                chunk = MagicMock()\n                chunk.choices = [choice]\n                chunks.append(chunk)\n\n            async def async_iter():\n                for c in chunks:\n                    yield c\n\n            instance = mock_openai.return_value\n            instance.chat.completions.create = AsyncMock(return_value=async_iter())\n\n            client = VLLMClient()\n            results = [p async for p in client.stream_chat(\"sys\", \"usr\")]\n            assert \"\" not in results\n            assert len(results) == 2\n```\n\n```python\n# tests/test_orchestrator.py\n\"\"\"Unit tests for OrchestratorAgent methods that don't require LLM calls.\"\"\"\nimport pytest\n\nfrom src.agents.orchestrator import OrchestratorAgent\nfrom src.models.schemas import CitationItem, RetrievalStatus, SpecialistResponse\n\n\ndef make_specialist_response(agent_id: str, citations: list[CitationItem] | None = None):\n    return SpecialistResponse(\n        agent_id=agent_id,\n        findings=\"Some findings\",\n        citations=citations or [],\n        confidence=\"high\",\n        retrieval_status=RetrievalStatus(\n            instruments_attempted=1,\n            instruments_successfully_retrieved=1,\n            instruments_failed=[],\n        ),\n    )\n\n\nclass TestAggregrateCitations:\n    def setup_method(self):\n        self.orch = OrchestratorAgent()\n\n    def test_deduplicates_same_url(self):\n        citation = CitationItem(\n            instrument_title=\"PSEA\",\n            instrument_type=\"Act\",\n            url=\"https://example.com/psea\",\n        )\n        resp_a = make_specialist_response(\"staffing\", [citation])\n        resp_b 