        "code": "# tests/test_orchestrator.py\n\"\"\"Unit tests for OrchestratorAgent.\"\"\"\n\nimport json\nimport pytest\nfrom unittest.mock import AsyncMock, MagicMock, patch\n\nfrom src.agents.orchestrator import OrchestratorAgent, get_orchestrator\nfrom src.models.schemas import OrchestratorCitation\n\n\n@pytest.fixture\ndef orchestrator():\n    with patch(\"src.agents.orchestrator.get_client\") as mock_client_fn, \\\n         patch(\"src.agents.orchestrator.get_config\"):\n        mock_client_fn.return_value = AsyncMock()\n        agent = OrchestratorAgent()\n        return agent\n\n\nclass TestBuildSynthesisPrompt:\n    def test_includes_query_text(self, orchestrator):\n        prompt = orchestrator._build_synthesis_prompt(\"test query\", [])\n        assert \"test query\" in prompt\n\n    def test_includes_agent_findings(self, orchestrator):\n        responses = [{\"agent_id\": \"staffing\", \"findings\": \"Found policy X\", \"confidence\": \"high\", \"citations\": []}]\n        prompt = orchestrator._build_synthesis_prompt(\"query\", responses)\n        assert \"Found policy X\" in prompt\n        assert \"STAFFING\" in prompt\n\n    def test_includes_citation_url(self, orchestrator):\n        responses = [{\n            \"agent_id\": \"staffing\",\n            \"findings\": \"findings\",\n            \"confidence\": \"high\",\n            \"citations\": [{\"instrument_title\": \"PSEA\", \"url\": \"https://laws.gc.ca/psea\", \"relevant_section\": \"s.10\"}],\n        }]\n        prompt = orchestrator._build_synthesis_prompt(\"query\", responses)\n        assert \"https://laws.gc.ca/psea\" in prompt\n\n    def test_no_citation_block_when_empty(self, orchestrator):\n        responses = [{\"agent_id\": \"staffing\", \"findings\": \"findings\", \"confidence\": \"high\", \"citations\": []}]\n        prompt = orchestrator._build_synthesis_prompt(\"query\", responses)\n        assert \"CITATIONS:\" not in prompt\n\n\nclass TestAggregateCitations:\n    def test_deduplicates_same_title_and_url(self, orchestrator):\n        responses = [\n            {\"agent_id\": \"staffing\", \"citations\": [{\"instrument_title\": \"PSEA\", \"url\": \"https://x.ca\", \"instrument_type\": \"Act\"}]},\n            {\"agent_id\": \"classification\", \"citations\": [{\"instrument_title\": \"PSEA\", \"url\": \"https://x.ca\", \"instrument_type\": \"Act\"}]},\n        ]\n        result = orchestrator._aggregate_citations(responses)\n        assert len(result) == 1\n\n    def test_different_urls_not_deduplicated(self, orchestrator):\n        responses = [\n            {\"agent_id\": \"staffing\", \"citations\": [{\"instrument_title\": \"PSEA\", \"url\": \"https://a.ca\", \"instrument_type\": \"Act\"}]},\n            {\"agent_id\": \"labour\", \"citations\": [{\"instrument_title\": \"PSLRA\", \"url\": \"https://b.ca\", \"instrument_type\": \"Act\"}]},\n        ]\n        result = orchestrator._aggregate_citations(responses)\n        assert len(result) == 2\n\n    def test_sourced_from_agent_set(self, orchestrator):\n        responses = [{\"agent_id\": \"equity\", \"citations\": [{\"instrument_title\": \"EEA\", \"url\": \"https://c.ca\", \"instrument_type\": \"Act\"}]}]\n        result = orchestrator._aggregate_citations(responses)\n        assert result[0].sourced_from_agent == \"equity\"\n\n    def test_empty_responses(self, orchestrator):\n        assert orchestrator._aggregate_citations([]) == []\n\n\nclass TestProcess:\n    @pytest.mark.asyncio\n    async def test_happy_path_valid_json(self, orchestrator):\n        payload = {\n            \"summary\": \"Direct answer\",\n            \"detailed_analysis\": \"Full analysis\",\n            \"citations\": [],\n            \"agents_consulted\": [\"staffing\"],\n            \"overall_confidence\": \"high\",\n        }\n        orchestrator._llm_client.chat = AsyncMock(return_value=json.dumps(payload))\n        result = await orchestrator.process(\"query\", [])\n        assert result.summary == \"Direct answer\"\n        assert result.overall_confidence == \"high\"\n\n    @pytest.mark.asyncio\n    async def test_strips_preamble_before_json(self, orchestrator):\n        payload = {\"summary\": \"s\", \"detailed_analysis\": \"d\", \"citations\": [], \"agents_consulted\": [], \"overall_confidence\": \"low\"}\n        orchestrator._llm_client.chat = AsyncMock(return_value=\"Here is your answer:\\n\" + json.dumps(payload))\n        result = await orchestrator.process(\"query\", [])\n        assert result.summary == \"s\"\n\n    @pytest.mark.asyncio\n    async def test_invalid_json_returns_error_response(self, orchestrator):\n        orchestrator._llm_client.chat = AsyncMock(return_value=\"not json at all\")\n        result = await orchestrator.process(\"query\", [])\n        assert result.overall_confidence == \"low\"\n        assert \"error\" in result.summary.lower()\n\n\nclass TestRoute:\n    @pytest.mark.asyncio\n    async def test_returns_parsed_routing(self, orchestrator):\n        payload = {\"selected_agents\": [\"staffing\", \"labour\"], \"routing_rationale\": \"r\", \"sub_queries\": {\"staffing\": \"q1\", \"labour\": \"q2\"}}\n        orchestrator._llm_client.chat = AsyncMock(return_value=json.dumps(payload))\n        result = await orchestrator._route(\"test query\")\n        assert result[\"selected_agents\"] == [\"staffing\", \"labour\"]\n\n    @pytest.mark.asyncio\n    async def test_fallback_to_all_agents_on_failure(self, orchestrator):\n        orchestrator._llm_client.chat = AsyncMock(side_effect=Exception(\"LLM down\"))\n        result = await orchestrator._route(\"test query\")\n        assert set(result[\"selected_agents\"]) == set(orchestrator._specialist_agent_ids)\n\n    @pytest.mark.asyncio\n    async def test_strips_preamble_in_routing(self, orchestrator):\n        payload = {\"selected_agents\": [\"ohs\"], \"routing_rationale\": \"r\", \"sub_queries\": {\"ohs\": \"q\"}}\n        orchestrator._llm_client.chat = AsyncMock(return_value=\"Sure!\\n\" + json.dumps(payload))\n        result = await orchestrator._route(\"query\")\n        assert result[\"selected_agents\"] == [\"ohs\"]\n\n\nclass TestGetOrchestratorSingleton:\n    def test_returns_same_instance(self):\n        import src.agents.orchestrator as mod\n        mod.ORCHESTRATOR = None\n        with patch(\"src.agents.orchestrator.get_client\"), patch(\"src.agents.orchestrator.get_config\"):\n            a = get_orchestrator()\n            b = get_orchestrator()\n            assert a is b\n        mod.ORCHESTRATOR = None"
