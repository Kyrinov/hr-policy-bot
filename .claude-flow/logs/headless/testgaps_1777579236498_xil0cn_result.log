", lambda self: None):\n            agent = OrchestratorAgent.__new__(OrchestratorAgent)\n            agent._config = MagicMock()\n            agent._llm_client = AsyncMock()\n            agent._specialist_agent_ids = [\n                \"staffing\", \"classification\", \"labour\", \"learning\",\n                \"equity\", \"ohs\", \"languages\", \"governance\",\n            ]\n            agent._agent_id = \"orchestrator\"\n            agent._display_name = \"Orchestrator Agent\"\n            agent._domain_description = \"Routes queries\"\n            agent._system_prompt = \"\"\n        return agent\n\n\nclass TestBuildSynthesisPrompt:\n    def test_includes_query_text(self, orchestrator):\n        prompt = orchestrator._build_synthesis_prompt(\"test query\", MOCK_SPECIALIST_RESPONSES)\n        assert \"test query\" in prompt\n\n    def test_includes_agent_ids(self, orchestrator):\n        prompt = orchestrator._build_synthesis_prompt(\"q\", MOCK_SPECIALIST_RESPONSES)\n        assert \"STAFFING\" in prompt\n        assert \"LABOUR\" in prompt\n\n    def test_includes_citations(self, orchestrator):\n        prompt = orchestrator._build_synthesis_prompt(\"q\", MOCK_SPECIALIST_RESPONSES)\n        assert \"PSEA\" in prompt\n\n    def test_empty_specialist_responses(self, orchestrator):\n        prompt = orchestrator._build_synthesis_prompt(\"q\", [])\n        assert \"q\" in prompt\n\n\nclass TestAggregateCitations:\n    def test_deduplicates_same_url_and_title(self, orchestrator):\n        citations = orchestrator._aggregate_citations(MOCK_SPECIALIST_RESPONSES)\n        titles = [c.instrument_title for c in citations]\n        assert titles.count(\"PSEA\") == 1\n\n    def test_preserves_distinct_citations(self, orchestrator):\n        citations = orchestrator._aggregate_citations(MOCK_SPECIALIST_RESPONSES)\n        assert len(citations) == 2\n\n    def test_sourced_from_agent_is_set(self, orchestrator):\n        citations = orchestrator._aggregate_citations(MOCK_SPECIALIST_RESPONSES)\n        assert any(c.sourced_from_agent == \"staffing\" for c in citations)\n\n    def test_empty_responses_returns_empty(self, orchestrator):\n        assert orchestrator._aggregate_citations([]) == []\n\n\nclass TestOrchestratorProcess:\n    @pytest.mark.asyncio\n    async def test_happy_path_returns_response(self, orchestrator):\n        orchestrator._llm_client.chat = AsyncMock(return_value=VALID_ORCHESTRATOR_JSON)\n        from src.agents.orchestrator import OrchestratorAgent\n        result = await orchestrator.process(\"query\", MOCK_SPECIALIST_RESPONSES)\n        assert result.summary == \"Direct answer.\"\n        assert result.overall_confidence == \"high\"\n\n    @pytest.mark.asyncio\n    async def test_json_embedded_in_text_is_parsed(self, orchestrator):\n        wrapped = \"Here is the result:\\n\" + VALID_ORCHESTRATOR_JSON + \"\\nDone.\"\n        orchestrator._llm_client.chat = AsyncMock(return_value=wrapped)\n        result = await orchestrator.process(\"query\", MOCK_SPECIALIST_RESPONSES)\n        assert result.summary == \"Direct answer.\"\n\n    @pytest.mark.asyncio\n    async def test_fallback_on_json_parse_failure(self, orchestrator):\n        orchestrator._llm_client.chat = AsyncMock(return_value=\"not valid json at all\")\n        result = await orchestrator.process(\"query\", MOCK_SPECIALIST_RESPONSES)\n        assert result.overall_confidence == \"low\"\n        assert \"error\" in result.summary.lower() or result.detailed_analysis\n\n\nclass TestOrchestratorRoute:\n    @pytest.mark.asyncio\n    async def test_returns_parsed_routing(self, orchestrator):\n        routing_json = '{\"selected_agents\": [\"staffing\"], \"sub_queries\": {\"staffing\": \"focused q\"}, \"routing_rationale\": \"staffing domain\"}'\n        orchestrator._llm_client.chat = AsyncMock(return_value=routing_json)\n        result = await orchestrator._route(\"query about staffing\")\n        assert result[\"selected_agents\"] == [\"staffing\"]\n\n    @pytest.mark.asyncio\n    async def test_fallback_invokes_all_agents_on_llm_error(self, orchestrator):\n        orchestrator._llm_client.chat = AsyncMock(side_effect=Exception(\"LLM down\"))\n        result = await orchestrator._route(\"any query\")\n        assert set(result[\"selected_agents\"]) == set(orchestrator._specialist_agent_ids)\n\n\nclass TestProcessWithStreaming:\n    @pytest.mark.asyncio\n    async def test_unavailable_agent_returns_low_confidence(self, orchestrator):\n        orchestrator._llm_client.chat = AsyncMock(return_value=VALID_ORCHESTRATOR_JSON)\n        orchestrator._route = AsyncMock(return_value={\n            \"selected_agents\": [\"nonexistent\"],\n            \"sub_queries\": {\"nonexistent\": \"q\"},\n        })\n        status_updates = []\n        with patch(\"src.agents.specialist.get_specialists\", return_value={}):\n            result = await orchestrator.process_with_streaming(\n                \"query\", MagicMock(), lambda u: status_updates.append(u) or AsyncMock()()\n            )\n        assert result is not None\n\n    @pytest.mark.asyncio\n    async def test_specialist_exception_captured_gracefully(self, orchestrator):\n        failing_agent = AsyncMock()\n        failing_agent.process_with_fetch = AsyncMock(side_effect=RuntimeError(\"boom\"))\n        orchestrator._llm_client.chat = AsyncMock(return_value=VALID_ORCHESTRATOR_JSON)\n        orchestrator._route = AsyncMock(return_value={\n            \"selected_agents\": [\"staffing\"],\n            \"sub_queries\": {\"staffing\": \"q\"},\n        })\n        status_updates = []\n        with patch(\"src.agents.specialist.get_specialists\", return_value={\"staffing\": failing_agent}):\n            result = await orchestrator.process_with_streaming(\n                \"query\", MagicMock(), lambda u: status_updates.append(u) or AsyncMock()()\n            )\n        assert result.overall_confidence in (\"low\", \"medium\", \"high\")\n```\n\n---\n\n",
