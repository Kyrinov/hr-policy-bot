      {
        "title": "tests/test_fetch_engine.py",
        "content": "\"\"\"Tests for FetchEngine.\"\"\"\n\nimport pytest\nfrom unittest.mock import AsyncMock, MagicMock, patch\n\n\n@pytest.fixture\ndef engine():\n    mock_cache = AsyncMock()\n    mock_extractor = MagicMock()\n    mock_extractor.extract.return_value = \"extracted content\"\n    from src.fetch.engine import FetchEngine\n    return FetchEngine(cache=mock_cache, extractor=mock_extractor)\n\n\nclass TestNormalizeUrl:\n    def test_rewrites_laws_lois_act_index(self, engine):\n        url = \"https://laws-lois.justice.gc.ca/eng/acts/P-33.01/\"\n        result = engine._normalize_url(url)\n        assert result.endswith(\"/FullText.html\")\n\n    def test_leaves_other_urls_unchanged(self, engine):\n        url = \"https://tbs-sct.canada.ca/pol/doc-eng.aspx?id=32621\"\n        assert engine._normalize_url(url) == url\n\n    def test_leaves_already_fulltext_url_unchanged(self, engine):\n        url = \"https://laws-lois.justice.gc.ca/eng/acts/P-33.01/FullText.html\"\n        assert engine._normalize_url(url) == url\n\n\nclass TestGetDomain:\n    def test_extracts_domain_from_normal_url(self, engine):\n        assert engine._get_domain(\"https://tbs-sct.canada.ca/pol/doc.aspx\") == \"tbs-sct.canada.ca\"\n\n    def test_returns_default_on_malformed_url(self, engine):\n        assert engine._get_domain(\"\") == \"default\"\n\n\nclass TestDoFetch:\n    @pytest.mark.asyncio\n    async def test_returns_cached_content_on_hit(self, engine):\n        from src.fetch.cache import CacheEntry\n        engine._cache.get = AsyncMock(return_value=CacheEntry(url=\"https://a.com\", content=\"cached!\", ttl_hours=168))\n        result = await engine._do_fetch(\"https://a.com\")\n        assert result == \"cached!\"\n\n    @pytest.mark.asyncio\n    async def test_fetches_and_caches_on_miss(self, engine):\n        engine._cache.get = AsyncMock(return_value=None)\n        engine._cache.set_cached = AsyncMock()\n\n        mock_response = MagicMock()\n        mock_response.status_code = 200\n        mock_response.text = \"<html><body>content</body></html>\"\n        mock_response.raise_for_status = MagicMock()\n        engine._client = AsyncMock()\n        engine._client.get = AsyncMock(return_value=mock_response)\n\n        result = await engine._do_fetch(\"https://a.com\")\n        assert result == \"extracted content\"\n        engine._cache.set_cached.assert_called_once()\n\n    @pytest.mark.asyncio\n    async def test_falls_back_to_stale_on_http_error(self, engine):\n        import httpx\n        from src.fetch.cache import CacheEntry\n        engine._cache.get = AsyncMock(return_value=None)\n        engine._cache.get_stale = AsyncMock(return_value=CacheEntry(url=\"https://a.com\", content=\"stale!\", ttl_hours=0))\n        engine._client = AsyncMock()\n        engine._client.get = AsyncMock(side_effect=httpx.RequestError(\"timeout\"))\n\n        result = await engine._do_fetch(\"https://a.com\")\n        assert result == \"stale!\"\n\n    @pytest.mark.asyncio\n    async def test_raises_fetch_error_when_no_stale(self, engine):\n        import httpx\n        from src.fetch.engine import FetchError\n        engine._cache.get = AsyncMock(return_value=None)\n        engine._cache.get_stale = AsyncMock(return_value=None)\n        engine._client = AsyncMock()\n        engine._client.get = AsyncMock(side_effect=httpx.RequestError(\"timeout\"))\n\n        with pytest.raises(FetchError):\n            await engine._do_fetch(\"https://a.com\")\n\n\nclass TestFetchBatch:\n    @pytest.mark.asyncio\n    async def test_returns_successful_urls_only(self, engine):\n        from src.fetch.engine import FetchError\n        async def mock_fetch(url):\n            if \"good\" in url:\n                return \"content\"\n            raise FetchError(\"bad\")\n\n        engine.fetch = mock_fetch\n        results = await engine.fetch_batch([\"https://good.com\", \"https://bad.com\"])\n        assert \"https://good.com\" in results\n        assert \"https://bad.com\" not in results\n```\n\n```python\n",
        "level": 1
