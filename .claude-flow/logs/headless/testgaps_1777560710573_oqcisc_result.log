        "code": "# tests/test_orchestrator.py\nimport pytest\nfrom unittest.mock import AsyncMock, MagicMock, patch\n\nclass TestAggregateCitations:\n    def test_deduplicates_by_title_and_url(self):\n        from src.agents.orchestrator import OrchestratorAgent\n        agent = OrchestratorAgent.__new__(OrchestratorAgent)\n        responses = [\n            {\"agent_id\": \"staffing\", \"citations\": [\n                {\"instrument_title\": \"PSEA\", \"instrument_type\": \"Act\",\n                 \"url\": \"https://example.com\", \"relevant_section\": \"s.30\"},\n            ]},\n            {\"agent_id\": \"labour\", \"citations\": [\n                {\"instrument_title\": \"PSEA\", \"instrument_type\": \"Act\",\n                 \"url\": \"https://example.com\", \"relevant_section\": \"s.40\"},\n            ]},\n        ]\n        result = agent._aggregate_citations(responses)\n        assert len(result) == 1\n        assert result[0].sourced_from_agent == \"staffing\"  # first wins\n\n    def test_different_urls_are_not_deduplicated(self):\n        from src.agents.orchestrator import OrchestratorAgent\n        agent = OrchestratorAgent.__new__(OrchestratorAgent)\n        responses = [\n            {\"agent_id\": \"a\", \"citations\": [\n                {\"instrument_title\": \"Doc\", \"instrument_type\": \"Policy\",\n                 \"url\": \"https://a.com\", \"relevant_section\": None},\n                {\"instrument_title\": \"Doc\", \"instrument_type\": \"Policy\",\n                 \"url\": \"https://b.com\", \"relevant_section\": None},\n            ]},\n        ]\n        result = agent._aggregate_citations(responses)\n        assert len(result) == 2\n\nclass TestProcess:\n    @pytest.mark.asyncio\n    async def test_json_parse_error_returns_error_response(self):\n        from src.agents.orchestrator import OrchestratorAgent\n        from unittest.mock import patch, AsyncMock\n        with patch(\"src.agents.orchestrator.get_config\"), \\\n             patch(\"src.agents.orchestrator.get_client\") as mock_client:\n            mock_client.return_value.chat = AsyncMock(return_value=\"not valid json at all\")\n            agent = OrchestratorAgent()\n            result = await agent.process(\"test query\", [])\n        assert result.overall_confidence == \"low\"\n        assert \"error\" in result.summary.lower()\n\n    @pytest.mark.asyncio\n    async def test_leading_preamble_stripped_before_json_parse(self):\n        from src.agents.orchestrator import OrchestratorAgent\n        import json\n        payload = json.dumps({\n            \"summary\": \"Summary text\",\n            \"detailed_analysis\": \"Analysis\",\n            \"citations\": [],\n            \"agents_consulted\": [\"staffing\"],\n            \"overall_confidence\": \"high\",\n        })\n        with patch(\"src.agents.orchestrator.get_config\"), \\\n             patch(\"src.agents.orchestrator.get_client\") as mock_client:\n            mock_client.return_value.chat = AsyncMock(return_value=f\"Here is the JSON:\\n{payload}\")\n            agent = OrchestratorAgent()\n            result = await agent.process(\"query\", [])\n        assert result.overall_confidence == \"high\"\n\nclass TestRoute:\n    @pytest.mark.asyncio\n    async def test_llm_failure_falls_back_to_all_agents(self):\n        from src.agents.orchestrator import OrchestratorAgent\n        with patch(\"src.agents.orchestrator.get_config\"), \\\n             patch(\"src.agents.orchestrator.get_client\") as mock_client:\n            mock_client.return_value.chat = AsyncMock(side_effect=RuntimeError(\"LLM down\"))\n            agent = OrchestratorAgent()\n            result = await agent._route(\"test query\")\n        assert set(result[\"selected_agents\"]) == set(agent._specialist_agent_ids)"
