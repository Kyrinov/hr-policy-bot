        "code": "# tests/test_db_extended.py\n\"\"\"Extended DatabaseManager tests covering untested methods.\"\"\"\n\nimport uuid\nimport pytest\nimport tempfile\nfrom pathlib import Path\nfrom datetime import datetime\n\nfrom src.data.db import DatabaseManager\nfrom src.models.schemas import (\n    AgentResponseRecord, CitationItem, FeedbackRecord,\n    FetchCacheEntry, OrchestratorResponseRecord, QueryRecord, RetrievalStatus\n)\n\n\n@pytest.fixture\nasync def db():\n    with tempfile.TemporaryDirectory() as tmpdir:\n        manager = DatabaseManager(db_path=Path(tmpdir) / \"test.db\")\n        await manager.initialize()\n        yield manager\n\n\nclass TestGetQueryMiss:\n    @pytest.mark.asyncio\n    async def test_get_nonexistent_query_returns_none(self, db):\n        result = await db.get_query(\"nonexistent-id\")\n        assert result is None\n\n\nclass TestListQueries:\n    @pytest.mark.asyncio\n    async def test_returns_empty_list_when_no_queries(self, db):\n        result = await db.list_queries()\n        assert result == []\n\n    @pytest.mark.asyncio\n    async def test_returns_queries_ordered_newest_first(self, db):\n        for i in range(3):\n            await db.save_query(QueryRecord(query_id=str(uuid.uuid4()), query_text=f\"q{i}\"))\n        result = await db.list_queries(limit=10)\n        assert len(result) == 3\n\n    @pytest.mark.asyncio\n    async def test_respects_limit(self, db):\n        for i in range(5):\n            await db.save_query(QueryRecord(query_id=str(uuid.uuid4()), query_text=f\"q{i}\"))\n        result = await db.list_queries(limit=2)\n        assert len(result) == 2\n\n\nclass TestAgentResponseRoundtrip:\n    @pytest.mark.asyncio\n    async def test_save_and_get_agent_response(self, db):\n        query_id = str(uuid.uuid4())\n        await db.save_query(QueryRecord(query_id=query_id, query_text=\"q\"))\n        record = AgentResponseRecord(\n            response_id=str(uuid.uuid4()),\n            query_id=query_id,\n            agent_id=\"staffing\",\n            findings=\"findings\",\n            confidence=\"high\",\n            retrieval_status=RetrievalStatus(\n                instruments_attempted=2, instruments_successfully_retrieved=2\n            ),\n        )\n        await db.save_agent_response(record)\n        results = await db.get_agent_responses(query_id)\n        assert len(results) == 1\n        assert results[0].agent_id == \"staffing\"\n\n\nclass TestOrchestratorResponseRoundtrip:\n    @pytest.mark.asyncio\n    async def test_save_and_get_orchestrator_response(self, db):\n        query_id = str(uuid.uuid4())\n        await db.save_query(QueryRecord(query_id=query_id, query_text=\"q\"))\n        record = OrchestratorResponseRecord(\n            response_id=str(uuid.uuid4()),\n            query_id=query_id,\n            summary=\"Summary text\",\n            overall_confidence=\"medium\",\n        )\n        await db.save_orchestrator_response(record)\n        result = await db.get_orchestrator_response(query_id)\n        assert result is not None\n        assert result.summary == \"Summary text\"\n\n    @pytest.mark.asyncio\n    async def test_get_nonexistent_orchestrator_response_returns_none(self, db):\n        assert await db.get_orchestrator_response(\"does-not-exist\") is None\n\n\nclass TestFeedbackRoundtrip:\n    @pytest.mark.asyncio\n    async def test_save_and_get_feedback(self, db):\n        query_id = str(uuid.uuid4())\n        await db.save_query(QueryRecord(query_id=query_id, query_text=\"q\"))\n        feedback = FeedbackRecord(\n            feedback_id=str(uuid.uuid4()),\n            query_id=query_id,\n            rating=\"accurate\",\n            comment=\"Very helpful\",\n        )\n        await db.save_feedback(feedback)\n        result = await db.get_feedback_for_query(query_id)\n        assert result is not None\n        assert result.rating == \"accurate\"\n\n    @pytest.mark.asyncio\n    async def test_export_feedback_returns_dicts(self, db):\n        query_id = str(uuid.uuid4())\n        await db.save_query(QueryRecord(query_id=query_id, query_text=\"q\"))\n        await db.save_feedback(FeedbackRecord(\n            feedback_id=str(uuid.uuid4()), query_id=query_id, rating=\"needs_work\"\n        ))\n        result = await db.export_feedback()\n        assert len(result) == 1\n        assert isinstance(result[0], dict)\n\n\nclass TestFetchCacheRoundtrip:\n    @pytest.mark.asyncio\n    async def test_set_and_get_cached(self, db):\n        entry = FetchCacheEntry(\n            url=\"https://x.ca\",\n            content_text=\"content\",\n            content_hash=\"hash\",\n            ttl_hours=168,\n            fetched_at=datetime.utcnow(),\n        )\n        await db.set_cached(entry)\n        result = await db.get_cached(\"https://x.ca\")\n        assert result is not None\n        assert result.content_text == \"content\"\n\n    @pytest.mark.asyncio\n    async def test_get_cached_expired_returns_none(self, db):\n        from datetime import timedelta\n        entry = FetchCacheEntry(\n            url=\"https://expired.ca\",\n            content_text=\"old\",\n            content_hash=\"h\",\n            ttl_hours=1,\n            fetched_at=datetime.utcnow() - timedelta(hours=2),\n        )\n        await db.set_cached(entry)\n        result = await db.get_cached(\"https://expired.ca\")\n        assert result is None\n\n    @pytest.mark.asyncio\n    async def test_get_stale_returns_expired_entry(self, db):\n        from datetime import timedelta\n        entry = FetchCacheEntry(\n            url=\"https://stale.ca\",\n            content_text=\"stale\",\n            content_hash=\"h\",\n            ttl_hours=1,\n            fetched_at=datetime.utcnow() - timedelta(hours=2),\n        )\n        await db.set_cached(entry)\n        result = await db.get_stale(\"https://stale.ca\")\n        assert result is not None\n        assert result.content_text == \"stale\"\n\n    @pytest.mark.asyncio\n    async def test_clear_expired_removes_entries(self, db):\n        from datetime import timedelta\n        entry = FetchCacheEntry(\n            url=\"https://old.ca\",\n            content_text=\"old\",\n            content_hash=\"h\",\n            ttl_hours=1,\n            fetched_at=datetime.utcnow() - timedelta(hours=2),\n        )\n        await db.set_cached(entry)\n        count = await db.clear_expired()\n        assert count >= 1\n        assert await db.get_stale(\"https://old.ca\") is None"
