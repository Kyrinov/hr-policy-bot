        "code": "# tests/test_specialist.py\n\"\"\"Tests for SpecialistAgent.\"\"\"\n\nimport pytest\nimport json\nfrom unittest.mock import AsyncMock, MagicMock, mock_open, patch\n\n\n@pytest.fixture\ndef registry_data():\n    return [\n        {\"id\": \"i1\", \"title\": \"PSEA\", \"type\": \"Act\", \"url\": \"https://laws.gc.ca/psea\", \"agent_ids\": [\"staffing\"]},\n        {\"id\": \"i2\", \"title\": \"PSLRA\", \"type\": \"Act\", \"url\": \"https://laws.gc.ca/pslra\", \"agent_ids\": [\"labour\"]},\n    ]\n\n\n@pytest.fixture\ndef staffing_agent(registry_data):\n    with patch(\"builtins.open\", mock_open(read_data=json.dumps(registry_data))):\n        with patch(\"src.llm.client.get_client\", return_value=MagicMock()):\n            with patch(\"src.agents.prompts.specialist_prompts.get_specialist_prompt\", return_value=\"prompt\"):\n                from src.agents.specialist import SpecialistAgent\n                return SpecialistAgent(\"staffing\", \"Staffing Agent\", \"Staffing domain\")\n\n\nclass TestLoadInstruments:\n    def test_filters_by_agent_id(self, staffing_agent):\n        assert len(staffing_agent._instruments) == 1\n        assert staffing_agent._instruments[0][\"title\"] == \"PSEA\"\n\n    def test_returns_empty_when_no_match(self, registry_data):\n        with patch(\"builtins.open\", mock_open(read_data=json.dumps(registry_data))):\n            with patch(\"src.llm.client.get_client\", return_value=MagicMock()):\n                with patch(\"src.agents.prompts.specialist_prompts.get_specialist_prompt\", return_value=\"p\"):\n                    from src.agents.specialist import SpecialistAgent\n                    agent = SpecialistAgent(\"ohs\", \"OHS Agent\", \"OHS\")\n        assert agent._instruments == []\n\n\nclass TestBuildPolicyContext:\n    def test_returns_empty_string_when_no_fetched(self, staffing_agent):\n        assert staffing_agent._build_policy_context([]) == \"\"\n\n    def test_includes_instrument_title_and_url(self, staffing_agent):\n        fetched = [({\"title\": \"PSEA\", \"type\": \"Act\", \"url\": \"https://a.com\"}, \"content here\")]\n        ctx = staffing_agent._build_policy_context(fetched)\n        assert \"PSEA\" in ctx\n        assert \"https://a.com\" in ctx\n        assert \"content here\" in ctx\n\n\nclass TestParseResponse:\n    def test_parses_valid_json(self, staffing_agent):\n        raw = json.dumps({\n            \"agent_id\": \"staffing\",\n            \"findings\": \"You must post.\",\n            \"citations\": [{\"instrument_title\": \"PSEA\", \"instrument_type\": \"Act\", \"url\": \"https://a.com\"}],\n            \"confidence\": \"high\",\n        })\n        result = staffing_agent._parse_response(raw, attempted=1, retrieved=1, failed=[])\n        assert result.confidence == \"high\"\n        assert result.findings == \"You must post.\"\n\n    def test_fallback_on_invalid_json(self, staffing_agent):\n        result = staffing_agent._parse_response(\"not json\", attempted=1, retrieved=0, failed=[\"PSEA\"])\n        assert result.confidence == \"low\"\n        assert result.findings == \"not json\"\n        assert result.retrieval_status.instruments_failed == [\"PSEA\"]\n\n    def test_strips_preamble_before_json(self, staffing_agent):\n        raw = 'Sure! Here:\\n' + json.dumps({\n            \"agent_id\": \"staffing\", \"findings\": \"f\", \"citations\": [], \"confidence\": \"medium\"\n        })\n        result = staffing_agent._parse_response(raw, attempted=0, retrieved=0, failed=[])\n        assert result.confidence == \"medium\"\n\n\nclass TestProcessWithFetch:\n    @pytest.mark.asyncio\n    async def test_skips_fetch_when_no_engine(self, staffing_agent):\n        staffing_agent._llm_client.chat = AsyncMock(return_value='{\"agent_id\":\"staffing\",\"findings\":\"f\",\"citations\":[],\"confidence\":\"medium\"}')\n        result = await staffing_agent.process_with_fetch(\"query\", fetch_engine=None)\n        assert result.retrieval_status.instruments_attempted == 0\n\n    @pytest.mark.asyncio\n    async def test_records_fetch_failures(self, staffing_agent):\n        mock_engine = MagicMock()\n        mock_engine.fetch = AsyncMock(side_effect=Exception(\"timeout\"))\n        staffing_agent._llm_client.chat = AsyncMock(return_value='{\"agent_id\":\"staffing\",\"findings\":\"f\",\"citations\":[],\"confidence\":\"low\"}')\n\n        result = await staffing_agent.process_with_fetch(\"query\", fetch_engine=mock_engine)\n        assert result.retrieval_status.instruments_attempted == 1\n        assert result.retrieval_status.instruments_successfully_retrieved == 0\n        assert len(result.retrieval_status.instruments_failed) == 1"
