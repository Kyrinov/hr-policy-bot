st.mark.asyncio\n    async def test_no_fetch_engine_skips_http_calls(self):\n        from src.agents.specialist import SpecialistAgent\n        from unittest.mock import patch, AsyncMock\n        import json\n        with patch(\"src.agents.specialist.get_client\") as mock_client, \\\n             patch(\"src.agents.specialist.get_specialist_prompt\", return_value=\"prompt\"), \\\n             patch.object(SpecialistAgent, \"_load_instruments\", return_value=[]):\n            payload = json.dumps({\n                \"agent_id\": \"staffing\", \"findings\": \"No instruments\",\n                \"citations\": [], \"confidence\": \"low\",\n            })\n            mock_client.return_value.chat = AsyncMock(return_value=payload)\n            agent = SpecialistAgent(\"staffing\", \"Staffing\", \"domain\")\n            result = await agent.process_with_fetch(\"test query\", None)\n        assert result.retrieval_status.instruments_attempted == 0"
