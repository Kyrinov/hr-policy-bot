   record = AgentResponseRecord(\n        response_id=str(uuid.uuid4()), query_id=qid, agent_id=\"staffing\",\n        findings=\"Test findings\", citations=[], confidence=\"medium\",\n        retrieval_status=RetrievalStatus(instruments_attempted=1, instruments_successfully_retrieved=1),\n    )\n    await db.save_agent_response(record)\n    results = await db.get_agent_responses(qid)\n    assert len(results) == 1\n    assert results[0].agent_id == \"staffing\"\n\n@pytest.mark.asyncio\nasync def test_clear_expired_removes_stale_entries(db):\n    from src.models.schemas import FetchCacheEntry\n    from datetime import datetime, timedelta\n    entry = FetchCacheEntry(\n        url=\"https://stale.example.com\",\n        content_text=\"old content\",\n        content_hash=\"abc\",\n        fetched_at=datetime.utcnow() - timedelta(hours=200),\n        ttl_hours=1,\n    )\n    await db.set_cached(entry)\n    count = await db.clear_expired()\n    assert count >= 1\n```\n\n---\n\n#### 8. `WebSocketManager` (`src/api/websocket.py`) — completely untested\n\n- `connect()` — stores connection, calls `websocket.accept()`\n- `disconnect()` — removes key safely (idempotent)\n- `send()` — returns `False` when `query_id` not registered; `False` and removes connection on send exception\n- `broadcast_error()` — message reaches all connections; disconnects failing sockets\n\n```python\n# tests/test_websocket_manager.py\nimport pytest\nfrom unittest.mock import AsyncMock, MagicMock\n\nclass TestWebSocketManager:\n    @pytest.mark.asyncio\n    async def test_connect_stores_websocket(self):\n        from src.api.websocket import WebSocketManager\n        manager = WebSocketManager()\n        ws = MagicMock()\n        ws.accept = AsyncMock()\n        await manager.connect(\"qid1\", ws)\n        assert \"qid1\" in manager._connections\n\n    @pytest.mark.asyncio\n    async def test_send_returns_false_for_unknown_query_id(self):\n        from src.api.websocket import WebSocketManager\n     