        "title": "tests/test_llm_client.py",
        "content": "import pytest\nfrom unittest.mock import AsyncMock, MagicMock, patch\nfrom src.llm.client import GeminiClient\n\n\n@pytest.fixture\ndef client():\n    with patch(\"src.llm.client.genai\"):\n        return GeminiClient(api_key=\"test-key\")\n\n\n@pytest.mark.asyncio\nasync def test_chat_returns_text(client):\n    client._model = MagicMock()\n    client._model.generate_content_async = AsyncMock(\n        return_value=MagicMock(text=\"Hello response\")\n    )\n    result = await client.chat([{\"role\": \"user\", \"content\": \"Hi\"}])\n    assert result == \"Hello response\"\n\n\n@pytest.mark.asyncio\nasync def test_chat_parsed_valid_json(client):\n    client._model = MagicMock()\n    client._model.generate_content_async = AsyncMock(\n        return_value=MagicMock(text='{\"answer\": \"yes\", \"citations\": []}')\n    )\n    result = await client.chat_parsed([{\"role\": \"user\", \"content\": \"Q\"}])\n    assert result == {\"answer\": \"yes\", \"citations\": []}\n\n\n@pytest.mark.asyncio\nasync def test_chat_parsed_malformed_json_returns_raw(client):\n    \"\"\"LLM sometimes returns prose instead of JSON — must not crash.\"\"\"\n    client._model = MagicMock()\n    client._model.generate_content_async = AsyncMock(\n        return_value=MagicMock(text=\"Sorry, I cannot answer that.\")\n    )\n    result = await client.chat_parsed([{\"role\": \"user\", \"content\": \"Q\"}])\n    # Should return the raw text or a fallback dict, not raise\n    assert result is not None\n\n\n@pytest.mark.asyncio\nasync def test_chat_parsed_truncated_json(client):\n    \"\"\"Truncated JSON from token limit — partial object.\"\"\"\n    client._model = MagicMock()\n    client._model.generate_content_async = AsyncMock(\n        return_value=MagicMock(text='{\"answer\": \"yes\", \"citation')\n    )\n    result = await client.chat_parsed([{\"role\": \"user\", \"content\": \"Q\"}])\n    assert result is not None  # Must not raise\n\n\n@pytest.mark.asyncio\nasync def test_chat_api_error_raises(client):\n    client._model = MagicMock()\n    client._model.generate_content_async = AsyncMock(side_effect=Exception(\"API error\"))\n    with pytest.raises(Exception):\n        await client.chat([{\"role\": \"user\", \"content\": \"Q\"}])\n\n\n@pytest.mark.asyncio\nasync def test_stream_chat_yields_chunks(client):\n    async def fake_stream():\n        for chunk in [\"Hello\", \" world\", \"!\"]:\n            yield MagicMock(text=chunk)\n\n    client._model = MagicMock()\n    client._model.generate_content_async = AsyncMock(return_value=fake_stream())\n    chunks = [c async for c in client.stream_chat([{\"role\": \"user\", \"content\": \"Q\"}])]\n    assert \"\".join(chunks) == \"Hello world!\"\n```\n\n---\n\n",
