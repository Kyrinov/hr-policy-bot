        "content": "import os, pytest\nfrom unittest.mock import patch, mock_open\n\nclass TestConfigErrors:\n    def test_missing_config_file_raises(self, tmp_path):\n        from src.config import _load_config\n        with pytest.raises(FileNotFoundError):\n            _load_config(str(tmp_path / \"nonexistent.yaml\"))\n\n    def test_invalid_yaml_raises(self, tmp_path):\n        bad = tmp_path / \"config.yaml\"\n        bad.write_text(\": : invalid: yaml: {[}\")\n        from src.config import _load_config\n        with pytest.raises(Exception):\n            _load_config(str(bad))\n\n    def test_non_numeric_server_port_raises(self, monkeypatch):\n        monkeypatch.setenv(\"SERVER_PORT\", \"not-a-number\")\n        # clear LRU cache before test\n        from src import config as cfg_module\n        cfg_module.get_config.cache_clear()\n        with pytest.raises(ValueError):\n            cfg_module.get_config()\n\n    def test_env_var_overrides_applied(self, monkeypatch):\n        monkeypatch.setenv(\"SERVER_HOST\", \"192.168.1.1\")\n        monkeypatch.setenv(\"SERVER_PORT\", \"9000\")\n        from src import config as cfg_module\n        cfg_module.get_config.cache_clear()\n        config = cfg_module.get_config()\n        assert config.server.host == \"192.168.1.1\"\n        assert config.server.port == 9000\n\n    def test_get_config_is_singleton(self):\n        from src.config import get_config\n        assert get_config() is get_config()\n```\n\n---\n\n",
