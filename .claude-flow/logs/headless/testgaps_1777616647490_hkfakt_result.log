        "code": "# tests/test_specialist.py\nimport pytest\nfrom unittest.mock import AsyncMock, MagicMock, patch\n\n\n@pytest.fixture(autouse=True)\ndef mock_env(monkeypatch):\n    monkeypatch.setenv(\"GEMINI_API_KEY\", \"test-key\")\n\n\nVALID_SPECIALIST_JSON = \"\"\"{\n    \"agent_id\": \"staffing\",\n    \"findings\": \"Found relevant staffing policy.\",\n    \"citations\": [{\"instrument_title\": \"PSEA\", \"instrument_type\": \"Act\", \"url\": \"https://example.com\"}],\n    \"caveats\": null,\n    \"scope_flags\": [],\n    \"confidence\": \"high\"\n}\"\"\"\n\n\n@pytest.fixture\ndef mock_llm():\n    with patch(\"src.agents.specialist.get_client\") as m:\n        client = AsyncMock()\n        m.return_value = client\n        yield client\n\n\n@pytest.fixture\ndef staffing_agent(mock_llm):\n    from src.agents.specialist import SpecialistAgent\n    return SpecialistAgent(\"staffing\", \"Staffing Agent\", \"Staffing domain\")\n\n\nclass TestSpecialistParseResponse:\n    def test_parses_valid_json(self, staffing_agent):\n        result = staffing_agent._parse_response(VALID_SPECIALIST_JSON, 1, 1, [])\n        assert result.findings == \"Found relevant staffing policy.\"\n        assert result.confidence == \"high\"\n        assert len(result.citations) == 1\n\n    def test_falls_back_on_invalid_json(self, staffing_agent):\n        result = staffing_agent._parse_response(\"not valid json\", 1, 0, [\"PSEA\"])\n        assert result.confidence == \"low\"\n        assert result.findings == \"not valid json\"\n        assert result.retrieval_status.instruments_failed == [\"PSEA\"]\n\n    def test_handles_json_with_missing_optional_fields(self, staffing_agent):\n        minimal = '{\"findings\": \"minimal\", \"confidence\": \"medium\", \"citations\": []}'\n        result = staffing_agent._parse_response(minimal, 1, 1, [])\n        assert result.findings == \"minimal\"\n\n    def test_records_retrieval_status(self, staffing_agent):\n        result = staffing_agent._parse_response(VALID_SPECIALIST_JSON, 5, 3, [\"X\", \"Y\"])\n        assert result.retrieval_status.instruments_attempted == 5\n        assert result.retrieval_status.instruments_successfully_retrieved == 3\n        assert len(result.retrieval_status.instruments_failed) == 2\n\n\nclass TestBuildPolicyContext:\n    def test_returns_empty_string_when_no_fetched(self, staffing_agent):\n        result = staffing_agent._build_policy_context([])\n        assert result == \"\"\n\n    def test_includes_instrument_title_and_url(self, staffing_agent):\n        fetched = [\n            ({\"title\": \"PSEA\", \"type\": \"Act\", \"url\": \"https://example.com\"}, \"Act content here\")\n        ]\n        result = staffing_agent._build_policy_context(fetched)\n        assert \"PSEA\" in result\n        assert \"Act content here\" in result\n        assert \"https://example.com\" in result\n\n\nclass TestProcessWithFetch:\n    @pytest.mark.asyncio\n    async def test_process_without_fetch_engine(self, staffing_agent, mock_llm):\n        mock_llm.chat = AsyncMock(return_value=VALID_SPECIALIST_JSON)\n        result = await staffing_agent.process(\"what are staffing rules?\")\n        assert result.agent_id == \"staffing\"\n\n    @pytest.mark.asyncio\n    async def test_process_with_all_fetches_failing(self, staffing_agent, mock_llm):\n        mock_llm.chat = AsyncMock(return_value=VALID_SPECIALIST_JSON)\n        mock_engine = AsyncMock()\n        mock_engine.fetch = AsyncMock(side_effect=Exception(\"network error\"))\n\n        result = await staffing_agent.process_with_fetch(\"query\", mock_engine)\n        assert result.retrieval_status.instruments_successfully_retrieved == 0\n\n    @pytest.mark.asyncio\n    async def test_process_with_partial_fetch_failures(self, staffing_agent, mock_llm):\n        mock_llm.chat = AsyncMock(return_value=VALID_SPECIALIST_JSON)\n        mock_engine = AsyncMock()\n        # First call succeeds, subsequent calls fail\n        mock_engine.fetch = AsyncMock(side_effect=[\"content\", Exception(\"err\")])\n\n        result = await staffing_agent.process_with_fetch(\"query\", mock_engine)\n        assert result is not None\n\n\nclass TestAllSpecialistsLoad:\n    @pytest.mark.parametrize(\"agent_id\", [\n        \"staffing\", \"classification\", \"labour\", \"learning\",\n        \"equity\", \"ohs\", \"languages\", \"governance\"\n    ])\n    def test_specialist_loads_instruments(self, agent_id, mock_llm):\n        from src.agents.specialist import SpecialistAgent\n        agent = SpecialistAgent(agent_id, f\"{agent_id} Agent\", f\"{agent_id} domain\")\n        assert isinstance(agent._instruments, list)\n\n    def test_get_specialists_returns_all_eight(self, mock_llm):\n        from src.agents.specialist import _specialists\n        import src.agents.specialist as spec_mod\n        spec_mod._specialists = None  # reset singleton\n        specialists = spec_mod.get_specialists()\n        assert len(specialists) == 8"
