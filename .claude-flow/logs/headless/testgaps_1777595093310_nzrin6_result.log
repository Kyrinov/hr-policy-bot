        "language": "python",
        "code": "# tests/test_config.py\nimport os\nimport pytest\nimport importlib\n\n\nclass TestConfigEnvOverrides:\n    def test_api_key_override(self, monkeypatch):\n        monkeypatch.setenv(\"GEMINI_API_KEY\", \"test-key-123\")\n        # Re-import to pick up new env\n        import src.config as cfg\n        importlib.reload(cfg)\n        config = cfg.get_config()\n        assert config.model.api_key == \"test-key-123\"\n\n    def test_port_override(self, monkeypatch):\n        monkeypatch.setenv(\"PORT\", \"9090\")\n        import src.config as cfg\n        importlib.reload(cfg)\n        config = cfg.get_config()\n        assert config.server.port == 9090\n\n    def test_missing_config_file_uses_defaults(self, tmp_path, monkeypatch):\n        monkeypatch.chdir(tmp_path)\n        import src.config as cfg\n        importlib.reload(cfg)\n        config = cfg.get_config()\n        assert config is not None  # must not raise\n\n    def test_config_is_singleton(self):\n        from src.config import get_config\n        a = get_config()\n        b = get_config()\n        assert a is b"
