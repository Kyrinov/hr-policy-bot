        "content": "import pytest\nfrom unittest.mock import AsyncMock, MagicMock, patch\n\n\n@pytest.fixture(autouse=True)\ndef mock_env(monkeypatch):\n    monkeypatch.setenv(\"GEMINI_API_KEY\", \"test-key\")\n\n\n@pytest.fixture\ndef mock_llm():\n    with patch(\"src.agents.orchestrator.get_client\") as m:\n        mock_client = AsyncMock()\n        m.return_value = mock_client\n        yield mock_client\n\n\n@pytest.fixture\ndef orchestrator(mock_llm):\n    from src.agents.orchestrator import OrchestratorAgent\n    return OrchestratorAgent()\n\n\nVALID_ORCH_JSON = \"\"\"{\n    \"summary\": \"Direct answer.\",\n    \"detailed_analysis\": \"Full analysis.\",\n    \"policy_tensions\": null,\n    \"citations\": [],\n    \"gaps_and_limitations\": null,\n    \"recommended_consultation\": null,\n    \"agents_consulted\": [\"staffing\"],\n    \"overall_confidence\": \"high\"\n}\"\"\"\n\n\nclass TestOrchestratorProcess:\n    @pytest.mark.asyncio\n    async def test_process_returns_orchestrator_response(self, orchestrator, mock_llm):\n        mock_llm.chat = AsyncMock(return_value=VALID_ORCH_JSON)\n        responses = [{\"agent_id\": \"staffing\", \"findings\": \"Found X\", \"confidence\": \"high\", \"citations\": []}]\n        result = await orchestrator.process(\"test query\", responses)\n        assert result.summary == \"Direct answer.\"\n        assert result.overall_confidence == \"high\"\n\n    @pytest.mark.asyncio\n    async def test_process_falls_back_on_invalid_json(self, orchestrator, mock_llm):\n        mock_llm.chat = AsyncMock(return_value=\"this is not json\")\n        result = await orchestrator.process(\"test query\", [])\n        assert result.overall_confidence == \"low\"\n        assert \"error\" in result.summary.lower() or result.detailed_analysis\n\n    @pytest.mark.asyncio\n    async def test_process_strips_preamble_before_json(self, orchestrator, mock_llm):\n        \"\"\"LLM sometimes emits text before the JSON object.\"\"\"\n        preamble = \"Sure, here is the answer:\\n\\n\" + VALID_ORCH_JSON\n        mock_llm.chat = AsyncMock(return_value=preamble)\n        result = await orchestrator.process(\"q\", [])\n        assert result.summary == \"Direct answer.\"\n\n    @pytest.mark.asyncio\n    async def test_process_with_empty_specialist_responses(self, orchestrator, mock_llm):\n        mock_llm.chat = AsyncMock(return_value=VALID_ORCH_JSON)\n        result = await orchestrator.process(\"q\", [])\n        assert result is not None\n\n\nclass TestAggregateCitations:\n    def test_deduplicates_identical_citations(self, orchestrator):\n        duplicate_citation = {\n            \"instrument_title\": \"PSEA\",\n            \"instrument_type\": \"Act\",\n            \"url\": \"https://example.com/psea\",\n            \"relevant_section\": \"s.30\",\n        }\n        responses = [\n            {\"agent_id\": \"staffing\", \"citations\": [duplicate_citation]},\n            {\"agent_id\": \"classification\", \"citations\": [duplicate_citation]},\n        ]\n        result = orchestrator._aggregate_citations(responses)\n        assert len(result) == 1\n\n    def test_preserves_distinct_citations(self, orchestrator):\n        responses = [\n            {\"agent_id\": \"staffing\", \"citations\": [\n                {\"instrument_title\": \"PSEA\", \"instrument_type\": \"Act\", \"url\": \"https://a.com\"}\n            ]},\n            {\"agent_id\": \"labour\", \"citations\": [\n                {\"instrument_title\": \"FPSLRA\", \"instrument_type\": \"Act\", \"url\": \"https://b.com\"}\n            ]},\n        ]\n        result = orchestrator._aggregate_citations(responses)\n        assert len(result) == 2\n\n    def test_handles_missing_citations_key(self, orchestrator):\n        responses = [{\"agent_id\": \"staffing\"}]  # no 'citations' key\n        result = orchestrator._aggregate_citations(responses)\n        assert result == []\n\n\nclass TestOrchestratorRouting:\n    @pytest.mark.asyncio\n    async def test_route_returns_parsed_json(self, orchestrator, mock_llm):\n        mock_llm.chat = AsyncMock(return_value='{\"selected_agents\": [\"staffing\"], \"sub_queries\": {\"staffing\": \"sub\"}}')\n        result = await orchestrator._route(\"staffing query\")\n        assert \"staffing\" in result[\"selected_agents\"]\n\n    @pytest.mark.asyncio\n    async def test_route_falls_back_to_all_agents_on_llm_error(self, orchestrator, mock_llm):\n        mock_llm.chat = AsyncMock(side_effect=Exception(\"LLM down\"))\n        result = await orchestrator._route(\"any query\")\n        assert set(result[\"selected_agents\"]) == set(orchestrator._specialist_agent_ids)\n\n\nclass TestBuildSynthesisPrompt:\n    def test_includes_original_query(self, orchestrator):\n        prompt = orchestrator._build_synthesis_prompt(\"my original question\", [])\n        assert \"my original question\" in prompt\n\n    def test_includes_agent_findings(self, orchestrator):\n        responses = [{\"agent_id\": \"staffing\", \"findings\": \"Key finding here\", \"confidence\": \"high\", \"citations\": []}]\n        prompt = orchestrator._build_synthesis_prompt(\"q\", responses)\n        assert \"Key finding here\" in prompt\n        assert \"STAFFING\" in prompt\n```\n\n---\n\n",
        "level": 1
      },
      {
        "title": "3. `SpecialistAgent` — Completely Untested (`src/agents/specialist.py`)",
        "content": "\n**Untested:** `_load_instruments()`, `_build_policy_context()`, `_parse_response()` (valid/invalid), `process_with_fetch()` partial failures, all 8 specialist configurations.\n\n```python\n",
        "level": 3
      },
      {
        "title": "tests/test_specialist.py",
        "content": "import pytest\nfrom unittest.mock import AsyncMock, MagicMock, patch\n\n\n@pytest.fixture(autouse=True)\ndef mock_env(monkeypatch):\n    monkeypatch.setenv(\"GEMINI_API_KEY\", \"test-key\")\n\n\nVALID_SPECIALIST_JSON = \"\"\"{\n    \"agent_id\": \"staffing\",\n    \"findings\": \"Found relevant staffing policy.\",\n    \"citations\": [{\"instrument_title\": \"PSEA\", \"instrument_type\": \"Act\", \"url\": \"https://example.com\"}],\n    \"caveats\": null,\n    \"scope_flags\": [],\n    \"confidence\": \"high\"\n}\"\"\"\n\n\n@pytest.fixture\ndef mock_llm():\n    with patch(\"src.agents.specialist.get_client\") as m:\n        client = AsyncMock()\n        m.return_value = client\n        yield client\n\n\n@pytest.fixture\ndef staffing_agent(mock_llm):\n    from src.agents.specialist import SpecialistAgent\n    return SpecialistAgent(\"staffing\", \"Staffing Agent\", \"Staffing domain\")\n\n\nclass TestSpecialistParseResponse:\n    def test_parses_valid_json(self, staffing_agent):\n        result = staffing_agent._parse_response(VALID_SPECIALIST_JSON, 1, 1, [])\n        assert result.findings == \"Found relevant staffing policy.\"\n        assert result.confidence == \"high\"\n        assert len(result.citations) == 1\n\n    def test_falls_back_on_invalid_json(self, staffing_agent):\n        result = staffing_agent._parse_response(\"not valid json\", 1, 0, [\"PSEA\"])\n        assert result.confidence == \"low\"\n        assert result.findings == \"not valid json\"\n        assert result.retrieval_status.instruments_failed == [\"PSEA\"]\n\n    def test_handles_json_with_missing_optional_fields(self, staffing_agent):\n        minimal = '{\"findings\": \"minimal\", \"confidence\": \"medium\", \"citations\": []}'\n        result = staffing_agent._parse_response(minimal, 1, 1, [])\n        assert result.findings == \"minimal\"\n\n    def test_records_retrieval_status(self, staffing_agent):\n        result = staffing_agent._parse_response(VALID_SPECIALIST_JSON, 5, 3, [\"X\", \"Y\"])\n        assert result.retrieval_status.instruments_attempted == 5\n        assert result.retrieval_status.instruments_successfully_retrieved == 3\n        assert len(result.retrieval_status.instruments_failed) == 2\n\n\nclass TestBuildPolicyContext:\n    def test_returns_empty_string_when_no_fetched(self, staffing_agent):\n        result = staffing_agent._build_policy_context([])\n        assert result == \"\"\n\n    def test_includes_instrument_title_and_url(self, staffing_agent):\n        fetched = [\n            ({\"title\": \"PSEA\", \"type\": \"Act\", \"url\": \"https://example.com\"}, \"Act content here\")\n        ]\n        result = staffing_agent._build_policy_context(fetched)\n        assert \"PSEA\" in result\n        assert \"Act content here\" in result\n        assert \"https://example.com\" in result\n\n\nclass TestProcessWithFetch:\n    @pytest.mark.asyncio\n    async def test_process_without_fetch_engine(self, staffing_agent, mock_llm):\n        mock_llm.chat = AsyncMock(return_value=VALID_SPECIALIST_JSON)\n        result = await staffing_agent.process(\"what are staffing rules?\")\n        assert result.agent_id == \"staffing\"\n\n    @pytest.mark.asyncio\n    async def test_process_with_all_fetches_failing(self, staffing_agent, mock_llm):\n        mock_llm.chat = AsyncMock(return_value=VALID_SPECIALIST_JSON)\n        mock_engine = AsyncMock()\n        mock_engine.fetch = AsyncMock(side_effect=Exception(\"network error\"))\n\n        result = await staffing_agent.process_with_fetch(\"query\", mock_engine)\n        assert result.retrieval_status.instruments_successfully_retrieved == 0\n\n    @pytest.mark.asyncio\n    async def test_process_with_partial_fetch_failures(self, staffing_agent, mock_llm):\n        mock_llm.chat = AsyncMock(return_value=VALID_SPECIALIST_JSON)\n        mock_engine = AsyncMock()\n        # First call succeeds, subsequent calls fail\n        mock_engine.fetch = AsyncMock(side_effect=[\"content\", Exception(\"err\")])\n\n        result = await staffing_agent.process_with_fetch(\"query\", mock_engine)\n        assert result is not None\n\n\nclass TestAllSpecialistsLoad:\n    @pytest.mark.parametrize(\"agent_id\", [\n        \"staffing\", \"classification\", \"labour\", \"learning\",\n        \"equity\", \"ohs\", \"languages\", \"governance\"\n    ])\n    def test_specialist_loads_instruments(self, agent_id, mock_llm):\n        from src.agents.specialist import SpecialistAgent\n        agent = SpecialistAgent(agent_id, f\"{agent_id} Agent\", f\"{agent_id} domain\")\n        assert isinstance(agent._instruments, list)\n\n    def test_get_specialists_returns_all_eight(self, mock_llm):\n        from src.agents.specialist import _specialists\n        import src.agents.specialist as spec_mod\n        spec_mod._specialists = None  # reset singleton\n        specialists = spec_mod.get_specialists()\n        assert len(specialists) == 8\n```\n\n---\n\n",
        "level": 1
      },
      {
        "title": "4. `FetchEngine` — Mostly Untested (`src/fetch/engine.py`)",
        "content": "\n**Untested:** `_normalize_url()`, `_do_fetch()` cache hit/miss/stale paths, `fetch_batch()` partial failures, `_get_domain()` edge cases, `FetchError`.\n\n```python\n",
        "level": 3
      },
      {
        "title": "tests/test_fetch_engine.py",
        "content": "import pytest\nfrom unittest.mock import AsyncMock, MagicMock, patch\n\n\n@pytest.fixture\ndef engine():\n    from src.fetch.engine import FetchEngine\n    mock_cache = AsyncMock()\n    mock_cache.get = AsyncMock(return_value=None)\n    mock_cache.get_stale = AsyncMock(return_value=None)\n    mock_cache.set_cached = AsyncMock()\n    mock_cache._get_default_ttl = MagicMock(return_value=168)\n\n    mock_extractor = MagicMock()\n    mock_extractor.extract = MagicMock(return_value=\"extracted content\")\n\n    return FetchEngine(cache=mock_cache, extractor=mock_extractor)\n\n\nclass TestNormalizeUrl:\n    def test_rewrites_laws_lois_act_index_to_fulltext(self):\n        from src.fetch.engine import FetchEngine\n        engine = FetchEngine.__new__(FetchEngine)\n        result = engine._normalize_url(\"https://laws-lois.justice.gc.ca/eng/acts/P-33.01/\")\n        assert result.endswith(\"/FullText.html\")\n\n    def test_does_not_rewrite_already_fulltext_url(self):\n        from src.fetch.engine import FetchEngine\n        engine = FetchEngine.__new__(FetchEngine)\n        url = \"https://laws-lois.justice.gc.ca/eng/acts/P-33.01/FullText.html\"\n        assert engine._normalize_url(url) == url\n\n    def test_does_not_rewrite_other_urls(self):\n        from src.fetch.engine import FetchEngine\n        engine = FetchEngine.__new__(FetchEngine)\n        url = \"https://tbs-sct.canada.ca/pol/doc-eng.aspx?id=12345\"\n        assert engine._normalize_url(url) == url\n\n\nclass TestGetDomain:\n    def test_extracts_domain(self, engine):\n        assert engine._get_domain(\"https://example.com/path\") == \"example.com\"\n\n    def test_handles_malformed_url(self, engine):\n        assert engine._get_domain(\"not_a_url\") == \"not_a_url\"\n\n    def test_falls_back_to_default_on_exception(self, engine):\n        result = engine._get_domain(\"\")\n        assert result == \"default\"\n\n\nclass TestDoFetch:\n    @pytest.mark.asyncio\n    async def test_returns_cached_content_on_cache_hit(self, engine):\n        from src.fetch.cache import CacheEntry\n        cached = CacheEntry(url=\"https://example.com\", content=\"cached text\", ttl_hours=168)\n        engine._cache.get = AsyncMock(return_value=cached)\n\n        result = await engine._do_fetch(\"https://example.com\")\n        assert result == \"cached text\"\n\n    @pytest.mark.asyncio\n    async def test_fetches_and_stores_on_cache_miss(self, engine):\n        import httpx\n        engine._cache.get = AsyncMock(return_value=None)\n\n        mock_response = MagicMock()\n        mock_response.text = \"<html><body>page</body></html>\"\n        mock_response.status_code = 200\n        mock_response.raise_for_status = MagicMock()\n        engine._client = AsyncMock()\n        engine._client.get = AsyncMock(return_value=mock_response)\n\n        result = await engine._do_fetch(\"https://example.com\")\n        assert result == \"extracted content\"\n        engine._cache.set_cached.assert_called_once()\n\n    @pytest.mark.asyncio\n    async def test_falls_back_to_stale_cache_on_http_error(self, engine):\n        import httpx\n        from src.fetch.cache import CacheEntry\n        engine._cache.get = AsyncMock(return_value=None)\n        engine._client = AsyncMock()\n        engine._client.get = AsyncMock(side_effect=httpx.RequestError(\"timeout\"))\n        stale = CacheEntry(url=\"https://example.com\", content=\"stale content\", ttl_hours=168)\n        engine._cache.get_stale = AsyncMock(return_value=stale)\n\n        result = await engine._do_fetch(\"https://example.com\")\n        assert result == \"stale content\"\n\n    @pytest.mark.asyncio\n    async def test_raises_fetch_error_when_no_cache_fallback(self, engine):\n        import httpx\n        from src.fetch.engine import FetchError\n        engine._cache.get = AsyncMock(return_value=None)\n        engine._cache.get_stale = AsyncMock(return_value=None)\n        engine._client = AsyncMock()\n        engine._client.get = AsyncMock(side_effect=httpx.RequestError(\"timeout\"))\n\n        with pytest.raises(FetchError):\n            await engine._do_fetch(\"https://example.com\")\n\n\nclass TestFetchBatch:\n    @pytest.mark.asyncio\n    async def test_returns_all_successful_urls(self, engine):\n        engine.fetch = AsyncMock(return_value=\"content\")\n        results = await engine.fetch_batch([\"https://a.com\", \"https://b.com\"])\n        assert len(results) == 2\n\n    @pytest.mark.asyncio\n    async def test_skips_failed_urls_silently(self, engine):\n        from src.fetch.engine import FetchError\n        engine.fetch = AsyncMock(side_effect=[FetchError(\"err\"), \"content\"])\n        results = await engine.fetch_batch([\"https://fail.com\", \"https://ok.com\"])\n        assert \"https://ok.com\" in results\n        assert \"https://fail.com\" not in results\n```\n\n---\n\n",
        "level": 1
      },
      {
        "title": "5. `FetchCache` — Completely Untested (`src/fetch/cache.py`)",
        "content": "\n**Untested:** `CacheEntry.expires_at`, `CacheEntry.is_valid()`, `content_hash`, `_get_default_ttl()` domain branching, `store()`, `clear_expired()`, `health_check()`.\n\n```python\n",
        "level": 3
      },
      {
        "title": "tests/test_fetch_cache.py",
        "content": "import pytest\nfrom datetime import datetime, timedelta\nfrom unittest.mock import AsyncMock, patch\n\n\nclass TestCacheEntry:\n    def test_content_hash_is_deterministic(self):\n        from src.fetch.cache import CacheEntry\n        entry = CacheEntry(url=\"https://x.com\", content=\"hello\", ttl_hours=24)\n        assert entry.content_hash == entry.content_hash\n\n    def test_is_valid_returns_true_for_fresh_entry(self):\n        from src.fetch.cache import CacheEntry\n        entry = CacheEntry(url=\"https://x.com\", content=\"x\", ttl_hours=24)\n        entry.fetched_at = datetime.utcnow()\n        assert entry.is_valid() is True\n\n    def test_is_valid_returns_false_for_expired_entry(self):\n        from src.fetch.cache import CacheEntry\n        entry = CacheEntry(url=\"https://x.com\", content=\"x\", ttl_hours=1)\n        entry.fetched_at = datetime.utcnow() - timedelta(hours=2)\n        assert entry.is_valid() is False\n\n\nclass TestGetDefaultTtl:\n    @pytest.fixture\n    def cache(self):\n        from src.fetch.cache import FetchCache\n        return FetchCache(db_manager=AsyncMock())\n\n    def test_legislation_domain_gets_720h_ttl(self, cache):\n        url = \"https://laws-lois.justice.gc.ca/eng/acts/P-33.01/FullText.html\"\n        assert cache._get_default_ttl(url) == 720\n\n    def test_collective_agreement_domain_gets_720h_ttl(self, cache):\n        url = \"https://tbs-sct.canada.ca/agreements-conventions/eng.aspx\"\n        assert cache._get_default_ttl(url) == 720\n\n    def test_default_domain_gets_config_ttl(self, cache):\n        url = \"https://some-other-domain.gc.ca/page\"\n        ttl = cache._get_default_ttl(url)\n        assert isinstance(ttl, int)\n        assert ttl > 0\n\n\nclass TestFetchCacheOperations:\n    @pytest.fixture\n    def mock_db(self):\n        return AsyncMock()\n\n    @pytest.fixture\n    def cache(self, mock_db):\n        from src.fetch.cache import FetchCache\n        return FetchCache(db_manager=mock_db)\n\n    @pytest.mark.asyncio\n    async def test_get_returns_none_on_cache_miss(self, cache, mock_db):\n        mock_db.get_cached = AsyncMock(return_value=None)\n        result = await cache.get(\"https://example.com\")\n        assert result is None\n\n    @pytest.mark.asyncio\n    async def test_store_calls_set_cached(self, cache, mock_db):\n        mock_db.set_cached = AsyncMock()\n        await cache.store(\"https://example.com\", \"content\", ttl_hours=48)\n        mock_db.set_cached.assert_called_once()\n\n    @pytest.mark.asyncio\n    async def test_clear_expired_delegates_to_db(self, cache, mock_db):\n        mock_db.clear_expired = AsyncMock(return_value=5)\n        count = await cache.clear_expired()\n        assert count == 5\n```\n\n---\n\n",
        "level": 1
      },
      {
        "title": "6. `DatabaseManager` — Mostly Untested (`src/data/db.py`)",
        "content": "\n**Untested:** `save_agent_response()`, `get_agent_responses()`, `save_orchestrator_response()`, `get_orchestrator_response()`, `save_feedback()` / `get_feedback_for_query()`, `export_feedback()`, `list_queries()`, cache CRUD, `clear_expired()`.\n\n```python\n",
        "level": 3
      },
      {
        "title": "tests/test_database_extended.py",
        "content": "import uuid\nimport pytest\nimport tempfile\nfrom pathlib import Path\nfrom datetime import datetime\n\n\n@pytest.fixture\nasync def db(tmp_path):\n    from src.data.db import DatabaseManager\n    manager = DatabaseManager(db_path=tmp_path / \"test.db\")\n    await manager.initialize()\n    return manager\n\n\n@pytest.fixture\ndef sample_query_id():\n    return str(uuid.uuid4())\n\n\n@pytest.fixture\nasync def saved_query(db, sample_query_id):\n    from src.models.schemas import QueryRecord\n    record = QueryRecord(query_id=sample_query_id, query_text=\"test query\", agents_invoked=[\"staffing\"])\n    await db.save_query(record)\n    return record\n\n\nclass TestQueryOperations:\n    @pytest.mark.asyncio\n    async def test_get_query_returns_none_for_missing_id(self, db):\n        result = await db.get_query(\"nonexistent-id\")\n        assert result is None\n\n    @pytest.mark.asyncio\n    async def test_list_queries_respects_limit(self, db):\n        from src.models.schemas import QueryRecord\n        for i in range(5):\n            r = QueryRecord(query_id=str(uuid.uuid4()), query_text=f\"q{i}\", agents_invoked=[])\n            await db.save_query(r)\n        results = await db.list_queries(limit=3)\n        assert len(results) <= 3\n\n    @pytest.mark.asyncio\n    async def test_save_query_is_idempotent(self, db, saved_query):\n        \"\"\"INSERT OR REPLACE should not raise on duplicate key.\"\"\"\n        from src.models.schemas import QueryRecord\n        same_id = QueryRecord(\n            query_id=saved_query.query_id,\n            query_text=\"updated text\",\n            agents_invoked=[\"labour\"],\n        )\n        await db.save_query(same_id)\n        retrieved = await db.get_query(saved_query.query_id)\n        assert retrieved.query_text == \"updated text\"\n\n\nclass TestAgentResponseOperations:\n    @pytest.mark.asyncio\n    async def test_save_and_retrieve_agent_response(self, db, saved_query):\n        from src.models.schemas import AgentResponseRecord, CitationItem, RetrievalStatus\n        record = AgentResponseRecord(\n            response_id=str(uuid.uuid4()),\n            query_id=saved_query.query_id,\n            agent_id=\"staffing\",\n            findings=\"Found policy.\",\n            citations=[CitationItem(instrument_title=\"PSEA\", instrument_type=\"Act\")],\n            confidence=\"high\",\n            retrieval_status=RetrievalStatus(instruments_attempted=1, instruments_successfully_retrieved=1),\n        )\n        await db.save_agent_response(record)\n        results = await db.get_agent_responses(saved_query.query_id)\n        assert len(results) == 1\n        assert results[0].agent_id == \"staffing\"\n\n    @pytest.mark.asyncio\n    async def test_get_agent_responses_empty_for_unknown_query(self, db):\n        results = await db.get_agent_responses(\"unknown-id\")\n        assert results == []\n\n\nclass TestOrchestratorResponseOperations:\n    @pytest.mark.asyncio\n    async def test_save_and_retrieve_orchestrator_response(self, db, saved_query):\n        from src.models.schemas import OrchestratorResponseRecord\n        record = OrchestratorResponseRecord(\n            response_id=str(uuid.uuid4()),\n            query_id=saved_query.query_id,\n            summary=\"Answer here.\",\n            citations=[],\n            overall_confidence=\"high\",\n        )\n        await db.save_orchestrator_response(record)\n        retrieved = await db.get_orchestrator_response(saved_query.query_id)\n        assert retrieved is not None\n        assert retrieved.summary == \"Answer here.\"\n\n    @pytest.mark.asyncio\n    async def test_get_orchestrator_response_returns_none_if_absent(self, db, saved_query):\n        result = await db.get_orchestrator_response(saved_query.query_id)\n        assert result is None\n\n\nclass TestFeedbackOperations:\n    @pytest.mark.asyncio\n    async def test_save_and_retrieve_feedback(self, db, saved_query):\n        from src.models.schemas import FeedbackRecord\n        record = FeedbackRecord(\n            feedback_id=str(uuid.uuid4()),\n            query_id=saved_query.query_id,\n            rating=\"accurate\",\n            comment=\"Very helpful\",\n        )\n        await db.save_feedback(record)\n        retrieved = await db.get_feedback_for_query(saved_query.query_id)\n        assert retrieved is not None\n        assert retrieved.rating == \"accurate\"\n\n    @pytest.mark.asyncio\n    async def test_export_feedback_returns_list(self, db, saved_query):\n        from src.models.schemas import FeedbackRecord\n        record = FeedbackRecord(\n            feedback_id=str(uuid.uuid4()),\n            query_id=saved_query.query_id,\n            rating=\"needs_work\",\n        )\n        await db.save_feedback(record)\n        exported = await db.export_feedback()\n        assert isinstance(exported, list)\n        assert len(exported) >= 1\n\n\nclass TestFetchCacheDb:\n    @pytest.mark.asyncio\n    async def test_get_cached_returns_none_before_init(self, db):\n        result = await db.get_cached(\"https://example.com\")\n        assert result is None\n\n    @pytest.mark.asyncio\n    async def test_clear_expired_returns_int(self, db):\n        count = await db.clear_expired()\n        assert isinstance(count, int)\n```\n\n---\n\n",
        "level": 1
      },
      {
        "title": "7. `ContentExtractor` — Partially Tested (`src/fetch/extractors.py`)",
        "content": "\n**Untested:** `_get_selectors()` domain matching, `_truncate()`, `_clean_text()`, `_format_content()` nested divs, extraction failure fallback.\n\n```python\n",
