        "title": "tests/test_extractors.py",
        "content": "import pytest\n\n\n@pytest.fixture\ndef extractor():\n    from src.fetch.extractors import ContentExtractor\n    return ContentExtractor()\n\n\nclass TestExtractTruncation:\n    def test_truncates_at_max_length(self, extractor):\n        long_html = f\"<html><body><p>{'x' * 100000}</p></body></html>\"\n        result = extractor.extract(\"https://example.com\", long_html, max_length=100)\n        assert len(result) <= 100\n\n    def test_adds_ellipsis_when_truncated(self, extractor):\n        long_html = f\"<html><body><p>{'x' * 100000}</p></body></html>\"\n        result = extractor.extract(\"https://example.com\", long_html, max_length=50)\n        assert result.endswith(\"...\")\n\n\nclass TestExtractRemoveElements:\n    def test_removes_navigation(self, extractor):\n        html = \"\"\"<html><body><main>\n            <nav>Skip to main</nav>\n            <p>Policy content here.</p>\n        </main></body></html>\"\"\"\n        result = extractor.extract(\"https://tbs-sct.canada.ca/pol/doc-eng.aspx\", html)\n        assert \"Skip to main\" not in result\n        assert \"Policy content here\" in result\n\n\nclass TestExtractHeadings:\n    def test_headings_preserved(self, extractor):\n        html = \"<html><body><main><h1>Title</h1><p>Body</p></main></body></html>\"\n        result = extractor.extract(\"https://example.com\", html)\n        assert \"Title\" in result\n        assert \"Body\" in result\n\n\nclass TestExtractEmptyAndMalformed:\n    def test_empty_html(self, extractor):\n        result = extractor.extract(\"https://example.com\", \"\")\n        assert isinstance(result, str)\n\n    def test_no_body_tag(self, extractor):\n        result = extractor.extract(\"https://example.com\", \"<p>Just a paragraph.</p>\")\n        assert isinstance(result, str)\n\n\nclass TestGetSelectors:\n    def test_falls_back_to_default_for_unknown_domain(self, extractor):\n        selectors = extractor._get_selectors(\"https://unknown-domain.example.com/page\")\n        assert isinstance(selectors, dict)\n\n    def test_returns_domain_specific_selectors(self, extractor):\n        laws_selectors = extractor._get_selectors(\"https://laws-lois.justice.gc.ca/eng/acts/P-33.01/\")\n        default_selectors = extractor._get_selectors(\"https://unknown.example.com/\")\n        # Laws domain should have specific selectors configured\n        assert isinstance(laws_selectors, dict)\n```\n\n---\n\n",
