  "output": "I now have a thorough picture of the codebase. Here is the full coverage analysis:\n\n---\n\n## Test Coverage Analysis\n\n### What's Tested\n\n| Module | Coverage |\n|---|---|\n| `KISSParser.parse_document` | Determinism + GC entity/deontic resolution |\n| `QueryKISSParser.parse` | Grievance and staffing query happy paths |\n| `SageExtractor.extract_triples` | Single \"must\" obligation triple |\n| `GraphQueryEngine._score` | One scoring scenario |\n| `ContentExtractor.extract` | Basic heading + paragraph extraction |\n| `FetchEngine` | Creation + health check only |\n| `schemas.py` | Two Pydantic model constructors |\n| `config.py` | Load + attribute existence |\n| `DatabaseManager` | Init + save/get query |\n\n---\n\n### Critical Gaps by Module\n\n---\n\n#### 1. `GCEntityMatcher` — zero direct unit tests\n\n**Untested paths:**\n- `find_matches()` — span overlap deconfliction (`_append_if_free`)\n- `find_matches()` — regex patterns: `CLASSIFICATION_PATTERN`, `LANGUAGE_PROFILE_PATTERN`, `SECTION_REF_PATTERN`\n- `get_entity_type()` — regex fallback branch\n- Longer phrase takes priority over shorter when overlapping\n\n```python\n# tests/test_parsing/test_gc_entities.py\n\nfrom src.parsing.gc_entities import GCEntityMatcher, EntityDefinition, CLASSIFICATION_PATTERN\n\nclass TestGCEntityMatcher:\n    def setup_method(self):\n        self.matcher = GCEntityMatcher()\n\n    def test_find_matches_returns_classification(self):\n        matches = self.matcher.find_matches(\"Appoint an IT-02 to the position.\")\n        types = {m.entity_type for m in matches}\n        assert \"CLASSIFICATION\" in types\n        assert any(m.text == \"IT-02\" for m in matches)\n\n    def test_find_matches_returns_language_designation(self):\n        matches = self.matcher.find_matches(\"The position requires a CBC profile.\")\n        assert any(m.text == \"CBC\" for m in matches)\n\n    def test_find_matches_returns_section_ref(self):\n        matches = self.matcher.find_matches(\"See section 5.2 for details.\")\n        assert any(m.entity_type == \"SECTION_REF\" for m in matches)\n\n    def test_longer_phrase_wins_overlap(self):\n        # \"delegated manager\" must win over standalone \"manager\"\n        matches = self.matcher.find_matches(\"The delegated manager must approve.\")\n        texts = [m.text.lower() for m in matches]\n        assert \"delegated manager\" in texts\n        # No separate \"manager\" match inside the same span\n        assert not any(t == \"manager\" for t in texts)\n\n    def test_no_overlapping_spans(self):\n        matches = self.matcher.find_matches(\n            \"The deputy head or delegated manager shall ensure compliance.\"\n        )\n        spans = [(m.char_start, m.char_end) for m in matches]\n        for i, (s1, e1) in enumerate(spans):\n            for j, (s2, e2) in enumerate(spans):\n                if i != j:\n                    assert not (s1 < e2 and e1 > s2), f\"Overlap: {spans[i]} vs {spans[j]}\"\n\n    def test_get_entity_type_classification_regex_fallback(self):\n        # Not in STATIC_ENTITIES but matches CLASSIFICATION_PATTERN\n        assert self.matcher.get_entity_type(\"AS-05\") == \"CLASSIFICATION\"\n\n    def test_get_entity_type_unknown_returns_none(self):\n        assert self.matcher.get_entity_type(\"banana\") is None\n\n    def test_matches_sorted_by_char_start(self):\n        matches = self.matcher.find_matches(\"Employee NCR indeterminate IT-02\")\n        starts = [m.char_start for m in matches]\n        assert starts == sorted(starts)\n\n    def test_custom_definitions_override_defaults(self):\n        custom = [EntityDefinition(\"CUSTOM_ACTOR\", \"GC_ACTOR\")]\n        matcher = GCEntityMatcher(definitions=custom)\n        assert matcher.get_entity_type(\"CUSTOM_ACTOR\") == \"GC_ACTOR\"\n        assert matcher.get_entity_type(\"employee\") is None  # not in custom list\n```\n\n---\n\n#### 2. `KISSParser` — missing edge cases\n\n**Untested:**\n- `_guess_pos()` for each branch (deontic, stopword, verb-ending, uppercase, digit)\n- Empty / whitespace-only text input\n- Text with no deontic verbs → `is_deontic=False` for all tokens\n- Text with multiple sentences → correct `sentence_idx` assignment\n- Heuristic fallback path when spaCy is unavailable\n- `classify_token()` CONNECTOR / PUNCT branches\n\n```python\n# tests/test_parsing/test_kiss_parser_extended.py\n\nimport pytest\nfrom src.parsing.kiss_parser import KISSParser\nfrom src.parsing.gc_entities import GCEntityMatcher\n\n\nclass TestKISSParserGuessPOS:\n    def setup_method(self):\n        self.parser = KISSParser()\n\n    def test_guess_pos_deontic_returns_aux(self):\n        assert self.parser._guess_pos(\"must\") == \"AUX\"\n        assert self.parser._guess_pos(\"shall\") == \"AUX\"\n\n    def test_guess_pos_stopword_returns_det(self):\n        assert self.parser._guess_pos(\"the\") == \"DET\"\n        assert self.parser._guess_pos(\"a\") == \"DET\"\n\n    def test_guess_pos_common_verb_returns_verb(self):\n        assert self.parser._guess_pos(\"approve\") == \"VERB\"\n\n    def test_guess_pos_ing_suffix_returns_verb(self):\n        assert self.parser._guess_pos(\"approving\") == \"VERB\"\n\n    def test_guess_pos_uppercase_returns_propn(self):\n        assert self.parser._guess_pos(\"Treasury\") == \"PROPN\"\n\n    def test_guess_pos_digit_returns_propn(self):\n        assert self.parser._guess_pos(\"02\") == \"PROPN\"\n\n    def test_guess_pos_punct_returns_punct(self):\n        assert self.parser._guess_pos(\".\") == \"PUNCT\"\n\n\nclass TestKISSParserEdgeCases:\n    def setup_method(self):\n        self.parser = KISSParser()\n\n    def test_empty_text_produces_empty_tokens(self):\n        doc = self.parser.parse_document(\"\", \"https://example.com\", \"Test\", \"staffing\")\n        assert doc.tokens == []\n\n    def test_no_deontic_verbs(self):\n        doc = self.parser.parse_document(\n            \"The employee works in Ottawa.\", \"https://example.com\", \"Test\", \"staffing\"\n        )\n        assert not any(t.is_deontic for t in doc.tokens)\n\n    def test_multi_sentence_assigns_correct_sentence_idx(self):\n        doc = self.parser.parse_document(\n            \"The employee must comply. The manager shall approve.\",\n            \"https://example.com\",\n            \"Test\",\n            \"staffing\",\n        )\n        indices = {t.sentence_idx for t in doc.tokens}\n        assert len(indices) >= 2, \"Expected tokens in at least two sentences\"\n\n    def test_heuristic_fallback_produces_tokens(self):\n        # Force heuristic path by injecting _nlp=None\n        parser = KISSParser()\n        parser._nlp = None\n        doc = parser.parse_document(\n            \"Employee must comply.\", \"https://example.com\", \"Policy\", \"staffing\"\n        )\n        assert len(doc.tokens) > 0\n        assert doc.model_version == \"heuristic\"\n\n    def test_classify_token_punctuation(self):\n        cat, is_d, d_type = self.parser.classify_token(\".\", \".\", \"PUNCT\")\n        assert cat == \"PUNCTUATION\"\n        assert not is_d\n\n    def test_classify_token_deontic_priority(self):\n        # \"must\" should be deontic regardless of pos supplied\n        cat, is_d, d_type = self.parser.classify_token(\"must\", \"must\", \"AUX\")\n        assert cat == \"VERB\"\n        assert is_d\n        assert d_type == \"obligation\"\n\n\nclass TestSentenceSpans:\n    def setup_method(self):\n        self.parser = KISSParser()\n\n    def test_single_sentence_no_punctuation(self):\n        spans = self.parser._sentence_spans(\"no period here\")\n        assert len(spans) == 1\n\n    def test_multiple_sentences(self):\n        spans = self.parser._sentence_spans(\"First. Second. Third.\")\n        assert len(spans) >= 2\n```\n\n---\n\n#### 3. `SageExtractor` — missing validation rule paths\n\n**Untested:**\n- `UNANCHORED_OBLIGATION` flag when subject is not a known GC actor\n- `DISCRETIONARY_RIGHT` flag (`employee` + `discretion` deontic)\n- `POTENTIAL_CONFLICT` flag from `_apply_cross_sentence_rules`\n- Sentence with fewer than 2 entities → no triple produced\n- `process_document_for_url()` → unknown URL returns `[]`\n- `_instrument_for_url()` with `/FullText.html` URL normalization\n\n```python\n# tests/test_parsing/test_sage_extractor_extended.py\n\nimport pytest\nfrom unittest.mock import AsyncMock, MagicMock\nfrom src.parsing.kiss_parser import KISSParser\nfrom src.parsing.sage_extractor import SageExtractor\nfrom src.models.schemas import KISSDocument, KISSToken\n\n\ndef _make_token(text, lemma, pos, category, is_deontic, deontic_type, start, end, sent_idx, tok_idx):\n    return KISSToken(\n        text=text, lemma=lemma, pos=pos, kiss_category=category,\n        is_deontic=is_deontic, deontic_type=deontic_type,\n        char_start=start, char_end=end,\n        sentence_idx=sent_idx, token_idx=tok_idx,\n    )\n\n\nclass TestValidationFlags:\n    def setup_method(self):\n        self.parser = KISSParser()\n        self.extractor = SageExtractor(parser=self.parser)\n\n    def test_unanchored_obligation_flag(self):\n        # Subject is \"supervisor\" (not in _GC_ACTORS), predicate is \"must\" (obligation)\n        doc = self.parser.parse_document(\n            \"The supervisor must complete the form.\", \"https://x.com\", \"Policy\", \"governance\"\n        )\n        triples = self.extractor.extract_triples(doc, \"doc-unanchored\")\n        obligation_triples = [t for t in triples if t.deontic_type == \"obligation\"]\n        unanchored = [t for t in obligation_triples if \"UNANCHORED_OBLIGATION\" in t.validation_flags]\n        assert len(unanchored) >= 1\n\n    def test_discretionary_right_flag(self):\n        doc = self.parser.parse_document(\n            \"An employee may request leave.\", \"https://x.com\", \"Policy\", \"governance\"\n        )\n        triples = self.extractor.extract_triples(doc, \"doc-discretion\")\n        discretion_triples = [t for t in triples if \"DISCRETIONARY_RIGHT\" in t.validation_flags]\n        assert len(discretion_triples) >= 1\n\n    def test_potential_conflict_flag(self):\n        parser = KISSParser()\n        extractor = SageExtractor(parser=parser)\n        doc1 = parser.parse_document(\n            \"The employee must submit the form.\", \"https://x.com\", \"P1\", \"governance\"\n        )\n        doc2 = parser.parse_document(\n            \"The employee must submit the report.\", \"https://x.com\", \"P2\", \"governance\"\n        )\n        triples = extractor.extract_triples(doc1, \"d1\") + extractor.extract_triples(doc2, \"d2\")\n        combined = extractor._apply_cross_sentence_rules(triples)\n        conflict_triples = [t for t in combined if \"POTENTIAL_CONFLICT\" in t.validation_flags]\n        assert len(conflict_triples) >= 1\n\n    def test_no_triple_when_fewer_than_two_entities(self):\n        doc = self.parser.parse_document(\n            \"Must comply.\", \"https://x.com\", \"Policy\", \"governance\"\n        )\n        triples = self.extractor.extract_triples(doc, \"doc-no-entities\")\n        assert triples == []\n\n\nclass TestInstrumentForUrl:\n    def setup_method(self):\n        self.extractor = SageExtractor()\n\n    def test_unknown_url_returns_none(self):\n        result = self.extractor._instrument_for_url(\"https://unknown-domain.example.com/policy\")\n        assert result is None\n\n    def test_fulltext_url_normalization(self):\n        # Should match instrument whose URL is the base without /FullText.html\n        result = self.extractor._instrument_for_url(\n            \"https://laws-lois.justice.gc.ca/eng/acts/P-33.3/FullText.html\"\n        )\n        # Result may be None if URL not in registry — test the matching logic\n        from pathlib import Path\n        import json\n        registry = json.loads(Path(\"src/data/policy_registry.json\").read_text())\n        for instrument in registry:\n            url = instrument.get(\"url\", \"\")\n            if url.endswith(\"/FullText.html\"):\n                base = url.removesuffix(\"/FullText.html\")\n                matched = self.extractor._instrument_for_url(base)\n                assert matched is not None\n                break\n\n\n@pytest.mark.asyncio\nasync def test_process_document_for_url_unknown_returns_empty():\n    extractor = SageExtractor()\n    result = await extractor.process_document_for_url(\"https://not-in-registry.example.com\", \"text\")\n    assert result == []\n```\n\n---\n\n#### 4. `GraphQueryEngine` — missing scoring + async paths\n\n**Untested:**\n- Score = 0 → triple excluded from results\n- Object-side entity match contributes +1\n- `find_conflicts()` — same object means no conflict pair; different objects produce one\n- `get_entity_neighborhood()` — depth parameter scales limit\n- `is_document_parsed()` and `get_coverage_stats()` delegation\n\n```python\n# tests/test_parsing/test_graph_query_extended.py\n\nimport pytest\nfrom src.models.schemas import PolicyTriple\nfrom src.parsing.graph_query import GraphQueryEngine\n\n\ndef _triple(subject, object_, deontic_type=None, flags=None):\n    return PolicyTriple(\n        triple_id=\"t1\", doc_id=\"d1\",\n        source_url=\"https://x.com\", instrument_title=\"P\",\n        agent_id=\"staffing\", section_heading=None,\n        sentence_text=\"test\",\n        subject=subject, predicate=\"must\", predicate_lemma=\"must\",\n        is_deontic=True, deontic_type=deontic_type or \"obligation\",\n        object_=object_, modifier=None,\n        validation_flags=flags or [],\n    )\n\n\nclass TestGraphQueryScoring:\n    def setup_method(self):\n        self.graph = GraphQueryEngine()\n\n    def test_zero_score_when_no_match(self):\n        triple = _triple(\"manager\", \"form\")\n        score = self.graph._score(triple, query_entities=[\"employee\"], query_verbs=[\"may\"])\n        assert score == 0\n\n    def test_object_match_contributes_one(self):\n        triple = _triple(\"manager\", \"indeterminate\")\n        score = self.graph._score(triple, query_entities=[\"indeterminate\"], query_verbs=[])\n        assert score == 1\n\n    def test_subject_and_object_match(self):\n        triple = _triple(\"employee\", \"form\")\n        score = self.graph._score(\n            triple, query_entities=[\"employee\", \"form\"], query_verbs=[]\n        )\n        assert score == 3  # 2 for subject + 1 for object\n\n    def test_corroboration_flag_adds_one(self):\n        triple = _triple(\"manager\", \"form\", flags=[\"CROSS_INSTRUMENT_CORROBORATION\"])\n        score = self.graph._score(triple, query_entities=[], query_verbs=[])\n        assert score == 1\n\n\nclass TestFindConflicts:\n    def setup_method(self):\n        self.graph = GraphQueryEngine()\n\n    def test_same_object_no_conflict(self):\n        t1 = _triple(\"employee\", \"form\")\n        t2 = _triple(\"employee\", \"form\")\n        conflicts = self.graph._pair_conflicts([t1, t2])\n        assert conflicts == []\n\n    def test_different_objects_produce_conflict(self):\n        t1 = _triple(\"employee\", \"form\")\n        t2 = _triple(\"employee\", \"report\")\n        conflicts = self.graph._pair_conflicts([t1, t2])\n        assert len(conflicts) == 1\n\n    def _pair_conflicts(self, triples):\n        # Inline the pairing logic (avoids DB) — replicate _find_conflicts logic\n        conflicts = []\n        for i, left in enumerate(triples):\n            for right in triples[i + 1:]:\n                if left.object_.lower() != right.object_.lower():\n                    conflicts.append((left, right))\n        return conflicts\n```\n\n---\n\n#### 5. `ContentExtractor` — missing branches\n\n**Untested:**\n- Truncation at `max_length` appends `\"...\"`\n- URL with no matching domain selector falls through to `default`\n- Missing `<main>` falls back to `<body>`\n- Heading elements formatted with newlines in `_format_content`\n- `_load_selectors()` failure gracefully returns defaults\n\n```python\n# tests/test_fetch/test_extractors.py\n\nimport pytest\nfrom src.fetch.extractors import ContentExtractor\n\n\nclass TestContentExtractorTruncation:\n    def setup_method(self):\n        self.extractor = ContentExtractor()\n\n    def test_truncation_adds_ellipsis(self):\n        long_html = f\"<html><body><p>{'x' * 50000}</p></body></html>\"\n        result = self.extractor.extract(\"https://example.com\", long_html, max_length=100)\n        assert result.endswith(\"...\")\n        assert len(result) == 100\n\n    def test_no_truncation_when_within_limit(self):\n        html = \"<html><body><p>Short text.</p></body></html>\"\n        result = self.extractor.extract(\"https://example.com\", html, max_length=1000)\n        assert \"Short text.\" in result\n        assert not result.endswith(\"...\")\n\n\nclass TestContentExtractorSelectors:\n    def setup_method(self):\n        self.extractor = ContentExtractor()\n\n    def test_fallback_to_body_when_no_main(self):\n        html = \"<html><body><p>Body content.</p></body></html>\"\n        result = self.extractor.extract(\"https://unknown.example.com\", html)\n        assert \"Body content.\" in result\n\n    def test_headings_extracted(self):\n        html = \"<html><body><main><h2>Policy Section</h2><p>Details.</p></main></body></html>\"\n        result = self.extractor.extract(\"https://tbs-sct.canada.ca/test\", html)\n        assert \"Policy Section\" in result\n\n    def test_unknown_domain_uses_default_selectors(self):\n        html = \"<html><body><main><p>Main content.</p></main></body></html>\"\n        result = self.extractor.extract(\"https://totally-unknown-domain.ca/page\", html)\n        assert \"Main content.\" in result\n\n    def test_load_selectors_failure_returns_defaults(self):\n        extractor = ContentExtractor(selectors_path=\"/nonexistent/path.yaml\")\n        html = \"<html><body><p>Fallback content.</p></body></html>\"\n        result = extractor.extract(\"https://example.com\", html)\n        assert \"Fallback content.\" in result\n```\n\n---\n\n#### 6. `FetchEngine` — zero error path tests\n\n**Untested:**\n- `_normalize_url()` rewrites `laws-lois` act index URLs\n- `_get_domain()` on a malformed URL\n- `fetch_batch()` with a mix of successes and failures\n- `FetchError` raised when both httpx and browser fallback fail\n- Cache hit path in `_do_fetch()` skips network\n\n```python\n# tests/test_fetch/test_engine.py\n\nimport pytest\nfrom unittest.mock import AsyncMock, MagicMock, patch\nfrom src.fetch.engine import FetchEngine, FetchError\nfrom src.fetch.cache import CacheEntry\n\n\nclass TestURLNormalization:\n    def setup_method(self):\n        self.engine = FetchEngine()\n\n    def test_normalize_act_index_appends_fulltext(self):\n        url = \"https://laws-lois.justice.gc.ca/eng/acts/P-33.3/\"\n        assert self.engine._normalize_url(url).endswith(\"/FullText.html\")\n\n    def test_normalize_does_not_alter_fulltext_url(self):\n        url = \"https://laws-lois.justice.gc.ca/eng/acts/P-33.3/FullText.html\"\n        assert self.engine._normalize_url(url) == url\n\n    def test_normalize_non_laws_url_unchanged(self):\n        url = \"https://tbs-sct.canada.ca/pol/doc-eng.aspx?id=12345\"\n        assert self.engine._normalize_url(url) == url\n\n\nclass TestGetDomain:\n    def setup_method(self):\n        self.engine = FetchEngine()\n\n    def test_extracts_domain(self):\n        assert self.engine._get_domain(\"https://laws-lois.justice.gc.ca/eng/acts/\") == \"laws-lois.justice.gc.ca\"\n\n    def test_malformed_url_returns_default(self):\n        assert self.engine._get_domain(\"not-a-url\") == \"default\"\n\n\n@pytest.mark.asyncio\nclass TestFetchCache:\n    async def test_cache_hit_skips_http(self):\n        engine = FetchEngine()\n        cached_content = \"cached policy text\"\n        engine._cache.get = AsyncMock(\n            return_value=CacheEntry(url=\"https://x.com\", content=cached_content, ttl_hours=168)\n        )\n        engine._client.get = AsyncMock(side_effect=AssertionError(\"should not call HTTP\"))\n        engine._config.parsing.enabled = False  # suppress parsing side effect\n\n        result = await engine._do_fetch(\"https://x.com\")\n        assert result == cached_content\n\n\n@pytest.mark.asyncio\nclass TestFetchBatch:\n    async def test_batch_skips_failed_urls(self):\n        engine = FetchEngine()\n        async def fake_fetch(url):\n            if \"good\" in url:\n                return \"content\"\n            raise FetchError(\"bad url\")\n\n        engine.fetch = fake_fetch\n        results = await engine.fetch_batch([\"https://good.com\", \"https://bad.com\"])\n        assert \"https://good.com\" in results\n        assert \"https://bad.com\" not in results\n```\n\n---\n\n#### 7. `OrchestratorAgent` — no tests at all\n\n**Untested (all):**\n- `_build_synthesis_prompt()` includes agent findings and citations\n- `_aggregate_citations()` deduplicates by (title, url)\n- `_deterministic_grounding()` computes correct `coverage` field for full/partial/none\n- `_route()` fallback when LLM returns malformed JSON\n- `process()` fallback when JSON parse fails\n\n```python\n# tests/test_agents/test_orchestrator.py\n\nimport json\nimport pytest\nfrom unittest.mock import AsyncMock\nfrom src.agents.orchestrator import OrchestratorAgent\nfrom src.models.schemas import OrchestratorResponse\n\n\n@pytest.fixture\ndef agent():\n    orch = OrchestratorAgent.__new__(OrchestratorAgent)\n    orch._config = None  # not needed for pure-logic tests\n    orch._specialist_agent_ids = [\n        \"staffing\", \"classification\", \"labour\", \"learning\",\n        \"equity\", \"ohs\", \"languages\", \"governance\",\n    ]\n    return orch\n\n\nclass TestBuildSynthesisPrompt:\n    def test_includes_agent_findings(self, agent):\n        responses = [{\"agent_id\": \"staffing\", \"findings\": \"You must use advertised process.\", \"confidence\": \"high\", \"citations\": []}]\n        prompt = agent._build_synthesis_prompt(\"How do I hire?\", responses)\n        assert \"STAFFING\" in prompt\n        assert \"advertised process\" in prompt\n\n    def test_includes_citations(self, agent):\n        responses = [{\n            \"agent_id\": \"staffing\",\n            \"findings\": \"See PSEA.\",\n            \"confidence\": \"high\",\n            \"citations\": [{\"instrument_title\": \"PSEA\", \"url\": \"https://laws-lois.justice.gc.ca/PSEA\", \"relevant_section\": \"s. 30\"}],\n        }]\n        prompt = agent._build_synthesis_prompt(\"Hiring?\", responses)\n        assert \"PSEA\" in prompt\n        assert \"s. 30\" in prompt\n\n\nclass TestAggregateCitations:\n    def test_deduplicates_same_title_and_url(self, agent):\n        responses = [\n            {\"agent_id\": \"staffing\", \"citations\": [{\"instrument_title\": \"PSEA\", \"url\": \"https://x.com\", \"instrument_type\": \"Act\"}]},\n            {\"agent_id\": \"labour\", \"citations\": [{\"instrument_title\": \"PSEA\", \"url\": \"https://x.com\", \"instrument_type\": \"Act\"}]},\n        ]\n        citations = agent._aggregate_citations(responses)\n        assert len(citations) == 1\n\n    def test_different_urls_not_deduplicated(self, agent):\n        responses = [\n            {\"agent_id\": \"staffing\", \"citations\": [{\"instrument_title\": \"PSEA\", \"url\": \"https://x.com\", \"instrument_type\": \"Act\"}]},\n            {\"agent_id\": \"labour\", \"citations\": [{\"instrument_title\": \"PSEA\", \"url\": \"https://y.com\", \"instrument_type\": \"Act\"}]},\n        ]\n        citations = agent._aggregate_citations(responses)\n        assert len(citations) == 2\n\n\nclass TestDeterministicGrounding:\n    def test_full_coverage_when_all_validate(self, agent):\n        responses = [\n            {\"grounding_mode\": \"validate\", \"citations\": [], \"retrieval_status\": {\"instruments_successfully_retrieved\": 3}},\n            {\"grounding_mode\": \"validate\", \"citations\": [], \"retrieval_status\": {\"instruments_successfully_retrieved\": 2}},\n        ]\n        grounding = agent._deterministic_grounding(responses)\n        assert grounding.graph_coverage == \"full\"\n        assert grounding.llm_mode == \"validate\"\n\n    def test_no_coverage_when_none_validate(self, agent):\n        responses = [{\"grounding_mode\": \"extract\", \"citations\": []}]\n        grounding = agent._deterministic_grounding(responses)\n        assert grounding.graph_coverage == \"none\"\n        assert grounding.llm_mode == \"extract\"\n\n    def test_partial_coverage_mixed_modes(self, agent):\n        responses = [\n            {\"grounding_mode\": \"validate\", \"citations\": [], \"retrieval_status\": {\"instruments_successfully_retrieved\": 1}},\n            {\"grounding_mode\": \"extract\", \"citations\": []},\n        ]\n        grounding = agent._deterministic_grounding(responses)\n        assert grounding.graph_coverage == \"partial\"\n\n\n@pytest.mark.asyncio\nclass TestRouteWithMockedLLM:\n    async def test_route_fallback_on_invalid_json(self):\n        agent = OrchestratorAgent.__new__(OrchestratorAgent)\n        agent._specialist_agent_ids = [\"staffing\", \"labour\"]\n        agent._llm_client = MagicMock()\n        agent._llm_client.chat = AsyncMock(return_value=\"not json at all\")\n        result = await agent._route(\"Test query\")\n        assert \"selected_agents\" in result\n        assert set(result[\"selected_agents\"]) == {\"staffing\", \"labour\"}\n```\n\n---\n\n#### 8. `QueryKISSParser` — fallback path not reached\n\n**Untested:**\n- `parse()` returns `None` when entity count < `query_entity_threshold`\n- `parse_with_fallback_result()` sets `fallback_triggered=True`\n- `_infer_entity_type()` for `ENTITY_OVERRIDE` pos\n\n```python\n# Additional tests for tests/test_parsing/test_query_kiss_parser.py\n\ndef test_parse_returns_none_for_too_few_entities() -> None:\n    from src.parsing.query_kiss_parser import QueryKISSParser\n    parser = QueryKISSParser()\n    # Single-word query is unlikely to meet entity threshold\n    result = parser.parse(\"Why?\")\n    assert result is None\n\n\ndef test_parse_with_fallback_result_sets_flag() -> None:\n    from src.parsing.query_kiss_parser import QueryKISSParser\n    parser = QueryKISSParser()\n    result = parser.parse_with_fallback_result(\"Why?\")\n    assert result is not None\n    assert result.fallback_triggered is True\n```\n\n---\n\n#### 9. Integration gap — no end-to-end flow test\n\nNo test exercises the path: `OrchestratorAgent.process_with_streaming` → specialist agents → `FetchEngine` (mocked) → `process()` → `OrchestratorResponse`. This is the single highest-value integration test missing.\n\n```python\n# tests/test_agents/test_orchestrator_integration.py\n\nimport pytest\nfrom unittest.mock import AsyncMock, MagicMock, patch\nfrom src.agents.orchestrator import OrchestratorAgent\nfrom src.models.schemas import SpecialistResponse, RetrievalStatus\n\n\n@pytest.mark.asyncio\nasync def test_process_with_streaming_returns_orchestrator_response():\n    \"\"\"Smoke test: full routing → specialist → synthesis pipeline with stubs.\"\"\"\n    import json\n\n    stub_response = json.dumps({\n        \"summary\": \"You must use an advertised process.\",\n        \"detailed_analysis\": \"Per PSEA s.30...\",\n        \"policy_tensions\": None,\n        \"citations\": [],\n        \"gaps_and_limitations\": None,\n        \"recommended_consultation\": None,\n        \"agents_consulted\": [\"staffing\"],\n        \"overall_confidence\": \"high\",\n    })\n\n    with patch(\"src.agents.orchestrator.get_client\") as mock_get_client, \\\n         patch(\"src.agents.orchestrator.get_specialists\") as mock_specialists:\n\n        llm_client = MagicMock()\n        llm_client.chat = AsyncMock(return_value=stub_response)\n        mock_get_client.return_value = llm_client\n\n        specialist = MagicMock()\n        specialist.process_with_fetch = AsyncMock(return_value=SpecialistResponse(\n            agent_id=\"staffing\",\n            findings=\"Must use advertised process per PSEA s.30.\",\n            citations=[],\n            confidence=\"high\",\n            retrieval_status=RetrievalStatus(\n                instruments_attempted=1,\n                instruments_successfully_retrieved=1,\n            ),\n        ))\n        mock_specialists.return_value = {\"staffing\": specialist}\n\n        orch = OrchestratorAgent()\n        status_updates = []\n\n        async def capture_status(update):\n            status_updates.append(update)\n\n        fetch_engine = MagicMock()\n        result = await orch.process_with_streaming(\n            \"How do I hire an indeterminate IT-02?\",\n            fetch_engine,\n            capture_status,\n        )\n\n    assert result.overall_confidence == \"high\"\n    assert \"advertised process\" in result.summary\n    assert any(u.agent_id == \"orchestrator\" for u in status_updates)\n```\n\n---\n\n### Summary of Gaps\n\n| Priority | Area | Gap |\n|---|---|---|\n| High | `GCEntityMatcher` | No tests at all — core NLP primitive |\n| High | `OrchestratorAgent` | No tests at all — main business logic |\n| High | End-to-end streaming flow | Never exercised together |\n| Medium | `KISSParser` edge cases | Empty input, heuristic fallback, multi-sentence |\n| Medium | `SageExtractor` validation flags | `UNANCHORED_OBLIGATION`, `DISCRETIONARY_RIGHT`, `POTENTIAL_CONFLICT` |\n| Medium | `GraphQueryEngine._score` | Zero-score exclusion, object-side match |\n| Medium | `FetchEngine` error paths | Cache hit, batch failure, URL normalization |\n| Low | `ContentExtractor` | Truncation, missing `<main>`, selector fallback |\n| Low | `QueryKISSParser` | Fallback path, `None` return |\n",
